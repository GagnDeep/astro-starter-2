      "src": "/meta/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/meta/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/meta/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
