{
  "name": "UViewDocument",
  "short_name": "UViewDocument",
  "description": "The fastest, most secure way to view any document in your browser. No sign-ups, no tracking, just your file.",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
