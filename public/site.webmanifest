{
  "name": "udocumentview",
  "short_name": "udocumentview",
  "description": "Simple browser-based document previewer for shared links. Preview PDF, DOCX, and more instantly without downloading.",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#2563eb",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "/meta/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/meta/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/meta/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
