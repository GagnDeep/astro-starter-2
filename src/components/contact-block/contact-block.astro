---
import CaptureForm from "../forms/capture-form.astro";
---
<section class="max-w-3xl mx-auto" style="padding: 4rem 1rem;">
  <h1 class="text-4xl font-bold" style="margin-bottom: 1rem;">Hire a Fractional CTO</h1>
  <p class="text-lg text-[var(--text-color)]" style="margin-bottom: 2rem;">Ready to start a conversation about a specific technology problem or a retainer engagement? Tell us about your current stack and the challenges you're facing.</p>

  <div class="bg-[var(--surface-color)] rounded-lg shadow-sm border border-[var(--border-color)]" style="padding: 1.5rem;">
    <CaptureForm form="contact" submitLabel="Request Consultation">
      <div style="margin-bottom: 1rem;">
        <label for="name" class="block text-sm font-medium" style="margin-bottom: 0.25rem;">Name</label>
        <input id="name" name="name" autocomplete="name" required class="w-full rounded border border-[var(--border-color)] bg-[var(--bg-color)]" style="padding: 0.5rem 0.75rem;" />
      </div>

      <div style="margin-bottom: 1rem;">
        <label for="email" class="block text-sm font-medium" style="margin-bottom: 0.25rem;">Email</label>
        <input id="email" name="email" type="email" autocomplete="email" required class="w-full rounded border border-[var(--border-color)] bg-[var(--bg-color)]" style="padding: 0.5rem 0.75rem;" />
      </div>

      <div style="margin-bottom: 1rem;">
        <label for="company" class="block text-sm font-medium" style="margin-bottom: 0.25rem;">Firm Name / AUM</label>
        <input id="company" name="company" type="text" class="w-full rounded border border-[var(--border-color)] bg-[var(--bg-color)]" style="padding: 0.5rem 0.75rem;" />
      </div>

      <div style="margin-bottom: 1rem;">
        <label for="message" class="block text-sm font-medium" style="margin-bottom: 0.25rem;">How can we help? (e.g., Orion/Redtail sync issues, SEC compliance audit)</label>
        <textarea id="message" name="message" rows="5" required class="w-full rounded border border-[var(--border-color)] bg-[var(--bg-color)]" style="padding: 0.5rem 0.75rem;"></textarea>
      </div>
    </CaptureForm>
  </div>
</section>
