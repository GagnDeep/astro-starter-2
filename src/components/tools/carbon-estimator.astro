---
import CaptureForm from "../forms/capture-form.astro";
---

<div class="carbon-estimator border border-slate-200 rounded-lg p-6 bg-slate-50 my-8">
  <form id="carbon-form" class="space-y-4">
    <div>
      <label for="capacity" class="block text-sm font-medium text-slate-700 mb-1">Battery Capacity (kWh)</label>
      <input type="number" id="capacity" min="1" max="200" value="60" required class="w-full px-3 py-2 border border-slate-300 rounded-md bg-white">
    </div>

    <div>
      <label for="chemistry" class="block text-sm font-medium text-slate-700 mb-1">Chemistry</label>
      <select id="chemistry" class="w-full px-3 py-2 border border-slate-300 rounded-md bg-white">
        <option value="nmc">NMC (Nickel Manganese Cobalt)</option>
        <option value="lfp">LFP (Lithium Iron Phosphate)</option>
      </select>
    </div>

    <button type="submit" class="btn btn-primary w-full mt-4">Estimate Footprint</button>
  </form>

  <div id="carbon-results" class="mt-6 hidden bg-white border border-slate-200 p-4 rounded-md">
    <div class="text-center mb-6">
      <div class="text-3xl font-bold text-slate-900" id="result-value">0</div>
      <div class="text-sm text-slate-500">kg CO2e per kWh (Estimated)</div>
      <div class="text-xs text-slate-400 mt-1">Based on EU JRC default lifecycle averages</div>
    </div>

    <div class="border-t border-slate-200 pt-4 mt-4">
      <h4 class="text-sm font-medium text-slate-700 mb-2">Email me the JRC calculation guide:</h4>
      <CaptureForm form="tool_results" submitLabel="Send Guide" class="btn btn-secondary w-full text-sm">
         <input type="hidden" name="tool" value="carbon-estimator" />
         <input type="hidden" id="hidden-carbon" name="estimated_carbon" value="" />
         <label class="sr-only" for="carbon-email">Work Email</label>
         <input type="email" id="carbon-email" name="email" required placeholder="name@company.com" class="w-full px-3 py-2 border border-slate-300 rounded mb-2 text-sm" />
      </CaptureForm>
    </div>
  </div>

  <noscript>
    <div class="mt-6 bg-white border border-slate-200 p-4 rounded-md text-sm text-slate-700">
      <p>Typical averages (JRC references):</p>
      <ul class="list-disc pl-5 mt-2">
        <li>NMC: ~70-80 kg CO2e / kWh</li>
        <li>LFP: ~50-60 kg CO2e / kWh</li>
      </ul>
    </div>
  </noscript>
</div>

<script>
  const form = document.getElementById('carbon-form');
  const results = document.getElementById('carbon-results');
  const resultValue = document.getElementById('result-value');
  const hiddenCarbon = document.getElementById('hidden-carbon');

  if (form && results && resultValue && hiddenCarbon) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const capacity = parseFloat((document.getElementById('capacity') as HTMLInputElement).value);
      const chemistry = (document.getElementById('chemistry') as HTMLSelectElement).value;

      // Rough EU JRC averages for estimation purposes
      let baseRate = chemistry === 'nmc' ? 75 : 55;

      // Add some variance based on capacity scale
      if (capacity < 10) baseRate *= 1.1;

      const total = Math.round(baseRate);

      resultValue.textContent = total.toString();
      hiddenCarbon.setAttribute('value', total.toString());
      results.classList.remove('hidden');
    });
  }
</script>
