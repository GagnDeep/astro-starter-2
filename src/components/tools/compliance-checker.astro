---
import CaptureForm from "../forms/capture-form.astro";
---

<div class="compliance-checker border border-slate-200 rounded-lg p-6 bg-slate-50 my-8">
  <form id="compliance-form" class="space-y-4">
    <p class="text-sm font-medium text-slate-800 mb-2">Check the data points you currently collect:</p>

    <div class="space-y-2">
      <label class="flex items-center space-x-2">
        <input type="checkbox" class="rounded border-slate-300" value="general">
        <span class="text-sm text-slate-700">General manufacturing info (dates, weights, chemistry)</span>
      </label>
      <label class="flex items-center space-x-2">
        <input type="checkbox" class="rounded border-slate-300" value="carbon">
        <span class="text-sm text-slate-700">Scope 1 & 2 Carbon Footprint per model</span>
      </label>
      <label class="flex items-center space-x-2">
        <input type="checkbox" class="rounded border-slate-300" value="supply">
        <span class="text-sm text-slate-700">Supplier Scope 3 emissions data</span>
      </label>
      <label class="flex items-center space-x-2">
        <input type="checkbox" class="rounded border-slate-300" value="recycled">
        <span class="text-sm text-slate-700">Recycled content percentages (Co, Li, Ni, Pb)</span>
      </label>
      <label class="flex items-center space-x-2">
        <input type="checkbox" class="rounded border-slate-300" value="health">
        <span class="text-sm text-slate-700">State of Health (SoH) metrics from BMS</span>
      </label>
    </div>

    <button type="submit" class="btn btn-primary w-full mt-4">Check Gap Analysis</button>
  </form>

  <div id="compliance-results" class="mt-6 hidden bg-white border border-slate-200 p-4 rounded-md">
    <div class="mb-4">
      <div class="flex justify-between items-center mb-1">
        <span class="text-sm font-medium text-slate-700">Readiness Score</span>
        <span id="score-text" class="text-sm font-bold text-blue-600">0%</span>
      </div>
      <div class="w-full bg-slate-200 rounded-full h-2.5">
        <div id="score-bar" class="bg-blue-600 h-2.5 rounded-full" style="width: 0%"></div>
      </div>
    </div>

    <div id="gap-analysis" class="text-sm text-slate-700 space-y-2 mb-6">
      <!-- Populated by JS -->
    </div>

    <div class="border-t border-slate-200 pt-4 mt-4">
      <h4 class="text-sm font-medium text-slate-700 mb-2">Get the full 90-point checklist:</h4>
      <CaptureForm form="tool_results" submitLabel="Send Checklist" class="btn btn-secondary w-full text-sm">
         <input type="hidden" name="tool" value="compliance-checker" />
         <input type="hidden" id="hidden-score" name="readiness_score" value="" />
         <label class="sr-only" for="compliance-email">Work Email</label>
         <input type="email" id="compliance-email" name="email" required placeholder="name@company.com" class="w-full px-3 py-2 border border-slate-300 rounded mb-2 text-sm" />
      </CaptureForm>
    </div>
  </div>

  <noscript>
    <div class="mt-6 bg-white border border-slate-200 p-4 rounded-md">
      <p class="text-sm text-slate-700">Please enable JavaScript for the interactive gap analysis, or <a href="/contact/" class="text-blue-600">contact us</a> for a manual review.</p>
    </div>
  </noscript>
</div>

<script>
  const form = document.getElementById('compliance-form');
  const results = document.getElementById('compliance-results');
  const scoreText = document.getElementById('score-text');
  const scoreBar = document.getElementById('score-bar');
  const gapAnalysis = document.getElementById('gap-analysis');
  const hiddenScore = document.getElementById('hidden-score');

  if (form && results && scoreText && scoreBar && gapAnalysis && hiddenScore) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const checkboxes = Array.from(form.querySelectorAll('input[type="checkbox"]:checked'));
      const values = checkboxes.map((cb: any) => cb.value);

      const total = 5;
      const score = Math.round((values.length / total) * 100);

      scoreText.textContent = `${score}%`;
      scoreBar.style.width = `${score}%`;
      hiddenScore.setAttribute('value', score.toString());

      let feedback = [];
      if (!values.includes('carbon') || !values.includes('supply')) {
        feedback.push('<p class="text-red-600 font-medium">Critical Gap: Carbon Footprint</p><p>You must map supplier scope 3 emissions to comply with the JRC methodology by 2025/2026.</p>');
      }
      if (!values.includes('recycled')) {
        feedback.push('<p class="text-amber-600 font-medium">Gap: Recycled Content</p><p>You need verifiable declarations of recycled Co, Li, Ni, and Pb shares before 2028 targets hit.</p>');
      }
      if (!values.includes('health')) {
        feedback.push('<p class="text-amber-600 font-medium">Gap: Dynamic Data</p><p>The passport requires a live or periodic link to the Battery Management System for State of Health (SoH).</p>');
      }
      if (values.length === total) {
        feedback.push('<p class="text-green-600 font-medium">Excellent foundation</p><p>You are tracking the core components. The next step is assigning Decentralized Identifiers (DIDs) to individual packs.</p>');
      }

      gapAnalysis.innerHTML = feedback.join('');
      results.classList.remove('hidden');
    });
  }
</script>
