---
---
<div class="privacy-checker-wrapper my-8 bg-surface border border-border p-6 rounded-xl">
  <h2 class="text-white mt-0 mb-4">Health Data Privacy & Compliance Checker</h2>

  <div class="no-js-fallback p-4 bg-gray-800 text-gray-300 rounded mb-6">
    <p class="font-medium mb-2">Compliance Cheat Sheet</p>
    <ul class="list-disc pl-5 mb-0">
      <li><strong>HIPAA (US):</strong> Required if handling Protected Health Information (PHI) and passing it to covered entities (doctors, hospitals).</li>
      <li><strong>GDPR (EU):</strong> Required if you have any EU users. Health data is "special category" requiring explicit opt-in consent.</li>
      <li><strong>CCPA (California):</strong> Required if doing business in CA and meeting revenue/data volume thresholds.</li>
      <li><strong>HealthKit/Google Fit:</strong> You must never sell data obtained from these APIs, and you must have a clear privacy policy accessible in the app store.</li>
    </ul>
    <p class="text-sm mt-4 mb-0">Enable JavaScript for an interactive compliance assessment.</p>
  </div>

  <form id="privacy-form" class="interactive-tool hidden space-y-4">
    <div class="space-y-4">
      <div>
        <label class="block font-medium text-white mb-2">1. Who are your users?</label>
        <div class="space-y-2">
          <label class="flex items-center text-gray-300"><input type="checkbox" name="region" value="us" class="mr-2"> US Residents</label>
          <label class="flex items-center text-gray-300"><input type="checkbox" name="region" value="eu" class="mr-2"> EU/UK Residents</label>
          <label class="flex items-center text-gray-300"><input type="checkbox" name="region" value="ca" class="mr-2"> California Residents</label>
        </div>
      </div>

      <div>
        <label class="block font-medium text-white mb-2">2. Does the app share data with doctors, hospitals, or insurance companies?</label>
        <div class="flex gap-4 text-gray-300">
          <label><input type="radio" name="covered_entity" value="yes" class="mr-1"> Yes</label>
          <label><input type="radio" name="covered_entity" value="no" class="mr-1" checked> No</label>
        </div>
      </div>

      <div>
        <label class="block font-medium text-white mb-2">3. What APIs will you use?</label>
        <div class="space-y-2">
          <label class="flex items-center text-gray-300"><input type="checkbox" name="api" value="healthkit" class="mr-2"> Apple HealthKit</label>
          <label class="flex items-center text-gray-300"><input type="checkbox" name="api" value="googlefit" class="mr-2"> Google Fit API</label>
          <label class="flex items-center text-gray-300"><input type="checkbox" name="api" value="custom" class="mr-2"> Custom Backend Database only</label>
        </div>
      </div>
    </div>

    <div class="pt-6 border-t border-border mt-6">
      <h3 class="text-white text-xl mb-4 mt-0">Your Compliance Requirements</h3>
      <div id="results-container" class="space-y-4">
        <!-- JS will populate this -->
        <p class="text-gray-400">Select options above to see your requirements.</p>
      </div>
    </div>
  </form>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const wrapper = document.querySelector('.privacy-checker-wrapper');
    if (!wrapper) return;

    wrapper.querySelector('.no-js-fallback')?.classList.add('hidden');
    wrapper.querySelector('.interactive-tool')?.classList.remove('hidden');

    const form = document.getElementById('privacy-form') as HTMLFormElement;
    const resultsContainer = document.getElementById('results-container');

    function evaluateCompliance() {
      if(!resultsContainer) return;

      const regions = Array.from(form.querySelectorAll('input[name="region"]:checked')).map((el: any) => el.value);
      const isCoveredEntity = form.querySelector('input[name="covered_entity"]:checked')?.getAttribute('value') === 'yes';
      const apis = Array.from(form.querySelectorAll('input[name="api"]:checked')).map((el: any) => el.value);

      let html = '';

      if (regions.length === 0 && apis.length === 0) {
        resultsContainer.innerHTML = '<p class="text-gray-400">Select options above to see your requirements.</p>';
        return;
      }

      // HIPAA Logic
      if (regions.includes('us') && isCoveredEntity) {
        html += `
          <div class="bg-red-900/30 border border-red-500/50 p-4 rounded text-white">
            <div class="font-bold text-red-400 flex items-center mb-1">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
              HIPAA Compliance Required
            </div>
            <p class="text-sm text-red-200 mt-1 mb-0">Because you are sharing data with a covered entity (doctor/hospital) in the US, your entire backend must be HIPAA compliant. This includes Business Associate Agreements (BAAs) with cloud providers, encryption at rest and in transit, and strict access controls.</p>
          </div>
        `;
      } else if (regions.includes('us') && !isCoveredEntity) {
        html += `
          <div class="bg-green-900/30 border border-green-500/50 p-4 rounded text-white">
            <div class="font-bold text-green-400">Not Subject to HIPAA (Likely)</div>
            <p class="text-sm text-green-200 mt-1 mb-0">General fitness apps for consumers are typically regulated by the FTC, not HIPAA. However, you must still honor your privacy policy and not engage in deceptive practices.</p>
          </div>
        `;
      }

      // GDPR Logic
      if (regions.includes('eu')) {
        html += `
          <div class="bg-blue-900/30 border border-blue-500/50 p-4 rounded text-white">
            <div class="font-bold text-blue-400">GDPR Compliance Required</div>
            <p class="text-sm text-blue-200 mt-1 mb-0">Health and biometric data is considered a "special category" under GDPR Article 9. You need <strong>explicit opt-in consent</strong> before collecting it. You must also provide data portability and the right to be forgotten.</p>
          </div>
        `;
      }

      // API Logic
      if (apis.includes('healthkit') || apis.includes('googlefit')) {
         html += `
          <div class="bg-yellow-900/30 border border-yellow-500/50 p-4 rounded text-white">
            <div class="font-bold text-yellow-400">Platform API Restrictions</div>
            <p class="text-sm text-yellow-200 mt-1 mb-0">Apple and Google expressly forbid selling data obtained from HealthKit/Google Fit to third parties (including advertisers and data brokers). You must have a prominent privacy policy.</p>
          </div>
        `;
      }

      if(html === '') {
         html = '<div class="p-4 bg-gray-800 rounded text-gray-300">Standard FTC privacy guidelines apply. Ensure you have a clear, accurate privacy policy.</div>';
      }

      resultsContainer.innerHTML = html;
    }

    form.addEventListener('change', evaluateCompliance);
  });
</script>
