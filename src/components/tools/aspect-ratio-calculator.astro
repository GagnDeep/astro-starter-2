---
---
<div class="bg-surface border border-border rounded-lg p-6 max-w-lg mx-auto">
  <h2 class="text-xl font-bold mb-4">Aspect Ratio Calculator</h2>
  <p class="text-sm mb-4">Calculate dimensions to maintain a specific aspect ratio for viewing documents or images.</p>

  <form id="ar-calc" class="space-y-4">
    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium mb-1" for="ar-w1">Original Width</label>
        <input type="number" id="ar-w1" class="w-full border border-border rounded p-2 bg-bg text-text" value="1920" min="1" step="any">
      </div>
      <div>
        <label class="block text-sm font-medium mb-1" for="ar-h1">Original Height</label>
        <input type="number" id="ar-h1" class="w-full border border-border rounded p-2 bg-bg text-text" value="1080" min="1" step="any">
      </div>
    </div>

    <div class="text-center font-bold text-xl py-2">=</div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <label class="block text-sm font-medium mb-1" for="ar-w2">New Width</label>
        <input type="number" id="ar-w2" class="w-full border border-border rounded p-2 bg-bg text-text" placeholder="Enter width">
      </div>
      <div>
        <label class="block text-sm font-medium mb-1" for="ar-h2">New Height</label>
        <input type="number" id="ar-h2" class="w-full border border-border rounded p-2 bg-bg text-text" placeholder="Enter height">
      </div>
    </div>

    <button type="button" id="ar-reset" class="w-full border border-border hover:bg-surface text-text py-2 px-4 rounded font-medium transition-colors">Reset</button>
  </form>

  <div class="mt-6 text-sm bg-bg border border-border p-3 rounded">
    <p class="font-semibold mb-1">How this is calculated:</p>
    <p>New Width = Original Width × (New Height ÷ Original Height)</p>
    <p>New Height = Original Height × (New Width ÷ Original Width)</p>
  </div>
</div>

<script>
  const w1 = document.getElementById('ar-w1') as HTMLInputElement;
  const h1 = document.getElementById('ar-h1') as HTMLInputElement;
  const w2 = document.getElementById('ar-w2') as HTMLInputElement;
  const h2 = document.getElementById('ar-h2') as HTMLInputElement;
  const reset = document.getElementById('ar-reset');

  if (w1 && h1 && w2 && h2 && reset) {
    w2.addEventListener('input', () => {
      if (!w1.value || !h1.value || !w2.value) return;
      const ratio = parseFloat(h1.value) / parseFloat(w1.value);
      h2.value = (parseFloat(w2.value) * ratio).toFixed(2);
    });

    h2.addEventListener('input', () => {
      if (!w1.value || !h1.value || !h2.value) return;
      const ratio = parseFloat(w1.value) / parseFloat(h1.value);
      w2.value = (parseFloat(h2.value) * ratio).toFixed(2);
    });

    reset.addEventListener('click', () => {
      w1.value = "1920";
      h1.value = "1080";
      w2.value = "";
      h2.value = "";
    });
  }
</script>
