---
---
<div class="roi-estimator-wrapper my-8 bg-surface border border-border p-6 rounded-xl">
  <h2 class="text-white mt-0 mb-4">Retention ROI Estimator</h2>

  <div class="no-js-fallback p-4 bg-gray-800 text-gray-300 rounded mb-6">
    <p class="font-medium mb-2">How it works</p>
    <p class="mb-0 text-sm">A 5% increase in customer retention can increase profits by 25% to 95%. This tool calculates the financial impact of improving your app's churn rate using standard LTV (Life Time Value) formulas.</p>
    <p class="text-sm mt-4 mb-0">Enable JavaScript for a tailored interactive estimate.</p>
  </div>

  <form id="roi-form" class="interactive-tool hidden space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <label class="block font-medium text-white mb-2">Monthly Active Users (MAU)</label>
        <input type="number" id="mau" value="10000" min="100" class="w-full rounded border border-border bg-gray-800 text-white px-3 py-2" />
      </div>
      <div>
        <label class="block font-medium text-white mb-2">ARPU (Monthly Rev Per User)</label>
        <input type="number" id="arpu" value="15" min="1" step="0.5" class="w-full rounded border border-border bg-gray-800 text-white px-3 py-2" />
      </div>
      <div>
        <label class="block font-medium text-white mb-2">Current Monthly Churn (%)</label>
        <input type="number" id="churn" value="8" min="0.1" max="100" step="0.1" class="w-full rounded border border-border bg-gray-800 text-white px-3 py-2" />
      </div>
      <div>
        <label class="block font-medium text-white mb-2">Target Monthly Churn (%)</label>
        <input type="number" id="target-churn" value="5" min="0.1" max="100" step="0.1" class="w-full rounded border border-border bg-gray-800 text-white px-3 py-2" />
      </div>
    </div>

    <div class="pt-6 border-t border-border mt-6 bg-gray-800 p-4 rounded">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <div class="text-gray-400 mb-1 text-sm">Current LTV</div>
          <div id="current-ltv" class="text-2xl font-bold text-white">$187.50</div>
        </div>
        <div>
          <div class="text-gray-400 mb-1 text-sm">Target LTV</div>
          <div id="target-ltv" class="text-2xl font-bold text-primary">$300.00</div>
        </div>
      </div>
      <div class="mt-4 pt-4 border-t border-gray-700">
        <div class="text-gray-400 mb-1 text-sm">Potential Annual Revenue Increase</div>
        <div id="roi-result" class="text-3xl font-bold text-primary">+$1,125,000</div>
        <p class="text-xs text-gray-500 mt-2">Formula: (Target LTV - Current LTV) * MAU. Note: Simplistic LTV calculation (ARPU / Churn Rate).</p>
      </div>
    </div>
  </form>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const wrapper = document.querySelector('.roi-estimator-wrapper');
    if (!wrapper) return;

    wrapper.querySelector('.no-js-fallback')?.classList.add('hidden');
    wrapper.querySelector('.interactive-tool')?.classList.remove('hidden');

    const mauEl = document.getElementById('mau') as HTMLInputElement;
    const arpuEl = document.getElementById('arpu') as HTMLInputElement;
    const churnEl = document.getElementById('churn') as HTMLInputElement;
    const targetChurnEl = document.getElementById('target-churn') as HTMLInputElement;

    const curLtvEl = document.getElementById('current-ltv');
    const tgtLtvEl = document.getElementById('target-ltv');
    const resultEl = document.getElementById('roi-result');

    const fmt = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
    const fmtDec = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });

    function calculate() {
      const mau = parseFloat(mauEl.value);
      const arpu = parseFloat(arpuEl.value);
      const churn = parseFloat(churnEl.value) / 100;
      const targetChurn = parseFloat(targetChurnEl.value) / 100;

      if(mau > 0 && arpu > 0 && churn > 0 && targetChurn > 0) {
        const curLtv = arpu / churn;
        const tgtLtv = arpu / targetChurn;
        const increase = (tgtLtv - curLtv) * mau;

        if(curLtvEl) curLtvEl.textContent = fmtDec.format(curLtv);
        if(tgtLtvEl) tgtLtvEl.textContent = fmtDec.format(tgtLtv);
        if(resultEl) resultEl.textContent = '+' + fmt.format(increase);
      }
    }

    [mauEl, arpuEl, churnEl, targetChurnEl].forEach(el => el?.addEventListener('input', calculate));
    calculate();
  });
</script>
