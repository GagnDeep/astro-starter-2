---
/**
 * Everything that belongs in <head> for search engines and social platforms.
 *
 * Rendered once by `src/layouts/Layout.astro`; pages never touch it — they set
 * `seo:` front matter and (for posts) the layout derives `article` metadata.
 *
 * Tags are written by hand rather than via a helper library so there is
 * exactly one `robots`, one `canonical` and one Open Graph block per page —
 * duplicated directives are a common cause of confusing Search Console
 * reports.
 */
import { resolveSeo, type ArticleMeta, type SeoFrontmatter } from "../../lib/seo/meta";
import { buildSchemaGraph, type BreadcrumbItem } from "../../lib/seo/schema";
import { observabilityConfig, observabilityOrigin } from "../../lib/observability/config";

interface Props {
  title?: string;
  seo?: SeoFrontmatter | null;
  article?: ArticleMeta;
  breadcrumbs?: BreadcrumbItem[];
  itemList?: {
    name: string;
    items: { name: string; description?: string }[];
  };
}

const { title, seo, article, breadcrumbs, itemList } = Astro.props;

const meta = resolveSeo({ title, seo, url: Astro.url, siteUrl: Astro.site, article });
const schema = buildSchemaGraph({ seo: meta, siteUrl: Astro.site, breadcrumbs, itemList });

const origin = Astro.site ?? new URL(Astro.url.origin);
const rssUrl = new URL("/feed.xml", origin).toString();
const sitemapUrl = new URL("/sitemap-index.xml", origin).toString();
---

<title>{meta.title}</title>
<meta name="description" content={meta.description} />
<link rel="canonical" href={meta.canonical} />

{
  /* `max-image-preview:large` unlocks large thumbnails in Google Discover and
    image results; `max-snippet:-1` lifts the snippet length cap. */
}
<meta name="robots" content={meta.robots} />
<meta name="googlebot" content={meta.robots} />

<meta property="og:type" content={meta.openGraphType} />
<meta property="og:title" content={meta.title} />
<meta property="og:description" content={meta.description} />
<meta property="og:url" content={meta.canonical} />
<meta property="og:site_name" content={meta.siteName} />
<meta property="og:locale" content={meta.locale} />
{meta.image && <meta property="og:image" content={meta.image} />}
{meta.image && meta.imageAlt && <meta property="og:image:alt" content={meta.imageAlt} />}

{
  meta.article?.publishedTime && (
    <meta property="article:published_time" content={meta.article.publishedTime} />
  )
}
{
  meta.article?.modifiedTime && (
    <meta property="article:modified_time" content={meta.article.modifiedTime} />
  )
}
{meta.article?.author && <meta property="article:author" content={meta.article.author} />}
{meta.article?.author && <meta name="author" content={meta.article.author} />}
{meta.article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={meta.title} />
<meta name="twitter:description" content={meta.description} />
{meta.image && <meta name="twitter:image" content={meta.image} />}
{meta.image && meta.imageAlt && <meta name="twitter:image:alt" content={meta.imageAlt} />}
{meta.twitterSite && <meta name="twitter:site" content={meta.twitterSite} />}
{meta.twitterCreator && <meta name="twitter:creator" content={meta.twitterCreator} />}

<meta name="theme-color" content={meta.themeColor} />
<meta name="format-detection" content="telephone=no" />

<link
  rel="alternate"
  type="application/rss+xml"
  title={`${meta.siteName} RSS Feed`}
  href={rssUrl}
/>
<link rel="sitemap" type="application/xml" href={sitemapUrl} />

{/* Shave a round-trip off the first RUM request when telemetry is enabled. */}
{observabilityConfig.enabled && <link rel="preconnect" href={observabilityOrigin()} crossorigin />}

{schema && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
