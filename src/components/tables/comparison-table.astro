---
interface Feature {
  name: string;
  freeFile: boolean | string;
  paidSoftware: boolean | string;
}

interface Props {
  title: string;
  features: Feature[];
}

const { title, features } = Astro.props;
---
<div class="my-12 w-full overflow-x-auto">
  <h3 class="text-2xl font-heading font-bold mb-6 text-[var(--color-primary)]">{title}</h3>
  <table class="w-full text-left border-collapse min-w-[600px]">
    <thead>
      <tr class="bg-gray-100 border-b-2 border-gray-200">
        <th class="p-4 font-semibold text-gray-900 w-1/3">Feature</th>
        <th class="p-4 font-semibold text-[var(--color-secondary)] w-1/3">Truly Free File</th>
        <th class="p-4 font-semibold text-gray-900 w-1/3">Paid Software (Avg)</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-200">
      {features.map((f) => (
        <tr class="hover:bg-gray-50 transition-colors">
          <td class="p-4 text-gray-800 font-medium">{f.name}</td>
          <td class="p-4">
            {typeof f.freeFile === 'boolean' ? (
              f.freeFile ? <span class="text-[var(--color-secondary)] font-bold">✓ Yes</span> : <span class="text-red-600 font-bold">✗ No</span>
            ) : (
              <span class="text-gray-700">{f.freeFile}</span>
            )}
          </td>
          <td class="p-4">
            {typeof f.paidSoftware === 'boolean' ? (
              f.paidSoftware ? <span class="text-green-600 font-bold">✓ Yes</span> : <span class="text-red-600 font-bold">✗ No</span>
            ) : (
              <span class="text-gray-700">{f.paidSoftware}</span>
            )}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
