---
import Markdown from "../utility/markdown.astro";
import { ChevronDown } from "@lucide/astro";

interface Props {
  heading?: string;
  subheading?: string;
  faqs: {
    question: string;
    answer: string;
  }[];
}

const { heading, subheading, faqs = [] } = Astro.props;
---

<section class="py-16 md:py-24 bg-surface-color reveal-on-scroll">
  <div class="mx-auto max-w-3xl px-8">
    {(heading || subheading) && (
      <div class="mb-12">
        {heading && (
          <h2 data-editable="text" data-prop="heading" class="text-balance mb-4">
            {heading}
          </h2>
        )}
        {subheading && (
          <div class="text-text-muted text-lg">
            <Markdown content={subheading} dataProp="subheading" dataType="block" />
          </div>
        )}
      </div>
    )}

    {faqs.length > 0 && (
      <div class="flex flex-col gap-4" data-editable="array" data-prop="faqs">
        {faqs.map((faq, index) => (
          <details class="group border border-border-color rounded-lg bg-bg-color overflow-hidden" data-editable="array-item">
            <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6 text-lg hover:text-brand-color focus-visible transition-colors">
              <span data-editable="text" data-prop={`faqs[${index}].question`} class="pr-6">
                {faq.question}
              </span>
              <ChevronDown class="w-5 h-5 text-text-muted group-open:-rotate-180 transition-transform duration-200 shrink-0" stroke-width="2" />
            </summary>
            <div class="p-6 pt-0 text-text-muted border-t border-transparent group-open:border-border-color">
              <Markdown content={faq.answer} dataProp={`faqs[${index}].answer`} dataType="block" />
            </div>
          </details>
        ))}
      </div>
    )}
  </div>
</section>
