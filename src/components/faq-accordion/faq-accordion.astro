---
import Markdown from "../utility/markdown.astro";
import { ChevronDown } from "@lucide/astro";

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  heading: string;
  items: FaqItem[];
}

const { heading, items } = Astro.props;
---

<section class="py-[var(--spacing-block)] reveal">
  <div class="mx-auto max-w-3xl px-8 flex flex-col gap-8">
    <h2
      data-editable="text"
      data-prop="heading"
      class="text-2xl md:text-3xl font-bold text-neutral-900 dark:text-neutral-100">
      {heading}
    </h2>
    <div class="flex flex-col gap-4 divide-y divide-neutral-300 dark:divide-neutral-700 border-y border-neutral-300 dark:border-neutral-700" data-editable="array" data-prop="items">
      {items.map((item, index) => (
        <details class="group" data-editable="array-item">
          <summary class="flex justify-between items-center font-medium cursor-pointer list-none py-4 text-neutral-800 dark:text-neutral-200 hover:text-brand dark:hover:text-accent-dark transition-colors focus-visible:outline-brand dark:focus-visible:outline-accent-dark">
            <span data-editable="text" data-prop={`items.${index}.question`}>{item.question}</span>
            <span class="transition-transform group-open:rotate-180">
              <ChevronDown class="w-6 h-6" />
            </span>
          </summary>
          <div class="prose text-neutral-600 dark:text-neutral-300 pb-4">
            <Markdown content={item.answer} dataProp={`items.${index}.answer`} dataType="block" />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
