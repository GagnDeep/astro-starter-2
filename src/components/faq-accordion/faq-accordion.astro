---
import Markdown from "../utility/markdown.astro";

interface Props {
  heading: string;
  items: {
    question: string;
    answer: string;
  }[];
}

const { heading, items } = Astro.props;
---

<section class="py-16 md:py-24 bg-(--surface-color) border-y border-(--border-color)">
  <div class="mx-auto max-w-4xl px-8 flex flex-col md:flex-row gap-12 lg:gap-24">
    <div class="md:w-1/3">
      <h2
        data-editable="text"
        data-prop="heading"
        class="text-3xl font-bold text-(--heading-color) text-balance sticky top-8">
        {heading}
      </h2>
    </div>

    <div class="md:w-2/3" data-editable="array" data-prop="items">
      {items && items.length > 0 && items.map((item, index) => (
        <details
          class="group border-b border-(--border-color) last:border-b-0 py-6"
          name="faq-accordion"
          data-editable="array-item"
        >
          <summary class="flex justify-between items-center cursor-pointer list-none text-xl font-medium text-(--heading-color) focus-visible marker:hidden [&::-webkit-details-marker]:hidden hover:text-(--color-brand-600) hover-transition">
            <span class="pr-6 text-balance" data-editable="text" data-prop={`items[${index}].question`}>{item.question}</span>
            <span class="relative flex-shrink-0 ml-1.5 w-5 h-5">
              <svg xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-5 h-5 opacity-100 group-open:opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="square" stroke-linejoin="miter" d="M12 4v16m8-8H4" />
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" class="absolute inset-0 w-5 h-5 opacity-0 group-open:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="square" stroke-linejoin="miter" d="M20 12H4" />
              </svg>
            </span>
          </summary>
          <div class="pt-4 pb-2 text-(--text-color) prose">
             <Markdown content={item.answer} dataProp={`items[${index}].answer`} dataType="block" />
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
