---
export interface Props {
  heading?: string;
  sources: { title: string; url?: string; description?: string }[];
}

const { heading = "Sources & Further Reading", sources } = Astro.props;
---

<section class="mx-auto max-w-3xl px-4 sm:px-8 py-12 mt-12 border-t border-[var(--border-color)]">
  <h2 class="text-2xl font-bold mb-6">{heading}</h2>
  <ul class="space-y-4">
    {sources?.map((source) => (
      <li class="flex flex-col">
        {source.url ? (
          <a href={source.url} class="font-bold text-[var(--link-color)] hover:underline break-words" target="_blank" rel="noopener noreferrer">
            {source.title}
          </a>
        ) : (
          <span class="font-bold">{source.title}</span>
        )}
        {source.description && <span class="text-sm text-[var(--color-neutral-600)] mt-1">{source.description}</span>}
      </li>
    ))}
  </ul>
</section>
