---
interface Source {
  title: string;
  url: string;
  date?: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

<section class="py-8 border-t border-[var(--border-color)]">
  <h3 class="text-lg font-bold mb-4 uppercase tracking-widest text-[var(--text-muted)]">Sources</h3>
  <ul class="space-y-2 text-sm text-[var(--text-muted)]">
    {sources.map((source) => (
      <li>
        <a href={source.url} rel="nofollow" class="underline hover:text-[var(--accent-color)] transition-colors">
          {source.title}
        </a>
        {source.date && <span class="ml-2">({source.date})</span>}
      </li>
    ))}
  </ul>
</section>
