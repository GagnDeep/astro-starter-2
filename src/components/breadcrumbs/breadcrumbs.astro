---
import type { BreadcrumbItem } from "../../lib/seo/schema";

export interface Props {
  breadcrumbs?: BreadcrumbItem[];
}

const { breadcrumbs = [] } = Astro.props;

if (breadcrumbs.length === 0) {
  return null;
}
---

<nav aria-label="Breadcrumb" class="py-4 text-sm text-[var(--color-text-muted)]">
  <ol class="flex flex-wrap items-center gap-2">
    <li>
      <a href="/" class="hover:text-[var(--color-brand-600)] hover:underline">Home</a>
    </li>
    {breadcrumbs.map((crumb, index) => {
      const isLast = index === breadcrumbs.length - 1;
      return (
        <li class="flex items-center gap-2">
          <span class="text-[var(--color-border)]">/</span>
          {isLast ? (
            <span aria-current="page" class="font-medium text-[var(--color-text-base)]">{crumb.name}</span>
          ) : (
            <a href={crumb.url} class="hover:text-[var(--color-brand-600)] hover:underline">{crumb.name}</a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
