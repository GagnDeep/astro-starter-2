---
import { ChevronRight } from "@lucide/astro";

export interface Props {
  items: { name: string; url: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mx-auto max-w-6xl px-4 sm:px-8 py-4">
  <ol class="flex items-center space-x-2 text-sm text-[var(--color-neutral-600)]">
    {items?.map((item, index) => (
      <li class="flex items-center">
        {index > 0 && <ChevronRight class="w-6 h-6 mx-2 text-[var(--color-neutral-400)]" />}
        {index === items.length - 1 ? (
          <span class="font-medium text-[var(--text-color)]" aria-current="page">{item.name}</span>
        ) : (
          <a href={item.url} class="hover:text-[var(--link-color)] hover-transition">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
