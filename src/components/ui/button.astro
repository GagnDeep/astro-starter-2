---
interface Props {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: "primary" | "secondary";
  class?: string;
}

const { href, type = "button", variant = "primary", class: className = "" } = Astro.props;
const btnClass = variant === "primary" ? "btn-primary" : "btn-secondary";

const Element = href ? "a" : "button";
const elementProps = href ? { href, class: `${btnClass} ${className}` } : { type, class: `${btnClass} ${className}` };
---

<Element {...elementProps}>
  <slot />
</Element>
