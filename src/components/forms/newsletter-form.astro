---
import { capture } from "../../../capture.config";
import { actionUrl } from "../../lib/capture";

interface Props {
  form?: string;
  submitLabel?: string;
  successMessage?: string;
  class?: string;
  placeholder?: string;
}

const {
  form = capture.forms.newsletter,
  submitLabel = "Subscribe",
  successMessage = "Thanks for subscribing!",
  class: className = "",
  placeholder = "Email address",
} = Astro.props;

const thanks = new URL(capture.thanksUrl, Astro.site ?? Astro.url).toString();
---

<form
  data-capture={form}
  data-capture-success={successMessage}
  method="POST"
  action={actionUrl(form)}
  class={`flex flex-col sm:flex-row gap-2 ${className}`}
>
  <input type="hidden" name="key" value={capture.publicKey} />
  <input type="hidden" name="redirect" value={thanks} />

  <div class="flex-1">
    <label for="email" class="sr-only">Email address</label>
    <input
      id="email"
      name="email"
      type="email"
      autocomplete="email"
      placeholder={placeholder}
      required
      class="input-field"
    />
  </div>

  <button type="submit" class="btn-primary shrink-0">
    {submitLabel}
  </button>

  <p
    data-capture-status
    role="status"
    aria-live="polite"
    class="absolute mt-14 text-sm data-[state=error]:text-red-600 data-[state=success]:text-green-600 font-medium"
  >
  </p>
</form>

<script>
  import "../../scripts/capture-forms";
</script>
