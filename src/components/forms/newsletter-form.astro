---
import { capture } from "../../../capture.config";
import { actionUrl } from "../../lib/capture";

interface Props {
  submitLabel?: string;
  successMessage?: string;
  class?: string;
}

const {
  submitLabel = "Get Updates",
  successMessage = "You're on the list. We'll send the guide soon.",
  class: className = "",
} = Astro.props;

const thanks = new URL(capture.thanksUrl, Astro.site ?? Astro.url).toString();
---

<form
  data-capture={capture.forms.newsletter}
  data-capture-success={successMessage}
  method="POST"
  action={actionUrl(capture.forms.newsletter)}
  class={`max-w-md ${className}`}
>
  <input type="hidden" name="key" value={capture.publicKey} />
  <input type="hidden" name="redirect" value={thanks} />
  {
    capture.honeypotField && (
      <div class="hidden" aria-hidden="true">
        <label for={capture.honeypotField}>Leave this field empty</label>
        <input
          id={capture.honeypotField}
          name={capture.honeypotField}
          tabindex="-1"
          autocomplete="off"
        />
      </div>
    )
  }

  <div class="flex flex-col sm:flex-row gap-3">
    <div class="flex-1">
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        placeholder="Enter your email"
        class="w-full rounded border border-slate-700 bg-slate-800 text-slate-50 px-4 py-2.5 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500 placeholder-slate-500"
      />
    </div>
    <button
      type="submit"
      class="rounded bg-cyan-500 px-5 py-2.5 font-bold text-slate-900 hover:bg-cyan-600 disabled:opacity-60 whitespace-nowrap"
    >
      {submitLabel}
    </button>
  </div>
  <p
    data-capture-status
    role="status"
    aria-live="polite"
    class="mt-2 text-sm text-slate-400 data-[state=error]:text-red-400 data-[state=success]:text-green-400"
  ></p>
</form>

<script>
  import "../../scripts/capture-forms";
</script>
