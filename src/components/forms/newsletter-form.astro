---
import { capture } from "../../../capture.config";
import { actionUrl } from "../../lib/capture";

interface Props {
  /** Form label — how these submissions are grouped in the dashboard. */
  form?: string;
  /** Submit button text. */
  submitLabel?: string;
  /** Inline message shown after a successful JavaScript submission. */
  successMessage?: string;
  class?: string;
}

const {
  form = capture.forms.newsletter,
  submitLabel = "Subscribe",
  successMessage = "Thanks for subscribing!",
  class: className = "",
} = Astro.props;

const thanks = new URL(capture.thanksUrl, Astro.site ?? Astro.url).toString();
---

<form
  data-capture={form}
  data-capture-success={successMessage}
  method="POST"
  action={actionUrl(form)}
  class={`flex gap-2 w-full max-w-sm ${className}`}
>
  <input type="hidden" name="key" value={capture.publicKey} />
  <input type="hidden" name="redirect" value={thanks} />
  {
    capture.honeypotField && (
      <div class="hidden" aria-hidden="true">
        <label for={`${capture.honeypotField}-newsletter`}>Leave this field empty</label>
        <input
          id={`${capture.honeypotField}-newsletter`}
          name={capture.honeypotField}
          tabindex="-1"
          autocomplete="off"
        />
      </div>
    )
  }

  <div class="flex-1">
    <label for="newsletter-email" class="sr-only">Email address</label>
    <input
      id="newsletter-email"
      name="email"
      type="email"
      autocomplete="email"
      required
      placeholder="Your email address"
      class="w-full rounded border border-border px-3 py-2 text-text bg-surface focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary h-full"
    />
  </div>

  <button
    type="submit"
    class="rounded bg-primary px-5 py-2 font-bold text-surface hover:bg-opacity-90 disabled:opacity-60 whitespace-nowrap h-full"
  >
    {submitLabel}
  </button>

  <p
    data-capture-status
    role="status"
    aria-live="polite"
    class="text-sm data-[state=error]:text-error data-[state=success]:text-primary hidden mt-2 basis-full"
  >
  </p>
</form>

<script>
  import "../../scripts/capture-forms";
</script>
