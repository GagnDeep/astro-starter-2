---
import { capture } from "../../../capture.config";
import { actionUrl } from "../../lib/capture";

interface Props {
  /** Submit button text. */
  submitLabel?: string;
  /** Inline message shown after a successful JavaScript submission. */
  successMessage?: string;
  class?: string;
}

const {
  submitLabel = "Subscribe",
  successMessage = "Thanks for subscribing.",
  class: className = "",
} = Astro.props;

const form = capture.forms.newsletter;
const thanks = new URL(capture.thanksUrl, Astro.site ?? Astro.url).toString();
---

<form
  data-capture={form}
  data-capture-success={successMessage}
  method="POST"
  action={actionUrl(form)}
  class={`flex flex-col sm:flex-row gap-2 ${className}`}
>
  <input type="hidden" name="key" value={capture.publicKey} />
  <input type="hidden" name="redirect" value={thanks} />
  {
    capture.honeypotField && (
      <div class="hidden" aria-hidden="true">
        <label for={capture.honeypotField}>Leave this field empty</label>
        <input
          id={capture.honeypotField}
          name={capture.honeypotField}
          tabindex="-1"
          autocomplete="off"
        />
      </div>
    )
  }

  <label for="newsletter-email" class="sr-only">Email address</label>
  <input
    id="newsletter-email"
    name="email"
    type="email"
    autocomplete="email"
    required
    placeholder="Enter your email"
    class="flex-1 rounded border border-border bg-surface px-4 py-2.5 text-text focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
  />

  <button
    type="submit"
    class="btn whitespace-nowrap"
  >
    {submitLabel}
  </button>

  <p
    data-capture-status
    role="status"
    aria-live="polite"
    class="text-sm text-text/80 data-[state=error]:text-error data-[state=success]:text-primary basis-full"
  >
  </p>
</form>

<script>
  import "../../scripts/capture-forms";
</script>
