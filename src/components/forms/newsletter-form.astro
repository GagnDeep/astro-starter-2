---
import { capture } from "../../../capture.config";
import { actionUrl } from "../../lib/capture";

interface Props {
  successMessage?: string;
}
const { successMessage = "Thanks for subscribing!" } = Astro.props;

const thanks = new URL(capture.thanksUrl, Astro.site ?? Astro.url).toString();
---

<form
  data-capture={capture.forms.newsletter}
  data-capture-success={successMessage}
  method="POST"
  action={actionUrl(capture.forms.newsletter)}
  class="flex flex-col sm:flex-row gap-2"
>
  <input type="hidden" name="key" value={capture.publicKey} />
  <input type="hidden" name="redirect" value={thanks} />
  {
    capture.honeypotField && (
      <input class="hidden" aria-hidden="true" name={capture.honeypotField} tabindex="-1" autocomplete="off" />
    )
  }

  <label for="newsletter-email" class="sr-only">Email address</label>
  <input
    id="newsletter-email"
    name="email"
    type="email"
    autocomplete="email"
    required
    placeholder="you@example.com"
    class="w-full rounded border border-border bg-surface px-3 py-2 text-text focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
  />
  <button
    type="submit"
    class="rounded bg-primary px-5 py-2 font-medium text-bg hover:bg-primary-hover whitespace-nowrap transition-colors"
  >
    Subscribe
  </button>

  <p
    data-capture-status
    role="status"
    aria-live="polite"
    class="w-full text-sm data-[state=error]:text-error data-[state=success]:text-primary font-medium sm:col-span-2 hidden"
  >
  </p>
</form>

<script>
  import "../../scripts/capture-forms";
</script>
