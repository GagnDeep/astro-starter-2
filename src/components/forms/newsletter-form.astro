---
import { capture } from "../../../capture.config";
import { actionUrl } from "../../lib/capture";

interface Props {
  formLabel?: keyof typeof capture.forms;
  submitText?: string;
  placeholder?: string;
  successMessage?: string;
  class?: string;
}

const {
  formLabel = "newsletter",
  submitText = "Subscribe",
  placeholder = "you@example.com",
  successMessage = "You're on the list — check your inbox.",
  class: className = "",
} = Astro.props;

const form = capture.forms[formLabel] || formLabel;
const thanks = new URL(capture.thanksUrl, Astro.site ?? Astro.url).toString();
---

<form
  data-capture={form}
  data-capture-success={successMessage}
  method="POST"
  action={actionUrl(form)}
  class={className}
>
  <input type="hidden" name="key" value={capture.publicKey} />
  <input type="hidden" name="redirect" value={thanks} />
  {
    capture.honeypotField && (
      <div class="hidden" aria-hidden="true">
        <label for={`hp-${form}`}>Leave this field empty</label>
        <input id={`hp-${form}`} name={capture.honeypotField} tabindex="-1" autocomplete="off" />
      </div>
    )
  }

  <div class="flex flex-col gap-2 sm:flex-row">
    <label for={`email-${form}`} class="sr-only">Email</label>
    <input
      id={`email-${form}`}
      name="email"
      type="email"
      autocomplete="email"
      required
      placeholder={placeholder}
      class="w-full rounded border border-gray-300 px-3 py-2 focus:border-brand-accent focus:outline-none focus:ring-1 focus:ring-brand-accent"
    />
    <button
      type="submit"
      class="shrink-0 rounded bg-brand-accent px-5 py-2.5 font-medium text-white hover:bg-brand-hover disabled:opacity-60 transition-colors"
    >
      {submitText}
    </button>
  </div>

  <p
    data-capture-status
    role="status"
    aria-live="polite"
    class="mt-2 text-sm text-text-secondary data-[state=error]:text-error data-[state=success]:text-green-700"
  >
  </p>
</form>

<script>
  import "../../scripts/capture-forms";
</script>
