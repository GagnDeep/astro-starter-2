---
/**
 * Inline email capture — newsletter sign-up or waitlist. Same wiring as
 * `capture-form.astro`, one field and a button on a single row.
 *
 * Pass `form={capture.forms.waitlist}` to file these under a different label.
 */
import { capture } from "../../../capture.config";
import { actionUrl } from "../../lib/capture";

interface Props {
  form?: string;
  submitLabel?: string;
  placeholder?: string;
  successMessage?: string;
  class?: string;
}

const {
  form = capture.forms.newsletter,
  submitLabel = "Subscribe",
  placeholder = "you@example.com",
  successMessage = "You're on the list — check your inbox.",
  class: className = "",
} = Astro.props;

const thanks = new URL(capture.thanksUrl, Astro.site ?? Astro.url).toString();
---

<form
  data-capture={form}
  data-capture-success={successMessage}
  method="POST"
  action={actionUrl(form)}
  class={className}
>
  <input type="hidden" name="key" value={capture.publicKey} />
  <input type="hidden" name="redirect" value={thanks} />
  {
    capture.honeypotField && (
      <div class="hidden" aria-hidden="true">
        <label for={`hp-${form}`}>Leave this field empty</label>
        <input id={`hp-${form}`} name={capture.honeypotField} tabindex="-1" autocomplete="off" />
      </div>
    )
  }

  <div class="flex flex-col gap-3 sm:flex-row">
    <label for={`email-${form}`} class="sr-only">Email</label>
    <input
      id={`email-${form}`}
      name="email"
      type="email"
      autocomplete="email"
      required
      placeholder={placeholder}
      class="w-full rounded-md border border-[var(--color-primary-200)] px-4 py-2.5 bg-[var(--color-surface)] text-[var(--color-text-main)] focus:border-[var(--color-primary-500)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary-500)] focus:ring-opacity-50 transition-colors"
    />
    <button
      type="submit"
      class="shrink-0 rounded-md bg-[var(--color-primary-600)] px-6 py-2.5 font-medium text-white hover:bg-[var(--color-primary-700)] focus:ring-2 focus:ring-offset-2 focus:ring-[var(--color-primary-500)] disabled:opacity-60 transition-colors cursor-pointer"
    >
      {submitLabel}
    </button>
  </div>

  <p
    data-capture-status
    role="status"
    aria-live="polite"
    class="mt-2 text-sm data-[state=error]:text-[var(--color-error)] data-[state=success]:text-[var(--color-primary-600)] min-h-[1.25rem]"
  >
  </p>
</form>

<script>
  import "../../scripts/capture-forms";
</script>
