---
import CaptureForm from "./capture-form.astro";
import { capture } from "../../../capture.config";

interface Props {
  class?: string;
  submitLabel?: string;
  title?: string;
  subtitle?: string;
}

const {
  class: className = "",
  submitLabel = "Download the Guide",
  title = "Get the Tax Firm Growth Guide",
  subtitle = "Learn how top CPAs acquire high-value clients without competing on price."
} = Astro.props;

const field = "w-full rounded border border-gray-300 px-3 py-2.5 focus:border-brand-emerald focus:outline-none focus:ring-1 focus:ring-brand-emerald bg-white text-brand-navy shadow-sm";
---

<CaptureForm
  form={capture.forms.guide}
  submitLabel={submitLabel}
  successMessage="Check your inbox — your guide is on the way."
  class={`bg-brand-light p-5 rounded-card border border-slate-200 ${className}`}
>
  <div class="mb-4">
    <h3 class="text-lg font-bold text-brand-navy mb-1">{title}</h3>
    <p class="text-sm text-brand-slate">{subtitle}</p>
  </div>

  <div class="space-y-3">
    <div>
      <label for="name" class="sr-only">First Name</label>
      <input id="name" name="name" type="text" autocomplete="name" required class={field} placeholder="First Name" />
    </div>

    <div>
      <label for="email" class="sr-only">Email Address</label>
      <input id="email" name="email" type="email" autocomplete="email" required class={field} placeholder="Email Address" />
    </div>
  </div>

  <div class="mt-4">
    <button
      type="submit"
      class="w-full rounded-button bg-brand-navy px-5 py-2.5 font-medium text-white hover:bg-brand-navy-light focus:outline-none focus:ring-2 focus:ring-brand-navy focus:ring-offset-2 disabled:opacity-60 transition-colors"
    >
      {submitLabel}
    </button>
  </div>
</CaptureForm>
