---
import { capture } from "../../../capture.config";
import { actionUrl } from "../../lib/capture";

interface Props {
  form?: string;
  cta?: string;
  successMessage?: string;
  class?: string;
}

const {
  form = capture.forms.contact,
  cta = "Submit",
  successMessage = "Success. We'll be in touch.",
  class: className = "",
} = Astro.props;

const thanks = new URL(capture.thanksUrl, Astro.site ?? Astro.url).toString();
const field = "w-full rounded border border-[var(--color-secondary)] px-3 py-2 focus:border-[var(--color-primary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-primary)] bg-white";
const label = "block text-sm font-medium text-[var(--color-text-base)] mb-1 text-left";
---

<form
  data-capture={form}
  data-capture-success={successMessage}
  method="POST"
  action={actionUrl(form)}
  class={`space-y-4 ${className}`}
>
  <input type="hidden" name="key" value={capture.publicKey} />
  <input type="hidden" name="redirect" value={thanks} />
  {
    capture.honeypotField && (
      <div class="hidden" aria-hidden="true">
        <label for={capture.honeypotField}>Leave this field empty</label>
        <input
          id={capture.honeypotField}
          name={capture.honeypotField}
          tabindex="-1"
          autocomplete="off"
        />
      </div>
    )
  }

  <slot>
    <div>
      <label for="email" class={label}>Email address</label>
      <input id="email" name="email" type="email" autocomplete="email" required class={field} />
    </div>
  </slot>

  <button
    type="submit"
    class="w-full btn-primary disabled:opacity-60"
  >
    {cta}
  </button>

  <p
    data-capture-status
    role="status"
    aria-live="polite"
    class="text-sm font-medium pt-2 text-[var(--color-text-base)] data-[state=error]:text-[var(--color-error)] data-[state=success]:text-[var(--color-primary)]"
  >
  </p>
</form>

<script>
  import "../../scripts/capture-forms";
</script>
