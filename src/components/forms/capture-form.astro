---
import { capture } from "../../../capture.config";
import { actionUrl } from "../../lib/capture";

interface Props {
  form?: string;
  submitLabel?: string;
  successMessage?: string;
  class?: string;
}

const {
  form = capture.forms.contact,
  submitLabel = "Send",
  successMessage = "Thanks — we'll be in touch.",
  class: className = "",
} = Astro.props;

const thanks = new URL(capture.thanksUrl, Astro.site ?? Astro.url).toString();

const field =
  "w-full rounded border border-slate-700 bg-slate-800 text-slate-50 px-3 py-2 focus:border-cyan-500 focus:outline-none focus:ring-1 focus:ring-cyan-500";
const label = "block text-sm font-medium text-slate-300 mb-1";
---

<form
  data-capture={form}
  data-capture-success={successMessage}
  method="POST"
  action={actionUrl(form)}
  class={`space-y-4 ${className}`}
>
  <input type="hidden" name="key" value={capture.publicKey} />
  <input type="hidden" name="redirect" value={thanks} />
  {
    capture.honeypotField && (
      <div class="hidden" aria-hidden="true">
        <label for={capture.honeypotField}>Leave this field empty</label>
        <input
          id={capture.honeypotField}
          name={capture.honeypotField}
          tabindex="-1"
          autocomplete="off"
        />
      </div>
    )
  }

  <slot>
    <div>
      <label for="name" class={label}>Name</label>
      <input id="name" name="name" autocomplete="name" required class={field} />
    </div>

    <div>
      <label for="email" class={label}>Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required class={field} />
    </div>

    <div>
      <label for="message" class={label}>Message</label>
      <textarea id="message" name="message" rows="5" class={field}></textarea>
    </div>
  </slot>

  <button
    type="submit"
    class="rounded bg-cyan-500 px-5 py-2.5 font-bold text-slate-900 hover:bg-cyan-600 disabled:opacity-60 w-full md:w-auto"
  >
    {submitLabel}
  </button>

  <p
    data-capture-status
    role="status"
    aria-live="polite"
    class="text-sm text-slate-400 data-[state=error]:text-red-400 data-[state=success]:text-green-400"
  >
  </p>
</form>

<script>
  import "../../scripts/capture-forms";
</script>
