---
import { capture } from "../../../capture.config";
import { actionUrl } from "../../lib/capture";

interface Props {
  /** Form label — how these submissions are grouped in the dashboard. */
  form?: string;
  /** Submit button text. */
  submitLabel?: string;
  /** Inline message shown after a successful JavaScript submission. */
  successMessage?: string;
  class?: string;
}

const {
  form = capture.forms.contact,
  submitLabel = "Send",
  successMessage = "Thanks — we'll be in touch.",
  class: className = "",
} = Astro.props;

// Same-origin absolute URL: the server refuses a cross-origin redirect target.
const thanks = new URL(capture.thanksUrl, Astro.site ?? Astro.url).toString();

const field =
  "w-full rounded border border-gray-300 px-3 py-2 focus:border-[var(--interactive)] focus:outline-none focus:ring-1 focus:ring-[var(--interactive)]";
const label = "block text-sm font-medium mb-1";
---

<form
  data-capture={form}
  data-capture-success={successMessage}
  method="POST"
  action={actionUrl(form)}
  class={`space-y-4 ${className}`}
>
  <input type="hidden" name="key" value={capture.publicKey} />
  <input type="hidden" name="redirect" value={thanks} />
  <input type="hidden" name="time_to_submit" id="time_to_submit" value="" />

  {/* UTM Capture Inputs */}
  <input type="hidden" name="utm_source" id="utm_source" value="" />
  <input type="hidden" name="utm_medium" id="utm_medium" value="" />
  <input type="hidden" name="utm_campaign" id="utm_campaign" value="" />
  <input type="hidden" name="utm_term" id="utm_term" value="" />
  <input type="hidden" name="utm_content" id="utm_content" value="" />

  {
    capture.honeypotField && (
      <div class="hidden" aria-hidden="true" style="display: none;">
        <label for={capture.honeypotField}>Leave this field empty</label>
        <input
          id={capture.honeypotField}
          name={capture.honeypotField}
          tabindex="-1"
          autocomplete="off"
        />
      </div>
    )
  }

  <slot>
    <div>
      <label for="name" class={label}>Name</label>
      <input id="name" name="name" autocomplete="name" required class={field} />
    </div>

    <div>
      <label for="email" class={label}>Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required class={field} />
    </div>

    <div>
      <label for="message" class={label}>Message</label>
      <textarea id="message" name="message" rows="5" class={field}></textarea>
    </div>
  </slot>

  <button
    type="submit"
    class="rounded bg-[var(--accent-primary)] px-5 py-2.5 font-medium text-white hover:bg-[var(--accent-secondary)] disabled:opacity-60"
  >
    {submitLabel}
  </button>

  <p
    data-capture-status
    role="status"
    aria-live="polite"
    class="text-sm data-[state=error]:text-[var(--error)] data-[state=success]:text-[var(--accent-primary)]"
  >
  </p>
</form>

<script>
  import "../../scripts/capture-forms";

  // Set time-to-submit and UTM fields client-side
  const loadTime = Date.now();

  document.addEventListener('submit', (e) => {
    const form = e.target as HTMLFormElement;
    if (form.hasAttribute('data-capture')) {
      const timeInput = form.querySelector('#time_to_submit') as HTMLInputElement;
      if (timeInput) {
        timeInput.value = Math.floor((Date.now() - loadTime) / 1000).toString();
      }
    }
  });

  // Parse URL search params for UTM tags
  const params = new URLSearchParams(window.location.search);
  const utms = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];

  document.querySelectorAll('form[data-capture]').forEach(form => {
    utms.forEach(utm => {
      const val = params.get(utm);
      if (val) {
        const input = form.querySelector(`#${utm}`) as HTMLInputElement;
        if (input) input.value = val;
      }
    });
  });
</script>
