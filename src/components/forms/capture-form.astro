---
/**
 * A working capture form for IBS-Go.
 */
import { capture } from "../../../capture.config";
import { actionUrl } from "../../lib/capture";

interface Props {
  /** Form label — how these submissions are grouped in the dashboard. */
  form?: string;
  /** Submit button text. */
  submitLabel?: string;
  /** Inline message shown after a successful JavaScript submission. */
  successMessage?: string;
  class?: string;
}

const {
  form = capture.forms.contact,
  submitLabel = "Send",
  successMessage = "Thanks — we'll be in touch.",
  class: className = "",
} = Astro.props;

// Same-origin absolute URL: the server refuses a cross-origin redirect target.
const thanks = new URL(capture.thanksUrl, Astro.site ?? Astro.url).toString();

const field =
  "w-full rounded-md border border-[var(--color-primary-200)] px-3 py-2 bg-[var(--color-surface)] text-[var(--color-text-main)] focus:border-[var(--color-primary-500)] focus:outline-none focus:ring-2 focus:ring-[var(--color-primary-500)] focus:ring-opacity-50 transition-colors";
const label = "block text-sm font-medium text-[var(--color-text-muted)] mb-1";
---

<form
  data-capture={form}
  data-capture-success={successMessage}
  method="POST"
  action={actionUrl(form)}
  class={`space-y-4 ${className}`}
>
  <input type="hidden" name="key" value={capture.publicKey} />
  <input type="hidden" name="redirect" value={thanks} />
  {
    capture.honeypotField && (
      <div class="hidden" aria-hidden="true">
        <label for={capture.honeypotField}>Leave this field empty</label>
        <input
          id={capture.honeypotField}
          name={capture.honeypotField}
          tabindex="-1"
          autocomplete="off"
        />
      </div>
    )
  }

  <slot>
    <div>
      <label for="name" class={label}>Name</label>
      <input id="name" name="name" autocomplete="name" required class={field} />
    </div>

    <div>
      <label for="email" class={label}>Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required class={field} />
    </div>

    <div>
      <label for="message" class={label}>Message</label>
      <textarea id="message" name="message" rows="5" class={field}></textarea>
    </div>
  </slot>

  <button
    type="submit"
    class="w-full sm:w-auto rounded-md bg-[var(--color-primary-600)] px-6 py-2.5 font-medium text-white hover:bg-[var(--color-primary-700)] focus:ring-2 focus:ring-offset-2 focus:ring-[var(--color-primary-500)] disabled:opacity-60 transition-colors cursor-pointer"
  >
    {submitLabel}
  </button>

  <p
    data-capture-status
    role="status"
    aria-live="polite"
    class="text-sm data-[state=error]:text-[var(--color-error)] data-[state=success]:text-[var(--color-primary-600)] min-h-[1.25rem]"
  >
  </p>
</form>

<script>
  import "../../scripts/capture-forms";
</script>
