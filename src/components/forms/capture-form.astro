---
import { capture, type FormLabel } from "../../../capture.config";
import { actionUrl } from "../../lib/capture";

interface Props {
  /**
   * The form label from `capture.config.ts` (e.g. "contact", "newsletter").
   * Submissions will be grouped under this label.
   */
  formLabel: FormLabel;
  /**
   * Optional custom thank-you page. If omitted, falls back to the default
   * in `capture.config.ts`.
   */
  thanksUrl?: string;
  class?: string;
  successText?: string;
}

const { formLabel, thanksUrl = capture.thanksUrl, class: className, successText = "Thanks — we'll be in touch." } = Astro.props;
---

<form
  action={actionUrl(formLabel)}
  method="POST"
  data-capture={formLabel}
  data-capture-success={successText}
  class:list={["wcs-capture-form", className]}
>
  <input type="hidden" name="key" value={capture.publicKey} />
  <input type="hidden" name="redirect" value={thanksUrl} />

  {
    capture.honeypotField && (
      <div style="display: none;" aria-hidden="true">
        <input type="text" name={capture.honeypotField} tabindex="-1" autocomplete="off" />
      </div>
    )
  }

  <slot />

  <div data-capture-status class="wcs-message" role="alert" aria-live="polite"></div>
</form>

<script>
  // Loads only on pages containing a capture form.
  import "../../scripts/capture-forms";
</script>

<style>
  @layer components {
    form.is-submitting {
      opacity: 0.7;
      pointer-events: none;
    }
    .wcs-message {
      display: none;
      margin-top: 1rem;
      padding: 0.75rem;
      border-radius: 0.25rem;
      font-size: 0.875rem;
    }
    .wcs-message[data-state="error"] {
      display: block;
      background-color: var(--color-error);
      color: white;
    }
    .wcs-message[data-state="success"] {
      display: block;
      background-color: var(--color-success);
      color: white;
    }
    .wcs-message[data-state="pending"] {
      display: block;
      background-color: var(--color-surface);
      border: 1px solid var(--color-border);
      color: var(--color-text-muted);
    }
  }
</style>
