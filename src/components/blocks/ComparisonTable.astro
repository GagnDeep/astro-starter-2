---
interface Column {
  header: string;
}

interface Row {
  label: string;
  values: string[];
}

interface Props {
  heading: string;
  columns: Column[];
  rows: Row[];
}

const { heading, columns, rows } = Astro.props;
---

<section class="py-16 sm:py-24 bg-[var(--color-bg)]">
  <div class="mx-auto max-w-6xl px-8 overflow-x-auto">
    <h2 class="mb-12 font-display font-bold text-[var(--color-text)]">
      {heading}
    </h2>

    <table class="w-full text-left border-collapse min-w-[600px] border-2 border-[var(--color-border)] shadow-[var(--shadow-sm)]">
      <thead class="bg-[var(--color-surface)] border-b-2 border-[var(--color-border)]">
        <tr>
          <th class="p-6 font-display font-bold text-lg text-[var(--color-text)] border-r-2 border-[var(--color-border)] w-1/3">
            Feature
          </th>
          {columns.map((col, index) => (
            <th class={`p-6 font-display font-bold text-lg text-[var(--color-text)] ${index !== columns.length - 1 ? 'border-r-2 border-[var(--color-border)]' : ''}`}>
              {col.header}
            </th>
          ))}
        </tr>
      </thead>
      <tbody class="divide-y-2 divide-[var(--color-border)] bg-[var(--color-bg)]">
        {rows.map((row) => (
          <tr class="hover:bg-[var(--color-surface)] hover-transition">
            <td class="p-6 font-bold text-[var(--color-text)] border-r-2 border-[var(--color-border)]">
              {row.label}
            </td>
            {row.values.map((val, index) => (
              <td class={`p-6 text-[var(--color-text-muted)] ${index !== row.values.length - 1 ? 'border-r-2 border-[var(--color-border)]' : ''}`}>
                {val}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
