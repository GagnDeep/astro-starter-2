---
export interface Column {
  header: string;
}

export interface Row {
  cells: string[];
}

export interface Props {
  heading: string;
  columns: Column[];
  rows: Row[];
}

const { heading, columns, rows } = Astro.props;
---

<section class="py-16 sm:py-24 max-w-7xl mx-auto px-8 w-full">
  <h2 class="text-3xl sm:text-4xl font-display mb-8">{heading}</h2>

  <div class="overflow-x-auto border border-(--border-color) surface-card">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr
          class="bg-(--color-neutral-100) dark:bg-(--color-brand-800) border-b border-(--border-color)"
        >
          {
            columns.map((col) => (
              <th class="p-4 font-medium border-r border-(--border-color) last:border-r-0 whitespace-nowrap">
                {col.header}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-b border-(--border-color) last:border-b-0 hover:bg-(--color-neutral-50) dark:hover:bg-(--color-brand-900)/50 transition-colors">
              {row.cells.map((cell) => (
                <td class="p-4 border-r border-(--border-color) last:border-r-0" set:html={cell} />
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
