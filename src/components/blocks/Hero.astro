---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export interface Props {
  heading: string;
  subheading?: string;
  primary_cta_text?: string;
  primary_cta_link?: string;
  secondary_cta_text?: string;
  secondary_cta_link?: string;
  image?: {
    image_path: string;
    alt_text?: string;
  };
  button?: {
    text: string;
    link: string;
  };
}

const {
  heading,
  subheading,
  primary_cta_text,
  primary_cta_link,
  secondary_cta_text,
  secondary_cta_link,
  image,
  button
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true }
);

const imgPath = image?.image_path;
const imageSrc = imgPath ? (images[imgPath]?.default ?? imgPath) : null;
const imageAlt = image?.alt_text || "";

const cta1_text = primary_cta_text || button?.text;
const cta1_link = primary_cta_link || button?.link;
---

<section class="py-16 sm:py-24 max-w-7xl mx-auto px-8 w-full">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
    <!-- Asymmetric Hero: Text gets 7 cols, image gets 5 -->
    <div class="lg:col-span-7 flex flex-col items-start text-left">
      <h1 class="text-balance text-gray-900 dark:text-white mb-6">{heading}</h1>
      {
        subheading && (
          <p class="text-xl text-gray-700 dark:text-gray-300 mb-8 max-w-2xl">{subheading}</p>
        )
      }

      <div class="flex flex-wrap gap-4">
        {
          cta1_text && cta1_link && (
            <a
              href={cta1_link}
              class="bg-(--color-brand-600) text-white px-6 py-3 font-medium hover:bg-(--color-brand-700) transition-colors"
            >
              {cta1_text}
            </a>
          )
        }
        {
          secondary_cta_text && secondary_cta_link && (
            <a
              href={secondary_cta_link}
              class="bg-transparent border-2 border-(--border-color) px-6 py-3 font-medium hover:border-(--color-brand-600) transition-colors"
            >
              {secondary_cta_text}
            </a>
          )
        }
      </div>
    </div>

    {
      imageSrc && (
        <div class="lg:col-span-5 h-full min-h-[300px] w-full">
          {typeof imageSrc === 'string' ? (
             <img
              src={imageSrc}
              alt={imageAlt}
              class="w-full h-full object-cover object-center shadow-md border border-(--border-color)"
            />
          ) : (
            <Image
              src={imageSrc}
              alt={imageAlt}
              loading="eager"
              class="w-full h-full object-cover object-center shadow-md border border-(--border-color)"
            />
          )}
        </div>
      )
    }
  </div>
</section>
