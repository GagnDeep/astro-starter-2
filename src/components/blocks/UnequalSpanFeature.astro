---
interface Feature {
  title: string;
  description: string;
}

interface Props {
  heading: string;
  features: Feature[];
}

const { heading, features } = Astro.props;

// Ensure we don't have exactly 3 identical cards
// We map to a bento-style unequal span layout using grid
---

<section class="py-16 sm:py-24 bg-[var(--color-bg)]">
  <div class="mx-auto max-w-6xl px-8">
    <h2 class="mb-12 font-display font-bold text-[var(--color-text)]">
      {heading}
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 auto-rows-[minmax(200px,auto)]">
      {features.map((feature, index) => {
        // Create unequal spans for a bento-box feel
        // Pattern: [8, 4], [4, 8], [6, 6] or if exactly 3: [7, 5], [12]
        let colSpan = "md:col-span-12";
        if (features.length === 3) {
          if (index === 0) colSpan = "md:col-span-7";
          else if (index === 1) colSpan = "md:col-span-5";
          else colSpan = "md:col-span-12";
        } else if (features.length % 2 === 0) {
           if (index % 4 === 0) colSpan = "md:col-span-8";
           else if (index % 4 === 1) colSpan = "md:col-span-4";
           else if (index % 4 === 2) colSpan = "md:col-span-5";
           else if (index % 4 === 3) colSpan = "md:col-span-7";
        } else {
           if (index === features.length -1) colSpan = "md:col-span-12";
           else colSpan = index % 2 === 0 ? "md:col-span-8" : "md:col-span-4";
        }

        return (
          <div class={`${colSpan} border-2 border-[var(--color-border)] bg-[var(--color-surface)] p-8 shadow-[var(--shadow-sm)] scroll-reveal is-visible`}>
            <h3 class="mb-4 font-display font-bold text-2xl text-[var(--color-text)]">
              {feature.title}
            </h3>
            <p class="text-[var(--color-text-muted)] text-pretty">
              {feature.description}
            </p>
          </div>
        );
      })}
    </div>
  </div>
</section>
