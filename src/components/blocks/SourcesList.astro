---
export interface Source {
  title: string;
  url: string;
}

export interface Props {
  heading?: string;
  sources: Source[];
}

const { heading = "Sources & Citations", sources } = Astro.props;
---

<section class="py-12 max-w-3xl mx-auto px-8 w-full border-t border-(--border-color) mt-16">
  <h2 class="text-xl font-medium mb-6">{heading}</h2>
  <ol
    class="list-decimal list-outside ml-5 space-y-3 text-sm text-(--color-neutral-600) dark:text-(--color-neutral-400)"
  >
    {
      sources.map((source) => (
        <li class="pl-2">
          <a
            href={source.url}
            rel="noopener noreferrer"
            class="hover:text-(--color-brand-600) dark:hover:text-(--color-brand-400) underline underline-offset-2"
          >
            {source.title}
          </a>
        </li>
      ))
    }
  </ol>
</section>
