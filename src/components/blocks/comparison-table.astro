---
interface Row {
  feature: string;
  our_value: string;
  their_value: string;
}

interface Props {
  heading: string;
  our_name?: string;
  their_name?: string;
  rows: Row[];
}

const {
  heading,
  our_name = "Us",
  their_name = "Them",
  rows
} = Astro.props;
---

<section class="py-16 md:py-24 bg-[var(--color-bg-base)]">
  <div class="mx-auto max-w-5xl px-8 lg:px-12">
    <h2
      data-editable="text"
      data-prop="heading"
      class="mb-12 text-[var(--color-brand-900)] dark:text-[var(--color-neutral-100)]"
    >
      {heading}
    </h2>

    <div class="overflow-x-auto border border-[var(--color-border-base)] bg-[var(--color-bg-surface)]">
      <table class="w-full text-left border-collapse min-w-[600px]">
        <thead>
          <tr class="bg-[var(--color-neutral-100)] dark:bg-[var(--color-brand-900)] border-b border-[var(--color-border-base)]">
            <th class="p-4 md:p-6 font-display font-bold text-[var(--color-text-base)] w-1/3">Feature</th>
            <th class="p-4 md:p-6 font-display font-bold text-[var(--color-brand-700)] dark:text-[var(--color-accent-400)] w-1/3 bg-[var(--color-brand-100)] dark:bg-[var(--color-brand-800)]" data-editable="text" data-prop="our_name">{our_name}</th>
            <th class="p-4 md:p-6 font-display font-bold text-[var(--color-text-muted)] w-1/3" data-editable="text" data-prop="their_name">{their_name}</th>
          </tr>
        </thead>
        <tbody data-editable="array" data-prop="rows">
          {rows.map((row, i) => (
            <tr class="border-b border-[var(--color-border-base)] last:border-0 hover:bg-[var(--color-neutral-100)] dark:hover:bg-[var(--color-brand-800)] transition-colors" data-editable="array-item">
              <td class="p-4 md:p-6 font-medium text-[var(--color-text-base)]" data-editable="text" data-prop={`rows[${i}].feature`}>{row.feature}</td>
              <td class="p-4 md:p-6 bg-[var(--color-brand-100)]/50 dark:bg-[var(--color-brand-800)]/50 font-semibold text-[var(--color-brand-800)] dark:text-[var(--color-neutral-200)]" data-editable="text" data-prop={`rows[${i}].our_value`}>{row.our_value}</td>
              <td class="p-4 md:p-6 text-[var(--color-text-muted)]" data-editable="text" data-prop={`rows[${i}].their_value`}>{row.their_value}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
