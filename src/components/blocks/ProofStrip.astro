---
interface Logo {
  image_url: string;
  alt_text: string;
}

interface Props {
  heading?: string;
  logos: Logo[];
}

const { heading, logos } = Astro.props;
---

<section class="py-12 bg-[var(--color-bg)] border-y-2 border-[var(--color-border)] overflow-hidden">
  <div class="mx-auto max-w-6xl px-8">
    {heading && (
      <p class="text-center font-display font-bold text-sm text-[var(--color-text-muted)] uppercase tracking-wider mb-8">
        {heading}
      </p>
    )}

    <div class="flex flex-wrap justify-center items-center gap-12 sm:gap-16 opacity-70 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300">
      {logos.map((logo) => (
        <img
          src={logo.image_url}
          alt={logo.alt_text}
          class="h-8 sm:h-10 w-auto object-contain"
          loading="lazy"
        />
      ))}
    </div>
  </div>
</section>
