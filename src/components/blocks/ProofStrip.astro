---
export interface Logo {
  image: string;
  alt: string;
}

export interface Props {
  text: string;
  logos: Logo[];
}

const { text, logos } = Astro.props;
---

<section
  class="py-12 border-y border-(--border-color) bg-(--color-neutral-100) dark:bg-(--color-brand-800)"
>
  <div class="max-w-7xl mx-auto px-8 w-full text-center">
    <p
      class="text-sm font-medium text-(--color-neutral-500) dark:text-(--color-neutral-400) uppercase tracking-wider mb-8"
    >
      {text}
    </p>
    <div
      class="flex flex-wrap justify-center gap-8 md:gap-16 items-center opacity-60 grayscale hover:grayscale-0 transition-all duration-300"
    >
      {
        logos.map((logo) => (
          <img src={logo.image} alt={logo.alt} class="h-8 md:h-12 w-auto object-contain" />
        ))
      }
    </div>
  </div>
</section>
