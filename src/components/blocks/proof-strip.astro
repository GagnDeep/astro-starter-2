---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Logo {
  image_path: string;
  alt_text: string;
}

interface Props {
  text: string;
  logos: Logo[];
}

const { text, logos } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
---

<section class="py-12 border-y border-[var(--color-border-base)] bg-[var(--color-bg-surface)]">
  <div class="mx-auto max-w-7xl px-8 lg:px-12 flex flex-col md:flex-row items-center gap-8 md:gap-16">
    <p
      class="text-sm font-bold tracking-widest uppercase text-[var(--color-text-muted)] shrink-0 whitespace-nowrap"
      data-editable="text"
      data-prop="text"
    >
      {text}
    </p>

    <div class="w-full flex flex-wrap justify-center md:justify-start items-center gap-8 md:gap-12" data-editable="array" data-prop="logos">
      {logos.map((logo, index) => {
        const imageSrc = allImages[logo.image_path]?.default ?? logo.image_path;
        return (
          <div class="h-10 opacity-60 grayscale hover:grayscale-0 hover:opacity-100 hover-transition shrink-0" data-editable="array-item">
            {logo.image_path && (
              <Picture
                data-editable="image"
                data-prop-src={`logos[${index}].image_path`}
                data-prop-alt={`logos[${index}].alt_text`}
                alt={logo.alt_text}
                src={imageSrc}
                class="h-full w-auto object-contain"
                widths={[200]}
                formats={["avif", "webp"]}
              />
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>
