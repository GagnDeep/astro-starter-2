---
interface Props {
  heading: string;
  subheading?: string;
  button: {
    text: string;
    link: string;
  };
}

const { heading, subheading, button } = Astro.props;
---

<section class="py-20 md:py-32 bg-[var(--color-brand-900)] text-[var(--color-neutral-100)] border-y border-[var(--color-brand-800)] relative overflow-hidden">
  {/* Abstract architectural element */}
  <div class="absolute top-0 right-0 w-1/3 h-full bg-[var(--color-brand-800)] -skew-x-12 translate-x-16 hidden md:block opacity-50"></div>

  <div class="mx-auto max-w-5xl px-8 lg:px-12 relative z-10 flex flex-col md:flex-row gap-12 items-start md:items-center justify-between">
    <div class="max-w-2xl">
      <h2
        class="text-3xl md:text-5xl font-bold mb-4 text-[var(--color-neutral-100)]"
        data-editable="text"
        data-prop="heading"
      >
        {heading}
      </h2>
      {subheading && (
        <p
          class="text-xl text-[var(--color-brand-300)]"
          data-editable="text"
          data-prop="subheading"
        >
          {subheading}
        </p>
      )}
    </div>

    <div class="shrink-0">
      <a
        href={button.link}
        class="inline-block whitespace-nowrap bg-[var(--color-accent-600)] px-8 py-4 text-[var(--color-brand-900)] font-bold tracking-wide hover:bg-[var(--color-accent-400)] hover-transition shadow-sm outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--color-accent-400)] focus-visible:ring-offset-[var(--color-brand-900)]"
      >
        <span data-editable="text" data-prop="button.text">
          {button.text}
        </span>
      </a>
    </div>
  </div>
</section>
