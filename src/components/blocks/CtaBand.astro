---
interface Props {
  heading: string;
  description?: string;
  cta_text: string;
  cta_link: string;
}

const { heading, description, cta_text, cta_link } = Astro.props;
---

<section class="py-16 bg-[var(--color-surface)] border-y-2 border-[var(--color-border)]">
  <div class="mx-auto max-w-6xl px-8">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
      <div class="max-w-2xl">
        <h2 class="font-display font-bold text-[var(--color-text)] mb-4">
          {heading}
        </h2>
        {description && (
          <p class="text-xl text-[var(--color-text-muted)] text-pretty">
            {description}
          </p>
        )}
      </div>
      <div class="shrink-0">
        <a href={cta_link} class="brutalist-button">
          {cta_text}
        </a>
      </div>
    </div>
  </div>
</section>
