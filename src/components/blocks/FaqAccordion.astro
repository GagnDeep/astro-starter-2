---
import { ChevronDown } from "@lucide/astro";

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  heading: string;
  faqs: Faq[];
}

const { heading, faqs } = Astro.props;
---

<section class="py-16 sm:py-24 bg-[var(--color-bg)]">
  <div class="mx-auto max-w-4xl px-8">
    <h2 class="mb-12 font-display font-bold text-[var(--color-text)]">
      {heading}
    </h2>

    <div class="flex flex-col gap-4">
      {faqs.map((faq) => (
        <details class="group border-2 border-[var(--color-border)] bg-[var(--color-surface)] shadow-[var(--shadow-sm)]">
          <summary class="flex cursor-pointer items-center justify-between p-6 font-display font-bold text-lg text-[var(--color-text)] focus-visible outline-none">
            {faq.question}
            <ChevronDown class="w-6 h-6 transition-transform duration-200 group-open:rotate-180" />
          </summary>
          <div class="px-6 pb-6 text-[var(--color-text-muted)] text-pretty border-t-2 border-[var(--color-border)] pt-4 mt-2">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
