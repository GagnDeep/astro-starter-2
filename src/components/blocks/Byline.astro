---
export interface Props {
  author_name: string;
  author_title?: string;
  date?: string;
}

const { author_name, author_title, date } = Astro.props;
---

<div class="flex items-center gap-4 py-6 border-b border-(--border-color) mb-8">
  <div>
    <p class="font-medium text-lg">{author_name}</p>
    {
      (author_title || date) && (
        <p class="text-(--color-neutral-600) dark:text-(--color-neutral-400) text-sm mt-1">
          {author_title}
          {author_title && date ? " • " : ""}
          {date}
        </p>
      )
    }
  </div>
</div>
