---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  author_name: string;
  author_title: string;
  date?: string;
  avatar_path?: string;
}

const { author_name, author_title, date, avatar_path } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);

const avatarSrc = avatar_path ? (allImages[avatar_path]?.default ?? avatar_path) : null;
---

<div class="flex items-center gap-4 py-6 border-t border-b border-[var(--color-border-base)] my-8">
  {avatarSrc && (
    <div class="shrink-0 w-12 h-12 rounded-none bg-[var(--color-neutral-200)] dark:bg-[var(--color-brand-800)] overflow-hidden border border-[var(--color-border-base)]">
      <Picture
        data-editable="image"
        data-prop-src="avatar_path"
        alt={`Portrait of ${author_name}`}
        src={avatarSrc}
        class="w-full h-full object-cover grayscale-[50%]"
        widths={[100]}
        formats={["avif", "webp"]}
      />
    </div>
  )}
  <div class="flex flex-col">
    <div class="font-bold text-[var(--color-brand-900)] dark:text-[var(--color-neutral-100)]" data-editable="text" data-prop="author_name">
      {author_name}
    </div>
    <div class="text-sm text-[var(--color-text-muted)]">
      <span data-editable="text" data-prop="author_title">{author_title}</span>
      {date && (
        <>
          <span class="mx-2 opacity-50">&bull;</span>
          <time datetime={new Date(date).toISOString()} data-editable="text" data-prop="date">
            {new Date(date).toLocaleDateString("en-US", { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </>
      )}
    </div>
  </div>
</div>
