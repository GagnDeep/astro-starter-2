---
import Markdown from "../utility/markdown.astro";

interface Feature {
  title: string;
  description: string;
}

interface Props {
  heading: string;
  features: Feature[];
}

const { heading, features } = Astro.props;
---

<section class="py-16 md:py-24 bg-[var(--color-bg-surface)] border-t border-[var(--color-border-base)]">
  <div class="mx-auto max-w-7xl px-8 lg:px-12">
    <h2
      data-editable="text"
      data-prop="heading"
      class="mb-12 md:mb-16 text-[var(--color-brand-900)] dark:text-[var(--color-neutral-100)]"
    >
      {heading}
    </h2>

    <div
      class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-px md:bg-[var(--color-border-base)] border md:border-0 border-[var(--color-border-base)]"
      data-editable="array"
      data-prop="features"
    >
      {
        features.map((feature, index) => {
          // Asymmetric bento grid logic: Alternate 7/5 column spans
          const spanClass = index % 3 === 0
            ? "md:col-span-7"
            : index % 3 === 1
              ? "md:col-span-5"
              : "md:col-span-12";

          return (
            <div
              class={`bg-[var(--color-bg-surface)] p-8 md:p-12 flex flex-col justify-center ${spanClass} hover:bg-[var(--color-neutral-100)] dark:hover:bg-[var(--color-brand-800)] hover-transition`}
              data-editable="array-item"
            >
              <h3
                class="text-xl md:text-2xl font-bold mb-4 text-[var(--color-brand-800)] dark:text-[var(--color-neutral-200)]"
                data-editable="text"
                data-prop={`features[${index}].title`}
              >
                {feature.title}
              </h3>
              <div class="text-[var(--color-text-muted)]">
                <Markdown
                  content={feature.description}
                  dataProp={`features[${index}].description`}
                  dataType="block"
                />
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
