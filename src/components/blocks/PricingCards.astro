---
export interface Props {
  plans: {
    name: string;
    price: string;
    description: string;
    features: string[];
    highlight?: boolean;
    ctaText: string;
    ctaLink: string;
  }[];
}

const { plans } = Astro.props;
---
<div class="grid grid-cols-1 md:grid-cols-3 gap-8 my-12">
  {plans.map(plan => (
    <div class={`rounded-2xl border p-8 flex flex-col ${plan.highlight ? 'border-primary shadow-lg relative' : 'border-border bg-surface'}`}>
      {plan.highlight && (
        <span class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-primary px-3 py-1 text-xs font-semibold text-surface">
          Most Popular
        </span>
      )}
      <h3 class="text-xl font-semibold text-text">{plan.name}</h3>
      <p class="mt-4 flex items-baseline text-4xl font-extrabold text-text">
        {plan.price}
        {plan.price !== 'Free' && plan.price !== 'Custom' && <span class="ml-1 text-xl font-medium text-text-muted">/mo</span>}
      </p>
      <p class="mt-4 text-sm text-text-muted">{plan.description}</p>

      <ul class="mt-8 space-y-4 flex-1">
        {plan.features.map(feature => (
          <li class="flex items-start">
            <svg class="h-5 w-5 shrink-0 text-primary" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span class="ml-3 text-sm text-text-muted">{feature}</span>
          </li>
        ))}
      </ul>

      <a href={plan.ctaLink} class={`mt-8 block w-full rounded-md px-3 py-2 text-center text-sm font-semibold shadow-sm focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 ${plan.highlight ? 'bg-primary text-surface hover:bg-primary-hover focus-visible:outline-primary' : 'bg-base text-text border border-border hover:bg-gray-100'}`}>
        {plan.ctaText}
      </a>
    </div>
  ))}
</div>
