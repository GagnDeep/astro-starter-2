---
import CalculatorWrapper from "./calculator-wrapper.astro";

const methodology = `
<p>This calculates the estimated self-employment tax (SE tax) based on 2024 rates.</p>
<ol>
  <li><strong>Net Earnings:</strong> Calculated as Gross 1099 Income minus Business Expenses.</li>
  <li><strong>Subject to SE Tax:</strong> Generally, 92.35% of your net earnings are subject to SE tax.</li>
  <li><strong>SE Tax Rate:</strong> The rate is 15.3% (12.4% for Social Security + 2.9% for Medicare).</li>
  <li><em>Note: Social Security tax is capped at $168,600 for 2024. This simple calculator applies the 15.3% to the full amount for estimates below the cap.</em></li>
</ol>
`;
---
<CalculatorWrapper
  id="self-employment"
  title="Self-Employment Tax Calculator"
  description="Estimate your self-employment tax (Social Security and Medicare) for your 1099 or freelance income."
  methodology={methodology}
>
  <div slot="inputs" class="space-y-4">
    <div>
      <label for="se-income" class="block text-sm font-medium text-gray-700 mb-1">Total 1099/Freelance Income ($)</label>
      <input type="number" id="se-income" name="se-income" min="0" required class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-[var(--color-primary)]" placeholder="50000" />
    </div>

    <div>
      <label for="se-expenses" class="block text-sm font-medium text-gray-700 mb-1">Business Expenses ($)</label>
      <input type="number" id="se-expenses" name="se-expenses" min="0" class="w-full p-2 border border-gray-300 rounded focus:ring-2 focus:ring-[var(--color-primary)]" placeholder="5000" />
    </div>
  </div>

  <div slot="results" class="space-y-4">
    <div class="p-4 bg-gray-100 rounded border border-gray-200">
      <p class="text-sm text-gray-600 mb-1">Net Business Profit:</p>
      <p class="text-xl font-bold text-gray-900" id="res-se-net">$0</p>
    </div>
    <div class="p-6 bg-orange-50 rounded-lg border-2 border-orange-500">
      <p class="text-sm font-bold text-orange-800 mb-1 uppercase tracking-wider">Estimated SE Tax:</p>
      <p class="text-3xl font-bold text-orange-700" id="res-se-tax">$0</p>
      <p class="text-xs text-orange-600 mt-2">Plus regular income tax.</p>
    </div>
  </div>
</CalculatorWrapper>

<script>
  const form = document.getElementById('form-self-employment') as HTMLFormElement;
  const resultsDiv = document.getElementById('results-self-employment');
  const fallbackDiv = document.getElementById('fallback-self-employment');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const income = parseFloat((document.getElementById('se-income') as HTMLInputElement).value) || 0;
      const expenses = parseFloat((document.getElementById('se-expenses') as HTMLInputElement).value) || 0;

      const netProfit = Math.max(0, income - expenses);

      // 92.35% of net earnings are subject to SE tax
      const subjectToTax = netProfit * 0.9235;

      // SE tax rate is 15.3%
      const seTax = subjectToTax * 0.153;

      document.getElementById('res-se-net')!.textContent = `$${netProfit.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
      document.getElementById('res-se-tax')!.textContent = `$${seTax.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;

      fallbackDiv!.classList.add('hidden');
      resultsDiv!.classList.remove('hidden');
    });
  }
</script>
