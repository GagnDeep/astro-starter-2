---
import NewsletterForm from "../forms/newsletter-form.astro";
import { capture } from "../../../capture.config";
---
<div class="calculator-container p-6 border border-slate-200 rounded-lg bg-white shadow-sm my-8">
  <h3 class="text-xl font-bold mb-4 text-slate-900">Protein Needs Calculator</h3>
  <form id="protein-form" class="space-y-4">
    <div>
      <label class="block font-semibold mb-1 text-slate-700">Weight (lbs)</label>
      <input type="number" id="protein-weight" class="w-full border border-slate-300 rounded px-3 py-2 text-slate-900" required min="50" max="500" value="150" />
    </div>
    <div>
      <label class="block font-semibold mb-1 text-slate-700">Goal</label>
      <select id="protein-goal" class="w-full border border-slate-300 rounded px-3 py-2 text-slate-900">
        <option value="maintenance">Maintenance</option>
        <option value="weight_loss" selected>Weight Loss (Preserve Muscle)</option>
        <option value="muscle_gain">Muscle Gain</option>
      </select>
    </div>
    <button type="submit" class="bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-2 px-4 rounded w-full transition-colors cursor-pointer">Calculate</button>
  </form>

  <div id="protein-result" class="hidden mt-6 p-4 bg-emerald-50 text-emerald-900 border border-emerald-200 rounded">
    <p class="font-bold text-lg mb-2 m-0">Your Daily Protein Target: <span id="protein-value"></span>g</p>
    <p class="text-sm m-0">Based on clinical guidelines for <span id="protein-explanation"></span>.</p>
  </div>

  <div id="calculator-capture" class="hidden mt-4 p-4 border border-slate-200 rounded">
    <p class="font-bold mb-2">Want weekly macro tips?</p>
    <NewsletterForm form={capture.forms.newsletter} />
  </div>

  <noscript>
    <div class="mt-6 p-4 bg-amber-50 text-amber-900 border border-amber-200 rounded">
      <p class="font-bold mb-2 m-0">How to calculate manually:</p>
      <p class="text-sm m-0">Multiply your weight in lbs by 0.8g for maintenance, 1.0g for weight loss, and 1.2g for muscle gain.</p>
    </div>
  </noscript>
</div>

<script>
  const form = document.getElementById('protein-form');
  const resultDiv = document.getElementById('protein-result');
  const valueSpan = document.getElementById('protein-value');
  const expSpan = document.getElementById('protein-explanation');

  if (form && resultDiv && valueSpan && expSpan) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const weight = parseFloat((document.getElementById('protein-weight') as HTMLInputElement).value);
      const goal = (document.getElementById('protein-goal') as HTMLSelectElement).value;

      let multiplier = 0.8;
      let exp = "general maintenance";

      if (goal === 'weight_loss') {
        multiplier = 1.0;
        exp = "preserving lean mass during a caloric deficit";
      } else if (goal === 'muscle_gain') {
        multiplier = 1.2;
        exp = "maximizing muscle protein synthesis";
      }

      const protein = Math.round(weight * multiplier);
      valueSpan.textContent = protein.toString();
      expSpan.textContent = exp;
      resultDiv.classList.remove('hidden');
      document.getElementById('calculator-capture')?.classList.remove('hidden');
    });
  }
</script>
