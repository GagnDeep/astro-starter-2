---
---
<div class="calculator bg-white p-6 rounded-lg shadow-sm border border-slate-200 my-8">
  <h3 class="text-2xl font-bold mb-4">Caffeine & Alcohol Adjuster</h3>
  <p class="mb-6 text-slate-600">See how diuretics affect your daily net hydration.</p>

  <form id="adjuster-form" class="space-y-4 max-w-md">
    <div>
      <label for="water-oz" class="block text-sm font-medium text-slate-700 mb-1">Water Consumed (oz)</label>
      <input type="number" id="water-oz" name="water-oz" required min="0" value="0" class="w-full px-3 py-2 border border-slate-300 rounded-md">
    </div>
    <div>
      <label for="coffee-oz" class="block text-sm font-medium text-slate-700 mb-1">Coffee/Tea Consumed (oz)</label>
      <input type="number" id="coffee-oz" name="coffee-oz" required min="0" value="0" class="w-full px-3 py-2 border border-slate-300 rounded-md">
    </div>
    <div>
      <label for="alcohol-oz" class="block text-sm font-medium text-slate-700 mb-1">Alcohol Consumed (oz)</label>
      <input type="number" id="alcohol-oz" name="alcohol-oz" required min="0" value="0" class="w-full px-3 py-2 border border-slate-300 rounded-md">
    </div>
    <button type="submit" class="w-full bg-primary text-white py-2 px-4 rounded-md hover:bg-primary-dark">Calculate Net Hydration</button>
  </form>

  <div id="adjuster-result" class="mt-6 p-4 bg-slate-50 border border-slate-200 rounded-md hidden">
    <h4 class="font-bold">Net Hydration Score:</h4>
    <div class="text-2xl font-bold text-primary"><span id="net-oz">0</span> oz equivalent</div>
  </div>
</div>

<script>
  const form = document.getElementById('adjuster-form');
  const resultContainer = document.getElementById('adjuster-result');
  const netOzEl = document.getElementById('net-oz');

  if (form && resultContainer && netOzEl) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form as HTMLFormElement);
      const water = parseFloat(formData.get('water-oz') as string) || 0;
      const coffee = parseFloat(formData.get('coffee-oz') as string) || 0;
      const alcohol = parseFloat(formData.get('alcohol-oz') as string) || 0;

      // Coffee hydrates slightly less (0.8x), Alcohol is a diuretic (-0.5x roughly for calculation purposes)
      const net = water + (coffee * 0.8) - (alcohol * 0.5);

      netOzEl.textContent = net.toFixed(1);
      resultContainer.classList.remove('hidden');
    });
  }
</script>
