---
---
<div class="calculator bg-white p-6 rounded-lg shadow-sm border border-slate-200 my-8">
  <h3 class="text-2xl font-bold mb-4">Hydration Status Estimator</h3>
  <p class="mb-6 text-slate-600">Estimate your current hydration level based on common subjective indicators.</p>

  <form id="status-form" class="space-y-4 max-w-md">
    <div>
      <label for="urine-color" class="block text-sm font-medium text-slate-700 mb-1">Urine Color</label>
      <select id="urine-color" name="urine-color" class="w-full px-3 py-2 border border-slate-300 rounded-md">
        <option value="1">Clear / Pale Yellow</option>
        <option value="2">Light Yellow</option>
        <option value="3">Dark Yellow / Amber</option>
      </select>
    </div>
    <div>
      <label for="thirst" class="block text-sm font-medium text-slate-700 mb-1">Thirst Level</label>
      <select id="thirst" name="thirst" class="w-full px-3 py-2 border border-slate-300 rounded-md">
        <option value="1">Not Thirsty</option>
        <option value="2">Mildly Thirsty</option>
        <option value="3">Very Thirsty / Dry Mouth</option>
      </select>
    </div>
    <button type="submit" class="w-full bg-primary text-white py-2 px-4 rounded-md hover:bg-primary-dark">Estimate Status</button>
  </form>

  <div id="status-result" class="mt-6 p-4 rounded-md border hidden"></div>
</div>

<script>
  const form = document.getElementById('status-form');
  const result = document.getElementById('status-result');

  if (form && result) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form as HTMLFormElement);
      const score = parseInt(formData.get('urine-color') as string) + parseInt(formData.get('thirst') as string);

      result.classList.remove('hidden', 'bg-green-50', 'border-green-200', 'bg-yellow-50', 'border-yellow-200', 'bg-red-50', 'border-red-200');

      if (score <= 3) {
        result.classList.add('bg-green-50', 'border-green-200');
        result.innerHTML = '<h4 class="font-bold text-green-800">Likely Euhydrated</h4><p class="text-green-700">You appear to be well hydrated. Keep up your current intake.</p>';
      } else if (score <= 4) {
        result.classList.add('bg-yellow-50', 'border-yellow-200');
        result.innerHTML = '<h4 class="font-bold text-yellow-800">Likely Mildly Dehydrated</h4><p class="text-yellow-700">You may be slightly dehydrated. Consider drinking a glass of water soon.</p>';
      } else {
        result.classList.add('bg-red-50', 'border-red-200');
        result.innerHTML = '<h4 class="font-bold text-red-800">Likely Dehydrated</h4><p class="text-red-700">You show signs of dehydration. Please drink fluids immediately.</p>';
      }
    });
  }
</script>
