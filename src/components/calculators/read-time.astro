---
---
<div class="bg-white rounded-lg shadow-sm border border-slate-200 p-6 md:p-8 my-8 max-w-2xl mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <div class="p-3 bg-blue-50 text-blue-600 rounded-lg">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <h3 class="text-xl font-bold m-0">Document Reading Time Calculator</h3>
  </div>

  <p class="text-slate-600 mb-6">Calculate how long it will take an average adult to read your document based on word count or page length.</p>

  <form id="read-time-calc" class="space-y-5">
    <div>
      <label class="block text-sm font-medium text-slate-700 mb-2">Input Method</label>
      <div class="flex items-center space-x-4">
        <label class="flex items-center">
          <input type="radio" name="input-method" value="words" checked class="border-slate-300 text-blue-600 focus:ring-blue-500">
          <span class="ml-2 text-sm text-slate-700">Word Count</span>
        </label>
        <label class="flex items-center">
          <input type="radio" name="input-method" value="pages" class="border-slate-300 text-blue-600 focus:ring-blue-500">
          <span class="ml-2 text-sm text-slate-700">Pages</span>
        </label>
      </div>
    </div>

    <div id="word-input-group">
      <label for="words" class="block text-sm font-medium text-slate-700 mb-1">Total Words</label>
      <input type="number" id="words" min="1" value="1000" class="block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 border px-3 py-2">
    </div>

    <div id="page-input-group" class="hidden">
      <label for="page-count" class="block text-sm font-medium text-slate-700 mb-1">Total Pages</label>
      <input type="number" id="page-count" min="1" value="5" class="block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 border px-3 py-2">
      <p class="text-xs text-slate-500 mt-1">Assuming ~250-300 words per page (standard spacing).</p>
    </div>

    <div>
      <label for="speed" class="block text-sm font-medium text-slate-700 mb-1">Reading Speed</label>
      <select id="speed" class="block w-full rounded-md border-slate-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 border px-3 py-2 bg-white">
        <option value="150">Slow / Technical (150 WPM)</option>
        <option value="238" selected>Average Adult (238 WPM)</option>
        <option value="300">Fast Reader (300 WPM)</option>
        <option value="400">Skimmer (400 WPM)</option>
      </select>
    </div>

    <button type="submit" class="w-full inline-flex justify-center items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 cursor-pointer">
      Calculate Read Time
    </button>
  </form>

  <div id="read-time-result" class="mt-8 hidden p-5 bg-slate-50 border border-slate-200 rounded-md">
    <h4 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-2">Estimated Reading Time</h4>
    <div class="text-3xl font-bold text-slate-900 mb-2" id="estimated-time">0 min</div>
    <p class="text-sm text-slate-600" id="time-explanation"></p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('read-time-calc');
    const resultDiv = document.getElementById('read-time-result');
    const timeDisplay = document.getElementById('estimated-time');
    const explanationDisplay = document.getElementById('time-explanation');

    const wordInputGroup = document.getElementById('word-input-group');
    const pageInputGroup = document.getElementById('page-input-group');
    const inputRadios = document.querySelectorAll('input[name="input-method"]');

    if (!form || !resultDiv || !timeDisplay || !explanationDisplay || !wordInputGroup || !pageInputGroup) return;

    // Toggle inputs
    inputRadios.forEach(radio => {
      radio.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (!target) return;
        if (target.value === 'words') {
          wordInputGroup.classList.remove('hidden');
          pageInputGroup.classList.add('hidden');
        } else {
          wordInputGroup.classList.add('hidden');
          pageInputGroup.classList.remove('hidden');
        }
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const methodElement = document.querySelector('input[name="input-method"]:checked') as HTMLInputElement | null;
      if (!methodElement) return;
      const method = methodElement.value;

      const speedElement = document.getElementById('speed') as HTMLSelectElement | null;
      if (!speedElement) return;
      const speed = parseInt(speedElement.value, 10);

      let words = 0;
      if (method === 'words') {
        const wordsElement = document.getElementById('words') as HTMLInputElement | null;
        words = wordsElement ? parseInt(wordsElement.value, 10) || 0 : 0;
      } else {
        const pagesElement = document.getElementById('page-count') as HTMLInputElement | null;
        const pages = pagesElement ? parseInt(pagesElement.value, 10) || 0 : 0;
        words = pages * 275; // Average words per page
      }

      // Calculate
      // Sourced from Marc Brysbaert's 2019 study on reading rates (238 WPM silent reading average)
      const minutes = words / speed;

      let formattedTime;
      if (minutes < 1) {
        formattedTime = "< 1 min";
      } else if (minutes < 60) {
        formattedTime = `${Math.ceil(minutes)} min`;
      } else {
        const hours = Math.floor(minutes / 60);
        const mins = Math.ceil(minutes % 60);
        formattedTime = `${hours} hr ${mins} min`;
      }

      timeDisplay.textContent = formattedTime;

      explanationDisplay.textContent = `Based on a total of ~${words.toLocaleString()} words read at ${speed} words per minute.`;
      resultDiv.classList.remove('hidden');
    });
  });
</script>
