---
import { footer } from "../../../data/navigation.json";
import NewsletterForm from "../forms/newsletter-form.astro";
import { capture } from "../../../capture.config";
---

<footer class="bg-surface text-white border-t border-border mt-16">
  <div class="mx-auto max-w-6xl px-8 py-12 border-b border-gray-700 mb-8 flex flex-col sm:flex-row gap-8 justify-between items-center">
    <div>
      <h3 class="text-xl font-bold mb-2">Fitness App Architecture Newsletter</h3>
      <p class="text-gray-400">Technical insights on building health apps, delivered monthly.</p>
    </div>
    <div class="w-full max-w-md">
      <NewsletterForm form={capture.forms.newsletter} submitLabel="Subscribe" />
    </div>
  </div>
  <div class="mx-auto max-w-6xl px-8 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-3 items-center gap-8">
      <a class="flex justify-center sm:justify-start" href={footer.logo_url}>
        <img class="w-48" src={footer.logo} alt={footer.logo_alt_text} />
      </a>

      <ul class="flex gap-6 items-center justify-center">
        {footer.links.map((link) => (
          <li>
            <a class="hover:text-gray-300 transition-colors" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <div class="text-center sm:text-end text-sm text-gray-400">
        &copy; {new Date().getFullYear()} {footer.copyright}
      </div>
    </div>
  </div>
</footer>
