---
import { footer } from "../../../data/navigation.json";
import NewsletterForm from "../forms/newsletter-form.astro";
---

<footer class="bg-gray-800 text-white">
  <div class="mx-auto max-w-6xl px-8 py-12">
    <div class="mb-12 border-b border-gray-700 pb-12 flex flex-col md:flex-row items-center justify-between gap-8">
      <div>
        <h3 class="text-xl font-bold mb-2">Get the Data Pack</h3>
        <p class="text-gray-400">Join our newsletter for the latest property insights.</p>
      </div>
      <div class="w-full md:w-auto min-w-[300px]">
        <NewsletterForm form="newsletter" submitLabel="Subscribe" class="w-full" />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 items-center gap-8">
      <a class="flex justify-center sm:justify-start" href={footer.logo_url}>
        <img class="w-48 filter brightness-0 invert" src={footer.logo} alt={footer.logo_alt_text} />
      </a>

      <ul class="flex gap-6 items-center justify-center">
        {footer.links.map((link) => (
          <li>
            <a class="hover:text-gray-300 transition-colors" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <div class="text-center sm:text-end text-sm text-gray-400">
        &copy; {new Date().getFullYear()} {footer.copyright}
      </div>
    </div>
  </div>
</footer>
