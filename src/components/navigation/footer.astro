---
import { footer } from "../../../data/navigation.json";
---

<footer class="bg-brand-900 text-neutral-200 border-t border-brand-700">
  <div class="mx-auto max-w-6xl px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 items-center gap-12">
      <div class="flex justify-center md:justify-start" data-editable="object" data-prop="footer">
        <a href={footer.logo_url}>
          <img class="w-48 brightness-0 invert" src={footer.logo} alt={footer.logo_alt_text} data-prop-src="footer.logo" data-prop-alt="footer.logo_alt_text" />
        </a>
      </div>

      <ul class="flex flex-wrap gap-6 items-center justify-center" data-editable="array" data-prop="footer.links">
        {footer.links.map((link) => (
          <li data-editable="array-item">
            <a class="hover:text-white transition-colors" href={link.link} data-prop="link">
              <span data-prop="text">{link.text}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="text-center md:text-end text-sm text-neutral-400">
        &copy; {new Date().getFullYear()} <span data-editable="text" data-prop="footer.copyright">{footer.copyright}</span>
      </div>
    </div>
  </div>
</footer>
