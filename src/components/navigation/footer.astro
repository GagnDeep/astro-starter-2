---
import { footer } from "../../../data/navigation.json";
---

<footer class="bg-[var(--color-brand-900)] text-[var(--color-neutral-100)] border-t border-[var(--color-brand-800)]">
  <div class="mx-auto max-w-6xl px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 items-center gap-10">
      <a class="flex justify-center md:justify-start outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent-400)] rounded-sm" href={footer.logo_url}>
        {/* Assume logo is adapted or has an inverted version for dark background, but we keep the same for now */}
        <img class="w-48 brightness-0 invert" src={footer.logo} alt={footer.logo_alt_text} />
      </a>

      <ul class="flex flex-wrap gap-6 items-center justify-center">
        {footer.links.map((link) => (
          <li>
            <a class="text-[var(--color-neutral-300)] hover:text-white hover-transition font-medium outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent-400)] rounded-sm px-1" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <div class="text-center md:text-end text-sm text-[var(--color-brand-400)]">
        &copy; {new Date().getFullYear()} {footer.copyright}
      </div>
    </div>
  </div>
</footer>
