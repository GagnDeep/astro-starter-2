---
import { footer_navigation } from "../../../data/navigation.json";
import CaptureForm from "../forms/capture-form.astro";
---

<footer class="mt-20 border-t border-gray-200 bg-gray-50 pt-12 pb-8">
  <div class="mx-auto max-w-5xl px-6 grid md:grid-cols-2 gap-12 mb-12 border-b border-gray-200 pb-12">
    <div>
      <h3 class="text-xl font-bold tracking-tight text-gray-900 mb-4">Stay Hydrated</h3>
      <p class="text-gray-600 mb-6">Join our newsletter to get weekly tips on hydration, wellness, and tracking your water intake effectively.</p>
    </div>
    <div>
      <CaptureForm form="newsletter" submitLabel="Subscribe" />
    </div>
  </div>

  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-6 px-6 sm:flex-row">
    <p class="text-sm text-gray-500">
      &copy; {new Date().getFullYear()} WaterTrackLog. All rights reserved.
    </p>
    <ul class="flex flex-wrap items-center gap-6">
      {
        footer_navigation.map((link: { url: string; name: string }) => (
          <li>
            <a href={link.url} class="text-sm text-gray-600 hover:text-blue-600">
              {link.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
