---
import navigation from "../../../data/navigation.json";

const { footer } = navigation;
---

<footer class="bg-brand-navy-light text-slate-300 py-12 mt-16">
  <div class="container grid grid-cols-1 md:grid-cols-4 gap-8">
    <div class="col-span-1 md:col-span-1">
      <a href={footer.logo_url} class="text-xl font-bold text-white mb-4 block">Institute for Tax</a>
      <p class="text-sm mt-4">{footer.copyright}</p>
    </div>

    <div>
      <h3 class="text-white font-semibold mb-4">Leads</h3>
      <ul class="space-y-2">
        <li><a href="/leads/tax-preparation/" class="hover:text-brand-emerald">Tax Preparation Leads</a></li>
        <li><a href="/leads/tax-resolution/" class="hover:text-brand-emerald">Tax Resolution Leads</a></li>
        <li><a href="/leads/high-net-worth/" class="hover:text-brand-emerald">High Net Worth Leads</a></li>
        <li><a href="/leads/corporate-tax/" class="hover:text-brand-emerald">Corporate Tax Leads</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-white font-semibold mb-4">Resources</h3>
      <ul class="space-y-2">
        <li><a href="/guides/tax-firm-marketing/" class="hover:text-brand-emerald">Marketing Guide</a></li>
        <li><a href="/tools/cpa-roi-calculator/" class="hover:text-brand-emerald">ROI Calculator</a></li>
        <li><a href="/glossary/cac/" class="hover:text-brand-emerald">Glossary</a></li>
        <li><a href="/blog/" class="hover:text-brand-emerald">Blog</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-white font-semibold mb-4">Company</h3>
      <ul class="space-y-2">
        {footer.links.map(link => (
          <li><a href={link.link} class="hover:text-brand-emerald">{link.text}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
