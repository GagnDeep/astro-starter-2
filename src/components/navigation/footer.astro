---
import { footer } from "../../../data/navigation.json";
---

<footer class="bg-[var(--bg-color)] border-t-2 border-[var(--border-color)]">
  <div class="mx-auto max-w-6xl px-8 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-3 items-center gap-8">
      <a class="flex justify-center sm:justify-start focus-visible:outline-offset-8" href={footer.logo_url}>
        <img class="w-48" src={footer.logo} alt={footer.logo_alt_text} />
      </a>

      <ul class="flex gap-6 items-center justify-center">
        {footer.links.map((link) => (
          <li>
            <a class="font-medium text-[var(--text-color)] hover:text-[var(--accent-color)] transition-colors duration-200" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <div class="text-center sm:text-end text-sm text-[var(--text-color)] opacity-80">
        &copy; {new Date().getFullYear()} {footer.copyright}
      </div>
    </div>
  </div>
</footer>
