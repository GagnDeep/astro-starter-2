---
import { footer } from "../../../data/navigation.json";
import NewsletterForm from "../forms/newsletter-form.astro";
---

<footer class="bg-gray-800 text-white">
  <div class="mx-auto max-w-6xl px-8 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <div class="lg:col-span-1">
        <a class="flex justify-start mb-4" href={footer.logo_url}>
          <img class="w-48" src={footer.logo} alt={footer.logo_alt_text} />
        </a>
        <div class="text-sm text-gray-400">
          &copy; {new Date().getFullYear()} {footer.copyright}
        </div>
      </div>

      <div class="lg:col-span-2">
        <ul class="flex flex-wrap gap-6 justify-start lg:justify-center">
          {footer.links.map((link) => (
            <li>
              <a class="hover:text-gray-300 transition-colors" href={link.link}>
                {link.text}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-1">
        <h4 class="text-lg font-bold mb-4">Subscribe for PTE Tips</h4>
        <NewsletterForm />
      </div>
    </div>
  </div>
</footer>
