---
import { footer } from "../../../data/navigation.json";
---

<footer class="bg-brand-950 text-neutral-50 border-t border-brand-900 mt-auto">
  <div class="mx-auto max-w-6xl px-4 sm:px-8 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-3 items-center gap-8">
      <a class="flex justify-center sm:justify-start focus-visible rounded-sm" href={footer.logo_url} aria-label="Home">
        <img class="w-48" src={footer.logo} alt={footer.logo_alt_text} />
      </a>

      <ul class="flex gap-6 items-center justify-center flex-wrap">
        {footer.links.map((link) => (
          <li>
            <a class="text-neutral-50 hover:text-accent-400 transition-colors focus-visible rounded-sm" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <div class="text-center sm:text-end text-sm text-brand-300">
        &copy; {new Date().getFullYear()} {footer.copyright}
      </div>
    </div>
  </div>
</footer>
