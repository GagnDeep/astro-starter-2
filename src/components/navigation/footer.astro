---
import { footer } from "../../../data/navigation.json";
---

<footer class="bg-gray-800 text-white">
  <div class="mx-auto max-w-6xl px-8 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
      <div>
        <a href="/">
          <img class="w-48 mb-4" src={footer.logo} alt={footer.logo_alt_text} />
        </a>
        <p class="text-sm text-gray-400">{footer.description}</p>
      </div>

      {footer.links_groups?.map((group) => (
        <div>
          <h3 class="font-bold mb-4">{group.title}</h3>
          <ul class="space-y-2">
            {group.links.map((link) => (
              <li>
                <a class="text-gray-300 hover:text-white transition-colors" href={link.link}>
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="mt-8 pt-8 border-t border-gray-700 flex flex-col sm:flex-row justify-between items-center text-sm text-gray-400">
      <div class="flex space-x-4 mb-4 sm:mb-0">
        {footer.bottom_links?.map((link) => (
          <a class="hover:text-white transition-colors" href={link.link}>{link.text}</a>
        ))}
      </div>
      <div>&copy; {new Date().getFullYear()} AI Wire Harness. All rights reserved.</div>
    </div>
  </div>
</footer>
