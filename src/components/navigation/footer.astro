---
import NewsletterForm from "../forms/newsletter-form.astro";
import siteData from "../../../data/site.json";
---

<footer class="bg-slate-900 text-slate-300 py-12 mt-auto">
  <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-4 gap-8">
    <div class="col-span-1 md:col-span-2">
      <h3 class="text-white text-xl font-bold mb-4">{siteData.site_title || "WaterTrackLog"}</h3>
      <p class="mb-6 max-w-sm">A science-backed web app that helps you calculate fluid needs and reminds you to drink.</p>

      <div class="bg-slate-800 p-6 rounded-lg border border-slate-700">
        <h4 class="text-white font-bold mb-2">Get a weekly hydration tip</h4>
        <NewsletterForm form="newsletter" submitLabel="Subscribe" />
      </div>
    </div>

    <div>
      <h4 class="text-white font-bold mb-4">Resources</h4>
      <ul class="space-y-2">
        <li><a href="/tools/daily-water-calculator" class="hover:text-white transition-colors">Water Calculator</a></li>
        <li><a href="/tools/sweat-loss-calculator" class="hover:text-white transition-colors">Sweat Loss Calculator</a></li>
        <li><a href="/reference" class="hover:text-white transition-colors">Reference Library</a></li>
        <li><a href="/beverages" class="hover:text-white transition-colors">Beverage Index</a></li>
        <li><a href="/glossary" class="hover:text-white transition-colors">Glossary</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white font-bold mb-4">Company</h4>
      <ul class="space-y-2">
        <li><a href="/about" class="hover:text-white transition-colors">About Us</a></li>
        <li><a href="/faq" class="hover:text-white transition-colors">FAQ</a></li>
        <li><a href="/pricing" class="hover:text-white transition-colors">Pricing</a></li>
        <li><a href="/contact" class="hover:text-white transition-colors">Contact</a></li>
        <li><a href="/legal/terms" class="hover:text-white transition-colors">Terms of Service</a></li>
        <li><a href="/legal/privacy" class="hover:text-white transition-colors">Privacy Policy</a></li>
      </ul>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 mt-12 pt-8 border-t border-slate-800 text-sm text-slate-500 text-center">
    &copy; {new Date().getFullYear()} WaterTrackLog. All rights reserved. Not medical advice.
  </div>
</footer>
