---
import { footer } from "../../../data/navigation.json";
---

<footer class="bg-[var(--color-brand-900)] text-[var(--color-support-100)]">
  <div class="mx-auto max-w-6xl px-4 sm:px-8 py-12">
    <div class="grid grid-cols-1 sm:grid-cols-3 items-center gap-8">
      <a class="flex justify-center sm:justify-start" href={footer.logo_url}>
        <img class="w-48" src={footer.logo} alt={footer.logo_alt_text} style="filter: invert(1) brightness(100);" />
      </a>

      <ul class="flex gap-6 items-center justify-center flex-wrap" data-editable="array" data-prop="footer.links" data-component-key="text">
        {footer.links.map((link) => (
          <li>
            <a class="hover:text-[var(--color-support-300)] hover-transition" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <div class="text-center sm:text-end text-sm text-[var(--color-support-300)] opacity-80">
        &copy; {new Date().getFullYear()} {footer.copyright}
      </div>
    </div>
  </div>
</footer>
