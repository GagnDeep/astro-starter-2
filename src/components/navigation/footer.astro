---
import { footer } from "../../../data/navigation.json";
---

<footer class="bg-[var(--color-surface-raised)] border-t border-[var(--color-border)] mt-auto">
  <div class="mx-auto max-w-6xl px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-5 flex flex-col gap-4">
        <a class="flex justify-start" href={footer.logo_url}>
          <span class="font-bold text-xl uppercase tracking-widest display-text text-[var(--color-text-base)]">
            {footer.logo_alt_text || "AEROSPACE UAE"}
          </span>
        </a>
        <p class="text-[var(--color-text-muted)] text-sm max-w-[40ch]">
          The independent supply chain directory and hiring board for the UAE aerospace and MRO sector.
        </p>
      </div>

      <div class="md:col-span-7 flex flex-col md:flex-row gap-8 justify-between">
        <div class="flex flex-col gap-4">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text-base)]">Navigation</h3>
          <ul class="flex flex-col gap-2 m-0 p-0" data-editable="array" data-prop="footer.links">
            {footer.links.map((link) => (
              <li data-editable="array-item">
                <a class="text-[var(--color-text-muted)] hover:text-[var(--color-brand-600)] hover-transition" href={link.link}>
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-col gap-4">
          <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--color-text-base)]">Legal</h3>
          <ul class="flex flex-col gap-2 m-0 p-0">
            <li><a href="/privacy/" class="text-[var(--color-text-muted)] hover:text-[var(--color-brand-600)] hover-transition">Privacy Policy</a></li>
            <li><a href="/terms/" class="text-[var(--color-text-muted)] hover:text-[var(--color-brand-600)] hover-transition">Terms of Service</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-16 pt-8 border-t border-[var(--color-border)] flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-sm text-[var(--color-text-muted)]">
        &copy; {new Date().getFullYear()} {footer.copyright}
      </div>
      <div class="text-xs text-[var(--color-text-muted)] opacity-70">
        Not affiliated with the UAE government or any official regulatory body.
      </div>
    </div>
  </div>
</footer>
