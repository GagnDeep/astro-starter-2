---
import { footer } from "../../../data/navigation.json";
---

<footer class="bg-(--bg-color) text-(--text-color) border-t border-(--border-color)">
  <div class="mx-auto max-w-6xl px-8 py-12" data-cms-bind="footer">
    <div class="grid grid-cols-1 sm:grid-cols-3 items-center gap-8">
      <a class="flex justify-center sm:justify-start focus-visible" href={footer.logo_url}>
        <img class="w-48" src={footer.logo} alt={footer.logo_alt_text} />
      </a>

      <ul class="flex flex-wrap gap-6 items-center justify-center" data-cms-bind="footer.links">
        {footer.links.map((link) => (
          <li>
            <a class="hover:text-(--color-brand-600) hover-transition focus-visible" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <div class="text-center sm:text-end text-sm text-(--color-neutral-600)">
        &copy; {new Date().getFullYear()} {footer.copyright}
      </div>
    </div>
  </div>
</footer>
