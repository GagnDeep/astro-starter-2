---
import { footer } from "../../../data/navigation.json";
---

<footer class="bg-[var(--color-neutral-900)] text-[var(--color-neutral-300)] border-t border-[var(--color-neutral-950)]">
  <div class="mx-auto max-w-6xl px-8 py-12 md:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-3 items-center gap-8">
      <a class="flex justify-center sm:justify-start font-bold text-2xl tracking-tighter text-white" href={footer.logo_url}>
        <img class="h-8 w-auto object-contain hidden" src={footer.logo} alt={footer.logo_alt_text} />
        {footer.logo_alt_text.replace(' logo', '')}
      </a>

      <ul class="flex gap-6 items-center justify-center font-medium">
        {footer.links.map((link) => (
          <li>
            <a class="hover:text-white transition-colors" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <div class="text-center sm:text-end text-sm text-[var(--color-neutral-500)]">
        &copy; {new Date().getFullYear()} {footer.copyright}
      </div>
    </div>
  </div>
</footer>
