---
import { footer } from "../../../data/navigation.json";
import CaptureForm from "../forms/capture-form.astro";
---

<footer class="bg-gray-800 text-white">
  <div class="mx-auto max-w-6xl px-8 py-12">

    <div class="mb-12 border-b border-gray-700 pb-8 flex flex-col md:flex-row gap-8 justify-between items-center">
      <div class="max-w-md text-center md:text-left">
        <h3 class="text-xl font-bold mb-2">Join the ClearPath Newsletter</h3>
        <p class="text-gray-400">Actionable advice for independent investors. Zero spam.</p>
      </div>
      <div class="w-full md:w-auto">
        <CaptureForm form="newsletter" submitLabel="Subscribe">
          <label for="footerEmail" class="sr-only">Email address</label>
          <input type="email" id="footerEmail" name="email" required placeholder="Enter your email" class="w-full sm:w-64 px-4 py-2 rounded text-gray-900 border-none mr-2 mb-2 sm:mb-0" />
        </CaptureForm>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 items-center gap-8">
      <a class="flex justify-center sm:justify-start" href={footer.logo_url}>
        <span class="text-xl font-bold tracking-tight">ClearPath Finance</span>
      </a>

      <ul class="flex gap-6 items-center justify-center">
        {footer.links.map((link) => (
          <li>
            <a class="hover:text-gray-300 transition-colors" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <div class="text-center sm:text-end text-sm text-gray-400">
        &copy; {new Date().getFullYear()} {footer.copyright}
      </div>
    </div>
  </div>
</footer>
