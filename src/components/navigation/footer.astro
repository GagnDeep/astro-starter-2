---
import { footer } from "../../../data/navigation.json";
---

<footer
  class="bg-neutral-900 text-neutral-50 border-t-2 border-neutral-900 dark:border-neutral-700"
>
  <div class="mx-auto max-w-6xl px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div>
        <a
          href="/"
          class="inline-block outline-none focus-visible:outline-2 focus-visible:outline-orange-500 focus-visible:outline-offset-4 mb-6"
        >
          <img class="w-48" src={footer.logo} alt={footer.logo_alt_text} />
        </a>
        <p class="text-neutral-300 text-body">{footer.description}</p>
      </div>

      {
        footer.links_groups?.map((group) => (
          <div>
            <h3 class="font-display font-semibold text-xl mb-4 text-neutral-100">{group.title}</h3>
            <ul class="space-y-3">
              {group.links.map((link) => (
                <li>
                  <a
                    class="text-neutral-400 hover:text-orange-500 hover:no-underline transition-colors focus-visible:outline-2 focus-visible:outline-orange-500 rounded-sm outline-none"
                    href={link.link}
                  >
                    {link.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-16 pt-8 border-t border-neutral-700 flex flex-col sm:flex-row justify-between items-center text-neutral-400"
    >
      <div class="flex flex-wrap gap-4 mb-4 sm:mb-0">
        {
          footer.bottom_links?.map((link) => (
            <a
              class="hover:text-neutral-100 hover:no-underline transition-colors focus-visible:outline-2 focus-visible:outline-orange-500 rounded-sm outline-none"
              href={link.link}
            >
              {link.text}
            </a>
          ))
        }
      </div>
      <div>&copy; {new Date().getFullYear()} AI Wire Harness. All rights reserved.</div>
    </div>
  </div>
</footer>
