---
import { footer } from "../../../data/navigation.json";
import NewsletterForm from '../forms/newsletter-form.astro';
---
<footer class="bg-surface border-t border-border mt-16 text-text-muted">
  <div class="mx-auto max-w-6xl px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-8">
      <div class="lg:col-span-2">
        <a class="flex items-center gap-2 mb-4" href={footer.logo_url}>
          <img class="w-8 h-8 opacity-80 grayscale" src={footer.logo} alt={footer.logo_alt_text} />
          <span class="font-bold text-lg text-text-main">UConvertDocument</span>
        </a>
        <p class="text-sm mb-6 max-w-md">Free online document format converter tool. Fast, secure, and no installation required. Convert PDF, Word, Excel, JPG, and more.</p>
        <NewsletterForm />
      </div>

      <div>
        <h4 class="font-semibold text-text-main mb-4">Quick Links</h4>
        <ul class="space-y-2">
          {footer.links.map((link) => (
            <li>
              <a class="hover:text-brand transition-colors text-sm" href={link.link}>
                {link.text}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="font-semibold text-text-main mb-4">Tools</h4>
        <ul class="space-y-2">
          <li><a class="hover:text-brand transition-colors text-sm" href="/tools/pdf-to-word">PDF to Word</a></li>
          <li><a class="hover:text-brand transition-colors text-sm" href="/tools/word-to-pdf">Word to PDF</a></li>
          <li><a class="hover:text-brand transition-colors text-sm" href="/tools/jpg-to-pdf">JPG to PDF</a></li>
          <li><a class="hover:text-brand transition-colors text-sm" href="/tools/merge-pdf">Merge PDF</a></li>
        </ul>
      </div>
    </div>

    <div class="text-sm border-t border-border pt-8 text-center sm:text-start flex flex-col sm:flex-row justify-between items-center">
      <div>&copy; {new Date().getFullYear()} {footer.copyright}</div>
    </div>
  </div>
</footer>
