---
import type { BreadcrumbItem } from "../../lib/seo/schema";
import { ChevronRight } from "@lucide/astro";

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-4" data-editable="breadcrumbs">
  <ol class="flex items-center flex-wrap gap-2 text-sm text-neutral-600">
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <li class="flex items-center gap-2">
          {isLast ? (
            <span class="text-brand-900 font-medium" aria-current="page">{item.name}</span>
          ) : (
            <>
              <a href={item.url} class="hover:text-accent-600 transition-colors focus-visible rounded-sm px-1 -ml-1">
                {item.name}
              </a>
              <ChevronRight class="w-6 h-6 text-neutral-400" aria-hidden="true" />
            </>
          )}
        </li>
      );
    })}
  </ol>
</nav>
