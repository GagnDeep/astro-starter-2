---
import { header } from "../../../data/navigation.json";
// Icons: @lucide/astro renders inline SVG at build time — zero client JS,
// tree-shaken per import. See AGENTS.md → "Icons".
import { Menu, X } from "@lucide/astro";
---

<header
  class="bg-neutral-50 border-b-2 border-neutral-900 shadow-brutal sticky top-0 z-40 dark:bg-neutral-900 dark:border-neutral-700"
>
  <div class="mx-auto max-w-6xl px-8">
    <nav class="flex items-center justify-between py-4">
      <a
        href={header.logo_url}
        class="outline-none focus-visible:outline-2 focus-visible:outline-orange-500 focus-visible:outline-offset-4"
      >
        <img class="w-48 dark:invert" src={header.logo} alt={header.logo_alt_text} />
      </a>

      <ul class="hidden md:flex items-center gap-6">
        {
          header.links.map((link) => (
            <li>
              <a
                class="font-display font-semibold text-neutral-800 hover:text-orange-500 hover:no-underline transition-colors dark:text-neutral-200 dark:hover:text-orange-400"
                href={link.link}
              >
                {link.text}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        class="md:hidden p-2 text-neutral-900 dark:text-neutral-50"
        aria-label="Open navigation menu"
        popovertarget="mobile-menu"
        popovertargetaction="show"
      >
        <Menu class="w-6 h-6" aria-hidden="true" />
      </button>

      <div
        popover
        id="mobile-menu"
        class="fixed inset-0 m-0 w-full h-full max-w-none max-h-none border-none bg-neutral-50 z-50 dark:bg-neutral-900"
      >
        <div class="flex flex-col h-full">
          <div
            class="mx-auto w-full max-w-6xl flex items-center justify-between px-8 py-4 border-b-2 border-neutral-900 dark:border-neutral-700"
          >
            <a
              href={header.logo_url}
              class="outline-none focus-visible:outline-2 focus-visible:outline-orange-500 focus-visible:outline-offset-4"
            >
              <img class="w-48 dark:invert" src={header.logo} alt={header.logo_alt_text} />
            </a>
            <button
              class="p-2 text-neutral-900 dark:text-neutral-50 hover:text-orange-500 transition-colors"
              aria-label="Close navigation menu"
              popovertarget="mobile-menu"
              popovertargetaction="hide"
            >
              <X class="w-6 h-6" aria-hidden="true" />
            </button>
          </div>
          <ul
            class="flex flex-1 flex-col items-center justify-center gap-0 divide-y-2 divide-neutral-200 dark:divide-neutral-800"
          >
            {
              header.links.map((link) => (
                <li class="w-full max-w-xs text-center">
                  <a
                    class="block py-5 font-display text-2xl font-semibold text-neutral-800 hover:text-orange-500 hover:no-underline transition-colors dark:text-neutral-200 dark:hover:text-orange-400"
                    href={link.link}
                  >
                    {link.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  #mobile-menu {
    opacity: 0;
    transition:
      opacity 200ms ease,
      display 200ms allow-discrete,
      overlay 200ms allow-discrete;
  }
  #mobile-menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    #mobile-menu:popover-open {
      opacity: 0;
    }
  }
</style>
