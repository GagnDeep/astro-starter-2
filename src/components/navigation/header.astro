---
import { header } from "../../../data/navigation.json";
// Icons: @lucide/astro renders inline SVG at build time — zero client JS
import { Menu, X } from "@lucide/astro";
---

<header class="bg-[var(--color-surface-base)] border-b border-[var(--color-border)] sticky top-0 z-40">
  <div class="mx-auto max-w-6xl px-8">
    <nav class="flex items-center justify-between py-4" aria-label="Main Navigation">
      <a href={header.logo_url} class="flex items-center gap-2 focus-visible:outline-offset-4">
        <span class="font-bold text-xl uppercase tracking-widest display-text text-[var(--color-text-base)]">
          {header.logo_alt_text || "AEROSPACE UAE"}
        </span>
      </a>

      {/* Desktop Menu */}
      <ul class="hidden sm:flex items-center gap-6 m-0 p-0" data-editable="array" data-prop="header.links">
        {header.links.map((link) => (
          <li data-editable="array-item">
            <a
              class="text-[var(--color-text-muted)] hover:text-[var(--color-brand-600)] font-medium transition-colors hover-transition"
              href={link.link}
            >
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      {/* Mobile Menu using details/summary for zero-JS toggle */}
      <details class="sm:hidden group relative">
        <summary class="list-none p-2 cursor-pointer outline-none focus-visible:bg-[var(--color-surface-raised)] rounded" aria-label="Toggle navigation menu">
          <Menu class="w-6 h-6 group-open:hidden" aria-hidden="true" />
          <X class="w-6 h-6 hidden group-open:block" aria-hidden="true" />
        </summary>

        <div class="absolute top-full right-0 left-[-100vw] w-screen bg-[var(--color-surface-base)] border-b border-[var(--color-border)] shadow-md p-4 flex flex-col gap-4 z-50">
          <ul class="flex flex-col gap-4 m-0 p-0 items-end pr-8">
            {header.links.map((link) => (
              <li>
                <a
                  class="text-[var(--color-text-base)] font-bold text-xl block py-2 hover:text-[var(--color-brand-600)] transition-colors focus-visible:outline-offset-2"
                  href={link.link}
                >
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </nav>
  </div>
</header>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
