---
import { Image } from 'astro:assets';
import logoSvg from '../../assets/logo-bro-tax.svg';
---

<header class="border-b-2 border-[var(--color-border-default)] bg-[var(--color-bg-primary)] sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 group hover:opacity-90 transition-opacity">
      <Image src={logoSvg} alt="bro.tax logo" class="h-10 w-auto" />
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-6 font-mono text-sm font-bold">
      <a href="/estimator" class="text-[var(--color-text-primary)] hover:text-[var(--color-text-emerald)] transition-colors">
        [ Calculator ]
      </a>
      <a href="/deductions" class="text-[var(--color-text-primary)] hover:text-[var(--color-text-emerald)] transition-colors">
        Write-Offs
      </a>
      <a href="/guides" class="text-[var(--color-text-primary)] hover:text-[var(--color-text-emerald)] transition-colors">
        Guides
      </a>
      <a href="/blog" class="text-[var(--color-text-primary)] hover:text-[var(--color-text-emerald)] transition-colors">
        Blog
      </a>
      <a href="/pricing" class="text-[var(--color-text-primary)] hover:text-[var(--color-text-emerald)] transition-colors">
        Pricing
      </a>
      <a href="/about" class="text-[var(--color-text-primary)] hover:text-[var(--color-text-emerald)] transition-colors">
        About
      </a>
    </nav>

    <!-- Header CTA -->
    <div class="flex items-center gap-3">
      <a
        href="/estimator"
        class="bg-[var(--color-bg-dark)] text-[var(--color-text-inverse)] px-4 py-2.5 rounded-md font-mono text-xs sm:text-sm font-bold border border-[var(--color-border-default)] shadow-[3px_3px_0px_0px_var(--color-border-accent)] hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[2px_2px_0px_0px_var(--color-border-accent)] transition-all"
      >
        Estimate Taxes &rarr;
      </a>
    </div>
  </div>

  <!-- Mobile Bar -->
  <div class="md:hidden border-t border-[var(--color-border-subtle)] bg-[var(--color-bg-secondary)] px-4 py-2 flex items-center justify-around font-mono text-xs font-bold overflow-x-auto whitespace-nowrap">
    <a href="/estimator" class="py-1 px-2 text-[var(--color-text-primary)] hover:text-[var(--color-text-emerald)]">[ Calculator ]</a>
    <a href="/deductions" class="py-1 px-2 text-[var(--color-text-primary)]">Write-Offs</a>
    <a href="/guides" class="py-1 px-2 text-[var(--color-text-primary)]">Guides</a>
    <a href="/blog" class="py-1 px-2 text-[var(--color-text-primary)]">Blog</a>
    <a href="/pricing" class="py-1 px-2 text-[var(--color-text-primary)]">Pricing</a>
  </div>
</header>
