---
import { Menu, X } from "@lucide/astro";

const navLinks = [
  { name: "Timer", href: "/" },
  { name: "Guides", href: "/guides/box-breathing" },
  { name: "Tools", href: "/tools/4-7-8-timer" },
  { name: "Blog", href: "/blog" }
];
---

<header class="w-full bg-bg-base/80 backdrop-blur-md border-b border-surface/50 sticky top-0 z-50">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <a href="/" class="text-xl font-bold tracking-tight text-text-base">
      BreathingTimer
    </a>

    <nav class="hidden md:flex gap-6 items-center">
      {navLinks.map((link) => (
        <a href={link.href} class="text-sm font-medium text-text-muted hover:text-text-base transition-colors">
          {link.name}
        </a>
      ))}
      <a href="/pricing" class="bg-surface hover:bg-surface/80 text-text-base px-4 py-2 rounded-lg text-sm font-medium transition-colors border border-surface/50">
        It's Free
      </a>
    </nav>
  </div>
</header>
