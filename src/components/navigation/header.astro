---
import { header } from "../../../data/navigation.json";
// Icons: @lucide/astro renders inline SVG at build time — zero client JS,
// tree-shaken per import. See AGENTS.md → "Icons".
import { Menu, X } from "@lucide/astro";
---

<header class="bg-[var(--color-brand-paper)] dark:bg-[var(--color-brand-paper-dark)] border-b border-[var(--color-brand-ink)] dark:border-white/20">
  <div class="mx-auto max-w-6xl px-8" data-editable="object" data-prop="header">
    <nav class="flex items-center justify-between py-4">
      <a href={header.logo_url} class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-accent)]">
        <img class="w-48 h-auto" src={header.logo} alt={header.logo_alt_text} />
      </a>

      <ul class="hidden sm:flex items-center gap-6" data-editable="array" data-prop="header.links">
        {header.links.map((link) => (
          <li data-editable="array-item">
            <a class="text-[var(--color-brand-ink)] dark:text-[var(--color-brand-ink-dark)] hover:text-[var(--color-brand-accent)] dark:hover:text-[var(--color-brand-accent-dark)] transition-colors duration-200 uppercase font-bold tracking-tight font-[family-name:var(--font-display)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-accent)]" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <button
        class="sm:hidden p-2 text-[var(--color-brand-ink)] dark:text-[var(--color-brand-ink-dark)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-accent)]"
        aria-label="Open navigation menu"
        popovertarget="mobile-menu"
        popovertargetaction="show"
      >
        <Menu class="w-6 h-6" aria-hidden="true" stroke-width="2" />
      </button>

      <div popover id="mobile-menu" class="fixed inset-0 m-0 w-full h-full max-w-none max-h-none border-none bg-[var(--color-brand-paper)] dark:bg-[var(--color-brand-paper-dark)] z-50">
        <div class="flex flex-col h-full">
        <div class="mx-auto w-full max-w-6xl flex items-center justify-between px-8 py-4 border-b border-[var(--color-brand-ink)] dark:border-white/20">
          <a href={header.logo_url} class="focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-accent)]">
            <img class="w-48 h-auto" src={header.logo} alt={header.logo_alt_text} />
          </a>
          <button
            class="p-2 text-[var(--color-brand-ink)] dark:text-[var(--color-brand-ink-dark)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-accent)]"
            aria-label="Close navigation menu"
            popovertarget="mobile-menu"
            popovertargetaction="hide"
          >
            <X class="w-6 h-6" aria-hidden="true" stroke-width="2" />
          </button>
        </div>
        <ul class="flex flex-1 flex-col items-center justify-center gap-0 divide-y divide-[var(--color-brand-ink)] dark:divide-white/20">
          {header.links.map((link) => (
            <li class="w-full max-w-xs text-center">
              <a class="block py-5 text-2xl font-bold font-[family-name:var(--font-display)] uppercase text-[var(--color-brand-ink)] dark:text-[var(--color-brand-ink-dark)] hover:text-[var(--color-brand-accent)] dark:hover:text-[var(--color-brand-accent-dark)] transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-accent)]" href={link.link}>
                {link.text}
              </a>
            </li>
          ))}
        </ul>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  #mobile-menu {
    opacity: 0;
    transition: opacity 200ms ease, display 200ms allow-discrete, overlay 200ms allow-discrete;
  }
  #mobile-menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    #mobile-menu:popover-open {
      opacity: 0;
    }
  }
</style>
