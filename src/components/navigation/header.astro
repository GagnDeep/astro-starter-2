---
import { header } from "../../../data/navigation.json";
// Icons: @lucide/astro renders inline SVG at build time — zero client JS,
// tree-shaken per import. See AGENTS.md → "Icons".
import { Menu, X } from "@lucide/astro";
---

<header class="bg-bg border-b border-border">
  <div class="mx-auto max-w-6xl px-8">
    <nav class="flex items-center justify-between py-4">
      <a href={header.logo_url} class="flex items-center gap-2">
        <img class="w-8 h-8" src={header.logo} alt={header.logo_alt_text} />
        <span class="text-white font-bold text-xl tracking-tight hidden sm:block">CreateFitnessApp</span>
      </a>

      <ul class="hidden sm:flex items-center gap-6">
        {header.links.map((link) => (
          <li>
            <a class="text-gray-300 hover:text-primary transition-colors font-medium" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <button
        class="sm:hidden p-2 text-white"
        aria-label="Open navigation menu"
        popovertarget="mobile-menu"
        popovertargetaction="show"
      >
        <Menu class="w-6 h-6" aria-hidden="true" />
      </button>

      <div popover id="mobile-menu" class="fixed inset-0 m-0 w-full h-full max-w-none max-h-none border-none bg-bg z-50">
        <div class="flex flex-col h-full">
        <div class="mx-auto w-full max-w-6xl flex items-center justify-between px-8 py-4">
          <a href={header.logo_url} class="flex items-center gap-2">
            <img class="w-8 h-8" src={header.logo} alt={header.logo_alt_text} />
            <span class="text-white font-bold text-xl tracking-tight">CreateFitnessApp</span>
          </a>
          <button
            class="p-2 text-white"
            aria-label="Close navigation menu"
            popovertarget="mobile-menu"
            popovertargetaction="hide"
          >
            <X class="w-6 h-6" aria-hidden="true" />
          </button>
        </div>
        <ul class="flex flex-1 flex-col items-center justify-center gap-0 divide-y divide-gray-800">
          {header.links.map((link) => (
            <li class="w-full max-w-xs text-center">
              <a class="block py-5 text-2xl font-medium text-white hover:text-primary transition-colors" href={link.link}>
                {link.text}
              </a>
            </li>
          ))}
        </ul>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  #mobile-menu {
    opacity: 0;
    transition: opacity 200ms ease, display 200ms allow-discrete, overlay 200ms allow-discrete;
  }
  #mobile-menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    #mobile-menu:popover-open {
      opacity: 0;
    }
  }
</style>
