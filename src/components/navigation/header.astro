---
import { header } from "../../../data/navigation.json";
// Icons: @lucide/astro renders inline SVG at build time — zero client JS,
// tree-shaken per import. See AGENTS.md → "Icons".
import { Menu, X } from "@lucide/astro";
---

<header class="bg-(--surface-color) text-(--text-color) border-b border-(--border-color)">
  <div class="mx-auto max-w-6xl px-8" data-cms-bind="header">
    <nav class="flex items-center justify-between py-4">
      <a href={header.logo_url} aria-label="Home" class="focus-visible">
        <img class="w-48" src={header.logo} alt={header.logo_alt_text} />
      </a>

      <ul class="hidden sm:flex items-center gap-6" data-cms-bind="header.links">
        {header.links.map((link) => (
          <li>
            <a class="text-(--text-color) hover:text-(--color-brand-600) hover-transition focus-visible" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <details class="sm:hidden group">
        <summary class="list-none p-2 cursor-pointer focus-visible text-(--text-color) marker:hidden [&::-webkit-details-marker]:hidden" aria-label="Toggle navigation menu">
          <Menu class="w-6 h-6 group-open:hidden" aria-hidden="true" />
          <X class="w-6 h-6 hidden group-open:block" aria-hidden="true" />
        </summary>

        <div class="absolute left-0 right-0 top-[calc(100%+1px)] bg-(--surface-color) border-b border-(--border-color) z-50 p-8 shadow-md">
          <ul class="flex flex-col gap-4">
            {header.links.map((link) => (
              <li>
                <a class="block text-xl font-medium text-(--text-color) hover:text-(--color-brand-600) transition-colors focus-visible" href={link.link}>
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>

    </nav>
  </div>
</header>
