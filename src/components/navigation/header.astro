---
import { header } from "../../../data/navigation.json";
// Icons: @lucide/astro renders inline SVG at build time — zero client JS,
// tree-shaken per import. See AGENTS.md → "Icons".
import { Menu, X } from "@lucide/astro";
---

<header class="bg-[var(--surface-color)] border-b border-[var(--border-color)]">
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <nav class="flex items-center justify-between py-4">
      <a href={header.logo_url}>
        <img class="w-48" src={header.logo} alt={header.logo_alt_text} />
      </a>

      <ul class="hidden sm:flex items-center gap-6" data-editable="array" data-prop="header.links" data-component-key="text">
        {header.links.map((link) => (
          <li>
            <a class="text-[var(--text-color)] hover:text-[var(--link-color)] hover-transition font-medium" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <button
        class="sm:hidden p-2 text-[var(--text-color)] hover:text-[var(--link-color)] hover-transition"
        aria-label="Open navigation menu"
        popovertarget="mobile-menu"
        popovertargetaction="show"
      >
        <Menu class="w-6 h-6" aria-hidden="true" />
      </button>

      <div popover id="mobile-menu" class="fixed inset-0 m-0 w-full h-full max-w-none max-h-none border-none bg-[var(--bg-color)] z-50">
        <div class="flex flex-col h-full">
          <div class="mx-auto w-full max-w-6xl flex items-center justify-between px-4 sm:px-8 py-4 border-b border-[var(--border-color)]">
            <a href={header.logo_url}>
              <img class="w-48" src={header.logo} alt={header.logo_alt_text} />
            </a>
            <button
              class="p-2 text-[var(--text-color)] hover:text-[var(--link-color)] hover-transition"
              aria-label="Close navigation menu"
              popovertarget="mobile-menu"
              popovertargetaction="hide"
            >
              <X class="w-6 h-6" aria-hidden="true" />
            </button>
          </div>
          <ul class="flex flex-1 flex-col items-center justify-center gap-0 divide-y divide-[var(--border-color)]" data-editable="array" data-prop="header.links" data-component-key="text">
            {header.links.map((link) => (
              <li class="w-full max-w-xs text-center">
                <a class="block py-5 text-2xl font-medium text-[var(--text-color)] hover:text-[var(--link-color)] hover-transition" href={link.link}>
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  #mobile-menu {
    opacity: 0;
    transition: opacity 200ms ease, display 200ms allow-discrete, overlay 200ms allow-discrete;
  }
  #mobile-menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    #mobile-menu:popover-open {
      opacity: 0;
    }
  }
</style>
