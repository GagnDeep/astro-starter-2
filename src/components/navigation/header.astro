---
import { header } from "../../../data/navigation.json";
import { Menu, X } from "@lucide/astro";
---

<header class="bg-surface-color border-b border-border-color sticky top-0 z-40">
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <nav class="flex items-center justify-between py-4">
      <a href={header.logo_url} class="focus-visible rounded-sm" aria-label="Home">
        <img class="w-48" src={header.logo} alt={header.logo_alt_text} />
      </a>

      <ul class="hidden sm:flex items-center gap-6">
        {header.links.map((link) => (
          <li>
            <a class="text-text-color hover:text-accent-color transition-colors focus-visible rounded-sm" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      {/* Mobile menu using native details/summary */}
      <details class="sm:hidden group">
        <summary class="p-2 cursor-pointer list-none focus-visible rounded-sm" aria-label="Toggle navigation menu">
          <Menu class="w-6 h-6 group-open:hidden" aria-hidden="true" />
          <X class="w-6 h-6 hidden group-open:block" aria-hidden="true" />
        </summary>

        <div class="absolute inset-x-0 top-full bg-surface-color border-b border-border-color shadow-lg p-4">
          <ul class="flex flex-col items-center justify-center gap-0 divide-y divide-border-color">
            {header.links.map((link) => (
              <li class="w-full text-center">
                <a class="block py-4 text-xl font-medium text-text-color hover:text-accent-color transition-colors focus-visible rounded-sm" href={link.link}>
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </nav>
  </div>
</header>
