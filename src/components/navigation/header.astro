---
import { header } from "../../../data/navigation.json";
// Icons: @lucide/astro renders inline SVG at build time — zero client JS,
// tree-shaken per import. See AGENTS.md → "Icons".
import { Menu, X } from "@lucide/astro";
---

<header class="bg-[var(--color-bg-surface)] border-b border-[var(--color-border-base)] relative z-40">
  <div class="mx-auto max-w-6xl px-8">
    <nav class="flex items-center justify-between py-4">
      <a href={header.logo_url} class="outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-900)] rounded-sm">
        <img class="w-48" src={header.logo} alt={header.logo_alt_text} />
      </a>

      <ul class="hidden sm:flex items-center gap-6">
        {header.links.map((link) => (
          <li>
            <a class="text-[var(--color-text-base)] hover:text-[var(--color-brand-700)] hover-transition font-medium outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-900)] rounded-sm px-1" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      {/* Mobile Menu uses details/summary for CSS-only state without popover API */}
      <details class="sm:hidden group">
        <summary class="p-2 list-none cursor-pointer outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-brand-900)] rounded-md" aria-label="Toggle navigation menu">
          <Menu class="w-6 h-6 group-open:hidden" aria-hidden="true" stroke-width="1.5" />
          <X class="w-6 h-6 hidden group-open:block" aria-hidden="true" stroke-width="1.5" />
        </summary>

        <div class="absolute top-full left-0 right-0 bg-[var(--color-bg-surface)] border-b border-[var(--color-border-base)] shadow-md">
          <div class="flex flex-col">
            <ul class="flex flex-1 flex-col items-start gap-0 divide-y divide-[var(--color-border-base)] w-full">
              {header.links.map((link) => (
                <li class="w-full">
                  <a class="block px-8 py-5 text-xl font-medium text-[var(--color-text-base)] hover:bg-[var(--color-bg-base)] hover:text-[var(--color-brand-700)] transition-colors outline-none focus-visible:bg-[var(--color-bg-base)]" href={link.link}>
                    {link.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </details>
    </nav>
  </div>
</header>
