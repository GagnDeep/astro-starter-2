---
import { top_navigation } from "../../../data/navigation.json";
---

<header class="border-b border-gray-200">
  <div class="mx-auto flex max-w-5xl items-center justify-between p-6">
    <a href="/" class="text-xl font-bold text-gray-900 tracking-tight">WaterTrackLog</a>
    <nav class="hidden md:block">
      <ul class="flex items-center gap-6">
        {
          top_navigation.map((link: { url: string; name: string }) => (
            <li>
              <a href={link.url} class="text-sm font-medium text-gray-700 hover:text-blue-600">
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href="/tools/intake-calculator" class="hidden md:inline-block rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">Calculate Intake</a>
  </div>
</header>
