---
import { header } from "../../../data/navigation.json";
// Icons: @lucide/astro renders inline SVG at build time — zero client JS,
// tree-shaken per import. See AGENTS.md → "Icons".
import { Menu, X } from "@lucide/astro";
---

<header class="bg-[var(--color-bg)] border-b-2 border-[var(--color-border)]">
  <div class="mx-auto max-w-6xl px-8">
    <nav class="flex items-center justify-between py-6">
      <a href={header.logo_url} class="focus-visible">
        <img class="w-48" src={header.logo} alt={header.logo_alt_text} />
      </a>

      <ul class="hidden sm:flex items-center gap-8 font-display font-bold text-lg">
        {header.links.map((link) => (
          <li>
            <a class="text-[var(--color-text)] hover:text-[var(--color-supporting)] hover-transition focus-visible" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <button
        class="sm:hidden p-2 text-[var(--color-text)] hover:text-[var(--color-supporting)] hover-transition focus-visible border-2 border-transparent hover:border-[var(--color-border)]"
        aria-label="Open navigation menu"
        popovertarget="mobile-menu"
        popovertargetaction="show"
      >
        <Menu class="w-6 h-6" aria-hidden="true" />
      </button>

      <div popover id="mobile-menu" class="fixed inset-0 m-0 w-full h-full max-w-none max-h-none border-none bg-[var(--color-bg)] z-50">
        <div class="flex flex-col h-full">
        <div class="mx-auto w-full max-w-6xl flex items-center justify-between px-8 py-6 border-b-2 border-[var(--color-border)]">
          <a href={header.logo_url} class="focus-visible">
            <img class="w-48" src={header.logo} alt={header.logo_alt_text} />
          </a>
          <button
            class="p-2 text-[var(--color-text)] hover:text-[var(--color-supporting)] hover-transition focus-visible border-2 border-transparent hover:border-[var(--color-border)]"
            aria-label="Close navigation menu"
            popovertarget="mobile-menu"
            popovertargetaction="hide"
          >
            <X class="w-6 h-6" aria-hidden="true" />
          </button>
        </div>
        <ul class="flex flex-1 flex-col items-stretch justify-start mt-8 px-8 gap-0 divide-y-2 divide-[var(--color-border)]">
          {header.links.map((link) => (
            <li class="w-full text-left">
              <a class="block py-6 text-3xl font-display font-bold text-[var(--color-text)] hover:text-[var(--color-supporting)] hover-transition focus-visible" href={link.link}>
                {link.text}
              </a>
            </li>
          ))}
        </ul>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  #mobile-menu {
    opacity: 0;
    transition: opacity 200ms ease, display 200ms allow-discrete, overlay 200ms allow-discrete;
  }
  #mobile-menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    #mobile-menu:popover-open {
      opacity: 0;
    }
  }
</style>
