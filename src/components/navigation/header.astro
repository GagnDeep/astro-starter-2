---
import { header } from "../../../data/navigation.json";
// Icons: @lucide/astro renders inline SVG at build time — zero client JS,
// tree-shaken per import. See AGENTS.md → "Icons".
import { Menu, X } from "@lucide/astro";
---

<header class="surface sticky top-0 z-40">
  <div class="mx-auto max-w-6xl px-8">
    <nav class="flex items-center justify-between py-4">
      <a href={header.logo_url} data-editable="object" data-prop="header">
        <img class="w-48" src={header.logo} alt={header.logo_alt_text} data-prop-src="header.logo" data-prop-alt="header.logo_alt_text" />
      </a>

      <ul class="hidden md:flex items-center gap-6" data-editable="array" data-prop="header.links">
        {header.links.map((link) => (
          <li data-editable="array-item">
            <a class="text-neutral-800 hover:text-brand-600 transition-colors font-medium dark:text-neutral-200 dark:hover:text-brand-300" href={link.link} data-prop="link">
              <span data-prop="text">{link.text}</span>
            </a>
          </li>
        ))}
      </ul>

      <button
        class="md:hidden p-2 text-neutral-800 dark:text-neutral-200"
        aria-label="Open navigation menu"
        popovertarget="mobile-menu"
        popovertargetaction="show"
      >
        <Menu class="w-6 h-6" aria-hidden="true" />
      </button>

      <div popover id="mobile-menu" class="fixed inset-0 m-0 w-full h-full max-w-none max-h-none border-none bg-neutral-50 dark:bg-brand-900 z-50">
        <div class="flex flex-col h-full">
          <div class="mx-auto w-full max-w-6xl flex items-center justify-between px-8 py-4">
            <a href={header.logo_url}>
              <img class="w-48" src={header.logo} alt={header.logo_alt_text} />
            </a>
            <button
              class="p-2 text-neutral-800 dark:text-neutral-200"
              aria-label="Close navigation menu"
              popovertarget="mobile-menu"
              popovertargetaction="hide"
            >
              <X class="w-6 h-6" aria-hidden="true" />
            </button>
          </div>
          <ul class="flex flex-1 flex-col items-center justify-center gap-0 divide-y divide-neutral-200 dark:divide-brand-700 w-full px-8">
            {header.links.map((link) => (
              <li class="w-full max-w-xs text-center">
                <a class="block py-5 text-xl font-medium text-neutral-800 hover:text-brand-600 transition-colors dark:text-neutral-200 dark:hover:text-brand-300" href={link.link}>
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  #mobile-menu {
    opacity: 0;
    transition: opacity 200ms ease, display 200ms allow-discrete, overlay 200ms allow-discrete;
  }
  #mobile-menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    #mobile-menu:popover-open {
      opacity: 0;
    }
  }
</style>
