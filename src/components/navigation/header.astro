---
import { header } from "../../../data/navigation.json";
// Icons: @lucide/astro renders inline SVG at build time — zero client JS,
// tree-shaken per import. See AGENTS.md → "Icons".
import { Menu, X } from "@lucide/astro";
---

<header class="border-b-2 border-[var(--border-color)] bg-[var(--surface-color)] sticky top-0 z-40">
  <div class="mx-auto max-w-6xl px-8">
    <nav class="flex items-center justify-between py-4">
      <a href={header.logo_url} class="block focus-visible:outline-offset-8">
        <img class="w-48" src={header.logo} alt={header.logo_alt_text} />
      </a>

      <ul class="hidden sm:flex items-center gap-6">
        {header.links.map((link) => (
          <li>
            <a class="font-medium text-[var(--text-color)] hover:text-[var(--accent-color)] transition-colors duration-200" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <details class="sm:hidden group">
        <summary class="p-2 cursor-pointer list-none focus-visible:outline-offset-2 [&::-webkit-details-marker]:hidden">
          <Menu class="w-6 h-6 group-open:hidden" aria-hidden="true" />
          <X class="w-6 h-6 hidden group-open:block" aria-hidden="true" />
          <span class="sr-only">Toggle navigation menu</span>
        </summary>

        <div class="absolute left-0 right-0 top-full bg-[var(--surface-color)] border-b-2 border-[var(--border-color)] shadow-md">
          <ul class="flex flex-col items-center py-4 gap-4">
            {header.links.map((link) => (
              <li class="w-full text-center">
                <a class="block py-2 text-xl font-medium text-[var(--text-color)] hover:text-[var(--accent-color)] transition-colors duration-200" href={link.link}>
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </nav>
  </div>
</header>
