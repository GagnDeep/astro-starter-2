---
import { header } from "../../../data/navigation.json";
// Icons: @lucide/astro renders inline SVG at build time — zero client JS,
// tree-shaken per import. See AGENTS.md → "Icons".
import { Menu, X } from "@lucide/astro";
---

<header class="bg-(--bg-surface) border-b-2 border-(--border-color) sticky top-0 z-40">
  <div class="mx-auto max-w-7xl px-8">
    <nav class="flex items-center justify-between py-4">
      <a href={header.logo_url} class="focus-visible">
        <img class="w-48" src={header.logo} alt={header.logo_alt_text} />
      </a>

      <ul class="hidden sm:flex items-center gap-6 font-semibold font-mono text-sm">
        {header.links.map((link) => (
          <li>
            <a class="text-(--text-main) hover:text-(--color-brand) transition-colors focus-visible" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      {/* Mobile Menu using details/summary for zero-JS toggle */}
      <details class="sm:hidden group">
        <summary class="p-2 cursor-pointer list-none focus-visible text-(--text-main) marker:hidden [&::-webkit-details-marker]:hidden" aria-label="Toggle navigation menu">
          <Menu class="w-6 h-6 group-open:hidden" aria-hidden="true" />
          <X class="w-6 h-6 hidden group-open:block" aria-hidden="true" />
        </summary>

        <div class="fixed top-[74px] left-0 right-0 bottom-0 bg-(--bg-surface) border-t-2 border-(--border-color) z-50 overflow-y-auto">
          <ul class="flex flex-col items-center justify-center min-h-[50vh] gap-4 p-8 font-mono font-semibold">
            {header.links.map((link) => (
              <li class="w-full text-center border-b-2 border-(--border-color) last:border-b-0 pb-4 last:pb-0">
                <a class="block py-2 text-xl text-(--text-main) hover:text-(--color-brand) transition-colors focus-visible" href={link.link}>
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </nav>
  </div>
</header>

<style>
  /* Extra specificity to hide markers if needed */
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
