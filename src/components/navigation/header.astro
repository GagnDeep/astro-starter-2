---
import { header } from "../../../data/navigation.json";
import { site_title } from "../../../data/site.json";
import { Menu, X, Battery } from "@lucide/astro";


// Used directly instead of via data file, it's safer
const navLinks = header || [];
---

<header class="bg-white border-b border-gray-200">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <a class="flex items-center gap-2 font-semibold text-gray-900 group" href="/" aria-label="Home">
      <Battery class="h-8 w-8 text-blue-600 group-hover:scale-105 transition-transform" aria-hidden="true" />
      <span class="hidden sm:inline-block tracking-tight">{site_title}</span>
    </a>

    <nav aria-label="Main" class="hidden md:flex flex-1 justify-end mr-6">
      <ul class="flex items-center gap-6 text-sm font-medium">
        {navLinks.map((link) => (
          <li>
            <a class="text-gray-700 hover:text-blue-600 transition-colors py-2" href={link.href}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden md:block">
      <a href="/tools/compliance-checker/" class="btn btn-primary text-sm px-4 py-2">Check Compliance</a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-gray-600 hover:text-gray-900 focus:outline-none"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu class="h-6 w-6 menu-icon-open block" aria-hidden="true" />
      <X class="h-6 w-6 menu-icon-close hidden" aria-hidden="true" />
    </button>
  </div>

  <!-- Mobile menu, hidden by default -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-gray-200" aria-labelledby="mobile-menu-btn">
    <nav aria-label="Mobile">
      <ul class="flex flex-col py-4 px-4 space-y-2">
        {navLinks.map((link) => (
          <li>
            <a class="block py-3 px-4 text-base font-medium text-gray-800 hover:bg-gray-50 rounded-md transition-colors" href={link.href}>
              {link.text}
            </a>
          </li>
        ))}
        <li class="pt-4 mt-2 border-t border-gray-100">
           <a href="/tools/compliance-checker/" class="block w-full text-center btn btn-primary py-3">Check Compliance</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const openIcon = document.querySelector(".menu-icon-open");
  const closeIcon = document.querySelector(".menu-icon-close");

  if (btn && menu) {
    btn.addEventListener("click", () => {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      btn.setAttribute("aria-expanded", String(!expanded));
      menu.classList.toggle("hidden");
      openIcon?.classList.toggle("hidden");
      closeIcon?.classList.toggle("hidden");
    });
  }
</script>
