---
import { Search, Apple, Stethoscope, BookOpen, Smartphone, ShieldAlert } from "@lucide/astro";
---

<header class="bg-sand-50/90 backdrop-blur-md border-b border-sand-200 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-8 h-8 rounded-lg bg-terracotta-500 text-sand-50 flex items-center justify-center font-bold text-sm shadow-xs group-hover:bg-terracotta-600 transition-colors">
        IBS
      </div>
      <span class="font-bold text-stone-900 text-lg tracking-tight">IBS Go</span>
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-stone-700">
      <a href="/food/" class="hover:text-terracotta-600 transition-colors flex items-center gap-1.5">
        <Apple class="w-4 h-4 text-emerald-700" /> Food Directory
      </a>
      <a href="/symptoms/" class="hover:text-terracotta-600 transition-colors flex items-center gap-1.5">
        <Stethoscope class="w-4 h-4 text-terracotta-500" /> Symptoms
      </a>
      <a href="/protocols/" class="hover:text-terracotta-600 transition-colors flex items-center gap-1.5">
        <BookOpen class="w-4 h-4 text-sage-600" /> Protocols
      </a>
      <a href="/tools/food-lookup/" class="hover:text-terracotta-600 transition-colors flex items-center gap-1.5">
        <Search class="w-4 h-4 text-stone-500" /> Tools
      </a>
      <a href="/blog/" class="hover:text-terracotta-600 transition-colors">
        Articles
      </a>
      <a href="/pricing/" class="hover:text-terracotta-600 transition-colors">
        Pricing
      </a>
    </nav>

    <!-- App CTA -->
    <div class="flex items-center gap-3">
      <a href="/pricing/" class="px-4 py-2 bg-terracotta-500 text-sand-50 font-bold text-xs rounded-lg hover:bg-terracotta-600 transition-colors shadow-xs">
        Try App Free
      </a>
    </div>
  </div>
</header>
