---
import { header } from "../../../data/navigation.json";
// Icons: @lucide/astro renders inline SVG at build time — zero client JS,
// tree-shaken per import. See AGENTS.md → "Icons".
import { Menu, X } from "@lucide/astro";
---

<header class="bg-[var(--bg-surface)] border-b border-[var(--border-color)]">
  <div class="mx-auto max-w-6xl px-8">
    <nav class="flex items-center justify-between py-4">
      <a href={header.logo_url} class="font-bold text-2xl tracking-tighter">
        <img class="h-8 w-auto object-contain hidden" width="120" height="32" src={header.logo} alt={header.logo_alt_text} loading="eager" />
        {header.logo_alt_text.replace(' logo', '')}
      </a>

      <ul class="hidden sm:flex items-center gap-8 font-medium">
        {header.links.map((link) => (
          <li>
            <a class="text-[var(--text-main)] hover:text-[var(--accent-color)] transition-colors" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <button
        class="sm:hidden p-2 text-[var(--text-main)]"
        aria-label="Open navigation menu"
        popovertarget="mobile-menu"
        popovertargetaction="show"
      >
        <Menu class="w-6 h-6 stroke-[1.5]" aria-hidden="true" />
      </button>

      <div popover id="mobile-menu" class="fixed inset-0 m-0 w-full h-full max-w-none max-h-none border-none bg-[var(--bg-surface)] z-50">
        <div class="flex flex-col h-full">
        <div class="mx-auto w-full max-w-6xl flex items-center justify-between px-8 py-4 border-b border-[var(--border-color)]">
          <a href={header.logo_url} class="font-bold text-2xl tracking-tighter">
            <img class="h-8 w-auto object-contain hidden" width="120" height="32" src={header.logo} alt={header.logo_alt_text} loading="lazy" />
            {header.logo_alt_text.replace(' logo', '')}
          </a>
          <button
            class="p-2 text-[var(--text-main)]"
            aria-label="Close navigation menu"
            popovertarget="mobile-menu"
            popovertargetaction="hide"
          >
            <X class="w-6 h-6 stroke-[1.5]" aria-hidden="true" />
          </button>
        </div>
        <ul class="flex flex-1 flex-col items-center justify-center gap-0 divide-y divide-[var(--border-color)]">
          {header.links.map((link) => (
            <li class="w-full max-w-xs text-center">
              <a class="block py-5 text-2xl font-bold text-[var(--text-main)] hover:text-[var(--accent-color)] transition-colors" href={link.link}>
                {link.text}
              </a>
            </li>
          ))}
        </ul>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  #mobile-menu {
    opacity: 0;
    transition: opacity 200ms ease, display 200ms allow-discrete, overlay 200ms allow-discrete;
  }
  #mobile-menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    #mobile-menu:popover-open {
      opacity: 0;
    }
  }
</style>
