---
import { header } from "../../../data/navigation.json";
// Icons: @lucide/astro renders inline SVG at build time — zero client JS,
// tree-shaken per import. See AGENTS.md → "Icons".
import { Menu, X } from "@lucide/astro";
---

<header class="bg-surface-color border-b border-border-color">
  <div class="mx-auto max-w-6xl px-8">
    <nav class="flex items-center justify-between py-6">
      <a href={header.logo_url} aria-label="Home">
        <img class="h-8 w-auto" src={header.logo} alt={header.logo_alt_text} />
      </a>

      <ul class="hidden sm:flex items-center gap-8">
        {header.links.map((link) => (
          <li>
            <a class="text-sm font-medium tracking-tight hover:text-accent-color transition-colors duration-200" href={link.link}>
              {link.text}
            </a>
          </li>
        ))}
      </ul>

      <details class="sm:hidden group relative">
        <summary class="list-none p-2 cursor-pointer focus-visible" aria-label="Toggle navigation menu">
          <Menu class="w-6 h-6 group-open:hidden" aria-hidden="true" stroke-width="2" />
          <X class="w-6 h-6 hidden group-open:block" aria-hidden="true" stroke-width="2" />
        </summary>
        <div class="absolute top-full left-0 right-0 z-50 bg-surface-color border-b border-border-color shadow-sm p-4 w-screen -ml-8">
          <ul class="flex flex-col gap-4">
            {header.links.map((link) => (
              <li>
                <a class="block text-lg font-medium py-2 hover:text-accent-color transition-colors duration-200" href={link.link}>
                  {link.text}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </nav>
  </div>
</header>
