---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import PostSummary from "./summary.astro";

// Used for routing via visual editing components
const _name = "BlogList";

// CloudCannon returns all files in the collection as part of the page props
const posts: CollectionEntry<"blog">[] = Astro.props.posts ?? (await getCollection("blog"));

// Sort posts by date, newest first
posts.sort(
  (a, b) => new Date(b.data.post_hero.date).getTime() - new Date(a.data.post_hero.date).getTime(),
);
---

<div class="space-y-16 mt-8">
  {posts.map((post, i) => <PostSummary {...post} key={i} loading={i === 0 ? "eager" : "lazy"} />)}
</div>
