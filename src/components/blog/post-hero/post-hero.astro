---
import site from "data/site.json";
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  heading: string;
  date: string | Date;
  author: string;
  image: string;
  image_alt: string;
  tags: Array<string>;
  bodyContent?: string;
}

const { heading, date, author, image, image_alt, tags, bodyContent } = Astro.props;

const wordCount = bodyContent?.split(" ")?.length ?? 0;
const dateObj = new Date(date);
const authorWithFallback = author || site.authors?.[0]?.name || "Editorial Team";

let readingTime = "Less than 1 minute";
const readingTimeInMins = Math.floor(wordCount / 183);
if (readingTimeInMins === 1) {
  readingTime = "1 minute";
} else if (readingTimeInMins > 1) {
  readingTime = `${readingTimeInMins} minutes`;
}

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,avif,webp}",
  { eager: true },
);
const imageSrc = images[image]?.default || image;
---

<div
  class="flex flex-col mb-12 border-b-2 border-neutral-900 pb-8 dark:border-neutral-700 reveal-on-scroll"
>
  <h1
    data-editable="text"
    data-prop="heading"
    class="text-display-1 mt-4 mb-6 text-neutral-900 dark:text-neutral-50 text-balance"
  >
    {heading}
  </h1>

  <div
    class="flex flex-col md:flex-row gap-4 py-4 text-body text-neutral-600 dark:text-neutral-300 border-t-2 border-neutral-900 dark:border-neutral-700 font-display font-semibold"
  >
    <p data-editable="text" data-prop="author">{authorWithFallback}</p>
    <span class="hidden md:inline">&mdash;</span>
    {
      dateObj && (
        <p>
          {dateObj.toLocaleDateString(undefined, {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </p>
      )
    }
    <span class="hidden md:inline">&mdash;</span>
    <p>{wordCount} words &middot; {readingTime}</p>
  </div>

  {
    tags?.length > 0 && (
      <div class="flex flex-wrap gap-2 my-4">
        {tags.map((tag: string) => (
          <a
            href={`/tags/${tag}/`}
            class="bg-neutral-900 text-neutral-50 dark:bg-neutral-50 dark:text-neutral-900 font-display font-semibold text-sm px-4 py-2 hover:bg-orange-500 dark:hover:bg-orange-500 hover:text-neutral-900 transition-colors no-underline focus-visible:outline-2 focus-visible:outline-orange-500 focus-visible:outline-offset-2"
          >
            {tag.charAt(0).toUpperCase() + tag.slice(1)}
          </a>
        ))}
      </div>
    )
  }

  {
    image && image_alt && (
      <div class="mt-8 border-2 border-neutral-900 shadow-brutal dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 p-2 transform rotate-1">
        <Picture
          data-editable="image"
          data-prop-src="image"
          data-prop-alt="image_alt"
          class="w-full aspect-video object-cover grayscale contrast-125 mix-blend-multiply dark:mix-blend-lighten"
          src={imageSrc}
          alt={image_alt}
          widths={[600, 800, 1200]}
          sizes="(max-width: 1200px) 100vw, 1200px"
          loading="eager"
          formats={["avif", "webp"]}
        />
      </div>
    )
  }
</div>
