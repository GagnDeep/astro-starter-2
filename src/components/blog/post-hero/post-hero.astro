---
import site from "../../../../data/site.json";
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  heading: string;
  date: string | Date;
  author: string;
  image: string;
  image_alt: string;
  tags: Array<string>;
  bodyContent?: string;
}

const { heading, date, author, image, image_alt, tags, bodyContent } = Astro.props;

const wordCount = bodyContent?.split(" ")?.length ?? 0;
const dateObj = new Date(date);
const authorWithFallback = author || site.default_author;

let readingTime = "Less than 1 minute";
const readingTimeInMins = Math.floor(wordCount / 183);
if (readingTimeInMins === 1) {
  readingTime = "1 minute";
} else if (readingTimeInMins > 1) {
  readingTime = `${readingTimeInMins} minutes`;
}

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,avif,webp}",
  { eager: true },
);
const imageSrc = images[image]?.default || image;
const isRemoteImage = typeof imageSrc === "string";
const imageWidth = isRemoteImage ? 1200 : undefined;
const imageHeight = isRemoteImage ? 675 : undefined;
---

<div class="flex flex-col">
  {
    image && image_alt && (
      <Picture
        data-editable="image"
        data-prop-src="image"
        data-prop-alt="image_alt"
        class="w-full rounded-none aspect-video object-cover mb-8 grayscale"
        src={imageSrc}
        alt={image_alt}
        inferSize={isRemoteImage ? undefined : false}
        width={imageWidth}
        height={imageHeight}
        widths={[600, 800, 1200]}
        sizes="(max-width: 1200px) 100vw, 1200px"
        loading="eager"
        formats={["avif", "webp"]}
      />
    )
  }
  <h1
    data-editable="text"
    data-prop="heading"
    class="text-4xl md:text-5xl lg:text-6xl font-bold mt-4 mb-6 text-balance"
  >
    {heading}
  </h1>
  <div
    class="flex items-center gap-4 py-4 text-sm font-sans tracking-wide uppercase border-t border-[var(--surface-border)] mt-4"
  >
    <p data-editable="text" data-prop="author" class="font-bold text-gray-900 dark:text-gray-100">
      {authorWithFallback}
    </p>
    {
      dateObj && (
        <p class="text-gray-500">
          {dateObj.toLocaleDateString(undefined, {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </p>
      )
    }
    <p class="text-gray-500">{readingTime}</p>
  </div>
  {
    tags?.length > 0 && (
      <div class="flex flex-wrap gap-2 my-4">
        {tags.map((tag: string) => (
          <a
            href={`/tags/${tag}/`}
            class="bg-[var(--surface-border)] text-gray-800 dark:text-gray-200 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-none hover:bg-[var(--color-brand-500)] hover:text-white transition-colors no-underline"
          >
            {tag}
          </a>
        ))}
      </div>
    )
  }
</div>
