---
import site from "data/site.json";
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  heading: string;
  date: string | Date;
  author: string;
  image: string;
  image_alt: string;
  tags: Array<string>;
  bodyContent?: string;
}

const { heading, date, author, image, image_alt, tags, bodyContent } =
  Astro.props;

const wordCount = bodyContent?.split(" ")?.length ?? 0;
const dateObj = new Date(date);
const authorWithFallback = author || site.default_author;

let readingTime = "Less than 1 minute";
const readingTimeInMins = Math.floor(wordCount / 183);
if (readingTimeInMins === 1) {
  readingTime = "1 minute";
} else if (readingTimeInMins > 1) {
  readingTime = `${readingTimeInMins} minutes`;
}

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,avif,webp}",
  { eager: true },
);
const imageSrc = images[image]?.default || image;
---

<div class="flex flex-col border-b border-[var(--border-color)] pb-12 mb-12">
  {
    image && image_alt && (
      <Picture
        data-editable="image"
        data-prop-src="image"
        data-prop-alt="image_alt"
        class="w-full h-auto aspect-video object-cover border border-[var(--border-color)] shadow-[var(--shadow-md)] mb-8"
        src={imageSrc}
        alt={image_alt}
        widths={[600, 800, 1200]}
        sizes="(max-width: 1200px) 100vw, 1200px"
        loading="eager"
        formats={["avif", "webp"]}
      />
    )
  }
  <h1
    data-editable="text"
    data-prop="heading"
    class="font-bold mt-4 mb-4 text-balance leading-tight">
    {heading}
  </h1>
  {
    tags?.length > 0 && (
      <div class="flex flex-wrap gap-2 my-4">
        {tags.map((tag: string) => (
          <a
            href={`/tags/${tag}/`}
            class="bg-[var(--color-neutral-100)] text-[var(--accent-color)] border border-[var(--border-color)] text-xs font-bold uppercase tracking-wider px-3 py-1 no-underline hover:-translate-y-1 hover:shadow-[var(--shadow-sm)] transition-all">
            {tag}
          </a>
        ))}
      </div>
    )
  }
  <div class="flex flex-wrap items-center gap-4 py-4 text-sm text-[var(--text-muted)] font-medium">
    <span data-editable="text" data-prop="author">{authorWithFallback}</span>
    <span class="text-[var(--border-color)]">|</span>
    {
      dateObj && (
        <span>
          {dateObj.toLocaleDateString(undefined, {
            year: "numeric",
            month: "long",
            day: "numeric",
          })}
        </span>
      )
    }
    <span class="text-[var(--border-color)]">|</span>
    <span>{wordCount} words &middot; {readingTime}</span>
  </div>
</div>
