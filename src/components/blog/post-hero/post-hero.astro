---
import { Calendar, Tag, User } from "@lucide/astro";
import site from "../../../../data/site.json";

export interface Props {
  date: string | Date;
  heading: string;
  tags?: string[];
  author?: string;
  image?: string;
  image_alt?: string;
}

const { date, heading, tags = [], author, image, image_alt } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString(site.locale, {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const defaultAuthor =
  site.authors && site.authors.length > 0 ? site.authors[0].name : "Editorial Team";
const authorWithFallback = author || defaultAuthor;
---

<div class="mb-12">
  <div
    class="mb-6 flex flex-wrap items-center gap-4 text-sm text-(--color-neutral-600) dark:text-(--color-neutral-400)"
  >
    <time datetime={new Date(date).toISOString()} class="flex items-center gap-1.5 font-medium">
      <Calendar class="w-4 h-4" />
      {formattedDate}
    </time>

    <span class="flex items-center gap-1.5 font-medium">
      <User class="w-4 h-4" />
      {authorWithFallback}
    </span>
  </div>

  <h1
    class="text-4xl md:text-5xl lg:text-6xl font-display text-(--color-neutral-900) dark:text-white mb-6 leading-tight text-balance"
  >
    {heading}
  </h1>

  {
    tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {tags.map((tag) => (
          <span class="inline-flex items-center gap-1 bg-(--color-neutral-100) dark:bg-(--color-brand-800) text-(--color-neutral-700) dark:text-(--color-neutral-300) px-3 py-1 rounded-full text-sm font-medium">
            <Tag class="w-3.5 h-3.5" />
            {tag}
          </span>
        ))}
      </div>
    )
  }

  {
    image && (
      <div class="mt-8 overflow-hidden rounded-xl bg-(--color-neutral-100) dark:bg-(--color-brand-800) border border-(--border-color)">
        <img
          src={image}
          alt={image_alt || ""}
          class="w-full h-auto aspect-video object-cover"
          width="1200"
          height="675"
          decoding="async"
        />
      </div>
    )
  }
</div>
