---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

const { data, id, loading } = Astro.props;
const { title, thumb_image_path, thumb_image_alt, post_hero } = data;
const { date, tags } = post_hero;

const dateObj = new Date(date);
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,avif}",
  { eager: true },
);
const imageSrc = images[thumb_image_path]?.default ?? thumb_image_path;
---

<div class="flex flex-col bg-bg-surface border border-border-subtle hover:border-accent-lime/60 rounded-xl p-5 transition-all group">
  <a href={`/blog/${id}/`}>
    {typeof imageSrc === "string" ? (
      <img
        class="w-full rounded-lg aspect-video object-cover border border-border-subtle"
        src={imageSrc}
        alt={thumb_image_alt}
        loading={loading}
      />
    ) : (
      <Picture
        class="w-full rounded-lg aspect-video object-cover border border-border-subtle"
        src={imageSrc}
        alt={thumb_image_alt}
        widths={[600, 800]}
        sizes="(max-width: 800px) 100vw, 800px"
        loading={loading}
        formats={["avif", "webp"]}
      />
    )}
  </a>
  <div class="mt-4">
    {tags?.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-3 font-mono">
        {tags.map((tag: string) => (
          <a
            href={`/tags/${tag}/`}
            class="bg-accent-lime/10 border border-accent-lime/30 text-accent-lime text-[11px] font-bold px-2 py-0.5 rounded uppercase"
          >
            {tag}
          </a>
        ))}
      </div>
    )}
    <h2 class="font-mono font-bold text-lg text-text-main group-hover:text-accent-lime transition-colors">
      <a href={`/blog/${id}/`}>
        {title}
      </a>
    </h2>
    <p class="font-mono text-xs text-text-muted mt-2">
      {dateObj.toLocaleDateString("ro-RO", {
        year: "numeric",
        month: "long",
        day: "numeric",
      })}
    </p>
  </div>
</div>
