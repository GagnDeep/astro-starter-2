---
export interface Source {
  title: string;
  url: string;
  date_accessed?: string;
}

export interface Props {
  heading?: string;
  sources: Source[];
}

const { heading = "Sources", sources } = Astro.props;
---

<div class="mt-12 pt-8 border-t border-border-color bg-surface-color p-8 rounded-sm shadow-sm" data-editable="sources-list">
  <h3 class="text-xl font-bold mb-4 text-brand-900">{heading}</h3>
  <ol class="list-decimal list-inside space-y-3 text-neutral-700 text-sm">
    {sources.map((source) => (
      <li class="pl-2">
        <a href={source.url} class="text-accent-700 hover:text-accent-900 underline underline-offset-2 transition-colors">
          {source.title}
        </a>
        {source.date_accessed && (
          <span class="text-neutral-500 ml-2">Accessed: {source.date_accessed}</span>
        )}
      </li>
    ))}
  </ol>
</div>
