---
import Markdown from "./utility/markdown.astro";

interface Feature {
  title: string;
  description: string;
  span?: 1 | 2;
}

interface Props {
  heading?: string;
  subheading?: string;
  features: Feature[];
}

const { heading, subheading, features } = Astro.props;
---

<section class="py-[var(--spacing-section)] reveal is-visible">
  <div class="mx-auto max-w-6xl px-8">
    {heading && (
      <div class="mb-12">
        <h2 data-editable="text" data-prop="heading" class="mb-4 text-[color:var(--color-brand-ink)] dark:text-[color:var(--color-brand-ink-dark)]">
          {heading}
        </h2>
        {subheading && (
          <div data-editable="text" data-prop="subheading" class="text-xl max-w-3xl text-[color:var(--color-neutral-800)] dark:text-[color:var(--color-neutral-200)]">
            <Markdown content={subheading} dataProp="subheading" dataType="block" />
          </div>
        )}
      </div>
    )}

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6" data-editable="array" data-prop="features">
      {features.map((feature, idx) => (
        <div class={`brutal-card flex flex-col gap-4 ${feature.span === 2 ? 'md:col-span-2' : 'md:col-span-1'}`} data-editable="array-item">
          <h3 class="text-2xl font-bold font-[family-name:var(--font-display)] text-[color:var(--color-brand-ink)] dark:text-[color:var(--color-brand-ink-dark)]">
            <span data-editable="text" data-prop={`features[${idx}].title`}>{feature.title}</span>
          </h3>
          <div class="text-[color:var(--color-neutral-800)] dark:text-[color:var(--color-neutral-200)] prose">
            <Markdown content={feature.description} dataProp={`features[${idx}].description`} dataType="block" />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
