---
import Markdown from "../utility/markdown.astro";

interface Props {
  heading?: string;
  text_content: string;
}

const { heading, text_content } = Astro.props;
---

<section class="py-16 md:py-24 border-b-2 border-neutral-900 dark:border-neutral-700">
  <div class="mx-auto max-w-3xl px-8 reveal-on-scroll">
    {
      heading && (
        <h2
          data-editable="text"
          data-prop="heading"
          class="font-display font-semibold text-3xl md:text-4xl mb-8 text-neutral-900 dark:text-neutral-50 text-balance"
        >
          {heading}
        </h2>
      )
    }
    <div class="prose text-neutral-800 dark:text-neutral-200">
      <Markdown content={text_content} dataProp="text_content" dataType="block" />
    </div>
  </div>
</section>
