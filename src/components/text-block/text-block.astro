---
import Markdown from "../utility/markdown.astro";

interface Props {
  heading?: string;
  text_content: string;
}

const { heading, text_content } = Astro.props;
---

<section class="border-b-2 border-(--border-color) bg-(--bg-surface) py-16 lg:py-24" data-component="TextBlock">
  <div class="mx-auto max-w-3xl px-8 reveal">
    {heading && (
      <h2
        data-editable="text"
        data-prop="heading"
        class="text-4xl mb-6"
      >
        {heading}
      </h2>
    )}
    <div class="prose">
      <Markdown content={text_content} dataProp="text_content" dataType="block" />
    </div>
  </div>
</section>
