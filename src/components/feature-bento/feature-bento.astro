---
export interface Props {
  heading?: string;
  features: {
    title: string;
    description: string;
    icon?: string;
  }[];
}

const { heading, features = [] } = Astro.props;
---
<section class="border-b-2 border-(--border-color) bg-(--bg-surface) py-16 lg:py-24" data-component="FeatureBento">
  <div class="mx-auto max-w-7xl px-8">
    {heading && <h2 class="mb-12 reveal text-4xl">{heading}</h2>}

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 auto-rows-[minmax(200px,auto)]">
      {features.map((feature, index) => {
        // Unequal spans logic: 7/5 for first row, 5/7 for second, etc.
        const isFirstInRow = index % 2 === 0;
        const colSpanClass = isFirstInRow ? "md:col-span-7" : "md:col-span-5";

        return (
          <div class={`brutal-card p-8 reveal flex flex-col justify-between ${colSpanClass}`}>
            <div>
              <h3 class="text-2xl mb-4 text-(--text-main)">{feature.title}</h3>
              <p class="text-(--text-muted) font-mono">{feature.description}</p>
            </div>
            {feature.icon && (
              <div class="mt-6 flex justify-end">
                <span class="text-(--color-brand) text-4xl" aria-hidden="true">{feature.icon}</span>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>
