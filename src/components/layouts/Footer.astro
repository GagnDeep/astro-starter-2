---
import NewsletterForm from '../forms/newsletter-form.astro';
import { capture } from "../../../capture.config";
---
<footer class="bg-slate-900 text-slate-300 py-12 mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
    <div class="col-span-1 md:col-span-2">
      <h3 class="text-white text-xl font-bold mb-4">Protein or Fiber</h3>
      <p class="mb-6 max-w-sm text-sm leading-relaxed">Practical, evidence-based macro optimization focusing on satiety and muscle preservation, bridging the gap between clinical science and everyday meal prep.</p>

      <div class="max-w-sm">
        <h4 class="text-white font-bold mb-2 text-sm">Join our Newsletter</h4>
        <NewsletterForm form={capture.forms.newsletter} />
      </div>
    </div>

    <div>
      <h4 class="text-white font-bold mb-4">Library</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/reference" class="hover:text-emerald-400 transition-colors">Reference</a></li>
        <li><a href="/taxonomy" class="hover:text-emerald-400 transition-colors">By Goal</a></li>
        <li><a href="/glossary" class="hover:text-emerald-400 transition-colors">Glossary</a></li>
        <li><a href="/tools" class="hover:text-emerald-400 transition-colors">Calculators</a></li>
        <li><a href="/blog" class="hover:text-emerald-400 transition-colors">Articles</a></li>
      </ul>
    </div>

    <div>
      <h4 class="text-white font-bold mb-4">Legal</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/pages/about" class="hover:text-emerald-400 transition-colors">About Us</a></li>
        <li><a href="/contact" class="hover:text-emerald-400 transition-colors">Contact</a></li>
        <li><a href="/pages/legal" class="hover:text-emerald-400 transition-colors">Privacy & Terms</a></li>
      </ul>
    </div>
  </div>
</footer>
