---
interface Props {
  redFlags: string[];
}

const { redFlags } = Astro.props;
---

{redFlags && redFlags.length > 0 && (
  <div class="my-8 bg-amber-50 border-l-4 border-amber-600 p-5 rounded-r-lg shadow-sm">
    <div class="flex items-start gap-3">
      <svg class="w-6 h-6 text-amber-600 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <div>
        <h4 class="font-serif font-bold text-amber-900 text-base mb-1">
          When to Seek Immediate / Urgent Medical Care
        </h4>
        <p class="text-xs text-amber-800 mb-3">
          If you experience any of the following acute symptoms, do not wait for an outpatient consultation. Contact emergency medical services (911) or visit the nearest emergency department immediately:
        </p>
        <ul class="list-disc list-inside space-y-1 text-xs text-amber-900 font-medium">
          {redFlags.map(flag => (
            <li>{flag}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
)}
