---
import NewsletterForm from "../forms/newsletter-form.astro";

export interface Props {
  heading: string;
  text?: string;
  button_text?: string;
}

const { heading, text, button_text } = Astro.props;
---

<section style="background-color: var(--color-accent-500); color: var(--color-neutral-900); padding-top: 4rem; padding-bottom: 4rem;">
  <div style="margin-left: auto; margin-right: auto; max-width: 72rem; padding-left: 1rem; padding-right: 1rem; display: flex; flex-direction: column; gap: 2rem;">
    <div style="max-width: 42rem;">
      <h2 style="font-size: 1.875rem; line-height: 2.25rem; font-weight: 700; margin-bottom: 1rem;">{heading}</h2>
      {text && <p style="font-size: 1.125rem; line-height: 1.75rem; opacity: 0.9;">{text}</p>}
    </div>
    <div style="flex-shrink: 0; width: 100%; min-width: 300px;">
      <NewsletterForm submitLabel={button_text || "Subscribe"} />
    </div>
  </div>
</section>
