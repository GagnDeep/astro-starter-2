---
import CaptureForm from "../forms/capture-form.astro";
import { capture } from "../../../capture.config";

interface Props {
  heading: string;
  subheading?: string;
  button_text?: string;
  button_link?: string;
  show_form?: boolean;
}

const { heading, subheading, button_text, button_link, show_form } = Astro.props;
---

<section class="py-12 md:py-20 bg-[var(--color-neutral-900)] text-[var(--color-neutral-50)] border-t border-b border-[var(--color-neutral-950)]">
  <div class="mx-auto max-w-4xl px-8 text-center flex flex-col items-center">
    <h2 data-editable="text" data-prop="heading" class="text-3xl md:text-5xl font-bold mb-4 text-balance text-white">
      {heading}
    </h2>
    {subheading && (
      <p data-editable="text" data-prop="subheading" class="text-lg md:text-xl text-[var(--color-neutral-300)] mb-8 max-w-[60ch]">
        {subheading}
      </p>
    )}

    {show_form ? (
      <div class="w-full max-w-md bg-[var(--color-neutral-800)] p-6 border border-[var(--color-neutral-700)] shadow-[var(--shadow-md)] text-left">
        <CaptureForm form={capture.forms.newsletter} submitLabel={button_text || "Subscribe"}>
          <div>
            <label for="email" class="block text-sm font-bold text-white mb-2">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="w-full bg-[var(--color-neutral-900)] border border-[var(--color-neutral-700)] px-4 py-3 text-white focus:border-[var(--accent-color)] focus:outline-none focus:ring-1 focus:ring-[var(--accent-color)]"
            />
          </div>
        </CaptureForm>
      </div>
    ) : button_link && button_text && (
      <a
        href={button_link}
        class="inline-flex px-8 py-4 bg-[var(--color-brand-light)] text-[var(--color-neutral-950)] font-bold text-lg hover:bg-white hover:-translate-y-1 hover:shadow-[var(--shadow-md)] transition-all duration-200"
      >
        <span data-editable="text" data-prop="button_text">{button_text}</span>
      </a>
    )}
  </div>
</section>
