---
import Markdown from "../utility/markdown.astro";
import CaptureForm from "../forms/capture-form.astro";

interface Props {
  heading: string;
  text_content: string;
  button?: {
    text: string;
    link: string;
  };
  capture_form?: boolean;
}

const { heading, text_content, button, capture_form } = Astro.props;
---

<section class="py-12 bg-neutral-200 dark:bg-neutral-800 border-y border-neutral-300 dark:border-neutral-700 reveal">
  <div class="mx-auto max-w-4xl px-8 flex flex-col md:flex-row items-center justify-between gap-8">
    <div class="flex-1 text-center md:text-left flex flex-col gap-2">
      <h2
        data-editable="text"
        data-prop="heading"
        class="text-2xl font-bold text-neutral-900 dark:text-neutral-100">
        {heading}
      </h2>
      <div class="prose text-neutral-600 dark:text-neutral-300">
        <Markdown content={text_content} dataProp="text_content" dataType="block" />
      </div>
    </div>
    <div class="flex-shrink-0 w-full md:w-auto md:min-w-[300px]">
      {capture_form ? (
        <CaptureForm />
      ) : button?.link ? (
        <a
          href={button.link}
          class="inline-flex items-center justify-center w-full md:w-auto rounded-[var(--radius-sm)] bg-brand dark:bg-accent-dark px-8 py-4 text-white font-medium hover:brightness-110 transition-colors shadow-sm focus-visible:outline-neutral-900 dark:focus-visible:outline-neutral-100">
          <span data-editable="text" data-prop="button.text">
            {button.text}
          </span>
        </a>
      ) : null}
    </div>
  </div>
</section>
