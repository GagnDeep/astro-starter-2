---
import CaptureForm from "../forms/capture-form.astro";

interface Props {
  heading: string;
  subheading?: string;
}

const { heading, subheading } = Astro.props;
---

<section class="py-16 md:py-24 border-y-2 border-neutral-900 bg-orange-500 dark:border-neutral-700">
  <div class="mx-auto max-w-5xl px-8 text-center reveal-on-scroll">
    <h2
      data-editable="text"
      data-prop="heading"
      class="font-display font-semibold text-4xl md:text-5xl mb-6 text-neutral-900 text-balance"
    >
      {heading}
    </h2>
    {
      subheading && (
        <p
          data-editable="text"
          data-prop="subheading"
          class="text-body text-neutral-900 font-medium max-w-2xl mx-auto mb-8"
        >
          {subheading}
        </p>
      )
    }
    <div class="max-w-md mx-auto text-left bg-neutral-50 p-6 shadow-brutal border-2 border-neutral-900">
      <CaptureForm
        submitLabel="Get Matched Now"
        successMessage="Thanks - we'll review your RFQ and connect you with verified manufacturers."
      />
    </div>
  </div>
</section>
