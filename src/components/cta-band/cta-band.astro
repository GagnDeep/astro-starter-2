---
interface Props {
  text: string;
  button_text: string;
  button_link: string;
}

const { text, button_text, button_link } = Astro.props;
---
<section class="py-12 bg-brand-500 border-y-4 border-neutral-900 mt-16 mb-16 shadow-lg">
  <div class="mx-auto max-w-6xl px-8 flex flex-col md:flex-row items-center justify-between gap-6">
    <h2 class="text-2xl md:text-3xl font-bold uppercase text-neutral-900 m-0">{text}</h2>
    <a href={button_link} class="whitespace-nowrap bg-neutral-900 text-white font-bold uppercase px-8 py-4 border-2 border-neutral-900 hover:bg-neutral-50 hover:text-neutral-900 transition-colors shadow-[4px_4px_0_0_#fff] hover:shadow-none hover:translate-y-1 hover:translate-x-1">
      {button_text}
    </a>
  </div>
</section>
