---
import CaptureForm from "../forms/capture-form.astro";

interface Props {
  heading: string;
  subheading: string;
}

const { heading, subheading } = Astro.props;
---

<section class="py-16 md:py-24 bg-(--color-brand-800) text-(--surface-color)">
  <div class="mx-auto max-w-4xl px-8 flex flex-col md:flex-row items-start gap-8 md:gap-16 reveal reveal-active">
    <div class="flex-1 flex flex-col gap-4 text-center md:text-left">
      <h2
        data-editable="text"
        data-prop="heading"
        class="text-3xl md:text-4xl font-bold text-balance text-(--surface-color)">
        {heading}
      </h2>
      <p
        data-editable="text"
        data-prop="subheading"
        class="text-xl text-(--color-brand-200) max-w-2xl">
        {subheading}
      </p>
    </div>

    <div class="flex-1 w-full max-w-md bg-(--surface-color) p-8 text-(--text-color) shadow-lg">
      <h3 class="text-xl font-bold text-(--heading-color) mb-6">Book a Consultation</h3>
      <CaptureForm form="contact" submitLabel="Submit Request" class="[&_label]:text-(--text-color) [&_input]:border-(--border-color) [&_input]:bg-(--bg-color) [&_input]:text-(--text-color) [&_textarea]:border-(--border-color) [&_textarea]:bg-(--bg-color) [&_textarea]:text-(--text-color) [&_button]:bg-(--color-brand-800) [&_button]:text-(--surface-color) [&_button]:hover:bg-(--color-brand-700) [&_button]:w-full [&_button]:py-3 [&_button]:font-bold [&_button]:mt-4" />
    </div>
  </div>
</section>
