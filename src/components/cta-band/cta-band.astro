---
import Markdown from "../utility/markdown.astro";
import CaptureForm from "../forms/capture-form.astro";

interface Props {
  heading: string;
  subheading?: string;
  button: {
    text: string;
    link: string;
  };
}

const { heading, subheading, button } = Astro.props;
---

<section class="py-16 md:py-24 bg-[var(--accent-color)] border-b-2 border-[var(--text-color)] text-[var(--text-color)]">
  <div class="mx-auto max-w-4xl px-8 reveal flex flex-col items-center">
    <div class="text-center">
      <h2 data-editable="text" data-prop="heading" class="text-3xl md:text-5xl font-bold mb-6 !text-[var(--text-color)]">
        {heading}
      </h2>
      {subheading && (
        <div class="text-lg md:text-xl mb-8 max-w-2xl font-sans font-medium !text-[var(--text-color)] opacity-90 mx-auto">
          <Markdown content={subheading} dataProp="subheading" dataType="block" />
        </div>
      )}
    </div>
    <div class="w-full max-w-md bg-[var(--surface-color)] text-[var(--text-color)] p-6 brutal-border brutal-shadow">
      <CaptureForm submitLabel={button.text} class="text-left" />
    </div>
  </div>
</section>
