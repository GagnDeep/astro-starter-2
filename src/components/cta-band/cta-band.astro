---
export interface Props {
  title: string;
  text: string;
  button_text: string;
  button_url: string;
}

const { title, text, button_text, button_url } = Astro.props;
---

<div class="bg-[var(--accent-color)] text-white py-16 px-8 border-y-2 border-[var(--border-color)] my-16">
  <div class="mx-auto max-w-6xl flex flex-col md:flex-row items-center justify-between gap-8 reveal">
    <div class="max-w-2xl">
      <h2 class="text-white mb-4">{title}</h2>
      <p class="text-white opacity-90 m-0">{text}</p>
    </div>
    <a href={button_url} class="bg-[var(--surface-color)] text-[var(--text-color)] border-2 border-[var(--border-color)] px-8 py-4 font-bold shadow-sm hover:shadow-md transition-shadow focus-visible:outline-white whitespace-nowrap">
      {button_text}
    </a>
  </div>
</div>
