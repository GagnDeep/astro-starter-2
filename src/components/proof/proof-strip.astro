---
export interface Logo {
  image_url: string;
  alt_text: string;
}

export interface Props {
  heading: string;
  logos: Logo[];
}

const { heading, logos } = Astro.props;
---

<section class="py-12 bg-surface-color border-y border-border-color overflow-hidden" data-editable="proof-strip">
  <div class="mx-auto max-w-6xl px-4 sm:px-8 text-center">
    <h3 class="text-sm font-bold tracking-wider text-neutral-500 uppercase mb-8">{heading}</h3>

    <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-70 hover:opacity-100 transition-opacity duration-300">
      {logos.map((logo) => (
        <img
          src={logo.image_url}
          alt={logo.alt_text}
          class="h-8 md:h-10 object-contain grayscale hover:grayscale-0 transition-all duration-300"
          loading="lazy"
        />
      ))}
    </div>
  </div>
</section>
