---
interface Citation {
  title: string;
  publication: string;
  year: number;
  doiUrl?: string;
}

interface Props {
  citations: Citation[];
}

const { citations } = Astro.props;
---

{citations && citations.length > 0 && (
  <section class="mt-12 pt-8 border-t border-border bg-surface/50 rounded-xl p-6">
    <h3 class="font-serif text-lg font-bold text-charcoal mb-4 flex items-center gap-2">
      <svg class="w-5 h-5 text-terracotta" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      Clinical Practice References & Guidelines
    </h3>
    <ul class="space-y-3 text-xs text-charcoal-muted">
      {citations.map((item, index) => (
        <li class="flex items-start gap-2">
          <span class="font-bold text-terracotta font-mono text-xs">[{index + 1}]</span>
          <div>
            <span class="font-semibold text-charcoal">{item.title}.</span>
            <span class="italic font-serif"> {item.publication}</span> ({item.year}).
            {item.doiUrl && (
              <a href={item.doiUrl} target="_blank" rel="noopener noreferrer" class="ml-1 text-terracotta underline hover:text-terracotta-hover">
                doi:{item.doiUrl.replace(/^https?:\/\/(dx\.)?doi\.org\//, '')}
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  </section>
)}
