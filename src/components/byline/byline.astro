---
interface Props {
  author: string;
  date: string | Date;
  role?: string;
}

const { author, date, role } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<div class="flex items-center gap-4 py-4 border-y border-border my-8 not-prose">
  <div class="flex flex-col">
    <div class="font-medium text-neutral-900 dark:text-neutral-50" data-editable="text" data-prop="author">{author}</div>
    {role && (
      <div class="text-sm text-neutral-500 dark:text-neutral-400" data-editable="text" data-prop="role">{role}</div>
    )}
  </div>
  <div class="w-px h-8 bg-border mx-2"></div>
  <time class="text-sm text-neutral-500 dark:text-neutral-400" datetime={new Date(date).toISOString()} data-editable="text" data-prop="date">
    {formattedDate}
  </time>
</div>
