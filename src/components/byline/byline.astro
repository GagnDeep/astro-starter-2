---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  author: string;
  role: string;
  date?: string;
  avatar?: {
    image_path: string;
    alt_text: string;
  };
}

const { author, role, date, avatar } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true }
);
const avatarSrc = avatar?.image_path ? (allImages[avatar.image_path]?.default ?? avatar.image_path) : null;
---

<div class="flex items-center gap-4 py-6 border-y border-border-color my-8 reveal-on-scroll">
  {avatarSrc && avatar?.alt_text && (
    <div class="shrink-0">
      <Picture
        data-editable="image"
        data-prop-src="avatar.image_path"
        data-prop-alt="avatar.alt_text"
        src={avatarSrc}
        alt={avatar.alt_text}
        class="w-12 h-12 rounded-full object-cover border border-border-color"
        widths={[100]}
        sizes="48px"
        formats={["avif", "webp"]}
      />
    </div>
  )}
  <div>
    <p class="font-medium text-text-color">
      <span data-editable="text" data-prop="author">{author}</span>
    </p>
    <div class="flex items-center text-sm text-text-muted gap-2">
      <span data-editable="text" data-prop="role">{role}</span>
      {date && (
        <>
          <span aria-hidden="true">&bull;</span>
          <time datetime={new Date(date).toISOString()} data-editable="text" data-prop="date">
            {new Date(date).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          </time>
        </>
      )}
    </div>
  </div>
</div>
