---
interface Props {
  author: string;
  role: string;
  date: string;
}

const { author, role, date } = Astro.props;
---

<div
  class="flex items-center gap-4 py-4 border-t-2 border-neutral-900 dark:border-neutral-700 my-8 reveal-on-scroll"
>
  <div class="flex flex-col">
    <p class="font-display font-semibold text-neutral-900 dark:text-neutral-50 text-lg">
      <span data-editable="text" data-prop="author">{author}</span>
    </p>
    <p class="text-neutral-600 dark:text-neutral-400 text-sm">
      <span data-editable="text" data-prop="role">{role}</span>
      <span class="mx-2">&middot;</span>
      <span data-editable="text" data-prop="date">{date}</span>
    </p>
  </div>
</div>
