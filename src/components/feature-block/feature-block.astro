---
export interface Props {
  heading?: string;
  features: {
    title: string;
    description: string;
    icon?: string;
    span?: "1" | "2";
  }[];
}

const { heading, features } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 sm:px-8 py-16">
  {heading && <h2 class="text-3xl font-bold mb-10">{heading}</h2>}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {features?.map((feature) => (
      <div class={`bg-[var(--surface-color)] p-8 shadow-sm border border-[var(--border-color)] ${feature.span === '2' ? 'md:col-span-2' : ''}`}>
        <h3 class="text-xl font-bold mb-4">{feature.title}</h3>
        <p class="text-[var(--text-color)] opacity-90">{feature.description}</p>
      </div>
    ))}
  </div>
</section>
