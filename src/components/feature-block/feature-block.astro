---
import Markdown from "../utility/markdown.astro";

interface Props {
  heading: string;
  items: {
    title: string;
    description: string;
  }[];
}

const { heading, items } = Astro.props;
---

<section class="py-16 md:py-24 bg-[var(--surface-color)]">
  <div class="mx-auto max-w-6xl px-8">
    {
      heading && (
        <h2
          data-editable="text"
          data-prop="heading"
          class="mb-12 border-b-4 border-[var(--color-brand-500)] pb-4 inline-block"
        >
          {heading}
        </h2>
      )
    }

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8" data-editable="array" data-prop="items">
      {
        items?.map((item, index) => {
          // Asymmetric span: first item spans 7, second spans 5. Repeat.
          const spanClass = index % 2 === 0 ? "md:col-span-7" : "md:col-span-5";
          return (
            <div
              class={`p-8 bg-[var(--bg-color)] border border-[var(--surface-border)] shadow-[var(--shadow-current)] ${spanClass}`}
            >
              <h3
                class="text-2xl font-bold mb-4"
                data-editable="text"
                data-prop={`items[${index}].title`}
              >
                {item.title}
              </h3>
              <div class="prose text-gray-700 dark:text-gray-300">
                <Markdown
                  content={item.description}
                  dataProp={`items[${index}].description`}
                  dataType="block"
                />
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
