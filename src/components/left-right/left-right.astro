---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../utility/markdown.astro";

interface Props {
  heading: string;
  text_content: string;
  image: {
    image_path: string;
    alt_text: string;
  };
  flipped?: boolean;
  button?: {
    text: string;
    link: string;
  };
}

const { heading, text_content, image, flipped, button } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = images[image.image_path]?.default ?? image.image_path;
---

<section
  class="py-16 md:py-24 border-b-2 border-neutral-900 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800"
>
  <div
    class={`mx-auto max-w-7xl px-8 grid grid-cols-1 md:grid-cols-12 gap-12 items-center reveal-on-scroll`}
  >
    <div class={`md:col-span-7 flex flex-col gap-6 ${flipped ? "md:order-2" : ""}`}>
      <h2
        data-editable="text"
        data-prop="heading"
        class="font-display font-semibold text-4xl md:text-5xl text-neutral-900 dark:text-neutral-50 text-balance"
      >
        {heading}
      </h2>
      <div class="text-body text-neutral-700 dark:text-neutral-300">
        <Markdown content={text_content} dataProp="text_content" dataType="block" />
      </div>
      {
        button?.link && (
          <a
            href={button.link}
            class="mt-4 inline-block w-fit bg-neutral-900 px-8 py-4 text-neutral-50 font-display font-semibold hover:bg-orange-500 hover:text-neutral-900 transition-colors shadow-brutal outline-none focus-visible:outline-2 focus-visible:outline-orange-500 focus-visible:outline-offset-4 dark:bg-neutral-50 dark:text-neutral-900 dark:hover:bg-orange-400"
          >
            <span data-editable="text" data-prop="button.text">
              {button.text}
            </span>
          </a>
        )
      }
    </div>
    {
      image.image_path && image.alt_text && (
        <div class={`md:col-span-5 ${flipped ? "md:order-1" : ""}`}>
          <div class="border-2 border-neutral-900 shadow-brutal dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-900 p-2 transform -rotate-1 md:-rotate-2">
            <Picture
              data-editable="image"
              data-prop-src="image.image_path"
              data-prop-alt="image.alt_text"
              alt={image.alt_text}
              src={imageSrc}
              class="w-full h-auto object-cover grayscale contrast-125 mix-blend-multiply dark:mix-blend-lighten"
              loading="lazy"
              widths={[600, 800, 1200]}
              sizes="(max-width: 1200px) 100vw, 600px"
              formats={["avif", "webp"]}
            />
          </div>
        </div>
      )
    }
  </div>
</section>
