---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../utility/markdown.astro";

interface Props {
  heading: string;
  text_content: string;
  image: {
    image_path: string;
    alt_text: string;
  };
  flipped?: boolean;
  button?: {
    text: string;
    link: string;
  };
}

const { heading, text_content, image, flipped, button } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = images[image.image_path]?.default ?? image.image_path;
---

<section class="py-[var(--spacing-block)] reveal">
  <div
    class={`mx-auto max-w-6xl px-8 grid grid-cols-1 md:grid-cols-12 gap-12 items-center`}>
    <div class={`flex flex-col gap-4 ${flipped ? "md:col-start-7 md:col-span-6 md:row-start-1" : "md:col-span-5"}`}>
      <h2
        data-editable="text"
        data-prop="heading"
        class="text-2xl md:text-4xl font-bold leading-tight text-balance text-neutral-900 dark:text-neutral-100">
        {heading}
      </h2>
      <div class="prose text-neutral-600 dark:text-neutral-300">
        <Markdown
          content={text_content}
          dataProp="text_content"
          dataType="block"
        />
      </div>
      {
        button?.link && (
          <a
            href={button.link}
            class="mt-2 inline-flex items-center justify-center w-fit rounded-[var(--radius-sm)] bg-brand dark:bg-accent-dark px-6 py-3 text-white font-medium hover:brightness-110 transition-colors shadow-sm focus-visible:outline-neutral-900 dark:focus-visible:outline-neutral-100">
            <span data-editable="text" data-prop="button.text">
              {button.text}
            </span>
          </a>
        )
      }
    </div>
    {
      image.image_path && image.alt_text && (
        <div class={`w-full h-full min-h-[300px] ${flipped ? "md:col-start-1 md:col-span-5 md:row-start-1" : "md:col-span-7"}`}>
          <Picture
            data-editable="image"
            data-prop-src="image.image_path"
            data-prop-alt="image.alt_text"
            alt={image.alt_text}
            src={imageSrc}
            class="w-full h-full object-cover rounded-none"
            loading="lazy"
            widths={[600, 800, 1200]}
            sizes="(max-width: 1200px) 100vw, 600px"
            formats={["avif", "webp"]}
          />
        </div>
      )
    }
  </div>
</section>
