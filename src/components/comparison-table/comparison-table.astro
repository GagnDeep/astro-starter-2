---
import Markdown from "../utility/markdown.astro";
import { Check, X } from "@lucide/astro";

interface Row {
  feature: string;
  our_tool: boolean | string;
  competitor: boolean | string;
}

interface Props {
  heading: string;
  subheading?: string;
  our_tool_name: string;
  competitor_name: string;
  rows: Row[];
}

const { heading, subheading, our_tool_name, competitor_name, rows } = Astro.props;
---

<section class="py-12 md:py-24">
  <div class="mx-auto max-w-5xl px-8">
    <div class="mb-10 text-center mx-auto max-w-2xl">
      <h2 data-editable="text" data-prop="heading" class="text-3xl md:text-5xl font-bold mb-4 text-balance">
        {heading}
      </h2>
      {subheading && (
        <div class="text-lg text-[var(--text-muted)]">
          <Markdown content={subheading} dataProp="subheading" dataType="block" />
        </div>
      )}
    </div>

    <div class="overflow-x-auto border-t border-l border-r border-[var(--border-color)]">
      <table class="w-full text-left border-collapse min-w-[600px]">
        <thead>
          <tr class="bg-[var(--bg-elevated)] border-b border-[var(--border-color)]">
            <th class="p-4 font-bold border-r border-[var(--border-color)] w-1/3">Feature</th>
            <th data-editable="text" data-prop="our_tool_name" class="p-4 font-bold text-[var(--accent-color)] border-r border-[var(--border-color)] w-1/3">
              {our_tool_name}
            </th>
            <th data-editable="text" data-prop="competitor_name" class="p-4 font-bold w-1/3 text-[var(--text-muted)]">
              {competitor_name}
            </th>
          </tr>
        </thead>
        <tbody data-editable="array" data-prop="rows">
          {rows.map((row, i) => (
            <tr data-editable="array-item" class="border-b border-[var(--border-color)]">
              <td data-editable="text" data-prop={`rows[${i}].feature`} class="p-4 font-medium border-r border-[var(--border-color)]">
                {row.feature}
              </td>
              <td class="p-4 border-r border-[var(--border-color)] bg-[var(--bg-surface)]">
                {typeof row.our_tool === "boolean" ? (
                  row.our_tool ? <Check class="h-6 w-6 text-[var(--accent-color)] stroke-[1.5]" /> : <X class="h-6 w-6 text-[var(--text-muted)] stroke-[1.5]" />
                ) : (
                  <span data-editable="text" data-prop={`rows[${i}].our_tool`} class="font-bold">{row.our_tool}</span>
                )}
              </td>
              <td class="p-4">
                {typeof row.competitor === "boolean" ? (
                  row.competitor ? <Check class="h-6 w-6 text-[var(--text-muted)] stroke-[1.5]" /> : <X class="h-6 w-6 text-[var(--text-muted)] stroke-[1.5]" />
                ) : (
                  <span data-editable="text" data-prop={`rows[${i}].competitor`} class="text-[var(--text-muted)]">{row.competitor}</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
