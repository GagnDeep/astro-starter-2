---
import Markdown from "../utility/markdown.astro";
import { Check, X } from "@lucide/astro";

interface Props {
  heading?: string;
  subheading?: string;
  columns: string[];
  rows: {
    label: string;
    values: string[];
  }[];
}

const { heading, subheading, columns = [], rows = [] } = Astro.props;
---

<section class="py-16 md:py-24 bg-bg-color reveal-on-scroll">
  <div class="mx-auto max-w-5xl px-8">
    {(heading || subheading) && (
      <div class="mb-12 max-w-3xl">
        {heading && (
          <h2 data-editable="text" data-prop="heading" class="text-balance mb-4">
            {heading}
          </h2>
        )}
        {subheading && (
          <div class="text-text-muted text-lg">
            <Markdown content={subheading} dataProp="subheading" dataType="block" />
          </div>
        )}
      </div>
    )}

    {columns.length > 0 && rows.length > 0 && (
      <div class="overflow-x-auto rounded-xl border border-border-color shadow-sm bg-surface-color">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-surface-color border-b border-border-color" data-editable="array" data-prop="columns">
              <th class="p-4 md:p-6 font-medium text-text-color min-w-[150px]">Feature</th>
              {columns.map((col, i) => (
                <th class="p-4 md:p-6 font-medium text-text-color min-w-[120px]" data-editable="array-item">
                  <span data-editable="text" data-prop={`columns[${i}]`}>{col}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-border-color" data-editable="array" data-prop="rows">
            {rows.map((row, rowIndex) => (
              <tr class="hover:bg-bg-color/50 transition-colors duration-150" data-editable="array-item">
                <td class="p-4 md:p-6 text-sm md:text-base font-medium text-text-color">
                  <span data-editable="text" data-prop={`rows[${rowIndex}].label`}>{row.label}</span>
                </td>
                {columns.map((_, colIndex) => {
                  const val = row.values[colIndex] || "";
                  const isCheck = val.toLowerCase() === "yes" || val.toLowerCase() === "true";
                  const isCross = val.toLowerCase() === "no" || val.toLowerCase() === "false";

                  return (
                    <td class="p-4 md:p-6 text-sm md:text-base text-text-muted">
                      {isCheck ? (
                        <Check class="w-5 h-5 text-green-600" aria-label="Yes" stroke-width="2" />
                      ) : isCross ? (
                        <X class="w-5 h-5 text-red-600" aria-label="No" stroke-width="2" />
                      ) : (
                        <span data-editable="text" data-prop={`rows[${rowIndex}].values[${colIndex}]`}>{val}</span>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>
</section>
