---
export interface Props {
  heading?: string;
  columns?: string[];
  rows?: {
    label: string;
    values: string[];
  }[];
}

const { heading, columns = [], rows = [] } = Astro.props;
---

<div class="py-16 md:py-24 border-t border-[var(--color-border)] overflow-x-auto">
  {heading && <h2 class="mb-8">{heading}</h2>}

  <table class="w-full border-collapse text-left whitespace-nowrap">
    <thead>
      <tr class="border-b-2 border-[var(--color-text-base)]">
        <th class="p-4 font-bold bg-[var(--color-surface-raised)]">Feature</th>
        {columns.map(col => (
          <th class="p-4 font-bold bg-[var(--color-surface-raised)]">{col}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map(row => (
        <tr class="border-b border-[var(--color-border)]">
          <td class="p-4 font-medium">{row.label}</td>
          {row.values.map(val => (
            <td class="p-4 text-[var(--color-text-muted)]">{val}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
