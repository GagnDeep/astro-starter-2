---
export interface Props {
  heading?: string;
  headers: string[];
  rows: {
    cells: string[];
  }[];
}

const { heading, headers, rows } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 sm:px-8 py-16 overflow-x-auto">
  {heading && <h2 class="text-3xl font-bold mb-8">{heading}</h2>}
  <table class="w-full min-w-3xl text-left border-collapse border border-[var(--border-color)] bg-[var(--surface-color)]">
    <thead class="bg-[var(--color-neutral-100)]">
      <tr>
        {headers?.map((header) => (
          <th class="p-4 border-b border-[var(--border-color)] font-bold text-lg">{header}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows?.map((row) => (
        <tr class="even:bg-[var(--color-neutral-50)]">
          {row.cells?.map((cell, i) => (
            <td class={`p-4 border-b border-[var(--border-color)] ${i === 0 ? 'font-bold' : ''}`}>{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</section>
