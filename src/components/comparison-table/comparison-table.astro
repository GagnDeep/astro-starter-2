---
export interface Props {
  heading?: string;
  competitors: string[];
  features: {
    name: string;
    values: string[];
  }[];
}

const { heading, competitors = [], features = [] } = Astro.props;
---
<section class="border-b-2 border-(--border-color) bg-(--bg-surface) py-16 lg:py-24" data-component="ComparisonTable">
  <div class="mx-auto max-w-7xl px-8">
    {heading && <h2 class="mb-12 reveal text-4xl">{heading}</h2>}

    <div class="overflow-x-auto border-2 border-(--border-color) bg-white">
      <table class="w-full text-left min-w-[800px] border-collapse">
        <thead>
          <tr class="bg-(--color-neutral-100) border-b-2 border-(--border-color)">
            <th class="p-6 border-r-2 border-(--border-color) text-lg w-1/3">Feature</th>
            {competitors.map(comp => (
              <th class="p-6 border-r-2 border-(--border-color) last:border-r-0 font-mono text-center">
                {comp}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {features.map((feature) => (
            <tr class="border-b-2 border-(--border-color) last:border-b-0 hover:bg-(--color-neutral-50) transition-colors">
              <td class="p-6 border-r-2 border-(--border-color) font-semibold">{feature.name}</td>
              {feature.values.map((val) => (
                <td class="p-6 border-r-2 border-(--border-color) last:border-r-0 text-center font-mono">
                  {val === 'true' || val === 'Yes' || val === '✓' ? (
                    <span class="text-(--color-brand) font-bold text-xl">✓</span>
                  ) : val === 'false' || val === 'No' || val === '✗' ? (
                    <span class="text-(--text-muted)">—</span>
                  ) : (
                    val
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
