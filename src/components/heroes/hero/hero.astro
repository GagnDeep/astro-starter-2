---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../../utility/markdown.astro";
import CaptureForm from "../../forms/capture-form.astro";
import { capture } from "../../../../capture.config";

interface Props {
  heading: string;
  subheading: string;
  image?: {
    image_path: string;
    alt_text: string;
  };
  button?: {
    text: string;
    link: string;
  };
  show_eligibility_form?: boolean;
}

const { heading, subheading, image, button, show_eligibility_form } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = image?.image_path ? (allImages[image.image_path]?.default ?? image.image_path) : null;
---

<section class="py-16 md:py-24 bg-[var(--color-bg)]">
  <div class="mx-auto max-w-6xl px-8 flex flex-col md:flex-row items-center gap-12">
    <div class="flex-1 flex flex-col gap-6">
      <h1
        data-editable="text"
        data-prop="heading"
        class="text-4xl md:text-5xl font-heading font-bold leading-tight text-balance text-[var(--color-primary)]">
        {heading}
      </h1>
      <div class="text-lg text-[var(--color-text)] max-w-prose">
        <Markdown content={subheading} dataProp="subheading" dataType="block" />
      </div>

      {show_eligibility_form ? (
        <div class="mt-4 p-6 bg-white border border-gray-200 shadow-sm rounded-lg max-w-md">
          <h3 class="text-xl font-heading font-semibold mb-2">Check IRS Free File Eligibility</h3>
          <p class="text-sm text-gray-600 mb-4">Find out if you qualify to file your taxes for absolutely free.</p>
          <CaptureForm form={capture.forms.eligibility} submitLabel="Check Eligibility" class="flex flex-col gap-4">
            <div>
              <label for="agi" class="block text-sm font-medium text-gray-700">Estimated Adjusted Gross Income (AGI)</label>
              <input type="number" name="agi" id="agi" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[var(--color-primary)] focus:ring-[var(--color-primary)] sm:text-sm p-2 border" placeholder="e.g. 50000" />
            </div>
            <div>
              <label for="age" class="block text-sm font-medium text-gray-700">Age</label>
              <input type="number" name="age" id="age" required class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[var(--color-primary)] focus:ring-[var(--color-primary)] sm:text-sm p-2 border" placeholder="e.g. 35" />
            </div>
            <div>
              <label for="state" class="block text-sm font-medium text-gray-700">State of Residence</label>
              <select name="state" id="state" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-[var(--color-primary)] focus:ring-[var(--color-primary)] sm:text-sm p-2 border" required>
                <option value="">Select a state...</option>
                <option value="CA">California</option>
                <option value="NY">New York</option>
                <option value="TX">Texas</option>
                <option value="FL">Florida</option>
                <option value="OTHER">Other</option>
              </select>
            </div>
          </CaptureForm>
        </div>
      ) : button?.link && (
        <a
          href={button.link}
          class="mt-2 inline-block w-fit rounded-lg bg-[var(--color-secondary)] px-8 py-4 text-white font-medium hover:opacity-90 transition-opacity text-lg">
          <span data-editable="text" data-prop="button.text">
            {button.text}
          </span>
        </a>
      )}
    </div>

    {
      imageSrc && image?.alt_text && !show_eligibility_form && (
        <div class="flex-1">
          <Picture
            data-editable="image"
            data-prop-src="image.image_path"
            data-prop-alt="image.alt_text"
            alt={image.alt_text}
            src={imageSrc}
            class="w-full max-w-lg shadow-xl rounded-lg"
            loading="eager"
            widths={[600, 800, 1200]}
            sizes="(max-width: 1200px) 100vw, 600px"
            formats={["avif", "webp"]}
          />
        </div>
      )
    }
  </div>
</section>
