---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../../utility/markdown.astro";

interface Props {
  heading: string;
  subheading: string;
  image: {
    image_path: string;
    alt_text: string;
  };
  button?: {
    text: string;
    link: string;
  };
}

const { heading, subheading, image, button } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = allImages[image.image_path]?.default ?? image.image_path;
const isRemoteImage = typeof imageSrc === "string";
const imageWidth = isRemoteImage ? 1200 : undefined;
const imageHeight = isRemoteImage ? 800 : undefined;
---

<section class="py-16 md:py-24 bg-[var(--bg-color)]">
  <div class="mx-auto max-w-6xl px-8 flex flex-col md:flex-row items-center gap-12 lg:gap-16">
    <div class="flex-1 flex flex-col gap-6 md:w-[60%] lg:w-[65%] shrink-0">
      <h1 data-editable="text" data-prop="heading" class="text-balance text-5xl lg:text-7xl">
        {heading}
      </h1>
      <div class="text-xl max-w-prose text-gray-700 dark:text-gray-300">
        <Markdown content={subheading} dataProp="subheading" dataType="block" />
      </div>
      {
        button?.link && (
          <a
            href={button.link}
            class="mt-4 inline-flex w-fit items-center justify-center rounded-none bg-[var(--color-brand-500)] px-8 py-4 text-white font-medium hover:bg-[var(--color-brand-600)] transition-colors text-lg"
          >
            <span data-editable="text" data-prop="button.text">
              {button.text}
            </span>
          </a>
        )
      }
    </div>
    {
      image.image_path && image.alt_text && (
        <div class="w-full md:w-[40%] lg:w-[35%]">
          <Picture
            data-editable="image"
            data-prop-src="image.image_path"
            data-prop-alt="image.alt_text"
            alt={image.alt_text}
            src={imageSrc}
            inferSize={isRemoteImage ? undefined : false}
            width={imageWidth}
            height={imageHeight}
            class="w-full h-auto aspect-square object-cover grayscale mix-blend-multiply dark:mix-blend-screen"
            loading="eager"
            widths={[600, 800, 1200]}
            sizes="(max-width: 1200px) 100vw, 600px"
            formats={["avif", "webp"]}
          />
        </div>
      )
    }
  </div>
</section>
