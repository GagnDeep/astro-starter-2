---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../../utility/markdown.astro";

interface Props {
  heading: string;
  subheading: string;
  image: {
    image_path: string;
    alt_text: string;
  };
  button?: {
    text: string;
    link: string;
  };
}

const { heading, subheading, image, button } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = allImages[image.image_path]?.default ?? image.image_path;
---

<section class="py-16 md:py-24 border-b-4 border-neutral-900 bg-brand-100/10">
  <div
    class="mx-auto max-w-6xl px-8 grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
    <div class="md:col-span-7 flex flex-col gap-6">
      <h1
        data-editable="text"
        data-prop="heading"
        class="text-neutral-900 text-balance uppercase tracking-tight">
        {heading}
      </h1>
      <div class="text-xl text-neutral-800 max-w-prose font-bold">
        <Markdown content={subheading} dataProp="subheading" dataType="block" />
      </div>
      {
        button?.link && (
          <a
            href={button.link}
            class="mt-4 inline-block w-fit bg-brand-500 px-8 py-4 text-white font-bold uppercase tracking-tight hover:bg-brand-900 transition-colors border-2 border-neutral-900 shadow-md hover:shadow-sm translate-y-0 hover:translate-y-1">
            <span data-editable="text" data-prop="button.text">
              {button.text}
            </span>
          </a>
        )
      }
    </div>
    {
      image.image_path && image.alt_text && (
        <div class="md:col-span-5 border-4 border-neutral-900 p-2 bg-white shadow-lg rotate-1">
          <Picture
            data-editable="image"
            data-prop-src="image.image_path"
            data-prop-alt="image.alt_text"
            alt={image.alt_text}
            src={imageSrc}
            class="w-full h-auto grayscale hover:grayscale-0 transition-all duration-300"
            loading="eager"
            widths={[600, 800, 1200]}
            sizes="(max-width: 1200px) 100vw, 600px"
            formats={["avif", "webp"]}
          />
        </div>
      )
    }
  </div>
</section>
