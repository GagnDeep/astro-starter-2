---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../../utility/markdown.astro";
import NewsletterForm from "../../forms/newsletter-form.astro";
import { capture } from "../../../../capture.config";

interface Props {
  heading: string;
  subheading: string;
  image: {
    image_path: string;
    alt_text: string;
  };
  button?: {
    text: string;
    link: string;
  };
}

const { heading, subheading, image, button } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = allImages[image.image_path]?.default ?? image.image_path;
---

<section class="py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-8 flex flex-col md:flex-row items-center gap-8">
    <div class="flex-1 flex flex-col gap-6">
      <h1
        data-editable="text"
        data-prop="heading"
        class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight text-slate-900 text-balance"
      >
        {heading}
      </h1>
      <div class="text-lg text-slate-600 max-w-prose">
        <Markdown content={subheading} dataProp="subheading" dataType="block" />
      </div>

      <div class="mt-4 p-6 bg-slate-50 rounded-xl border border-slate-200">
        <h3 class="font-semibold text-lg text-slate-900 mb-2">Join the Waitlist</h3>
        <p class="text-slate-600 text-sm mb-4">
          Be the first to know when full courses launch. Get practical AI insights weekly.
        </p>
        <NewsletterForm form={capture.forms.waitlist} submitLabel="Join Waitlist" />
      </div>
    </div>
    {
      image.image_path && image.alt_text && (
        <div class="flex-1">
          <Picture
            data-editable="image"
            data-prop-src="image.image_path"
            data-prop-alt="image.alt_text"
            alt={image.alt_text}
            src={imageSrc}
            class="w-full max-w-lg mx-auto drop-shadow-xl rounded-2xl border border-slate-200 object-cover"
            loading="eager"
            widths={[600, 800, 1200]}
            sizes="(max-width: 1200px) 100vw, 600px"
            formats={["avif", "webp"]}
          />
        </div>
      )
    }
  </div>
</section>
