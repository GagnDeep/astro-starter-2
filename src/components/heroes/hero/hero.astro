---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../../utility/markdown.astro";

interface Props {
  heading: string;
  subheading: string;
  image: {
    image_path: string;
    alt_text: string;
  };
  button?: {
    text: string;
    link: string;
  };
}

const { heading, subheading, image, button } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = allImages[image.image_path]?.default ?? image.image_path;
---

<section class="py-16 md:py-24 border-b border-border">
  <div class="mx-auto max-w-6xl px-8 grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
    <!-- Asymmetric Hero: text spans 7 columns, image spans 5 -->
    <div class="md:col-span-7 flex flex-col gap-6">
      <h1
        data-editable="text"
        data-prop="heading"
        class="text-display font-bold text-neutral-900 dark:text-neutral-50">
        {heading}
      </h1>
      <div class="text-lg text-neutral-700 dark:text-neutral-300 max-w-[65ch]">
        <Markdown content={subheading} dataProp="subheading" dataType="block" />
      </div>
      {
        button?.link && (
          <a
            href={button.link}
            class="mt-4 inline-flex w-fit items-center justify-center rounded-sm bg-brand-700 px-8 py-3 text-white font-semibold hover:bg-brand-600 transition-colors shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500">
            <span data-editable="text" data-prop="button.text">
              {button.text}
            </span>
          </a>
        )
      }
    </div>
    {
      image.image_path && image.alt_text && (
        <div class="md:col-span-5 w-full">
          <Picture
            data-editable="image"
            data-prop-src="image.image_path"
            data-prop-alt="image.alt_text"
            alt={image.alt_text}
            src={imageSrc}
            class="w-full h-auto object-cover rounded-sm shadow-md"
            loading="eager"
            widths={[600, 800]}
            sizes="(max-width: 768px) 100vw, 40vw"
            formats={["avif", "webp"]}
          />
        </div>
      )
    }
  </div>
</section>
