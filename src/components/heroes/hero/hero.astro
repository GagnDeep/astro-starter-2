---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../../utility/markdown.astro";

interface Props {
  heading: string;
  subheading: string;
  image: {
    image_path: string;
    alt_text: string;
  };
  button?: {
    text: string;
    link: string;
  };
}

const { heading, subheading, image, button } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = allImages[image.image_path]?.default ?? image.image_path;
---

<section class="py-16 md:py-24 border-b-2 border-[var(--border-color)] bg-[var(--surface-color)]">
  <div class="mx-auto max-w-6xl px-8 flex flex-col md:flex-row items-center gap-12 lg:gap-24">
    <div class="flex-1 flex flex-col gap-6 md:w-3/5 reveal">
      <h1
        data-editable="text"
        data-prop="heading"
        class="text-[color:var(--text-color)] text-balance m-0">
        {heading}
      </h1>
      <div class="text-xl max-w-prose opacity-90 m-0">
        <Markdown content={subheading} dataProp="subheading" dataType="block" />
      </div>
      {
        button?.link && (
          <a
            href={button.link}
            class="mt-4 inline-block w-fit bg-[var(--accent-color)] text-white border-2 border-[var(--border-color)] shadow-sm hover:shadow-md transition-shadow px-8 py-4 font-bold focus-visible:outline-offset-4">
            <span data-editable="text" data-prop="button.text">
              {button.text}
            </span>
          </a>
        )
      }
    </div>
    {
      image.image_path && image.alt_text && (
        <div class="w-full md:w-2/5 border-2 border-[var(--border-color)] shadow-md bg-[var(--bg-color)] reveal" style="animation-delay: 200ms;">
          <Picture
            data-editable="image"
            data-prop-src="image.image_path"
            data-prop-alt="image.alt_text"
            alt={image.alt_text}
            src={imageSrc}
            class="w-full h-auto object-cover grayscale opacity-90"
            loading="eager"
            widths={[600, 800]}
            sizes="(max-width: 768px) 100vw, 40vw"
            formats={["avif", "webp"]}
          />
        </div>
      )
    }
  </div>
</section>
