---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../../utility/markdown.astro";

interface Props {
  heading: string;
  subheading: string;
  image: {
    image_path: string;
    alt_text: string;
  };
  button?: {
    text: string;
    link: string;
  };
}

const { heading, subheading, image, button } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = allImages[image.image_path]?.default ?? image.image_path;
---

<section class="py-16 md:py-24 bg-(--bg-color) overflow-hidden relative">
  <div
    class="mx-auto max-w-6xl px-8 flex flex-col md:flex-row items-center gap-12 lg:gap-24 relative z-10">
    <div class="flex-1 md:w-5/12 lg:w-4/12 flex flex-col gap-6 reveal reveal-active shrink-0">
      <h1
        data-editable="text"
        data-prop="heading"
        class="font-bold text-balance text-(--heading-color)">
        {heading}
      </h1>
      <div class="text-lg text-(--text-color) max-w-[45ch]">
        <Markdown content={subheading} dataProp="subheading" dataType="block" />
      </div>
      {
        button?.link && (
          <div class="pt-4">
            <a
              href={button.link}
              class="inline-block w-fit bg-(--color-brand-800) px-8 py-4 text-(--surface-color) font-medium hover:bg-(--color-brand-700) hover-transition focus-visible shadow-sm">
              <span data-editable="text" data-prop="button.text">
                {button.text}
              </span>
            </a>
          </div>
        )
      }
    </div>
    {
      image.image_path && image.alt_text && (
        <div class="flex-1 md:w-7/12 lg:w-8/12 w-full h-[50vh] md:h-auto min-h-[400px] md:min-h-[600px] relative reveal reveal-active overflow-hidden shadow-[var(--card-shadow)] bg-(--surface-color)">
          <Picture
            data-editable="image"
            data-prop-src="image.image_path"
            data-prop-alt="image.alt_text"
            alt={image.alt_text}
            src={imageSrc}
            class="absolute inset-0 w-full h-full object-cover block filter grayscale-[20%]"
            loading="eager"
            widths={[600, 800, 1200, 1600]}
            sizes="(max-width: 768px) 100vw, 66vw"
            formats={["avif", "webp"]}
          />
        </div>
      )
    }
  </div>

  {/* Ambient decorative element to support the editorial asymmetrical layout */}
  <div class="absolute right-0 top-0 w-1/3 h-full bg-(--surface-color) -z-10 hidden md:block"></div>
</section>
