---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../../utility/markdown.astro";
import CaptureForm from "../../forms/capture-form.astro";

interface Props {
  heading: string;
  subheading: string;
  image: {
    image_path: string;
    alt_text: string;
  };
  button?: {
    text: string;
    link: string;
  };
  capture_form?: boolean;
}

const { heading, subheading, image, button, capture_form } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = allImages[image.image_path]?.default ?? image.image_path;
---

<section class="py-[var(--spacing-section)] reveal reveal-visible">
  <div
    class="mx-auto max-w-6xl px-8 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
    <div class="col-span-1 md:col-span-7 flex flex-col gap-6">
      <h1
        data-editable="text"
        data-prop="heading"
        class="text-[var(--text-display-lg)] leading-[var(--text-display-lg-line-height)] tracking-[var(--text-display-lg-tracking)] font-bold text-balance text-neutral-900 dark:text-neutral-100">
        {heading}
      </h1>
      <div class="text-[1.25rem] text-neutral-600 dark:text-neutral-300 max-w-prose leading-relaxed">
        <Markdown content={subheading} dataProp="subheading" dataType="block" />
      </div>

      {capture_form ? (
        <div class="mt-4">
          <CaptureForm />
        </div>
      ) : button?.link ? (
        <a
          href={button.link}
          class="mt-2 inline-flex items-center justify-center w-fit rounded-[var(--radius-sm)] bg-brand dark:bg-accent-dark px-8 py-4 text-white font-medium hover:brightness-110 transition-all shadow-sm focus-visible:outline-neutral-900 dark:focus-visible:outline-neutral-100">
          <span data-editable="text" data-prop="button.text">
            {button.text}
          </span>
        </a>
      ) : null}
    </div>
    {
      image.image_path && image.alt_text && (
        <div class="col-span-1 md:col-span-5 w-full h-full min-h-[400px] relative">
          <Picture
            data-editable="image"
            data-prop-src="image.image_path"
            data-prop-alt="image.alt_text"
            alt={image.alt_text}
            src={imageSrc}
            class="w-full h-full object-cover rounded-none"
            loading="eager"
            widths={[600, 800, 1200]}
            sizes="(max-width: 1200px) 100vw, 600px"
            formats={["avif", "webp"]}
          />
        </div>
      )
    }
  </div>
</section>
