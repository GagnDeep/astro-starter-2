---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../../utility/markdown.astro";

interface Props {
  heading: string;
  subheading: string;
  image: {
    image_path: string;
    alt_text: string;
  };
  button?: {
    text: string;
    link: string;
  };
}

const { heading, subheading, image, button } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = allImages[image.image_path]?.default ?? image.image_path;
---

<section
  class="py-16 md:py-24 border-b-2 border-neutral-900 dark:border-neutral-700 overflow-hidden"
>
  <div class="mx-auto max-w-7xl px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
      <div class="md:col-span-7 flex flex-col gap-6 reveal-on-scroll">
        <h1
          data-editable="text"
          data-prop="heading"
          class="text-display-1 text-neutral-900 dark:text-neutral-50 text-balance"
        >
          {heading}
        </h1>
        <div class="text-body text-neutral-600 dark:text-neutral-300 max-w-prose">
          <Markdown content={subheading} dataProp="subheading" dataType="block" />
        </div>
        {
          button?.link && (
            <a
              href={button.link}
              class="mt-4 inline-block w-fit bg-orange-500 px-8 py-4 text-neutral-50 font-display font-semibold hover:bg-neutral-900 hover:text-orange-500 transition-colors shadow-brutal outline-none focus-visible:outline-2 focus-visible:outline-orange-500 focus-visible:outline-offset-4 dark:hover:bg-neutral-50 dark:hover:text-neutral-900"
            >
              <span data-editable="text" data-prop="button.text">
                {button.text}
              </span>
            </a>
          )
        }
      </div>
      {
        image.image_path && image.alt_text && (
          <div class="md:col-span-5 reveal-on-scroll" style="animation-delay: 150ms;">
            <div class="border-2 border-neutral-900 shadow-brutal dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800 p-2 transform rotate-1 md:rotate-2">
              <Picture
                data-editable="image"
                data-prop-src="image.image_path"
                data-prop-alt="image.alt_text"
                alt={image.alt_text}
                src={imageSrc}
                class="w-full h-auto aspect-square object-cover grayscale contrast-125 mix-blend-multiply dark:mix-blend-lighten"
                loading="eager"
                widths={[600, 800, 1200]}
                sizes="(max-width: 1200px) 100vw, 600px"
                formats={["avif", "webp"]}
              />
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
