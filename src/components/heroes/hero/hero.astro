---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../../utility/markdown.astro";

interface Props {
  heading: string;
  subheading: string;
  image: {
    image_path: string;
    alt_text: string;
  };
  button?: {
    text: string;
    link: string;
  };
}

const { heading, subheading, image, button } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = allImages[image?.image_path]?.default ?? image?.image_path;
---

<section class="py-[var(--spacing-section)] reveal is-visible">
  <div
    class="mx-auto max-w-6xl px-8 grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
    <div class="md:col-span-7 flex flex-col gap-6 order-2 md:order-1">
      <h1
        data-editable="text"
        data-prop="heading"
        class="text-[color:var(--color-brand-ink)] dark:text-[color:var(--color-brand-ink-dark)]">
        {heading}
      </h1>
      <div class="text-[color:var(--color-brand-ink)] dark:text-[color:var(--color-brand-ink-dark)] text-xl font-[family-name:var(--font-body)]">
        <Markdown content={subheading} dataProp="subheading" dataType="block" />
      </div>
      {
        button?.link && button?.text && button.text.trim() !== "" && (
          <div class="mt-4">
            <a href={button.link} class="brutal-btn">
              <span data-editable="text" data-prop="button.text">
                {button.text}
              </span>
            </a>
          </div>
        )
      }
    </div>
    {
      imageSrc && image?.alt_text && (
        <div class="md:col-span-5 order-1 md:order-2">
          <Picture
            data-editable="image"
            data-prop-src="image.image_path"
            data-prop-alt="image.alt_text"
            alt={image.alt_text}
            src={imageSrc}
            class="w-full border-2 border-[var(--color-brand-ink)] shadow-[var(--shadow-brutal)] dark:border-white/20 dark:shadow-[0_-1px_0_0_rgba(255,255,255,0.1)] object-cover aspect-square md:aspect-auto"
            loading="eager"
            widths={[600, 800, 1200]}
            sizes="(max-width: 1200px) 100vw, 600px"
            formats={["avif", "webp"]}
          />
        </div>
      )
    }
  </div>
</section>
