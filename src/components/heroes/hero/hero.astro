---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../../utility/markdown.astro";

interface Props {
  heading: string;
  subheading: string;
  image: {
    image_path: string;
    alt_text: string;
  };
  button?: {
    text: string;
    link: string;
  };
}

const { heading, subheading, image, button } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = allImages[image.image_path]?.default ?? image.image_path;
---

<section class="py-16 md:py-24">
  <div
    class="mx-auto max-w-6xl px-8 flex flex-col md:flex-row items-center gap-8">
    <div class="flex-[1.2] flex flex-col gap-6">
      <h1
        data-editable="text"
        data-prop="heading"
        class="font-bold leading-tight text-balance">
        {heading}
      </h1>
      <div class="text-lg text-[var(--text-muted)] max-w-prose">
        <Markdown content={subheading} dataProp="subheading" dataType="block" />
      </div>
      {
        button?.link && (
          <a
            href={button.link}
            class="mt-4 inline-block w-fit bg-[var(--color-brand-light)] px-8 py-4 text-[var(--color-neutral-950)] font-bold text-lg hover:bg-white hover:-translate-y-1 shadow-[var(--shadow-md)] hover:shadow-[var(--shadow-lg)] border border-[var(--border-color)] transition-all duration-200">
            <span data-editable="text" data-prop="button.text">
              {button.text}
            </span>
          </a>
        )
      }
    </div>
    {
      image.image_path && image.alt_text && (
        <div class="flex-[0.8]">
          <Picture
            data-editable="image"
            data-prop-src="image.image_path"
            data-prop-alt="image.alt_text"
            alt={image.alt_text}
            src={imageSrc}
            class="w-full h-auto border border-[var(--border-color)] shadow-[var(--shadow-md)]"
            loading="eager"
            widths={[600, 800, 1200]}
            sizes="(max-width: 1200px) 100vw, 600px"
            formats={["avif", "webp"]}
          />
        </div>
      )
    }
  </div>
</section>
