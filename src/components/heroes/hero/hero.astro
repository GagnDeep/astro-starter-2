---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../../utility/markdown.astro";

interface Props {
  heading: string;
  subheading: string;
  image?: {
    image_path: string;
    alt_text: string;
  };
  button?: {
    text: string;
    link: string;
  };
}

const { heading, subheading, image, button } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = image?.image_path ? (allImages[image.image_path]?.default ?? image.image_path) : "";
---

<section class="border-b-2 border-(--border-color) bg-(--bg-surface) overflow-hidden relative" data-component="Hero">
  <div class="mx-auto max-w-7xl px-8 flex flex-col md:flex-row items-center gap-8 min-h-[70vh]">
    <div class="lg:col-span-7 flex flex-col justify-center px-8 py-16 lg:py-24 z-10 border-r-2 border-(--border-color)">
      <h1
        data-editable="text"
        data-prop="heading"
        class="display-title mb-6 reveal text-(--text-main)">
        {heading}
      </h1>
      <div class="text-xl md:text-2xl text-(--text-muted) mb-10 max-w-2xl reveal font-mono">
        <Markdown content={subheading} dataProp="subheading" dataType="block" />
      </div>
      {
        button?.link && (
          <a
            href={button.link}
            class="brutal-button text-lg px-8 py-4">
            <span data-editable="text" data-prop="button.text">
              {button.text}
            </span>
          </a>
        )
      }
    </div>
    {
      image?.image_path && image?.alt_text && (
        <div class="flex-1">
          <Picture
            data-editable="image"
            data-prop-src="image.image_path"
            data-prop-alt="image.alt_text"
            alt={image.alt_text}
            src={imageSrc}
            class="w-full max-w-lg"
            loading="eager"
            widths={[600, 800, 1200]}
            sizes="(max-width: 1200px) 100vw, 600px"
            formats={["avif", "webp"]}
          />
        </div>
      )
    }
  </div>
</section>
