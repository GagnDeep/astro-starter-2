---
export interface Props {
  heading?: string;
  subheading?: string;
  primary_cta_text?: string;
  primary_cta_link?: string;
  image?: string;
  image_alt?: string;
}

const {
  heading = "Default Heading",
  subheading = "Default Subheading",
  primary_cta_text,
  primary_cta_link,
  image,
  image_alt = "",
} = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-12 gap-8 py-16 md:py-24 items-center">
  {/* Asymmetric layout: text gets 7 columns, image gets 5 columns */}
  <div class="md:col-span-7 flex flex-col items-start space-y-6">
    <h1 class="text-balance">{heading}</h1>
    {subheading && <p class="text-text-muted max-w-[65ch]">{subheading}</p>}
    {primary_cta_text && primary_cta_link && (
      <a
        href={primary_cta_link}
        class="inline-block px-6 py-3 bg-[var(--color-brand-600)] text-white font-medium hover:bg-[var(--color-brand-700)] hover-transition shadow-sm"
      >
        {primary_cta_text}
      </a>
    )}
  </div>

  {image && (
    <div class="md:col-span-5 h-full">
      <img
        src={image}
        alt={image_alt}
        class="w-full h-full object-cover shadow-md border border-[var(--color-border)]"
      />
    </div>
  )}
</div>
