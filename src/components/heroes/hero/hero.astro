---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import Markdown from "../../utility/markdown.astro";

interface Props {
  heading: string;
  subheading: string;
  image: {
    image_path: string;
    alt_text: string;
  };
  button?: {
    text: string;
    link: string;
  };
}

const { heading, subheading, image, button } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
const imageSrc = allImages[image.image_path]?.default ?? image.image_path;
---

<section class="py-16 md:py-24 border-b-2 border-[var(--border-color)]">
  <div
    class="mx-auto max-w-6xl px-8 grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
    <div class="md:col-span-7 flex flex-col gap-6 reveal">
      <h1
        data-editable="text"
        data-prop="heading"
        class="text-4xl md:text-5xl lg:text-6xl font-bold leading-none text-[var(--text-color)] text-balance">
        {heading}
      </h1>
      <div class="text-xl md:text-2xl text-[var(--text-color)] max-w-prose font-sans">
        <Markdown content={subheading} dataProp="subheading" dataType="block" />
      </div>
      {
        button?.link && (
          <div class="mt-4">
            <a
              href={button.link}
              class="brutal-button focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--focus-ring)]">
              <span data-editable="text" data-prop="button.text">
                {button.text}
              </span>
            </a>
          </div>
        )
      }
    </div>
    {
      image.image_path && image.alt_text && (
        <div class="md:col-span-5 reveal" style="transition-delay: 150ms;">
          <div class="brutal-border brutal-shadow bg-[var(--surface-color)] p-2">
            <Picture
              data-editable="image"
              data-prop-src="image.image_path"
              data-prop-alt="image.alt_text"
              alt={image.alt_text}
              src={imageSrc}
              class="w-full h-auto aspect-square object-cover"
              loading="eager"
              widths={[600, 800, 1200]}
              sizes="(max-width: 1200px) 100vw, 600px"
              formats={["avif", "webp"]}
            />
          </div>
        </div>
      )
    }
  </div>
</section>
