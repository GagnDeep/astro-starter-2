---
import NewsletterForm from "../forms/newsletter-form.astro";

export interface Props {
  heading: string;
  description?: string;
  primary_button_text?: string;
  primary_button_link?: string;
  secondary_button_text?: string;
  secondary_button_link?: string;
  show_form?: boolean;
}

const { heading, description, primary_button_text, primary_button_link, secondary_button_text, secondary_button_link, show_form } = Astro.props;
---

<section class="py-16 md:py-24 bg-brand-900 text-neutral-50" data-editable="cta-band">
  <div class="mx-auto max-w-4xl px-4 sm:px-8 text-center scroll-reveal">
    <h2 class="text-white mb-6 font-bold">{heading}</h2>
    {description && <p class="text-brand-100 mb-10 text-lg max-w-2xl mx-auto">{description}</p>}

    {show_form ? (
      <div class="max-w-md mx-auto">
        <NewsletterForm />
      </div>
    ) : (
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        {primary_button_text && primary_button_link && (
          <a href={primary_button_link} class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3 bg-accent-600 text-white font-medium rounded-sm hover:bg-accent-700 transition-colors focus-visible shadow-md">
            {primary_button_text}
          </a>
        )}

        {secondary_button_text && secondary_button_link && (
          <a href={secondary_button_link} class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3 bg-transparent border-2 border-brand-700 text-white font-medium rounded-sm hover:bg-brand-800 transition-colors focus-visible">
            {secondary_button_text}
          </a>
        )}
      </div>
    )}
  </div>
</section>
