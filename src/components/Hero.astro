---
import CaptureForm from "./forms/capture-form.astro";

interface Props {
  title: string;
  description: string;
  includeForm?: boolean;
}
const { title, description, includeForm = false } = Astro.props;
---
<section class="bg-surface py-20 px-4 text-center border-b border-secondary">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-4xl md:text-5xl font-bold text-primary mb-6 text-balance">{title}</h1>
    <p class="text-xl md:text-2xl text-text max-w-2xl mx-auto text-pretty mb-8">{description}</p>

    {includeForm && (
      <div class="max-w-md mx-auto mt-8 bg-bg p-6 rounded-lg border border-secondary shadow-sm">
        <h3 class="text-lg font-semibold mb-4">Start optimizing your wealth today</h3>
        <CaptureForm form="newsletter" submitLabel="Get Started">
          <input type="email" name="email" required placeholder="Enter your email" class="w-full px-3 py-2 border border-secondary rounded mb-4" />
        </CaptureForm>
      </div>
    )}
  </div>
</section>
