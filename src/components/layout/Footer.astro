---
import NewsletterForm from "../forms/newsletter-form.astro";
import { capture } from "../../../capture.config";
---
<footer class="border-t border-border bg-surface py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-4">
      <div>
        <a href="/" class="text-xl font-bold tracking-tight text-text mb-4 block">UPlayVideo</a>
        <p class="text-sm text-secondary mb-6">The privacy-first, lightning-fast in-browser video player and converter. No uploads, no waiting.</p>
        <NewsletterForm form={capture.forms.newsletter} class="w-full" />
      </div>
      <div>
        <h3 class="font-semibold mb-4 text-text">Tools</h3>
        <ul class="space-y-2 text-sm text-secondary">
          <li><a href="/" class="hover:text-primary">Online Video Converter</a></li>
          <li><a href="/" class="hover:text-primary">Online Video Player</a></li>
          <li><a href="/calculators/video-file-size" class="hover:text-primary">File Size Calculator</a></li>
          <li><a href="/calculators/bitrate-calculator" class="hover:text-primary">Bitrate Calculator</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-semibold mb-4 text-text">Learn</h3>
        <ul class="space-y-2 text-sm text-secondary">
          <li><a href="/reference/" class="hover:text-primary">Video Codecs Reference</a></li>
          <li><a href="/formats/" class="hover:text-primary">Format Support</a></li>
          <li><a href="/glossary/" class="hover:text-primary">Glossary</a></li>
          <li><a href="/blog/" class="hover:text-primary">Blog</a></li>
        </ul>
      </div>
      <div>
        <h3 class="font-semibold mb-4 text-text">Company</h3>
        <ul class="space-y-2 text-sm text-secondary">
          <li><a href="/about" class="hover:text-primary">About</a></li>
          <li><a href="/faq" class="hover:text-primary">FAQ</a></li>
          <li><a href="/contact" class="hover:text-primary">Contact</a></li>
          <li><a href="/legal/privacy" class="hover:text-primary">Privacy Policy</a></li>
          <li><a href="/legal/terms" class="hover:text-primary">Terms of Service</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 border-t border-border pt-8 text-sm text-secondary flex flex-col md:flex-row justify-between items-center">
      <p>&copy; {new Date().getFullYear()} UPlayVideo. All rights reserved.</p>
    </div>
  </div>
</footer>
