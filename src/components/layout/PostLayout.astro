---
import Layout from "../../layouts/Layout.astro";
import CaptureForm from "../forms/capture-form.astro";

const { frontmatter } = Astro.props;
---

<Layout
  title={frontmatter.title}
  seo={frontmatter.seo}
  post_hero={{ date: frontmatter.date }}
>
  <article class="max-w-3xl mx-auto py-20 px-4 md:px-8 prose">
    <h1 class="text-4xl font-bold mb-4">{frontmatter.title}</h1>
    <div class="text-text-muted mb-8">{new Date(frontmatter.date).toLocaleDateString()}</div>

    <slot />

    <hr class="my-12" />

    <div class="bg-surface-alt p-8 rounded-lg border border-border mt-12">
      <h3 class="text-2xl font-bold mb-4 not-prose">Stop reading. Start signing.</h3>
      <p class="mb-6 not-prose text-text-muted">Join thousands of small businesses closing deals faster with usignpdf.</p>
      <CaptureForm form="post" class="not-prose" submitLabel="Get Started Free">
        <div class="mb-4">
          <label class="block text-sm font-medium mb-1" for="post-email">Your Email</label>
          <input type="email" id="post-email" name="email" required class="w-full px-4 py-2 border border-border rounded focus:outline-none focus:ring-2 focus:ring-focus" placeholder="you@example.com" />
        </div>
      </CaptureForm>
    </div>
  </article>
</Layout>
