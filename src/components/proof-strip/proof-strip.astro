---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Logo {
  image_path: string;
  alt_text: string;
}

interface Props {
  heading?: string;
  logos: Logo[];
}

const { heading, logos = [] } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
---

<section class="py-12 border-b-2 border-[var(--border-color)] bg-[var(--surface-color)]">
  <div class="mx-auto max-w-6xl px-8 reveal">
    {heading && (
      <h3 data-editable="text" data-prop="heading" class="text-center text-sm font-bold uppercase tracking-widest text-[var(--text-color)] opacity-70 mb-8 font-sans">
        {heading}
      </h3>
    )}

    <div data-editable="array" data-prop="logos" class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-70 grayscale hover:grayscale-0 transition-all duration-300">
      {logos.map((logo) => {
        const imageSrc = allImages[logo.image_path]?.default ?? logo.image_path;
        return (
          <div data-editable="array-item" class="w-32 md:w-40 flex items-center justify-center">
            {logo.image_path && logo.alt_text && (
              <Picture
                data-editable="image"
                data-prop-src="logos[].image_path"
                data-prop-alt="logos[].alt_text"
                alt={logo.alt_text}
                src={imageSrc}
                class="w-full h-auto object-contain max-h-12"
                widths={[200, 400]}
                sizes="(max-width: 400px) 200px, 400px"
              />
            )}
          </div>
        );
      })}
    </div>
  </div>
</section>
