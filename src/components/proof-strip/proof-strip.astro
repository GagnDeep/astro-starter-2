---
export interface Props {
  text: string;
  logos: { image: string; alt: string }[];
}

const { text, logos } = Astro.props;
---

<section class="border-y border-[var(--border-color)] bg-[var(--surface-color)] py-8">
  <div class="mx-auto max-w-6xl px-4 sm:px-8 text-center">
    {text && <p class="text-sm font-bold uppercase tracking-wider text-[var(--color-neutral-600)] mb-6">{text}</p>}
    <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-60 grayscale hover:grayscale-0 transition-all duration-200">
      {logos?.map((logo) => (
        <img src={logo.image} alt={logo.alt} class="h-8 md:h-10 w-auto object-contain" />
      ))}
    </div>
  </div>
</section>
