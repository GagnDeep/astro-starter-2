---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Logo {
  image_path: string;
  alt_text: string;
}

interface Props {
  heading: string;
  logos: Logo[];
}

const { heading, logos } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
---

<section class="py-12 border-t border-b border-[var(--border-color)] bg-[var(--bg-elevated)] overflow-hidden">
  <div class="mx-auto max-w-6xl px-8 flex flex-col md:flex-row items-center gap-8">
    <h2 data-editable="text" data-prop="heading" class="text-sm font-bold uppercase tracking-widest text-[var(--text-muted)] whitespace-nowrap">
      {heading}
    </h2>
    <div class="flex flex-wrap justify-center md:justify-start items-center gap-8 md:gap-12" data-editable="array" data-prop="logos">
      {logos.map((logo, i) => {
        const imageSrc = allImages[logo.image_path]?.default ?? logo.image_path;
        return (
          <div data-editable="array-item" class="grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-200">
            <Picture
              data-editable="image"
              data-prop-src={`logos[${i}].image_path`}
              data-prop-alt={`logos[${i}].alt_text`}
              src={imageSrc}
              alt={logo.alt_text}
              class="h-8 md:h-12 w-auto object-contain"
              widths={[200]}
              formats={["avif", "webp"]}
            />
          </div>
        );
      })}
    </div>
  </div>
</section>
