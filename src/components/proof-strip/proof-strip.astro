---
interface LogoItem {
  image: string;
  alt: string;
}

interface Props {
  heading: string;
  logos: LogoItem[];
}

const { heading, logos } = Astro.props;
---

<section
  class="py-12 border-b-2 border-neutral-900 dark:border-neutral-700 bg-neutral-100 dark:bg-neutral-800"
>
  <div class="mx-auto max-w-6xl px-8 reveal-on-scroll">
    <p
      data-editable="text"
      data-prop="heading"
      class="text-center font-display font-semibold text-neutral-600 dark:text-neutral-400 mb-8 uppercase tracking-widest text-sm"
    >
      {heading}
    </p>
    <div
      class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-70 grayscale contrast-125 dark:invert dark:opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
      data-editable="array"
      data-prop="logos"
    >
      {
        logos.map((logo, index) => (
          <img
            data-editable="image"
            data-prop-src={`logos.${index}.image`}
            data-prop-alt={`logos.${index}.alt`}
            src={logo.image}
            alt={logo.alt}
            class="h-12 object-contain"
            loading="lazy"
          />
        ))
      }
    </div>
  </div>
</section>
