---
interface Props {
  heading: string;
  logos: {
    image_path: string;
    alt_text: string;
  }[];
}
const { heading, logos } = Astro.props;
---

<section class="py-12 border-y border-[var(--surface-border)] bg-[var(--surface-color)]">
  <div class="mx-auto max-w-6xl px-8 flex flex-col md:flex-row items-center gap-8 justify-between">
    {
      heading && (
        <p
          class="font-bold text-gray-500 uppercase tracking-wider text-sm shrink-0"
          data-editable="text"
          data-prop="heading"
        >
          {heading}
        </p>
      )
    }
    <div
      class="flex flex-wrap items-center justify-center gap-8 md:gap-12 grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
      data-editable="array"
      data-prop="logos"
    >
      {
        logos?.map((logo, index) => (
          <img
            src={logo.image_path}
            alt={logo.alt_text}
            class="h-12 w-auto object-contain dark:invert"
            data-editable="image"
            data-prop-src={`logos[${index}].image_path`}
            data-prop-alt={`logos[${index}].alt_text`}
          />
        ))
      }
    </div>
  </div>
</section>
