---
interface Props {
  logos: { image_path: string; alt_text: string }[];
  heading?: string;
}

const { logos, heading } = Astro.props;

import type { ImageMetadata } from "astro";

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true },
);
---

<section class="py-8 bg-neutral-200/50 dark:bg-neutral-800/50 border-y border-neutral-200 dark:border-neutral-800 reveal">
  <div class="mx-auto max-w-6xl px-8 flex flex-col items-center gap-6">
    {heading && (
      <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400 uppercase tracking-wider text-center" data-editable="text" data-prop="heading">
        {heading}
      </p>
    )}
    <div class="flex flex-wrap justify-center items-center gap-8 md:gap-16 opacity-70 grayscale hover:grayscale-0 transition-all duration-300" data-editable="array" data-prop="logos">
      {logos.map((logo) => {
        const imageSrc = allImages[logo.image_path]?.default ?? logo.image_path;
        return (
          <div data-editable="array-item" class="w-32 flex items-center justify-center">
             <img src={typeof imageSrc === 'string' ? imageSrc : imageSrc.src} alt={logo.alt_text} class="max-h-12 w-auto object-contain dark:brightness-0 dark:invert" data-editable="image" data-prop-src="image_path" data-prop-alt="alt_text" loading="lazy" />
          </div>
        )
      })}
    </div>
  </div>
</section>
