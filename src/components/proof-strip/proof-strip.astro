---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  text?: string;
  logos: {
    image_path: string;
    alt_text: string;
  }[];
}

const { text, logos = [] } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,svg,webp,avif}",
  { eager: true }
);
---

<section class="py-12 bg-bg-color border-y border-border-color reveal-on-scroll">
  <div class="mx-auto max-w-6xl px-8 flex flex-col md:flex-row items-center justify-between gap-8 md:gap-12">
    {text && (
      <p data-editable="text" data-prop="text" class="text-sm font-medium tracking-wide text-text-muted uppercase shrink-0 text-center md:text-left">
        {text}
      </p>
    )}

    {logos.length > 0 && (
      <div class="flex flex-wrap justify-center md:justify-end items-center gap-8 md:gap-12 opacity-60 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-300" data-editable="array" data-prop="logos">
        {logos.map((logo, index) => {
          const imageSrc = allImages[logo.image_path]?.default ?? logo.image_path;
          return (
            <div data-editable="array-item" class="flex items-center justify-center">
              <Picture
                data-editable="image"
                data-prop-src={`logos[${index}].image_path`}
                data-prop-alt={`logos[${index}].alt_text`}
                src={imageSrc}
                alt={logo.alt_text}
                class="max-h-8 w-auto object-contain"
                widths={[200]}
                sizes="200px"
                formats={["avif", "webp"]}
              />
            </div>
          );
        })}
      </div>
    )}
  </div>
</section>
