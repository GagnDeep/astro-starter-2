---
/**
 * Source editable page.
 * No markdown front matter — content lives directly in the `.astro` file, and
 * CloudCannon edits it in place via `data-editable="source"`.
 */
import Layout from "../../layouts/Layout.astro";

const seo = {
  page_description: "About World AI School.",
  no_index: false,
};
---

<Layout title="About World AI School" seo={seo}>
  <main class="mx-auto max-w-4xl px-4 py-16">
    <h1
      data-editable="source"
      data-path="src/content/pages/about.astro"
      data-key="h1"
      class="text-4xl font-bold mb-8">
      About Us
    </h1>
    <div
      data-editable="source"
      data-path="src/content/pages/about.astro"
      data-key="content"
      class="prose max-w-none text-slate-800">
      <p>World AI School is an online course platform teaching practical AI skills to students worldwide.</p>
      <p>We believe in building, automating, and scaling with AI without getting bogged down in unnecessary academic theory.</p>
      <h2>Our Mission</h2>
      <p>To empower builders, founders, and professionals with the tools they need to leverage modern Large Language Models and AI agents.</p>
    </div>
  </main>
</Layout>
