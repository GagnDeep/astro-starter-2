---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="About">
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-8">
      <h1
        data-editable="source"
        data-path="src/content/pages/about.astro"
        data-key="heading"
        class="text-3xl md:text-5xl font-bold mb-8 text-balance">
        About Us
      </h1>
      <div
        data-editable="source"
        data-path="src/content/pages/about.astro"
        data-key="description"
        class="prose text-lg text-gray-600">
        <p>
          Breather Timer is an independent project dedicated to open access for breathwork tools. We believe that physiological pacing tools should be free and not gated behind paid apps.
        </p>
        <p>
          All of our tools are built based on clinical research and transparently cite their mechanisms.
        </p>
      </div>
    </div>
  </section>
</Layout>
