---
import Layout from "../../layouts/Layout.astro";
import { Check, ShieldAlert, Zap } from "@lucide/astro";

const title = "IBS Go Premium Subscription Pricing — Simple, Transparent Access";
const description = "Simple, transparent pricing for IBS Go Premium subscription. Zero ad-tracking, full local privacy, instant food lookup, and smart pattern analytics.";
---

<Layout title={title} seo={{ page_description: description }}>
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="mb-6 text-sm text-stone-600 flex items-center gap-2">
      <a href="/" class="hover:underline">Home</a> <span>/</span> <span class="font-semibold text-stone-900">Pricing</span>
    </nav>

    <header class="text-center max-w-3xl mx-auto mb-12">
      <h1 class="text-3xl sm:text-4xl font-bold text-stone-900 mb-4">Invest in Your Digestive Peace</h1>
      <p class="text-stone-700 text-lg">Try free with essential features, or unlock Premium unlimited pattern tracking, FODMAP stacking warnings, and PDF dietitian export.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <!-- Free Tier -->
      <div class="bg-white p-8 rounded-2xl border border-stone-200 shadow-sm flex flex-col justify-between">
        <div>
          <h2 class="text-2xl font-bold text-stone-900 mb-2">Free Core</h2>
          <p class="text-xs text-stone-600 mb-6">Essential food lookup and basic symptom journal.</p>
          <div class="text-4xl font-bold font-mono text-stone-900 mb-6">$0 <span class="text-xs font-sans text-stone-500 font-normal">/ forever</span></div>

          <ul class="space-y-3 text-xs text-stone-700 mb-8">
            <li class="flex items-center gap-2"><Check class="w-4 h-4 text-emerald-700"/> Full static food directory access</li>
            <li class="flex items-center gap-2"><Check class="w-4 h-4 text-emerald-700"/> Basic daily symptom logger</li>
            <li class="flex items-center gap-2"><Check class="w-4 h-4 text-emerald-700"/> Standard protocol guides</li>
            <li class="flex items-center gap-2"><Check class="w-4 h-4 text-emerald-700"/> Local device privacy guarantee</li>
          </ul>
        </div>
        <a href="/contact/" class="w-full py-3 bg-stone-100 text-stone-900 font-bold text-xs rounded-xl text-center hover:bg-stone-200 transition-colors">Get Started Free</a>
      </div>

      <!-- Premium Tier -->
      <div class="bg-amber-900 text-white p-8 rounded-2xl shadow-md flex flex-col justify-between relative overflow-hidden">
        <div class="absolute top-4 right-4 bg-amber-500 text-stone-950 font-bold text-[10px] uppercase tracking-wider px-3 py-1 rounded-full">
          Most Popular
        </div>
        <div>
          <h2 class="text-2xl font-bold mb-2">IBS Go Premium</h2>
          <p class="text-xs text-amber-200 mb-6">Complete gut intelligence, stacking detection & PDF reports.</p>
          <div class="text-4xl font-bold font-mono text-amber-100 mb-6">$6.99 <span class="text-xs font-sans text-amber-300 font-normal">/ month or $49.99/yr</span></div>

          <ul class="space-y-3 text-xs text-amber-100 mb-8">
            <li class="flex items-center gap-2"><Check class="w-4 h-4 text-amber-300"/> Everything in Free Core</li>
            <li class="flex items-center gap-2"><Check class="w-4 h-4 text-amber-300"/> Real-time FODMAP meal stacking warnings</li>
            <li class="flex items-center gap-2"><Check class="w-4 h-4 text-amber-300"/> Reintroduction challenge calendar & tracking</li>
            <li class="flex items-center gap-2"><Check class="w-4 h-4 text-amber-300"/> Export 1-click PDF summary for your GI doctor/RD</li>
            <li class="flex items-center gap-2"><Check class="w-4 h-4 text-amber-300"/> Cross-platform sync (iOS, Android, Web)</li>
          </ul>
        </div>
        <a href="/contact/" class="w-full py-3 bg-amber-500 text-stone-950 font-bold text-xs rounded-xl text-center hover:bg-amber-400 transition-colors">Start 7-Day Free Trial</a>
      </div>
    </div>

    <div class="pt-8 border-t border-stone-200 flex flex-wrap gap-4 text-sm font-medium">
      <a href="/app/" class="text-amber-800 hover:underline">Explore App Features &rarr;</a>
      <a href="/research/" class="text-amber-800 hover:underline">Clinical Research & Competitor Basis &rarr;</a>
    </div>
  </main>
</Layout>
