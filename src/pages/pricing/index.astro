---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Pricing - usignpdf"
  seo={{
    page_description: "Transparent, affordable pricing for e-signatures. Free tier available. No enterprise bloat.",
    canonical_url: "https://usignpdf.com/pricing/"
  }}
>
  <div class="max-w-4xl mx-auto py-20 px-4 md:px-8 text-center">
    <h1 class="text-4xl font-bold mb-4">Simple, transparent pricing</h1>
    <p class="text-xl text-text-muted mb-12">No hidden fees, no "contact sales" buttons.</p>

    <div class="grid md:grid-cols-2 gap-8 max-w-3xl mx-auto">
      <div class="border border-border p-8 rounded-lg bg-surface shadow-sm">
        <h2 class="text-2xl font-bold mb-2">Free</h2>
        <div class="text-4xl font-bold mb-6">$0<span class="text-lg text-text-muted font-normal">/mo</span></div>
        <ul class="text-left space-y-3 mb-8">
          <li>✓ 3 documents per month</li>
          <li>✓ Legally binding signatures</li>
          <li>✓ Basic Audit Trail</li>
          <li>✓ Zero client signup</li>
        </ul>
        <a href="/" class="block w-full bg-surface-alt hover:bg-border text-text-main font-semibold py-3 rounded transition-colors text-center border border-border">Start Free</a>
      </div>

      <div class="border-2 border-accent p-8 rounded-lg bg-surface shadow-md relative">
        <div class="absolute top-0 left-1/2 transform -translate-x-1/2 -translate-y-1/2 bg-accent text-surface px-4 py-1 rounded-full text-sm font-semibold">Most Popular</div>
        <h2 class="text-2xl font-bold mb-2">Pro</h2>
        <div class="text-4xl font-bold mb-6">$9<span class="text-lg text-text-muted font-normal">/mo</span></div>
        <ul class="text-left space-y-3 mb-8">
          <li>✓ Unlimited documents</li>
          <li>✓ Legally binding signatures</li>
          <li>✓ Comprehensive Audit Trail</li>
          <li>✓ Custom branding</li>
          <li>✓ Priority support</li>
        </ul>
        <a href="/" class="block w-full bg-accent hover:bg-accent-hover text-surface font-semibold py-3 rounded transition-colors text-center">Upgrade to Pro</a>
      </div>
    </div>
  </div>
</Layout>
