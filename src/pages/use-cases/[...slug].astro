---
import Layout from "../../layouts/Layout.astro";
import { getCollection, type CollectionEntry, render } from "astro:content";

export interface Props {
  entry: CollectionEntry<"use-cases">;
}

export async function getStaticPaths() {
  const entries = await getCollection("use-cases");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, industry, seo } = entry.data;

const finalSeo = {
  ...seo,
  page_description: seo?.page_description || summary,
};
---

<Layout title={title} seo={finalSeo}>
  <article class="max-w-4xl mx-auto px-6 py-12 prose">
    <p class="text-sm font-semibold tracking-wide text-brand-600 uppercase">{industry}</p>
    <h1>{title}</h1>
    <p class="text-xl text-slate-600 mb-8">{summary}</p>
    <Content />
  </article>
</Layout>
