---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Use Cases | usignpdf"
  seo={{
    page_description: "Discover how freelancers, agencies, and small businesses use usignpdf to get contracts signed instantly.",
    canonical_url: "https://usignpdf.com/use-cases/"
  }}
>
  <div class="max-w-4xl mx-auto py-20 px-4 md:px-8">
    <h1 class="text-4xl font-bold mb-8 text-center">Who uses usignpdf?</h1>
    <p class="text-center text-text-muted mb-12">From real estate to freelance dev, find out how much <a href="/tools/roi-calculator" class="underline text-accent">time you can save</a>. Grab a <a href="/templates" class="underline text-accent">template</a> and get started.</p>
    <div class="grid md:grid-cols-2 gap-8">
      <a href="/use-cases/freelancers" class="block p-6 bg-surface border border-border rounded shadow hover:shadow-md transition">
        <h2 class="text-2xl font-semibold mb-2">Freelancers</h2>
        <p class="text-text-muted">Get SOWs and NDAs signed without making your clients jump through hoops.</p>
      </a>
      <a href="/use-cases/agencies" class="block p-6 bg-surface border border-border rounded shadow hover:shadow-md transition">
        <h2 class="text-2xl font-semibold mb-2">Agencies</h2>
        <p class="text-text-muted">Onboard new clients fast with a seamless, white-labeled signing experience.</p>
      </a>
      <a href="/use-cases/real-estate" class="block p-6 bg-surface border border-border rounded shadow hover:shadow-md transition">
        <h2 class="text-2xl font-semibold mb-2">Real Estate</h2>
        <p class="text-text-muted">Sign leases and agreements on the go, right from your phone.</p>
      </a>
      <a href="/use-cases/contractors" class="block p-6 bg-surface border border-border rounded shadow hover:shadow-md transition">
        <h2 class="text-2xl font-semibold mb-2">Contractors</h2>
        <p class="text-text-muted">Get work orders approved instantly before starting the job.</p>
      </a>
    </div>
  </div>
</Layout>
