---
import Layout from '../layouts/Layout.astro';
import CaptureForm from '../components/forms/capture-form.astro';
---
<Layout title="Frequently Asked Questions" seo={{ page_description: "Answers to common questions about using UConvertDocument." }}>
  <div class="mx-auto max-w-4xl px-4 py-16 prose">
    <h1>Frequently Asked Questions</h1>
    <h2>Is UConvertDocument free?</h2>
    <p>Yes, our tool is 100% free to use. We support the site through ads.</p>
    <h2>Are my files safe?</h2>
    <p>Absolutely. We use secure connections (HTTPS) and automatically delete your files from our servers shortly after processing.</p>
    <h2>Do I need to install anything?</h2>
    <p>No, our tools run entirely in your web browser. There is no software to install.</p>
    <h2>What formats do you support?</h2>
    <p>We support a wide range of formats including PDF, Word (DOCX), Excel (XLSX), JPG, PNG, and more. Check our <a href="/formats/">Formats Library</a> for a full list.</p>
  </div>

  <div class="mx-auto max-w-xl px-4 py-16 bg-surface mt-16 rounded border border-border">
    <h2 class="text-2xl font-bold mb-4">Still have questions?</h2>
    <p class="mb-6 text-text-muted">Send us a message and we'll get back to you.</p>
    <CaptureForm formLabel="contact">
      <div class="space-y-4">
        <div>
          <label for="name" class="block text-sm font-medium text-text-main mb-1">Name</label>
          <input type="text" id="name" name="name" required class="w-full px-3 py-2 border border-border rounded focus:outline-none focus:border-brand" />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-text-main mb-1">Email</label>
          <input type="email" id="email" name="email" required class="w-full px-3 py-2 border border-border rounded focus:outline-none focus:border-brand" />
        </div>
        <div>
          <label for="message" class="block text-sm font-medium text-text-main mb-1">Message</label>
          <textarea id="message" name="message" rows="4" required class="w-full px-3 py-2 border border-border rounded focus:outline-none focus:border-brand"></textarea>
        </div>
        <button type="submit" class="w-full bg-brand hover:bg-brand-hover text-white font-medium py-2 px-4 rounded transition-colors">
          Send Message
        </button>
      </div>
    </CaptureForm>
  </div>
</Layout>
