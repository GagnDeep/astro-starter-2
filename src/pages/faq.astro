---
import Layout from "../layouts/Layout.astro";

const faqs = [
  {
    q: "What does an endocrinologist do?",
    a: "An endocrinologist is a medical specialist who diagnoses and treats conditions involving hormones and the endocrine glands, including the thyroid, pancreas (diabetes), adrenals, parathyroids, ovaries/testes, and pituitary gland."
  },
  {
    q: "Do I need a physician referral to see Dr. Ameena?",
    a: "Referral requirements depend on your insurance plan. While PPO plans often allow self-referrals, HMO and POS plans typically require a primary care physician (PCP) referral. Please check with your carrier or use our Insurance Panel tool."
  },
  {
    q: "What should I bring to my first appointment?",
    a: "Please bring a photo ID, current insurance card, list of current medications and supplements, and copies of relevant lab results or imaging reports from the past 6 to 12 months."
  },
  {
    q: "How long is an initial endocrinology consultation?",
    a: "Initial new patient consultations last 60 minutes to allow adequate time for comprehensive clinical history, diagnostic lab review, physical examination, and care plan development."
  },
  {
    q: "How does Dr. Ameena manage thyroid nodules?",
    a: "Thyroid nodules are evaluated using high-resolution ultrasound and classified according to ACR TI-RADS guidelines. If diagnostic criteria are met, an in-office ultrasound-guided fine needle aspiration (FNA) biopsy is performed."
  },
  {
    q: "Does the practice offer Continuous Glucose Monitoring (CGM)?",
    a: "Yes. Dr. Ameena prescribes and optimizes Continuous Glucose Monitors (such as Dexcom G7 and FreeStyle Libre 3) for Type 1, Type 2, prediabetes, and gestational diabetes patients."
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout title="Frequently Asked Questions (FAQ)" schemaData={schemaData}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10">
    <div class="space-y-3 border-b border-stone-200 pb-6">
      <span class="badge-reviewed">Practice Guidance</span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#1B4332]">Frequently Asked Questions</h1>
      <p class="text-stone-600 text-sm sm:text-base">
        Common questions regarding consultations, insurance panels, laboratory preparations, and endocrine conditions.
      </p>
    </div>

    <div class="space-y-6">
      {faqs.map((faq, idx) => (
        <div class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm space-y-2">
          <h2 class="text-lg font-serif font-bold text-[#1B4332] flex items-start gap-2">
            <span class="text-[#2D6A4F]">Q{idx + 1}.</span> {faq.q}
          </h2>
          <p class="text-xs sm:text-sm text-stone-700 leading-relaxed pl-6">
            {faq.a}
          </p>
        </div>
      ))}
    </div>

    <div class="bg-[#E8F5E9] p-6 rounded-xl border border-emerald-200 text-center space-y-3">
      <h3 class="text-lg font-serif font-bold text-[#1B4332]">Have a Question Not Listed Here?</h3>
      <p class="text-xs text-stone-600 max-w-md mx-auto">
        Contact our Austin administrative office or schedule an initial consultation visit.
      </p>
      <div class="pt-1 flex flex-wrap justify-center gap-4">
        <a href="/booking/" class="btn-primary text-xs">Book Appointment</a>
        <a href="/location/" class="btn-secondary text-xs">Contact Office</a>
      </div>
    </div>
  </div>
</Layout>
