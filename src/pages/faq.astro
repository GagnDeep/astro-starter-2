---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: 'Frequently Asked Questions',
  page_description: 'Common questions about downloading and filing tax forms.'
};
---
<Layout seo={seo} title="Frequently Asked Questions">
  <main class="max-w-4xl mx-auto px-4 py-12 prose">
    <h1>Frequently Asked Questions</h1>
    <h2>Are these forms official?</h2>
    <p>Yes, all forms are official IRS PDFs.</p>
    <h2>Do you offer tax advice?</h2>
    <p>No, we are not tax professionals. The information provided is for educational purposes only.</p>
  </main>
</Layout>
