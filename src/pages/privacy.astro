---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: 'Privacy Policy',
  page_description: 'Privacy Policy for FreeTaxPDF.'
};
---
<Layout seo={seo} title="Privacy Policy">
  <main class="max-w-4xl mx-auto px-4 py-12 prose">
    <h1>Privacy Policy</h1>
    <p>We take your privacy seriously. We do not sell your personal information.</p>
  </main>
</Layout>
