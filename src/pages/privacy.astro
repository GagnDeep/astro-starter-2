---
import Layout from "../layouts/Layout.astro";

const title = "Privacy Policy — IBS Go";
const description = "Privacy policy for IBS Go: Local-first data architecture, zero health data selling, and HIPAA/GDPR alignment.";
---

<Layout title={title} seo={{ page_description: description }}>
  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 prose">
    <h1>Privacy Policy</h1>
    <p>Last updated: May 2024</p>
    <p>At IBS Go, your health privacy is sacred. We store symptom and food logs locally on your device whenever possible and never sell sensitive health data to third-party ad networks.</p>
    <h2>Data Collection & Form Submissions</h2>
    <p>When you fill out our contact or newsletter form, submissions post securely through our MarkRemover capture endpoint according to strict encryption protocols.</p>
    <p><a href="/">&larr; Return to Home</a></p>
  </main>
</Layout>
