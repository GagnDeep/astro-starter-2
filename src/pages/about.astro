---
import Layout from "../layouts/Layout.astro";

const schemaData = {
  "@context": "https://schema.org",
  "@type": "Physician",
  "name": "Dr. Ameena, MD — Endocrinology Specialist",
  "medicalSpecialty": ["Endocrinology", "InternalMedicine"],
  "description": "Board Certified Endocrinologist providing evidence-led, patient-centered clinical care in Austin, TX."
};
---

<Layout title="About Dr. Ameena, MD" schemaData={schemaData}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-12">
    <!-- Header Banner -->
    <div class="space-y-4 border-b border-stone-200 pb-8">
      <div class="inline-flex items-center gap-2">
        <span class="badge-reviewed">Physician Profile</span>
        <span class="text-xs text-stone-500 font-semibold">Austin, TX</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#1B4332]">Dr. Ameena, MD, FACP <span class="bg-amber-100 text-amber-900 text-xs px-2 py-0.5 rounded font-bold">[NEEDS CONFIRMATION]</span></h1>
      <p class="text-lg text-stone-600">Board Certified Endocrinologist & Internal Medicine Specialist</p>
    </div>

    <!-- Main Bio & Practice Philosophy -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      <div class="md:col-span-1 bg-white p-6 rounded-xl border border-stone-200 shadow-sm space-y-4 text-center">
        <div class="w-24 h-24 mx-auto rounded-full bg-[#E8F5E9] border-2 border-[#2D6A4F] flex items-center justify-center font-serif text-3xl font-bold text-[#1B4332]">
          DA
        </div>
        <div>
          <div class="font-serif font-bold text-base text-[#1B4332]">Dr. Ameena, MD</div>
          <div class="text-xs text-stone-500">Endocrinology & Metabolic Care</div>
        </div>
        <div class="pt-2 border-t border-stone-100 text-xs text-left space-y-2 text-stone-600">
          <p><strong>Board Certifications <span class="bg-amber-100 text-amber-900 text-[10px] px-1 rounded font-bold">[NEEDS CONFIRMATION]</span>:</strong> Endocrinology, Diabetes & Metabolism; Internal Medicine.</p>
          <p><strong>Affiliations <span class="bg-amber-100 text-amber-900 text-[10px] px-1 rounded font-bold">[NEEDS CONFIRMATION]</span>:</strong> Ascension Seton, St. David's Medical Center.</p>
          <p><strong>Texas Medical License <span class="bg-amber-100 text-amber-900 text-[10px] px-1 rounded font-bold">[NEEDS CONFIRMATION]</span>:</strong> Verified TX Medical Board.</p>
        </div>
      </div>

      <div class="md:col-span-2 space-y-6 prose text-stone-800">
        <h2 class="text-2xl font-serif font-bold text-[#1B4332]">Evidence-Led, Patient-Centered Philosophy</h2>
        <p>
          Endocrine conditions—whether hypothyroidism, complex diabetes management, PCOS, or osteoporosis—are deeply connected to daily quality of life. My approach as a practising physician centers on careful diagnostic precision, thorough clinical listening, and applying the latest peer-reviewed guidelines from the Endocrine Society, American Thyroid Association (ATA), and American Diabetes Association (ADA).
        </p>

        <h3 class="text-xl font-serif font-bold text-[#2D6A4F]">Medical Education & Training <span class="bg-amber-100 text-amber-900 text-xs px-2 py-0.5 rounded font-bold">[NEEDS CONFIRMATION]</span></h3>
        <ul class="list-disc pl-5 space-y-2 text-sm text-stone-700">
          <li><strong>Fellowship in Endocrinology, Diabetes & Metabolism:</strong> [NEEDS CONFIRMATION: Academic Medical Center / University Hospital]</li>
          <li><strong>Residency in Internal Medicine:</strong> [NEEDS CONFIRMATION: University Hospital Internal Medicine Program]</li>
          <li><strong>Doctor of Medicine (M.D.):</strong> [NEEDS CONFIRMATION: Accredited School of Medicine]</li>
          <li><strong>Bachelor of Science (B.S.):</strong> [NEEDS CONFIRMATION: Undergraduate Institution]</li>
        </ul>

        <h3 class="text-xl font-serif font-bold text-[#2D6A4F]">Clinical Specialties</h3>
        <p class="text-sm text-stone-700">
          Dr. Ameena provides comprehensive diagnostic evaluations and long-term care plans for:
        </p>
        <ul class="list-disc pl-5 space-y-1 text-sm text-stone-700">
          <li>Thyroid nodule risk-stratification, ultrasound, and fine needle aspiration (FNA) biopsy</li>
          <li>Autoimmune thyroiditis (Hashimoto's & Graves' disease) and T3/T4 optimization</li>
          <li>Type 1 & Type 2 Diabetes management including CGM and automated insulin pumps</li>
          <li>Polycystic Ovary Syndrome (PCOS) insulin resistance and androgen balancing</li>
          <li>Post-menopausal bone health, osteoporosis, and DEXA bone density evaluation</li>
          <li>Adrenal disorders, hyperparathyroidism, and pituitary hormone testing</li>
        </ul>

        <div class="disclaimer-box">
          <strong>Notice Regarding Physician Credentials:</strong> All specific medical degree institution names, fellowship programs, hospital privileges, and state license numbers on this preview website are tagged <span class="bg-amber-100 text-amber-900 text-xs px-1 rounded font-bold">[NEEDS CONFIRMATION]</span> to adhere strictly to healthcare transparency rules until direct administrative confirmation is provided.
        </div>
      </div>
    </div>
  </div>
</Layout>
