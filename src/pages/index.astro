---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";
import NewsletterForm from "../components/forms/newsletter-form.astro";

const seo = {
  page_description: "The most objective, data-driven, and veterinary-sourced guide to what you feed your dog between meals.",
  open_graph_type: "website" as const,
};
---

<Layout title="DogSnacking - Healthier Snacks, Longer Lives" seo={seo}>
  <main>
    <!-- 1. Hero with inline tool CTA -->
    <section class="bg-[var(--color-surface)] py-20 px-4 text-center border-b border-[var(--color-border)]">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-6xl font-bold mb-6 text-[var(--color-primary)]">Are you overfeeding treats?</h1>
        <p class="text-xl text-[var(--color-muted)] mb-8 max-w-2xl mx-auto">
          Calculate your dog's exact daily treat allowance based on veterinary science, not guesswork.
        </p>
        <div class="flex justify-center gap-4">
          <a href="/tools/treat-allowance-calculator/" class="bg-[var(--color-primary)] text-white px-8 py-4 rounded font-bold hover:bg-[var(--color-primary-hover)] transition-colors">
            Calculate Allowance
          </a>
          <a href="/tools/toxicity-calculator/" class="bg-white text-[var(--color-primary)] px-8 py-4 rounded font-bold border-2 border-[var(--color-primary)] hover:bg-gray-50 transition-colors">
            Check Toxicity
          </a>
        </div>
      </div>
    </section>

    <!-- 2. The 10% Rule -->
    <section class="py-16 px-4">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold mb-4">The 10% Rule</h2>
          <p class="text-lg text-gray-700 mb-6">
            Veterinarians agree: snacks should make up <strong>no more than 10%</strong> of a dog's daily caloric intake. The remaining 90% must come from a complete and balanced diet. Ignoring this rule leads to obesity, nutritional deficiencies, and joint problems.
          </p>
          <a href="/library/" class="text-[var(--color-secondary)] font-semibold hover:underline">Explore the Reference Library &rarr;</a>
        </div>
        <div class="bg-[var(--color-surface)] p-8 rounded-full aspect-square flex items-center justify-center border-8 border-[var(--color-primary)] border-t-[var(--color-secondary)]">
          <div class="text-center">
            <span class="block text-4xl font-bold text-[var(--color-primary)]">90%</span>
            <span class="text-sm font-medium text-gray-500 uppercase tracking-wide">Food</span>
            <span class="block mt-4 text-2xl font-bold text-[var(--color-secondary)]">10%</span>
            <span class="text-sm font-medium text-gray-500 uppercase tracking-wide">Treats</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. Safety Deep Dives Grid -->
    <section class="bg-gray-50 py-16 px-4 border-y border-[var(--color-border)]">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold mb-8 text-center">Safety Deep Dives</h2>
        <div class="grid md:grid-cols-3 gap-8">
          <a href="/library/types/rawhide/" class="block bg-white p-6 rounded shadow hover:shadow-md transition-shadow">
            <h3 class="text-xl font-bold mb-2 text-[var(--color-danger)]">The Rawhide Risk</h3>
            <p class="text-gray-600">Why veterinarians warn against traditional rawhide chews and the digestion risks involved.</p>
          </a>
          <a href="/library/ingredients/xylitol/" class="block bg-white p-6 rounded shadow hover:shadow-md transition-shadow">
            <h3 class="text-xl font-bold mb-2 text-[var(--color-danger)]">Xylitol Toxicity</h3>
            <p class="text-gray-600">The artificial sweetener that can be fatal in tiny doses. Where it hides in human foods.</p>
          </a>
          <a href="/library/types/bully-sticks/" class="block bg-white p-6 rounded shadow hover:shadow-md transition-shadow">
            <h3 class="text-xl font-bold mb-2 text-[var(--color-primary)]">Bully Sticks: Safe?</h3>
            <p class="text-gray-600">Caloric density, contamination risks, and safety for puppies under 6 months.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- 4. Compare Treat Types (Table Preview) -->
    <section class="py-16 px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl font-bold mb-8 text-center">Compare Treat Types</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="bg-[var(--color-surface)] border-b border-[var(--color-border)]">
                <th class="p-4 font-bold text-gray-700">Type</th>
                <th class="p-4 font-bold text-gray-700">Digestibility</th>
                <th class="p-4 font-bold text-gray-700">Choke Risk</th>
                <th class="p-4 font-bold text-gray-700">Caloric Density</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-[var(--color-border)]">
                <td class="p-4 font-semibold"><a href="/library/types/bully-sticks/" class="text-[var(--color-secondary)] hover:underline">Bully Sticks</a></td>
                <td class="p-4">High</td>
                <td class="p-4">Moderate (End pieces)</td>
                <td class="p-4 text-[var(--color-warning)]">High (~3000 kcal/kg)</td>
              </tr>
              <tr class="border-b border-[var(--color-border)]">
                <td class="p-4 font-semibold"><a href="/library/types/yak-chews/" class="text-[var(--color-secondary)] hover:underline">Yak Chews</a></td>
                <td class="p-4">Moderate</td>
                <td class="p-4 text-[var(--color-danger)]">High (Tooth fracture)</td>
                <td class="p-4">Moderate</td>
              </tr>
              <tr class="border-b border-[var(--color-border)]">
                <td class="p-4 font-semibold"><a href="/library/types/rawhide/" class="text-[var(--color-secondary)] hover:underline">Rawhide</a></td>
                <td class="p-4 text-[var(--color-danger)]">Low</td>
                <td class="p-4 text-[var(--color-danger)]">High (Blockage)</td>
                <td class="p-4">Moderate</td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="mt-6 text-center">
          <a href="/comparison/" class="text-[var(--color-primary)] font-bold hover:underline">View Full Comparison Table &rarr;</a>
        </div>
      </div>
    </section>

    <!-- 5. Latest Reviews & Taxonomy -->
    <section class="bg-[var(--color-surface)] py-16 px-4 border-y border-[var(--color-border)]">
      <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-12">
        <div>
          <h2 class="text-3xl font-bold mb-6">Latest Reviews</h2>
          <ul class="space-y-4">
            <li><a href="/blog/zukes-review/" class="text-lg font-medium text-[var(--color-secondary)] hover:underline">Zuke's Mini Naturals Review</a></li>
            <li><a href="/blog/greenies-review/" class="text-lg font-medium text-[var(--color-secondary)] hover:underline">Are Greenies Actually Good for Teeth?</a></li>
            <li><a href="/blog/farm-hounds-review/" class="text-lg font-medium text-[var(--color-secondary)] hover:underline">Farm Hounds Single-Ingredient Treats</a></li>
            <li><a href="/blog/best-training-treats/" class="text-lg font-medium text-[var(--color-secondary)] hover:underline">Best High Value Treats for Loose Leash Walking</a></li>
          </ul>
          <div class="mt-6">
            <a href="/blog/" class="font-bold hover:underline">Read the Blog &rarr;</a>
          </div>
        </div>
        <div>
          <h2 class="text-3xl font-bold mb-6">Health Conditions</h2>
          <div class="flex flex-wrap gap-2">
            <a href="/health/pancreatitis/" class="bg-white border border-[var(--color-border)] px-4 py-2 rounded-full text-sm font-medium hover:border-[var(--color-primary)] transition-colors">Pancreatitis</a>
            <a href="/health/obesity/" class="bg-white border border-[var(--color-border)] px-4 py-2 rounded-full text-sm font-medium hover:border-[var(--color-primary)] transition-colors">Obesity</a>
            <a href="/health/allergies/" class="bg-white border border-[var(--color-border)] px-4 py-2 rounded-full text-sm font-medium hover:border-[var(--color-primary)] transition-colors">Allergies</a>
            <a href="/health/dental/" class="bg-white border border-[var(--color-border)] px-4 py-2 rounded-full text-sm font-medium hover:border-[var(--color-primary)] transition-colors">Dental</a>
            <a href="/health/sensitive-stomach/" class="bg-white border border-[var(--color-border)] px-4 py-2 rounded-full text-sm font-medium hover:border-[var(--color-primary)] transition-colors">Sensitive Stomach</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Capture -->
    <section class="py-20 px-4 bg-[var(--color-primary)] text-white text-center">
      <div class="max-w-xl mx-auto">
        <h2 class="text-3xl font-bold mb-4 text-white">Get the Recall Alert Newsletter</h2>
        <p class="mb-8 text-[var(--color-primary-light)]">Join 10,000+ owners who receive instant alerts when dog treats are recalled for contamination or safety hazards.</p>
        <NewsletterForm
          form="newsletter"
          class="max-w-md mx-auto"
          submitLabel="Subscribe"
        />
      </div>
    </section>
  </main>
</Layout>
