---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";

const seo = {
  page_description: "The pragmatic, regulation-focused compliance platform for the cable manufacturing and import industry.",
  canonical_url: null,
  featured_image: null,
  featured_image_alt: null,
  author_twitter_handle: null,
  open_graph_type: "website",
  no_index: false,
};
---

<Layout title="CablePassport - ESPR Compliance for Cables" {seo}>
  <main class="max-w-6xl mx-auto px-4 py-12">
    <!-- Hero Block -->
    <section class="mb-20 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
      <div>
        <h1 class="text-4xl md:text-5xl font-bold mb-4 leading-tight text-[var(--color-text)]">
          Stop Guessing About EU Cable Regulations. Start Complying.
        </h1>
        <p class="text-xl mb-8 text-gray-700">
          The pragmatic, regulation-focused Digital Product Passport (DPP) platform specifically for the cable manufacturing and import industry.
        </p>

        <div class="bg-[var(--color-bg)] p-6 border border-[var(--color-border)] inline-block w-full max-w-md">
          <h2 class="text-lg font-bold mb-2 mt-0">Join the waitlist for ESPR updates</h2>
          <CaptureForm form="waitlist">
            <div class="flex flex-col gap-4">
              <label class="flex flex-col gap-1">
                <span class="text-sm font-bold">Email Address</span>
                <input type="email" name="email" required class="p-2 border border-[var(--color-border)] rounded" />
              </label>
              <button type="submit" class="bg-[var(--color-primary)] text-white px-4 py-2 font-bold rounded cursor-pointer hover:bg-[#b02d18]">
                Get Updates
              </button>
            </div>
          </CaptureForm>
        </div>
      </div>
      <div class="bg-gray-100 p-8 border border-[var(--color-border)] rounded flex flex-col justify-center items-center h-full min-h-[300px]">
         <span class="text-[var(--color-secondary)] font-bold text-xl mb-4">ESPR Compliance Tracker</span>
         <div class="w-full bg-white p-4 border border-[var(--color-border)] rounded text-sm font-mono mb-2">Phase 1: High Voltage Power (Target 2026)</div>
         <div class="w-full bg-white p-4 border border-[var(--color-border)] rounded text-sm font-mono mb-2">Phase 2: Telecom/Copper (Target 2027)</div>
         <div class="w-full bg-white p-4 border border-[var(--color-border)] rounded text-sm font-mono">Phase 3: Specialty/Fiber (Target 2028+)</div>
      </div>
    </section>

    <!-- Why Us Block (Competitor Gap) -->
    <section class="mb-20">
      <h2 class="text-3xl font-bold mb-8 border-b border-[var(--color-border)] pb-2 text-[var(--color-secondary)]">Why general DPP platforms fail cable manufacturers</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-6 border border-[var(--color-border)] bg-white">
          <h3 class="text-xl font-bold mb-2">Not just "Blockchain"</h3>
          <p>You don't need Web3 buzzwords. You need a pragmatic system that connects to your ERP and generates an EN 50575 compliant payload.</p>
        </div>
        <div class="p-6 border border-[var(--color-border)] bg-white">
          <h3 class="text-xl font-bold mb-2">Material Specific</h3>
          <p>Generic platforms don't understand the difference between drawing copper wire and extruding PVC. We have pre-built LCA factors for cable materials.</p>
        </div>
        <div class="p-6 border border-[var(--color-border)] bg-white">
          <h3 class="text-xl font-bold mb-2">Built for Audits</h3>
          <p>Your DPP will be audited by third parties. Our data exports match exact EU market surveillance schemas, preventing customs delays.</p>
        </div>
      </div>
    </section>

    <!-- Navigation / Tools -->
    <section class="mb-20">
      <h2 class="text-3xl font-bold mb-8 border-b border-[var(--color-border)] pb-2">Start Preparing Today</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <a href="/tools" class="block p-8 bg-[var(--color-secondary)] text-white hover:bg-[#1f3a2c] transition-colors rounded no-underline">
          <h3 class="text-2xl font-bold mb-2">Compliance Tools</h3>
          <p>Check if your cables are mandated, generate required data checklists, and estimate carbon footprints.</p>
        </a>
        <a href="/reference" class="block p-8 border border-[var(--color-primary)] text-[var(--color-primary)] hover:bg-gray-50 transition-colors rounded no-underline">
          <h3 class="text-2xl font-bold mb-2">ESPR Reference Library</h3>
          <p>Deep-dive into the regulations. 15+ detailed pages analyzing the mandates.</p>
        </a>
      </div>
    </section>
  </main>
</Layout>
