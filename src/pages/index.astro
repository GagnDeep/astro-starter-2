---
import Layout from "../layouts/Layout.astro";
import NewsletterForm from "../components/forms/newsletter-form.astro";
import DailyWaterCalculator from "../components/calculators/daily-water-calculator.astro";
import { getCollection } from "astro:content";
import PostSummary from "../components/blog/summary.astro";

const posts = await getCollection("blog");
---

<Layout title="WaterTrackLog | Track Your Hydration, Simply.">
  <!-- Hero Section -->
  <section class="bg-primary text-white py-20 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-5xl md:text-6xl font-bold mb-6">Track Your Hydration, Simply.</h1>
      <p class="text-xl md:text-2xl mb-8 text-primary-100">A science-backed web app that helps you calculate fluid needs and reminds you to drink. No downloads, no subscriptions.</p>

      <div class="flex flex-col sm:flex-row justify-center gap-4 mb-12">
        <a href="#calculator" class="bg-white text-primary px-8 py-4 rounded-lg font-bold hover:bg-slate-50 transition-colors">Calculate Your Needs</a>
        <a href="/tools/sweat-loss-calculator" class="border-2 border-white text-white px-8 py-4 rounded-lg font-bold hover:bg-primary-dark transition-colors">Sweat Loss Calculator</a>
      </div>

      <div class="max-w-md mx-auto bg-white/10 p-6 rounded-lg backdrop-blur-sm">
        <p class="text-sm mb-4 font-semibold">Join the waitlist for custom reminders:</p>
        <NewsletterForm form="waitlist" submitLabel="Join Waitlist" />
      </div>
    </div>
  </section>

  <!-- Problem/Agitation -->
  <section class="py-16 px-4 bg-slate-50">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl font-bold mb-6 text-slate-800">You're probably mildly dehydrated right now.</h2>
      <p class="text-xl text-slate-600 mb-4">Studies show that even a 2% drop in body water can lead to noticeable cognitive decline and physical fatigue.</p>
      <p class="text-lg text-slate-600">Don't rely on arbitrary "8 glasses a day" rules. Your needs are unique based on weight, activity, and climate.</p>
    </div>
  </section>

  <!-- How it Works -->
  <section class="py-16 px-4">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-12">How It Works</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center p-6 border border-slate-200 rounded-lg">
          <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">1</div>
          <h3 class="text-xl font-bold mb-2">Calculate</h3>
          <p class="text-slate-600">Find your scientific baseline using our advanced calculators.</p>
        </div>
        <div class="text-center p-6 border border-slate-200 rounded-lg">
          <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">2</div>
          <h3 class="text-xl font-bold mb-2">Log</h3>
          <p class="text-slate-600">Track your intake quickly without navigating clunky app menus.</p>
        </div>
        <div class="text-center p-6 border border-slate-200 rounded-lg">
          <div class="w-16 h-16 bg-primary text-white rounded-full flex items-center justify-center text-2xl font-bold mx-auto mb-4">3</div>
          <h3 class="text-xl font-bold mb-2">Feel Better</h3>
          <p class="text-slate-600">Experience better focus, sleep, and physical performance.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Grid -->
  <section class="py-16 px-4 bg-slate-800 text-white">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <div>
          <h3 class="text-2xl font-bold mb-2">Works Offline</h3>
          <p class="text-slate-300">No connection? No problem. The app works anywhere you are.</p>
        </div>
        <div>
          <h3 class="text-2xl font-bold mb-2">Privacy First</h3>
          <p class="text-slate-300">Your tracking data stays on your device.</p>
        </div>
        <div>
          <h3 class="text-2xl font-bold mb-2">No JavaScript Required</h3>
          <p class="text-slate-300">Core functionality works even if scripts fail or are blocked.</p>
        </div>
        <div>
          <h3 class="text-2xl font-bold mb-2">Science-Backed</h3>
          <p class="text-slate-300">Calculations based on verified clinical guidelines.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Calculator Teaser -->
  <section id="calculator" class="py-16 px-4">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl font-bold text-center mb-8">Discover Your Baseline</h2>
      <DailyWaterCalculator />
    </div>
  </section>

  <!-- Recent Articles -->
  <section class="py-16 px-4 bg-slate-50">
    <div class="max-w-6xl mx-auto">
      <div class="flex justify-between items-center mb-8">
        <h2 class="text-3xl font-bold">Latest Hydration Science</h2>
        <a href="/blog" class="text-primary font-bold hover:underline">View All &rarr;</a>
      </div>
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {posts.slice(0, 3).map(post => (
          <li>
            <PostSummary data={post.data} id={post.id} />
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
