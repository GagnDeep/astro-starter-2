---
import { getEntry } from "astro:content";
import Layout from "../layouts/Layout.astro";
import NewsletterForm from "../components/forms/newsletter-form.astro";
import { capture } from "../../capture.config";

// Look up the "index.md" entry
const page = await getEntry("pages", "index");

// Fallback in case the markdown wasn't found properly
if (!page || !("hero_block" in page.data)) {
  throw new Error("Could not find index.md in pages collection.");
}

const { hero_block, content_blocks, title, seo } = page.data;
---

<Layout title={title} seo={seo}>
  <main>
    <section class="bg-brand-primary text-brand-surface py-20 px-8 text-center">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">{hero_block?.heading}</h1>
        <p class="text-xl mb-8">{hero_block?.subheading}</p>
        <a href={hero_block?.button?.link} class="bg-brand-accent text-brand-text font-semibold px-6 py-3 rounded-lg">{hero_block?.button?.text}</a>

        <div class="mt-12 p-6 bg-brand-surface text-brand-text rounded-xl shadow-lg max-w-md mx-auto">
          <h3 class="font-bold text-lg mb-2">Join our Waitlist for the 7-Day Gut Reset Guide</h3>
          <NewsletterForm form={capture.forms.waitlist} submitLabel="Get the Guide" />
        </div>
      </div>
    </section>

    <div class="space-y-16 py-16">
    {content_blocks?.map((block: any) => (
      <section class={`max-w-6xl mx-auto px-8 flex flex-col ${block.flipped ? 'md:flex-row-reverse' : 'md:flex-row'} items-center gap-12`}>
        <div class="flex-1">
          <h2 class="text-3xl font-bold mb-4">{block.heading}</h2>
          <p class="text-lg text-brand-text-muted mb-6">{block.text_content}</p>
          {block.button?.link && (
            <a href={block.button.link} class="text-brand-primary font-medium border-b-2 border-brand-primary pb-1">{block.button.text} &rarr;</a>
          )}
        </div>
        <div class="flex-1">
          <img src={block.image?.image_path} alt={block.image?.alt_text || ""} class="w-full h-auto rounded-lg shadow-lg" />
        </div>
      </section>
    ))}
    </div>
  </main>
</Layout>
