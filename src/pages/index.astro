---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchModal from '../components/SearchModal';
import InsuranceChecker from '../components/InsuranceChecker';

const coreConditions = [
  {
    title: "Hypothyroidism & Hashimoto's",
    url: "/conditions/hypothyroidism-hashimotos/",
    category: "Thyroid & Parathyroid",
    desc: "Complete T3/T4 hormone optimization and TPO antibody monitoring beyond basic TSH screening."
  },
  {
    title: "Type 2 Diabetes & Remission",
    url: "/conditions/type-2-diabetes/",
    category: "Diabetes & Metabolism",
    desc: "Targeting underlying insulin resistance with GLP-1/SGLT2 therapies and HOMA-IR tracking."
  },
  {
    title: "Type 1 Diabetes & CGM Technology",
    url: "/conditions/type-1-diabetes-cgm/",
    category: "Diabetes & Metabolism",
    desc: "Dexcom G7, Freestyle Libre 3, and automated pump tuning (Omnipod 5, Tandem Control-IQ)."
  },
  {
    title: "Thyroid Nodules & FNA Biopsy",
    url: "/conditions/thyroid-nodules-fna/",
    category: "Thyroid & Parathyroid",
    desc: "In-office high-resolution sonograms and same-day fine needle aspiration biopsies."
  },
  {
    title: "PCOS & Metabolic Balance",
    url: "/conditions/pcos-metabolic-health/",
    category: "Hormones & Reproductive",
    desc: "Addressing hyperinsulinemia, androgen excess, facial hair growth, and ovulation recovery."
  },
  {
    title: "Osteoporosis & Bone Density",
    url: "/conditions/osteoporosis-bone-health/",
    category: "Bone & Mineral",
    desc: "DEXA Trabecular Bone Scores, anabolic bone builders (Evenity), and fracture reduction."
  }
];
---

<BaseLayout
  title="Dr. Ameena Patel, MD, FACE — Austin Endocrinology & Diabetes Specialist"
  description="Board-certified endocrinologist in Austin, TX. Specialized evidence-led care for thyroid disease, Hashimoto's, Type 1 & 2 diabetes, continuous glucose monitoring, PCOS, and bone health."
>

  <!-- Hero Section -->
  <section class="relative bg-cream border-b border-border py-16 lg:py-24 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 bg-sage-light border border-sage/30 px-3.5 py-1.5 rounded-full text-xs font-semibold text-sage-dark">
            <span class="w-2 h-2 rounded-full bg-sage"></span>
            <span>Accepting New Patients in Central Austin</span>
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-bold text-charcoal leading-tight">
            Endocrinology Built Around Your Lived Experience, Backed by Science.
          </h1>

          <p class="text-base sm:text-lg text-charcoal-muted leading-relaxed font-sans max-w-2xl">
            If you are tired of being told "your lab work is completely normal" while still struggling with fatigue, weight gain, or blood sugar spikes, you belong here. Dr. Ameena Patel provides board-certified, root-cause subspecialty care in Austin, TX.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a href="/book/" class="bg-terracotta text-cream font-medium px-6 py-3.5 rounded-lg text-sm hover:bg-terracotta-hover transition-colors shadow-md">
              Schedule Your Consultation
            </a>
            <a href="/conditions/" class="bg-surface text-charcoal border border-border font-medium px-6 py-3.5 rounded-lg text-sm hover:bg-border/60 transition-colors">
              Explore Conditions Treated
            </a>
            <SearchModal client:load />
          </div>

          <!-- Credential Badges -->
          <div class="pt-6 border-t border-border/80 grid grid-cols-3 gap-4 text-xs font-medium text-charcoal-muted">
            <div>
              <strong class="block text-charcoal font-serif text-sm">Board Certified</strong>
              <span>Endocrinology & Diabetes</span>
            </div>
            <div>
              <strong class="block text-charcoal font-serif text-sm">FACE Fellow</strong>
              <span>Amer. Coll. of Endocrinology</span>
            </div>
            <div>
              <strong class="block text-charcoal font-serif text-sm">Austin Office</strong>
              <span>3801 N Lamar Blvd</span>
            </div>
          </div>
        </div>

        <!-- Doctor Portrait / Clinical Photography Block -->
        <div class="lg:col-span-5">
          <div class="relative rounded-2xl bg-surface border border-border p-4 shadow-lg">
            <div class="aspect-[4/5] rounded-xl bg-terracotta/10 border border-terracotta/20 flex flex-col items-center justify-center p-6 text-center space-y-4">
              <div class="w-24 h-24 rounded-full bg-terracotta text-cream flex items-center justify-center font-serif text-3xl font-bold shadow-md">
                AP
              </div>
              <div>
                <h2 class="font-serif text-xl font-bold text-charcoal">Dr. Ameena Patel, MD, FACE</h2>
                <p class="text-xs text-terracotta font-semibold mt-1">Endocrinologist & Clinical Specialist</p>
              </div>
              <p class="text-xs text-charcoal-muted leading-relaxed italic">
                "My clinical philosophy is simple: listen to the patient first, evaluate the complete biochemistry second, and build a partnership for lasting hormonal health."
              </p>
              <div class="pt-2 text-[11px] text-sage-dark bg-sage-light px-3 py-1.5 rounded-md font-medium border border-sage/20">
                In-Office Thyroid Ultrasound & Same-Day FNA Biopsy
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- The Diagnostic Difference Section -->
  <section class="py-16 bg-surface/50 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center space-y-4 mb-12">
        <span class="text-xs font-bold text-terracotta uppercase tracking-wider">The Clinical Difference</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal">
          Why "Normal Labs" Don't Always Mean You Feel Normal
        </h2>
        <p class="text-sm text-charcoal-muted leading-relaxed">
          Standard medical appointments often rely on a single screening test (like TSH or fasting glucose). Endocrine health is far more complex. We test peripheral conversion, active free hormone levels, and cellular sensitivity.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-cream border border-border rounded-xl p-6 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-lg bg-terracotta/10 text-terracotta flex items-center justify-center font-bold">01</div>
          <h3 class="font-serif text-lg font-bold text-charcoal">Full Panel Diagnostics</h3>
          <p class="text-xs text-charcoal-muted leading-relaxed">
            We measure Free T3, Free T4, TPO Antibodies, Reverse T3, and HOMA-IR insulin resistance markers rather than relying on basic TSH alone.
          </p>
        </div>

        <div class="bg-cream border border-border rounded-xl p-6 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-lg bg-sage/10 text-sage-dark flex items-center justify-center font-bold">02</div>
          <h3 class="font-serif text-lg font-bold text-charcoal">In-Office Imaging & Biopsy</h3>
          <p class="text-xs text-charcoal-muted leading-relaxed">
            Skip hospital delays. Dr. Ameena personally performs high-resolution thyroid ultrasounds and same-week fine needle aspiration (FNA) biopsies.
          </p>
        </div>

        <div class="bg-cream border border-border rounded-xl p-6 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-lg bg-terracotta/10 text-terracotta flex items-center justify-center font-bold">03</div>
          <h3 class="font-serif text-lg font-bold text-charcoal">Advanced Diabetes Tech</h3>
          <p class="text-xs text-charcoal-muted leading-relaxed">
            Specialized setup and tuning for Dexcom G7, Freestyle Libre 3, Omnipod 5, and Tandem Control-IQ to maximize your Time-in-Range.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Conditions Grid -->
  <section class="py-16 bg-cream border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 gap-4">
        <div>
          <span class="text-xs font-bold text-terracotta uppercase tracking-wider">Condition Library</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal mt-1">Specialized Endocrine Care Areas</h2>
        </div>
        <a href="/conditions/" class="text-xs font-semibold text-terracotta hover:underline flex items-center gap-1">
          View All 12+ Conditions Treated →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {coreConditions.map(item => (
          <a href={item.url} class="group bg-surface border border-border rounded-xl p-6 hover:border-terracotta/50 hover:shadow-md transition-all">
            <span class="text-[10px] font-bold uppercase tracking-wider text-sage-dark bg-sage-light px-2.5 py-1 rounded-full inline-block mb-3">
              {item.category}
            </span>
            <h3 class="font-serif text-lg font-bold text-charcoal group-hover:text-terracotta transition-colors mb-2">
              {item.title}
            </h3>
            <p class="text-xs text-charcoal-muted leading-relaxed">
              {item.desc}
            </p>
            <span class="inline-block mt-4 text-xs font-semibold text-terracotta group-hover:translate-x-1 transition-transform">
              Read Treatment Protocols →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Insurance & Pricing Quick-Checker Section -->
  <section class="py-16 bg-surface/30 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-6 space-y-4">
          <span class="text-xs font-bold text-terracotta uppercase tracking-wider">Financial Transparency</span>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal">
            Transparent Pricing & Major Insurance Coverage
          </h2>
          <p class="text-sm text-charcoal-muted leading-relaxed">
            We believe medical care should never come with unexpected bill surprises. We are in-network with major Texas PPO/POS insurance networks and offer clear self-pay consultation options with detailed billing super-bills for reimbursement.
          </p>
          <div class="space-y-2 text-xs text-charcoal font-medium">
            <div class="flex items-center gap-2">
              <span class="text-sage font-bold">✓</span>
              <span>In-Network: BCBS Texas, Aetna, UnitedHealthcare, Medicare Part B</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-sage font-bold">✓</span>
              <span>Self-Pay Initial Consult: $275 | Follow-up Consult: $150</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-sage font-bold">✓</span>
              <span>In-Office Thyroid Ultrasound / FNA Biopsy itemized pricing provided upfront</span>
            </div>
          </div>
          <div class="pt-2">
            <a href="/services/" class="text-xs font-semibold text-terracotta underline hover:text-terracotta-hover">
              View Complete Fee Schedule & Insurance Policies →
            </a>
          </div>
        </div>

        <div class="lg:col-span-6">
          <InsuranceChecker client:visible />
        </div>
      </div>
    </div>
  </section>

  <!-- Consultation Journey -->
  <section class="py-16 bg-cream border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="text-xs font-bold text-terracotta uppercase tracking-wider">What to Expect</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal">Your First Consultation Journey</h2>
        <p class="text-xs text-charcoal-muted">Designed to remove friction and provide actionable answers from day one.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-surface border border-border rounded-xl p-6 relative">
          <span class="text-3xl font-serif font-bold text-terracotta/30 block mb-2">01</span>
          <h3 class="font-serif font-bold text-base text-charcoal mb-2">Pre-Consult Lab Review</h3>
          <p class="text-xs text-charcoal-muted leading-relaxed">
            Submit your past 12 months of lab records and continuous glucose logs prior to your appointment so Dr. Ameena can analyze trends before you walk through the door.
          </p>
        </div>

        <div class="bg-surface border border-border rounded-xl p-6 relative">
          <span class="text-3xl font-serif font-bold text-terracotta/30 block mb-2">02</span>
          <h3 class="font-serif font-bold text-base text-charcoal mb-2">45-Minute Deep Dive</h3>
          <p class="text-xs text-charcoal-muted leading-relaxed">
            A comprehensive, unhurried face-to-face consultation reviewing your full medical history, symptom timeline, physical neck exam, and in-office ultrasound if needed.
          </p>
        </div>

        <div class="bg-surface border border-border rounded-xl p-6 relative">
          <span class="text-3xl font-serif font-bold text-terracotta/30 block mb-2">03</span>
          <h3 class="font-serif font-bold text-base text-charcoal mb-2">Tailored Care Plan</h3>
          <p class="text-xs text-charcoal-muted leading-relaxed">
            Leave with a written treatment roadmap: specialized lab orders, precise hormone or diabetes medication prescriptions, and direct portal access to our clinical team.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA & Map Section -->
  <section class="py-16 bg-surface/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      <h2 class="font-serif text-3xl sm:text-4xl font-bold text-charcoal">
        Take the First Step Toward Hormonal Clarity
      </h2>
      <p class="text-sm text-charcoal-muted max-w-xl mx-auto leading-relaxed font-sans">
        Schedule your comprehensive subspecialty consultation with Dr. Ameena Patel in Central Austin today.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a href="/book/" class="bg-terracotta text-cream font-medium px-8 py-3.5 rounded-lg text-sm hover:bg-terracotta-hover transition-colors shadow-md">
          Request Appointment Online
        </a>
        <a href="tel:5125550199" class="bg-cream text-charcoal border border-border font-medium px-8 py-3.5 rounded-lg text-sm hover:bg-border/60 transition-colors">
          Call Clinic: (512) 555-0199
        </a>
      </div>
      <p class="text-xs text-charcoal-muted pt-4">
        <strong>Austin Medical Plaza:</strong> 3801 N Lamar Blvd, Suite 300, Austin, TX 78756
      </p>
    </div>
  </section>

</BaseLayout>
