---
import Layout from "../layouts/Layout.astro";
import foodsData from "../../data/foods.json";
import symptomsData from "../../data/symptoms.json";
import protocolsData from "../../data/protocols.json";
import { Search, ShieldAlert, Apple, Stethoscope, BookOpen, ArrowRight, CheckCircle2, HeartPulse, Sparkles } from "@lucide/astro";

const title = "IBS Go — Practical Low-FODMAP Diet & Symptom Companion";
const description = "Warm, non-judgemental IBS symptom tracking & Monash-cited low-FODMAP food directory. Designed for people tired of being dismissed.";
---

<Layout title={title} seo={{ page_description: description }}>
  <!-- Hero Section with Food Directory & Symptom Guide Focus -->
  <section class="bg-gradient-to-b from-amber-100/60 via-amber-50/40 to-stone-50 py-12 sm:py-16 border-b border-stone-200/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-950 text-xs font-semibold mb-4 border border-amber-200">
          <HeartPulse class="w-3.5 h-3.5 text-amber-800" /> Grounded in Monash, NICE & ACG Guidelines
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-stone-900 tracking-tight leading-tight mb-6">
          Regain Control of Your Gut.<br class="hidden sm:inline"/> Without Fear or Dismissal.
        </h1>
        <p class="text-lg sm:text-xl text-stone-700 mb-8 leading-relaxed">
          IBS Go combines instant Monash-cited FODMAP food lookup, symptom timing analytics, and structured reintroduction protocols into a warm, practical companion.
        </p>

        <!-- Food Directory Search Direct CTA -->
        <div class="flex flex-col sm:flex-row gap-4 mb-8">
          <a href="/food/" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-amber-900 text-amber-50 font-bold rounded-xl shadow-sm hover:bg-amber-950 transition-colors text-sm">
            <Search class="w-4 h-4" /> Explore Food Directory & Thresholds
          </a>
          <a href="/symptoms/" class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-stone-900 font-bold rounded-xl border border-stone-300 shadow-sm hover:bg-stone-50 transition-colors text-sm">
            <Stethoscope class="w-4 h-4 text-emerald-800" /> Symptom & Trigger Library
          </a>
        </div>
      </div>
    </div>
  </section>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-16">
    <!-- Medical Warning & Non-Restriction Core Directive -->
    <div class="bg-amber-50 border-l-4 border-amber-600 p-6 rounded-r-xl shadow-sm text-stone-900 space-y-3">
      <div class="flex items-center gap-2 text-amber-950 font-bold">
        <ShieldAlert class="w-5 h-5 text-amber-700 shrink-0" />
        Clinical Rule: Low-FODMAP is Time-Limited Elimination (Not Permanent Restriction)
      </div>
      <p class="text-sm text-stone-800 leading-relaxed">
        The low-FODMAP diet is a 3-phase diagnostic protocol: <strong>2–6 weeks elimination</strong>, followed by <strong>systematic reintroduction</strong> to discover exact personal thresholds. Staying on strict restriction long-term harms colon bacterial diversity.
      </p>
      <div class="text-xs text-stone-700 pt-2 border-t border-amber-200 flex flex-wrap gap-x-6 gap-y-1">
        <span><strong>Monash Cutoffs:</strong> Updated 2023/2024</span>
        <span><strong>NICE CG61:</strong> Updated 2021</span>
        <span><strong>ACG Guideline:</strong> Published 2021</span>
      </div>
    </div>

    <!-- Quick Food Directory Section -->
    <section>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-stone-900 flex items-center gap-2">
            <Apple class="w-6 h-6 text-emerald-800" /> Low-FODMAP Serving Directory Preview
          </h2>
          <p class="text-stone-600 text-sm">Instant threshold lookups for green, amber, and red portions.</p>
        </div>
        <a href="/food/" class="text-amber-800 font-bold text-sm hover:underline flex items-center gap-1">
          View All 25+ Foods &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {foodsData.slice(0, 8).map((food) => (
          <a href={`/food/${food.slug}/`} class="bg-white p-4 rounded-xl border border-stone-200 shadow-sm hover:border-amber-400 transition-colors flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-[10px] font-bold text-stone-500 uppercase tracking-wider">{food.category}</span>
                <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full ${
                  food.fodmap_rating.includes('Low') ? 'bg-emerald-100 text-emerald-900' :
                  food.fodmap_rating.includes('Moderate') ? 'bg-amber-100 text-amber-900' :
                  'bg-rose-100 text-rose-900'
                }`}>
                  {food.fodmap_rating}
                </span>
              </div>
              <h3 class="font-bold text-stone-900 text-sm mb-1">{food.name}</h3>
              <p class="text-xs text-stone-600 line-clamp-2">{food.tips}</p>
            </div>
            <div class="mt-3 pt-2 border-t border-stone-100 text-[11px] font-mono text-emerald-800 font-semibold">
              Green: {food.green_serving}
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Symptom Library Section -->
    <section>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-bold text-stone-900 flex items-center gap-2">
            <Stethoscope class="w-6 h-6 text-amber-800" /> Symptom & Trigger Library
          </h2>
          <p class="text-stone-600 text-sm">Understand visceral pain, transit timing, and gut-brain axis flares.</p>
        </div>
        <a href="/symptoms/" class="text-amber-800 font-bold text-sm hover:underline flex items-center gap-1">
          View All 15 Symptom Guides &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {symptomsData.slice(0, 6).map((sym) => (
          <a href={`/symptoms/${sym.slug}/`} class="bg-white p-5 rounded-xl border border-stone-200 shadow-sm hover:border-amber-400 transition-colors">
            <span class="text-[10px] font-mono font-bold bg-amber-50 text-amber-900 px-2 py-0.5 rounded mb-2 inline-block">
              {sym.medical_name}
            </span>
            <h3 class="font-bold text-stone-900 text-base mb-2">{sym.name}</h3>
            <p class="text-xs text-stone-600 line-clamp-3 leading-relaxed">{sym.description}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Protocol Phase Cards -->
    <section>
      <h2 class="text-2xl font-bold text-stone-900 mb-6 flex items-center gap-2">
        <BookOpen class="w-6 h-6 text-amber-800" /> The 3 Protocol Phases
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {protocolsData.slice(0, 3).map((p, idx) => (
          <div class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm flex flex-col justify-between">
            <div>
              <span class="text-xs font-mono font-bold text-amber-900 bg-amber-100 px-2.5 py-1 rounded-md mb-3 inline-block">
                Phase {idx + 1}
              </span>
              <h3 class="text-lg font-bold text-stone-900 mb-2">{p.title}</h3>
              <p class="text-xs text-stone-600 mb-4 leading-relaxed">{p.subtitle}</p>
            </div>
            <a href={`/protocols/${p.slug}/`} class="text-amber-800 font-bold text-xs hover:underline flex items-center gap-1 pt-3 border-t border-stone-100">
              Read Phase Guide &rarr;
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- App Features & Pricing CTA -->
    <section class="bg-amber-900 text-stone-50 rounded-2xl p-8 sm:p-10 shadow-md flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="max-w-2xl space-y-4">
        <span class="text-xs font-bold text-amber-300 uppercase tracking-wider">IBS Go Companion App</span>
        <h2 class="text-2xl sm:text-3xl font-bold leading-tight">Track Meals & Symptoms in 5 Seconds. Zero Data Sales.</h2>
        <p class="text-amber-100 text-sm leading-relaxed">
          Log meals, monitor Bristol stool types, calculate FODMAP stacking risk, and export 1-click PDF reports for your gastroenterologist or dietitian.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <a href="/pricing/" class="px-6 py-3.5 bg-amber-500 text-stone-950 font-bold text-xs rounded-xl text-center hover:bg-amber-400 transition-colors shadow-sm">
          View Subscription Pricing
        </a>
        <a href="/research/" class="px-6 py-3.5 bg-amber-950 text-amber-200 font-bold text-xs rounded-xl text-center hover:bg-amber-900 border border-amber-800 transition-colors">
          Clinical Research Base
        </a>
      </div>
    </section>
  </main>
</Layout>
---
