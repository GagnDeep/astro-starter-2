---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
// Optional: sort posts by date
posts.sort((a, b) => new Date(b.data.date || '').valueOf() - new Date(a.data.date || '').valueOf());
---

<Layout
  title="Blog - usignpdf"
  seo={{
    page_description: "Articles and guides on electronic signatures, freelance contracts, and running a small business.",
    canonical_url: "https://usignpdf.com/blog/"
  }}
>
  <div class="max-w-4xl mx-auto py-20 px-4 md:px-8">
    <h1 class="text-4xl font-bold mb-12">Blog</h1>
    <div class="grid gap-8">
      {posts.map(post => (
        <article class="bg-surface p-6 border border-border rounded shadow-sm">
          <h2 class="text-2xl font-semibold mb-2"><a href={`/blog/${post.id}`} class="text-primary hover:text-accent transition-colors">{post.data.title}</a></h2>
          <p class="text-sm text-text-muted mb-4">{new Date(post.data.date || '').toLocaleDateString()}</p>
          <a href={`/blog/${post.id}`} class="text-accent font-medium hover:underline">Read more →</a>
        </article>
      ))}
    </div>
  </div>
</Layout>
