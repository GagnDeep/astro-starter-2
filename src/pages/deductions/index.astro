---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const deductions = await getCollection('deductions');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout
  title="Freelance Tax Deductions & Write-Offs Library | bro.tax"
  description="Explore our complete CPA-verified library of 12+ freelance tax write-offs, IRS rules, receipt requirements, and audit risk ratings."
  canonicalUrl={canonicalUrl}
>
  <section class="py-12 md:py-20 bg-[var(--color-bg-primary)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <span class="font-mono text-xs font-bold bg-[var(--color-bg-dark)] text-[var(--color-text-inverse)] px-3 py-1 rounded uppercase tracking-wider">
          Organic Write-Off Directory
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[var(--color-text-primary)] mt-4 tracking-tight">
          Freelance Write-Offs & Deductions Library
        </h1>
        <p class="text-lg text-[var(--color-text-secondary)] mt-4 leading-relaxed">
          Stop overpaying the IRS. Explore our complete collection of plain-English write-off guides reviewed by accredited CPAs. Every guide includes IRS citations, exact receipt rules, and audit risk scores.
        </p>
      </div>

      <!-- Grid of 12+ Deduction Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {deductions.map((item) => (
          <a
            href={`/deductions/${item.id}`}
            class="bg-[var(--color-bg-secondary)] border-2 border-[var(--color-border-default)] rounded-xl p-6 hover:border-[var(--color-border-accent)] hover:shadow-[4px_4px_0px_0px_var(--color-border-accent)] transition-all flex flex-col justify-between group"
          >
            <div>
              <div class="flex items-center justify-between font-mono text-xs mb-3">
                <span class="bg-[var(--color-bg-primary)] px-2 py-0.5 rounded border border-[var(--color-border-subtle)] font-bold text-[var(--color-text-secondary)]">
                  {item.data.category}
                </span>
                <span class="bg-[var(--color-bg-amber)] text-[var(--color-text-amber)] px-2 py-0.5 rounded font-bold">
                  {item.data.deduction_percentage}
                </span>
              </div>
              <h2 class="text-xl font-bold text-[var(--color-text-primary)] group-hover:text-[var(--color-text-emerald)] transition-colors">
                {item.data.title}
              </h2>
              <p class="text-xs text-[var(--color-text-secondary)] mt-2 leading-relaxed">
                {item.data.summary}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-[var(--color-border-subtle)] flex items-center justify-between font-mono text-xs">
              <span class="text-[var(--color-text-secondary)]">
                Audit Risk: <strong class="text-[var(--color-text-primary)]">{item.data.audit_risk}</strong>
              </span>
              <span class="font-bold text-[var(--color-text-emerald)] group-hover:underline">
                Read Rules &rarr;
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
