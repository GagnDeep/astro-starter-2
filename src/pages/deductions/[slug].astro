---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { ShieldCheck, FileCheck, ArrowLeft, BookOpen } from "@lucide/astro";

export async function getStaticPaths() {
  const deductions = await getCollection("deductions");
  return deductions.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const seo = {
  page_description: entry.data.seo?.page_description || entry.data.summary,
};
---

<Layout title={`${entry.data.title} — Deduceeri PFA 2025`} seo={seo}>
  <article class="py-12 md:py-16 bg-bg-base">
    <div class="mx-auto max-w-4xl px-6 md:px-8">
      <!-- Back Link -->
      <a
        href="/deductions/"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-text-muted hover:text-accent-lime mb-8 transition-colors"
      >
        <ArrowLeft class="w-4 h-4" />
        Înapoi la Ghidul de Deduceeri
      </a>

      <!-- Header Info -->
      <div class="border-b border-border-subtle pb-8 mb-8">
        <div class="flex flex-wrap items-center gap-3 mb-4 font-mono text-xs">
          <span class="px-2.5 py-1 bg-accent-lime/10 text-accent-lime border border-accent-lime/30 rounded font-bold uppercase">
            Deductibil {entry.data.deductibilityPercentage}%
          </span>
          <span class="text-text-muted">
            Categorie: <strong class="text-text-main">{entry.data.category}</strong>
          </span>
        </div>

        <h1 class="font-mono font-black text-3xl sm:text-4xl text-text-main tracking-tight mb-4">
          {entry.data.title}
        </h1>

        <p class="text-text-muted text-base leading-relaxed mb-6">
          {entry.data.summary}
        </p>

        <!-- Legal Citation Badge -->
        <div class="p-4 bg-bg-surface border border-border-subtle rounded-xl flex items-center gap-3 text-xs font-mono text-text-main">
          <ShieldCheck class="w-5 h-5 text-accent-lime shrink-0" />
          <div>
            <span class="text-text-muted block text-[10px] uppercase font-bold">Baza Legală Codul Fiscal:</span>
            <span>{entry.data.legalReference}</span>
          </div>
        </div>
      </div>

      <!-- Required Documents Box -->
      <div class="bg-bg-surface border border-border-subtle rounded-xl p-6 mb-10">
        <h3 class="font-mono font-bold text-base text-accent-lime mb-3 flex items-center gap-2">
          <FileCheck class="w-5 h-5" />
          Documente Obligatorii la Control ANAF
        </h3>
        <ul class="space-y-2 font-mono text-xs text-text-main">
          {entry.data.requiredDocuments.map((doc) => (
            <li class="flex items-start gap-2">
              <span class="text-accent-lime font-bold">✓</span>
              <span>{doc}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- MDX Content Body -->
      <div class="prose max-w-none text-text-main">
        <Content />
      </div>

      <!-- Benefits Bullets -->
      <div class="mt-12 p-6 bg-accent-lime/5 border border-accent-lime/20 rounded-xl">
        <h4 class="font-mono font-bold text-sm uppercase text-accent-lime mb-3">
          Beneficiul direct asupra impozitului tău:
        </h4>
        <ul class="space-y-2 font-sans text-xs text-text-main">
          {entry.data.benefits.map((b) => (
            <li class="flex items-start gap-2">
              <span class="text-accent-lime font-mono font-bold">•</span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </article>
</Layout>
