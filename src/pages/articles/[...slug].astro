---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import PostHero from "../../components/blog/post-hero/post-hero.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.mdx?$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} seo={post.data.seo}>
  <PostHero {...post.data.post_hero} />
  <div class="mx-auto max-w-3xl px-8 py-12 prose prose-lg text-[var(--text-color)]">
    <Content />
  </div>
</Layout>
