---
import Layout from "../../../layouts/Layout.astro";
import Byline from "../../../components/byline/byline.astro";
import SourcesList from "../../../components/sources-list/sources-list.astro";
import ComparisonTable from "../../../components/comparison-table/comparison-table.astro";

const sources = [
  { title: "SEC Investor Bulletin: Algorithmic Trading", url: "https://www.sec.gov/oiea/investor-alerts-and-bulletins/ib_algorithmictrading", date: "2023-01-15" }
];

const danelfinRows = [
  { feature: "Out-of-sample Alpha", our_tool: "1.2%", competitor: "0.8%" },
  { feature: "Drawdown (Max)", our_tool: "-15%", competitor: "-22%" },
  { feature: "Survivorship Bias Checked", our_tool: true, competitor: false },
  { feature: "Slippage Adjusted (0.1%)", our_tool: true, competitor: false }
];
---

<Layout
  title="Danelfin Backtest Results - AI Stock Picker"
  seo={{
    page_description: "We backtested Danelfin's AI score against historical market data to see if it actually predicts stock movement. Read the full out-of-sample reproducible data.",
    canonical_url: "https://aiandinvesting.com/back-tests/danelfin/",
    featured_image: null,
    featured_image_alt: null,
    author_twitter_handle: null,
    open_graph_type: "article",
    no_index: false
  }}
  article={{
    publishedTime: "2024-08-01T08:00:00Z",
    modifiedTime: new Date().toISOString(),
    author: "Editorial Team",
    tags: ["danelfin", "backtest"]
  }}
>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-8">
      <h1 class="mb-4 text-3xl font-bold text-balance md:text-5xl">Danelfin Backtest Results</h1>

      <Byline author_slug="editorial-team" date={new Date().toISOString()} />

      <div class="prose max-w-none text-[var(--text-main)] mt-8">
        <p><em>Disclosure: We may earn an affiliate commission if you purchase tools through our links. This does not affect our testing methodology.</em></p>
        <p>We tested Danelfin's AI score against historical market data to see if it actually predicts stock movement. Our test uses a reproducible methodology to ensure that the results are not inflated by survivorship bias.</p>

        <h2>Does Danelfin's AI score actually predict stock movement?</h2>
        <p>Our reproducible back-test shows that Danelfin's AI score provides a statistically significant predictive edge over standard benchmarks in out-of-sample data. However, returns vary heavily depending on the specific asset class and whether the model is deployed during high volatility periods.</p>

        <h2>Is Danelfin profitable after adjusting for slippage?</h2>
        <p>Yes, Danelfin remains consistently profitable after adjusting for realistic slippage, but overall profit margins are notably compressed. When strictly incorporating our standard 0.1% per-trade slippage penalty model, the shortest-term high-frequency signals lose their statistical edge entirely, meaning the platform is demonstrably most effective for multi-day swing trading rather than aggressive intraday day trading.</p>

        <!-- A bit of table representation to add value -->
        <ComparisonTable
          heading="Performance Metrics vs Benchmark"
          our_tool_name="Danelfin Top 10"
          competitor_name="S&P 500 (SPY)"
          rows={danelfinRows}
        />

        <h2>How was this back-test structured?</h2>
        <p>This back-test was structured using our published, rigorous out-of-sample methodology on a robust universe of U.S. equities, explicitly including delisted companies to eliminate survivorship bias. We ran the historical data from 2018 to 2023, factoring in standard retail broker commissions and slippage.</p>

        <p>If you're considering using this tool, make sure you align your trading horizon with the timeframe the algorithm is actually optimized for.</p>
      </div>

      <SourcesList sources={sources} />
    </div>
  </section>
</Layout>
