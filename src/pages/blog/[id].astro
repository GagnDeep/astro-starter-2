---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout
  title={`${post.data.title} | bro.tax Blog`}
  description={post.data.description}
  canonicalUrl={canonicalUrl}
  jsonLdType="Article"
  jsonLdData={{
    "@type": "Article",
    "headline": post.data.title,
    "description": post.data.description,
    "author": { "@type": "Organization", "name": post.data.author },
    "publisher": { "@type": "Organization", "name": "bro.tax" },
    "datePublished": post.data.pubDate
  }}
>
  <article class="py-12 md:py-20 bg-[var(--color-bg-primary)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="font-mono text-xs mb-6 text-[var(--color-text-secondary)]">
        <a href="/" class="hover:underline">Home</a> &gt; <a href="/blog" class="hover:underline">Blog</a> &gt; <span class="text-[var(--color-text-primary)] font-bold">{post.data.title}</span>
      </nav>

      <header class="border-b-2 border-[var(--color-border-default)] pb-8 mb-10">
        <div class="flex items-center gap-3 font-mono text-xs text-[var(--color-text-secondary)] mb-4">
          <span class="bg-[var(--color-bg-dark)] text-[var(--color-text-inverse)] px-3 py-1 rounded font-bold uppercase">
            Blog Post
          </span>
          <span>Published {post.data.pubDate}</span>
          <span>•</span>
          <span>By {post.data.author}</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-black text-[var(--color-text-primary)] tracking-tight leading-tight">
          {post.data.title}
        </h1>
        <p class="text-lg text-[var(--color-text-secondary)] mt-4 leading-relaxed font-sans">
          {post.data.description}
        </p>
      </header>

      <div class="prose max-w-none">
        <Content />
      </div>
    </div>
  </article>
</Layout>
