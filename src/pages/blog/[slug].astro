---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import CaptureForm from "../../components/forms/capture-form.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} seo={post.data.seo}>
  <main class="max-w-4xl mx-auto px-4 py-12 prose">
    <h1>{post.data.post_hero.heading}</h1>
    <p class="text-sm text-gray-500">{new Date(post.data.post_hero.date).toLocaleDateString()} - by {post.data.post_hero.author}</p>

    <div class="mt-8">
      <Content />
    </div>

    <div class="mt-12 p-6 bg-[var(--color-bg)] border border-[var(--color-border)]">
      <h2>Don't miss compliance updates</h2>
      <p>Subscribe to our newsletter for the latest ESPR news for the cable industry.</p>
      <CaptureForm form="newsletter">
        <div class="flex flex-col gap-4">
          <label class="flex flex-col gap-1">
            <span class="text-sm font-bold">Email Address</span>
            <input type="email" name="email" required class="p-2 border border-[var(--color-border)] rounded" />
          </label>
          <button type="submit" class="bg-[var(--color-primary)] text-white px-4 py-2 font-bold rounded cursor-pointer self-start hover:bg-[#b02d18]">
            Subscribe
          </button>
        </div>
      </CaptureForm>
    </div>
  </main>
</Layout>
