---
import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";
import NewsletterForm from "../../components/forms/newsletter-form.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id } }));
}

if (!Astro.params.slug) {
  throw new Error("Post slug is undefined");
}
const post = await getEntry("blog", Astro.params.slug);
if (!post) {
  throw new Error("Failed to get post with slug: " + Astro.params.slug);
}
const { Content } = await render(post);

const seo = {
  ...post.data.seo,
  title: post.data.title,
};
---

<Layout seo={seo} title={post.data.title}>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <article class="prose max-w-none">
      <h1>{post.data.title}</h1>
      <p class="text-sm text-text-muted mb-8">By {post.data.author} | {new Date(post.data.date).toLocaleDateString()}</p>

      <Content />

      <div class="mt-12 pt-8 border-t border-border">
        <h3>Stay Updated</h3>
        <p>Get the latest tax tips directly to your inbox.</p>
        <div class="bg-surface p-6 rounded shadow-sm">
          <NewsletterForm />
        </div>
      </div>
    </article>
  </main>
</Layout>
