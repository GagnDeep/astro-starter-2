---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---

<Layout title="Blog | Institute of Property">
  <div class="py-16 px-6 sm:px-12 bg-background min-h-screen">
    <div class="max-w-5xl mx-auto">
      <h1 class="text-4xl font-bold mb-4">The Analysis Blog</h1>
      <p class="text-lg text-text-muted mb-10">Data-driven breakdowns of property strategies and market realities.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {posts.map(post => (
          <a href={`/blog/${post.id.split('.')[0]}/`} class="card hover:shadow-md hover:border-accent transition-all">
            <h3 class="font-bold text-xl mb-2">{post.data.title}</h3>
            <p class="text-sm text-text-muted mb-4">{new Date(post.data.post_hero.date).toLocaleDateString()}</p>
            <p class="text-text-muted line-clamp-3">{post.data.post_hero.heading}</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</Layout>
