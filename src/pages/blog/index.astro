---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");

const seo = {
  page_description: "The latest insights, guides, and updates from the uDocumentViewer team on web performance and document rendering.",
};
---

<Layout title="Blog | uDocumentViewer" seo={seo}>
  <div class="max-w-7xl mx-auto px-4 py-20">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold mb-4">The Document Engineering Blog</h1>
      <p class="text-xl text-text/80 max-w-2xl mx-auto">Insights on web performance, PDF rendering, and building better web applications.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map(post => (
        <a href={`/blog/${post.id}/`} class="block bg-surface rounded-lg border border-border overflow-hidden hover:border-primary transition-colors flex flex-col h-full">
          <div class="p-6 flex-1">
            <h2 class="text-xl font-bold mb-3">{post.data.title}</h2>
            <p class="text-text/70 line-clamp-3">{post.data.seo?.page_description}</p>
          </div>
          <div class="px-6 py-4 border-t border-border bg-bg text-sm text-text/60">
            Read Article &rarr;
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
