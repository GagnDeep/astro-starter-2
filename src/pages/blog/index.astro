---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
---

<BaseLayout
  title="Patient Education & Insights — Dr. Ameena Patel, MD"
  description="Evidence-led patient education articles on thyroid lab testing, GLP-1 medications, continuous glucose monitor interpretation, and metabolic health."
>

  <div class="py-12 bg-cream border-b border-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

      <div class="space-y-3">
        <span class="text-xs font-bold text-terracotta uppercase tracking-wider">Patient Education</span>
        <h1 class="font-serif text-3xl sm:text-4xl font-bold text-charcoal">
          Evidence-Led Medical Insights
        </h1>
        <p class="text-sm text-charcoal-muted leading-relaxed max-w-2xl">
          In-depth articles written by Dr. Ameena Patel to empower patients with clinical clarity regarding thyroid labs, diabetes technology, and metabolic health.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {allPosts.map((item) => (
          <a href={`/blog/${item.id.replace(/\.(md|mdx)$/, '')}/`} class="group bg-surface border border-border rounded-xl p-6 hover:border-terracotta/50 hover:shadow-md transition-all flex flex-col justify-between space-y-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between text-[11px] text-charcoal-muted">
                <span>{new Date(item.data.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                <span class="bg-sage-light text-sage-dark font-semibold px-2 py-0.5 rounded-full">
                  {item.data.tags[0] || 'Medical'}
                </span>
              </div>
              <h2 class="font-serif text-lg font-bold text-charcoal group-hover:text-terracotta transition-colors leading-snug">
                {item.data.title}
              </h2>
              <p class="text-xs text-charcoal-muted line-clamp-3 leading-relaxed">
                {item.data.summary}
              </p>
            </div>
            <div class="text-[11px] text-terracotta font-semibold flex items-center justify-between border-t border-border/60 pt-3 mt-auto">
              <span>Read Full Article</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>

</BaseLayout>
