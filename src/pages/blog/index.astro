---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Blog">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-8">Blog</h1>
    <p class="text-lg text-secondary mb-8">Browse our comprehensive blog.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      <a href="/blog/how-to-compress-video" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">how to compress video</a>
      <a href="/blog/best-video-formats" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">best video formats</a>
      <a href="/blog/mkv-vs-mp4" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">mkv vs mp4</a>
      <a href="/blog/h264-vs-h265" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">h264 vs h265</a>
      <a href="/blog/fix-audio-sync" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">fix audio sync</a>
      <a href="/blog/video-for-web" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">video for web</a>
      <a href="/blog/reduce-file-size" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">reduce file size</a>
      <a href="/blog/play-mkv-mac" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">play mkv mac</a>
      <a href="/blog/video-editing-basics" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">video editing basics</a>
      <a href="/blog/subtitles-guide" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">subtitles guide</a>
      <a href="/blog/video-quality-metrics" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">video quality metrics</a>
      <a href="/blog/streaming-protocols" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">streaming protocols</a>
    </div>
  </div>
</Layout>
