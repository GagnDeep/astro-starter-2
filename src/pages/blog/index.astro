---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
// Sort by date descending
posts.sort((a, b) => new Date(b.data.post_hero.date).getTime() - new Date(a.data.post_hero.date).getTime());

const page = {
  data: {
    title: "Insights & Analysis | Dubai US Capital",
    seo: {
      page_description: "Expert insights on US real estate investing, tax strategies, and market analysis for UAE residents.",
    }
  }
};
---

<Layout title={page.data.title} seo={page.data.seo}>
  <div class="max-w-5xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-slate-900 mb-6">Insights & Analysis</h1>
    <p class="text-lg text-slate-700 mb-12">
      In-depth articles and tax guides for Gulf-based investors navigating the US real estate market.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="block bg-white rounded-lg shadow-sm border border-slate-200 hover:border-blue-500 transition-colors overflow-hidden flex flex-col">
          <div class="p-6 flex-1 flex flex-col">
            <div class="text-xs font-semibold text-blue-600 mb-2">{new Date(post.data.post_hero.date).toLocaleDateString()}</div>
            <h2 class="text-xl font-bold text-slate-900 mb-3">{post.data.title}</h2>
            <p class="text-slate-600 text-sm flex-1">{post.data.seo?.page_description || ""}</p>
            <div class="mt-4 text-blue-600 text-sm font-medium">Read article &rarr;</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
