---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Seo from "../../components/seo/seo.astro";

const posts = await getCollection("blog");

const seo = { page_description: "Insights & Guides index.", no_index: false };
---
<Layout title="Insights & Guides">
  <Seo seo={seo} />
  <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold mb-8">Insights & Guides</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post: any) => (
        <a href={`/blog/${post.id}/`} class="p-4 border border-secondary rounded hover:bg-surface text-primary font-medium">{post.data.title}</a>
      ))}
    </div>
  </div>
</Layout>
