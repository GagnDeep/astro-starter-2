---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import GuideForm from "../../components/forms/guide-form.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
  title={post.data.title}
  seo={post.data.seo}
  post_hero={post.data.post_hero}
>
  <div class="container py-12 lg:py-20">
    <article class="max-w-3xl mx-auto">
      <header class="mb-10 text-center">
        <div class="text-sm text-brand-emerald font-semibold mb-4 flex items-center justify-center gap-2">
          {post.data.post_hero.tags.map((tag: string) => (
            <span class="bg-brand-emerald/10 px-2 py-1 rounded">{tag}</span>
          ))}
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-6 text-brand-navy leading-tight">{post.data.post_hero.heading}</h1>
        <div class="flex items-center justify-center gap-4 text-brand-slate">
          <span>By <strong>{post.data.post_hero.author}</strong></span>
          <span>&bull;</span>
          <time datetime={new Date(post.data.post_hero.date).toISOString()}>
            {new Date(post.data.post_hero.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
        </div>
      </header>

      <img
        src={post.data.post_hero.image}
        alt={post.data.post_hero.image_alt}
        class="w-full h-auto rounded-card shadow-sm mb-12"
      />

      <div class="prose prose-lg max-w-none prose-a:text-brand-emerald hover:prose-a:text-brand-emerald-hover">
        <Content />
      </div>

      <div class="mt-16 pt-12 border-t border-slate-200">
        <div class="bg-brand-navy text-white p-8 rounded-card text-center">
          <h3 class="text-2xl font-bold mb-4">Want more insights like this?</h3>
          <p class="text-slate-300 mb-6">Join 5,000+ CPAs receiving our weekly newsletter on scaling tax practices.</p>
          <div class="max-w-md mx-auto text-left">
            <GuideForm
              title="Join the Newsletter"
              subtitle="Weekly marketing tips for tax professionals."
              submitLabel="Subscribe"
            />
          </div>
        </div>
      </div>
    </article>
  </div>
</Layout>
