---
import Layout from "../layouts/Layout.astro";
import { Check } from "@lucide/astro";

const seo = {
  page_description: "Transparent pricing for exclusive tax preparation and resolution leads. No monthly retainers, no setup fees. Pay only for the leads you receive.",
  canonical_url: "/pricing/",
  open_graph_type: "website"
};
---

<Layout title="Pricing | Institute for Tax" seo={seo}>
  <div class="container py-12 lg:py-24">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h1 class="text-4xl md:text-5xl font-bold mb-6">Simple, Transparent Pricing</h1>
      <p class="text-xl text-brand-slate">
        No retainers. No agency fees. No long-term contracts. You only pay for the exclusive, pre-qualified leads delivered to your inbox.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">

      <!-- Tax Prep -->
      <div class="bg-white rounded-card border border-slate-200 shadow-sm p-8 flex flex-col h-full relative">
        <h2 class="text-2xl font-bold text-brand-navy mb-2">Tax Preparation Leads</h2>
        <p class="text-brand-slate mb-6">High-income individuals ($100k+) and business owners needing annual filing and planning.</p>
        <div class="mb-6 pb-6 border-b border-slate-100">
          <span class="text-4xl font-bold text-brand-navy">$75</span>
          <span class="text-brand-slate font-medium">/ lead</span>
        </div>
        <ul class="space-y-4 mb-8 flex-1">
          <li class="flex items-start gap-3">
            <Check class="w-5 h-5 text-brand-emerald shrink-0 mt-0.5" />
            <span>100% Exclusive (never shared)</span>
          </li>
          <li class="flex items-start gap-3">
            <Check class="w-5 h-5 text-brand-emerald shrink-0 mt-0.5" />
            <span>Income verified >$100,000 or business entity</span>
          </li>
          <li class="flex items-start gap-3">
            <Check class="w-5 h-5 text-brand-emerald shrink-0 mt-0.5" />
            <span>Not a "price shopper" (agrees to professional minimums)</span>
          </li>
          <li class="flex items-start gap-3">
            <Check class="w-5 h-5 text-brand-emerald shrink-0 mt-0.5" />
            <span>Real-time delivery via Email/SMS/Webhook</span>
          </li>
        </ul>
        <a href="/#get-leads" class="btn-secondary w-full">Apply for Territory</a>
      </div>

      <!-- Tax Resolution -->
      <div class="bg-brand-navy rounded-card shadow-lg p-8 flex flex-col h-full relative border border-brand-emerald/30 transform md:-translate-y-4">
        <div class="absolute top-0 right-8 transform -translate-y-1/2 bg-brand-emerald text-white px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full">
          Highest ROI
        </div>
        <h2 class="text-2xl font-bold text-white mb-2">Tax Resolution Leads</h2>
        <p class="text-slate-300 mb-6">Individuals and businesses with $10k+ in tax debt seeking OIC, installment agreements, or audit defense.</p>
        <div class="mb-6 pb-6 border-b border-white/10">
          <span class="text-4xl font-bold text-white">$150</span>
          <span class="text-slate-300 font-medium">/ lead</span>
        </div>
        <ul class="space-y-4 mb-8 flex-1 text-slate-300">
          <li class="flex items-start gap-3">
            <Check class="w-5 h-5 text-brand-emerald shrink-0 mt-0.5" />
            <span class="text-white">100% Exclusive (never shared)</span>
          </li>
          <li class="flex items-start gap-3">
            <Check class="w-5 h-5 text-brand-emerald shrink-0 mt-0.5" />
            <span class="text-white">Minimum $10,000+ verified tax debt</span>
          </li>
          <li class="flex items-start gap-3">
            <Check class="w-5 h-5 text-brand-emerald shrink-0 mt-0.5" />
            <span class="text-white">Actively seeking representation immediately</span>
          </li>
          <li class="flex items-start gap-3">
            <Check class="w-5 h-5 text-brand-emerald shrink-0 mt-0.5" />
            <span class="text-white">Real-time delivery via Email/SMS/Webhook</span>
          </li>
        </ul>
        <a href="/#get-leads" class="btn-primary w-full shadow-lg shadow-brand-emerald/20">Apply for Territory</a>
      </div>

    </div>

    <div class="mt-20 max-w-3xl mx-auto text-center">
      <h3 class="text-2xl font-bold mb-4">Refund Policy</h3>
      <p class="text-brand-slate mb-6">
        We stand behind our lead quality. If you receive a lead with a disconnected phone number, completely invalid contact information, or someone looking for a service you do not provide (if properly configured), you can request a refund within 5 days of delivery. No questions asked.
      </p>
      <p class="font-medium text-brand-navy">Minimum initial deposit: $500 (applied entirely to your lead balance).</p>
    </div>
  </div>
</Layout>
