---
import Layout from '../layouts/Layout.astro';
import CaptureForm from '../components/forms/capture-form.astro';

const seo = {
  page_description: "WaterTrackLog Pricing",
  no_index: false,
};
---
<Layout title="Pricing" seo={seo}>
  <div class="mx-auto max-w-4xl px-6 py-12">
    <h1 class="text-4xl font-bold mb-8 text-center">Pricing</h1>
    <div class="grid md:grid-cols-2 gap-8 mt-12">
      <div class="border border-gray-200 rounded-lg p-8 shadow-sm">
        <h2 class="text-2xl font-bold mb-4">Basic (Free)</h2>
        <ul class="mb-8 list-disc pl-5">
          <li>Daily tracking</li>
          <li>Basic hydration tools</li>
          <li>Ad-free experience</li>
        </ul>
        <CaptureForm form="waitlist" submitLabel="Get Started" />
      </div>
      <div class="border border-blue-600 rounded-lg p-8 shadow-sm bg-blue-50">
        <h2 class="text-2xl font-bold mb-4 text-blue-900">Pro ($4/mo)</h2>
        <ul class="mb-8 list-disc pl-5">
          <li>Smart desktop reminders</li>
          <li>Historical data exports</li>
          <li>Custom hydration goals</li>
        </ul>
        <CaptureForm form="waitlist" submitLabel="Join Pro Waitlist" />
      </div>
    </div>
  </div>
</Layout>
