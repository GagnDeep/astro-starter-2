---
import Layout from "../layouts/Layout.astro";
import { CheckCircle2, ShieldCheck, ArrowRight, HelpCircle } from "@lucide/astro";

const seo = {
  page_description:
    "Prețuri transparente și fixe pentru servicii de contabilitate și depunere Declarația Unică PFA și SRL în 2025. De la 89 RON/lună.",
};
---

<Layout title="Tarife & Abonamente 2025 — ro.tax" seo={seo}>
  <section class="py-12 md:py-20 bg-bg-base border-b border-border-subtle">
    <div class="mx-auto max-w-6xl px-6 md:px-8 text-center max-w-3xl">
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-accent-lime block mb-2">
        [ FĂRĂ TARIFAREL ASCUNSE ]
      </span>
      <h1 class="font-mono font-black text-3xl sm:text-4xl md:text-5xl text-text-main tracking-tight mb-4">
        Contabilitate Fără Costume. Prețuri Fixe.
      </h1>
      <p class="text-text-muted text-base leading-relaxed">
        Plătești doar pentru serviciile de care ai nevoie. Fără ore de consultanță umflate, fără abonamente minime pe un an.
      </p>
    </div>
  </section>

  <section class="py-16 bg-bg-surface border-b border-border-subtle">
    <div class="mx-auto max-w-6xl px-6 md:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- PFA Complete -->
        <div class="bg-bg-base border-2 border-accent-lime rounded-2xl p-8 flex flex-col justify-between relative shadow-xl">
          <span class="absolute -top-3.5 left-6 bg-accent-lime text-bg-base font-mono font-bold text-[11px] uppercase px-3 py-1 rounded-full">
            Recomandat Freelanceri PFA
          </span>
          <div>
            <h3 class="font-mono font-bold text-2xl text-text-main mb-2">PFA Complete</h3>
            <p class="text-xs text-text-muted mb-6">Pachet integral pentru PFA în Regim Real</p>
            <div class="mb-6">
              <span class="font-mono text-4xl font-extrabold text-accent-lime tabular-nums">89 lei</span>
              <span class="text-text-muted text-xs font-mono"> / lună</span>
            </div>
            <ul class="space-y-3 font-sans text-xs text-text-main mb-8">
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-accent-lime shrink-0" />
                <span>Emitere nelimitată facturi & integrare e-Factura SPV</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-accent-lime shrink-0" />
                <span>Calcul automat CASS, CAS și Impozit 10%</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-accent-lime shrink-0" />
                <span>Scanare automată bonuri & înregistrare cheltuieli</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-accent-lime shrink-0" />
                <span>Generare & Depunere 1-click Declarația Unică 212</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-accent-lime shrink-0" />
                <span>Asistență rapidă prin chat în aplicație</span>
              </li>
            </ul>
          </div>
          <button class="w-full bg-accent-lime hover:bg-accent-lime-hover text-bg-base font-mono font-bold text-xs uppercase py-4 rounded-xl transition-all">
            Incearcă 14 Zile Gratuit
          </button>
        </div>

        <!-- Solo SRL -->
        <div class="bg-bg-base border border-border-subtle rounded-2xl p-8 flex flex-col justify-between">
          <div>
            <h3 class="font-mono font-bold text-2xl text-text-main mb-2">Solo SRL</h3>
            <p class="text-xs text-text-muted mb-6">Contabilitate completă Microîntreprindere</p>
            <div class="mb-6">
              <span class="font-mono text-4xl font-extrabold text-text-main tabular-nums">189 lei</span>
              <span class="text-text-muted text-xs font-mono"> / lună</span>
            </div>
            <ul class="space-y-3 font-sans text-xs text-text-main mb-8">
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-accent-lime shrink-0" />
                <span>Contabilitate primară & balanță lunară</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-accent-lime shrink-0" />
                <span>Calcul dividende trimestriale & impozit 8%</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-accent-lime shrink-0" />
                <span>Salarizare inclusă pentru 1 angajat</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-accent-lime shrink-0" />
                <span>Contabil autorizat CECCAR dedicat</span>
              </li>
            </ul>
          </div>
          <button class="w-full bg-bg-surface hover:bg-bg-surface-hover border border-border-subtle text-text-main font-mono font-bold text-xs uppercase py-4 rounded-xl transition-all">
            Selectează Planul SRL
          </button>
        </div>

        <!-- Single Return -->
        <div class="bg-bg-base border border-border-subtle rounded-2xl p-8 flex flex-col justify-between">
          <div>
            <h3 class="font-mono font-bold text-2xl text-text-main mb-2">Declarația Unică</h3>
            <p class="text-xs text-text-muted mb-6">Serviciu unal pentru Formularul 212</p>
            <div class="mb-6">
              <span class="font-mono text-4xl font-extrabold text-text-main tabular-nums">349 lei</span>
              <span class="text-text-muted text-xs font-mono"> / an</span>
            </div>
            <ul class="space-y-3 font-sans text-xs text-text-main mb-8">
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-accent-lime shrink-0" />
                <span>Auditul veniturilor și cheltuielilor 2024</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-accent-lime shrink-0" />
                <span>Calcul optimizat al pragurilor CASS și CAS</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-accent-lime shrink-0" />
                <span>Depunere electronică securizată la ANAF</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-accent-lime shrink-0" />
                <span>Predare recipisă de confirmare oficială</span>
              </li>
            </ul>
          </div>
          <button class="w-full bg-bg-surface hover:bg-bg-surface-hover border border-border-subtle text-text-main font-mono font-bold text-xs uppercase py-4 rounded-xl transition-all">
            Comandă Depunerea
          </button>
        </div>
      </div>
    </div>
  </section>
</Layout>
