---
import Layout from "../../layouts/Layout.astro";

const guidesList = [
  { slug: "first-visit-what-to-expect", title: "First Visit: What to Expect at Your Appointment", desc: "Comprehensive breakdown of your initial 60-minute consultation, intake paperwork, and lab review.", category: "Appointment Prep" },
  { slug: "preparing-for-thyroid-ultrasound", title: "Preparing for Your Thyroid Ultrasound", desc: "Clothing recommendations, neck positioning, and what the sonographer looks for during imaging.", category: "Procedure Prep" },
  { slug: "fasting-lab-work-prep-guide", title: "Fasting Lab Work Preparation Protocol", desc: "Fasting hours, water intake, coffee rules, and morning biotin/medication timing before labs.", category: "Lab Prep" },
  { slug: "understanding-your-a1c-results", title: "Decoding Your HbA1c Results", desc: "Translating A1C percentages into Estimated Average Glucose (eAG) mg/dL and target ranges.", category: "Lab Interpretation" },
  { slug: "how-to-wear-and-track-cgm", title: "How to Wear, Apply, and Calibrate Your CGM", desc: "Upper arm/abdomen insertion, skin prep, avoiding compression lows, and interpreting trends.", category: "Diabetes Tech" },
  { slug: "managing-hypothyroidism-symptoms", title: "Tracking & Managing Hypothyroidism Symptoms", desc: "Symptom tracking sheet, morning levothyroxine timing with calcium/coffee, and TSH lab prep.", category: "Condition Management" },
  { slug: "navigating-pcos-lifestyle-and-nutrition", title: "Navigating PCOS Lifestyle & Nutrition", desc: "Evidence-based dietary strategies, protein distribution, and exercise for insulin sensitivity.", category: "Lifestyle & Nutrition" },
  { slug: "dexa-scan-preparation-and-t-scores", title: "DEXA Bone Scan Preparation & T-Scores", desc: "Calcium supplement hold rules before DEXA, T-scores vs Z-scores, and FRAX scores.", category: "Bone Health" },
  { slug: "talking-to-your-family-about-hereditary-endocrine-conditions", title: "Hereditary Endocrine Conditions & Family History", desc: "Discussing thyroid, MEN syndromes, and autoimmune diabetes with relatives for risk assessment.", category: "Family Health" },
  { slug: "traveling-with-insulin-and-injectables", title: "Traveling with Insulin & Injectable Medications", desc: "TSA security screening rules, cooling pouches, time zone adjustments, and backup supplies.", category: "Travel & Safety" },
  { slug: "medication-prior-authorization-guide", title: "Navigating Medication Prior Authorizations", desc: "Step-by-step guide to insurance prior authorizations for GLP-1s, CGMs, and branded thyroid meds.", category: "Insurance & Access" },
  { slug: "telehealth-consultation-checklist", title: "Telehealth Visit Preparation Checklist", desc: "Tech requirements, camera setup, lab upload checklist, and home blood pressure/glucose logging.", category: "Virtual Care" }
];
---

<Layout title="12 Patient Care Guides">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 space-y-10">
    <div class="space-y-3 border-b border-stone-200 pb-6">
      <span class="badge-reviewed">Patient Education</span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#1B4332]">12 Practical Patient Care Guides</h1>
      <p class="text-stone-600 text-sm sm:text-base max-w-3xl">
        Step-by-step preparation protocols, lab result decoding sheets, and actionable lifestyle checklists.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {guidesList.map((item) => (
        <a href={`/guides/${item.slug}/`} class="bg-white p-6 rounded-xl border border-stone-200 hover:border-[#2D6A4F] hover:shadow-md transition space-y-3 flex flex-col justify-between group">
          <div class="space-y-2">
            <span class="badge-category">{item.category}</span>
            <h2 class="text-lg font-serif font-bold text-[#1B4332] group-hover:text-[#2D6A4F] transition">{item.title}</h2>
            <p class="text-xs text-stone-600 leading-relaxed">{item.desc}</p>
          </div>
          <div class="text-xs font-semibold text-[#2D6A4F] group-hover:underline pt-2">
            Read Patient Guide →
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
