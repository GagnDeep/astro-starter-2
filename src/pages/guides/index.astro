---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const guides = await getCollection('guides');
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<Layout
  title="Freelance Tax Guides & Schedule C Manuals | bro.tax"
  description="Comprehensive, plain-English tax guides for freelancers, creators, and gig workers. Learn 1099 vs W2 rules, quarterly estimated taxes, and Schedule C."
  canonicalUrl={canonicalUrl}
>
  <section class="py-12 md:py-20 bg-[var(--color-bg-primary)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-12">
        <span class="font-mono text-xs font-bold bg-[var(--color-bg-dark)] text-[var(--color-text-inverse)] px-3 py-1 rounded uppercase tracking-wider">
          Comprehensive Manuals
        </span>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[var(--color-text-primary)] mt-4 tracking-tight">
          Freelance Tax Guides
        </h1>
        <p class="text-lg text-[var(--color-text-secondary)] mt-4 leading-relaxed">
          Deep-dive guides written in plain English by CPAs. Master 1099 tax math, quarterly deadlines, Form 1040 Schedule C line items, and LLC vs Sole Prop decisions.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {guides.map((guide) => (
          <a
            href={`/guides/${guide.id}`}
            class="bg-[var(--color-bg-secondary)] border-2 border-[var(--color-border-default)] rounded-xl p-8 hover:border-[var(--color-border-accent)] hover:shadow-[6px_6px_0px_0px_var(--color-border-accent)] transition-all flex flex-col justify-between group"
          >
            <div>
              <div class="flex items-center justify-between font-mono text-xs mb-4">
                <span class="bg-[var(--color-bg-primary)] px-2.5 py-1 rounded font-bold border border-[var(--color-border-subtle)]">
                  {guide.data.category}
                </span>
                <span class="text-[var(--color-text-secondary)] font-bold">
                  {guide.data.readTime}
                </span>
              </div>
              <h2 class="text-2xl font-extrabold text-[var(--color-text-primary)] group-hover:text-[var(--color-text-emerald)] transition-colors">
                {guide.data.title}
              </h2>
              <p class="text-sm text-[var(--color-text-secondary)] mt-3 leading-relaxed">
                {guide.data.description}
              </p>
            </div>

            <div class="mt-8 pt-4 border-t border-[var(--color-border-subtle)] flex items-center justify-between font-mono text-xs">
              <span class="text-[var(--color-text-secondary)]">By {guide.data.author}</span>
              <span class="font-bold text-[var(--color-text-emerald)] group-hover:underline">Read Full Guide &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
