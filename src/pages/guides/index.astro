---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
---
<Layout title="Document Conversion Guides" seo={{ page_description: "Expert guides on document formatting and conversion." }}>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Guides</h1>
    <div class="grid gap-6">
      {posts.map(post => (
        <a href={`/guides/${post.id}/`} class="block p-6 bg-surface border border-border rounded shadow-sm hover:border-brand transition-all">
          <h2 class="text-xl font-semibold text-brand mb-2">{post.data.title}</h2>
          <p class="text-sm text-text-muted">{post.data.seo?.page_description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
