---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { ArrowLeft, Clock, Calendar, ShieldCheck } from "@lucide/astro";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const seo = {
  page_description: entry.data.seo?.page_description || entry.data.description,
};
---

<Layout title={`${entry.data.title} — Ghid Fiscal ro.tax`} seo={seo}>
  <article class="py-12 md:py-16 bg-bg-base">
    <div class="mx-auto max-w-4xl px-6 md:px-8">
      <a
        href="/guides/"
        class="inline-flex items-center gap-1.5 font-mono text-xs text-text-muted hover:text-accent-lime mb-8 transition-colors"
      >
        <ArrowLeft class="w-4 h-4" />
        Înapoi la Ghiduri
      </a>

      <div class="border-b border-border-subtle pb-8 mb-8">
        <div class="flex flex-wrap items-center gap-4 mb-4 font-mono text-xs text-text-muted">
          <span class="px-2.5 py-1 bg-accent-lime/10 text-accent-lime border border-accent-lime/30 rounded font-bold uppercase">
            {entry.data.difficulty}
          </span>
          <span class="flex items-center gap-1">
            <Clock class="w-3.5 h-3.5" />
            {entry.data.readTimeMinutes} minute lectură
          </span>
          <span class="flex items-center gap-1">
            <Calendar class="w-3.5 h-3.5" />
            Actualizat: {new Date(entry.data.updatedDate).toLocaleDateString("ro-RO")}
          </span>
        </div>

        <h1 class="font-mono font-black text-3xl sm:text-4xl text-text-main tracking-tight mb-4">
          {entry.data.title}
        </h1>

        <p class="text-text-muted text-base leading-relaxed">
          {entry.data.description}
        </p>
      </div>

      <div class="prose max-w-none text-text-main">
        <Content />
      </div>

      <div class="mt-12 p-6 bg-bg-surface border border-border-subtle rounded-xl flex items-start gap-3">
        <ShieldCheck class="w-5 h-5 text-accent-lime shrink-0 mt-0.5" />
        <p class="text-xs text-text-muted font-sans leading-relaxed">
          <strong>Rigurozitate garantată:</strong> Acest ghid este menținut la zi în acord cu modificările Codului Fiscal publicate în Monitorul Oficial. Pentru cazuri specifice de restructurare corporativă, recomandăm verificarea de către un contabil autorizat.
        </p>
      </div>
    </div>
  </article>
</Layout>
