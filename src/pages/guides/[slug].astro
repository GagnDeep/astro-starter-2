---
import Layout from "../../layouts/Layout.astro";
import { guidesData } from "../../data/guidesData";

export function getStaticPaths() {
  return guidesData.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;

const schemaData = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": guide.title,
  "description": guide.overview,
  "step": guide.timeline.map((t, idx) => ({
    "@type": "HowToStep",
    "position": idx + 1,
    "name": t.step,
    "text": t.detail || t.description
  }))
};
---

<Layout title={guide.title} schemaData={schemaData}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10">
    <div class="space-y-4 border-b border-stone-200 pb-8">
      <div class="flex flex-wrap items-center gap-2 text-xs">
        <a href="/guides/" class="text-[#2D6A4F] hover:underline font-semibold">← All Patient Guides</a>
        <span class="text-stone-300">•</span>
        <span class="badge-category">{guide.category}</span>
        <span class="badge-reviewed">Reviewed by {guide.reviewedBy} on {guide.lastReviewed}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#1B4332]">{guide.title}</h1>
      <p class="text-lg text-stone-600 leading-relaxed">{guide.subtitle}</p>
    </div>

    <section class="space-y-3">
      <h2 class="text-2xl font-serif font-bold text-[#1B4332]">Overview</h2>
      <p class="text-stone-800 text-base leading-relaxed">{guide.overview}</p>
    </section>

    <section class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm space-y-4">
      <h2 class="text-xl font-serif font-bold text-[#1B4332] flex items-center gap-2">
        <span>📋</span> Preparation & Action Checklist
      </h2>
      <ul class="space-y-2.5 text-xs text-stone-800">
        {guide.checklist.map((item) => (
          <li class="flex items-start gap-3 bg-[#FDFBF7] p-3 rounded border border-stone-200">
            <input type="checkbox" class="mt-0.5 rounded text-[#2D6A4F] focus:ring-[#2D6A4F]" />
            <span class="font-medium leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="space-y-4">
      <h2 class="text-2xl font-serif font-bold text-[#1B4332]">Step-by-Step Timeline</h2>
      <div class="space-y-3">
        {guide.timeline.map((step, idx) => (
          <div class="bg-white p-4 rounded-xl border border-stone-200 shadow-sm flex items-start gap-4">
            <div class="w-8 h-8 rounded-full bg-[#E8F5E9] text-[#1B4332] font-bold flex items-center justify-center shrink-0 text-sm">
              {idx + 1}
            </div>
            <div class="space-y-1">
              <h3 class="font-serif font-bold text-sm text-[#1B4332]">{step.step}</h3>
              <p class="text-xs text-stone-700 leading-relaxed">{step.detail || step.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    {guide.faqs && guide.faqs.length > 0 && (
      <section class="space-y-4">
        <h2 class="text-2xl font-serif font-bold text-[#1B4332]">Frequently Asked Questions</h2>
        <div class="space-y-3">
          {guide.faqs.map((faq) => (
            <div class="bg-white p-5 rounded-xl border border-stone-200 space-y-1">
              <h3 class="font-serif font-bold text-sm text-[#1B4332]">Q: {faq.question}</h3>
              <p class="text-xs text-stone-700 leading-relaxed">A: {faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <div class="disclaimer-box">
      <strong>Medical Disclaimer:</strong> Patient guides are provided for educational purposes. Always consult Dr. Ameena, MD or your clinical team for personalized instructions.
    </div>

    <section class="citations-box space-y-2">
      <h3 class="text-sm font-serif font-bold text-[#1B4332]">References & Guidelines:</h3>
      <ol class="list-decimal pl-5 space-y-1 text-xs text-stone-600">
        {guide.citations.map((cite) => (
          <li>{cite}</li>
        ))}
      </ol>
    </section>
  </div>
</Layout>
