---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Store, ArrowRight } from "@lucide/astro";
import CaptureForm from "../../components/forms/capture-form.astro";

const vendors = await getCollection("vendors");
---

<Layout title="Vendor Directory" seo={{ page_description: "Compare battery passport software vendors and platforms." } }>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="mb-12">
      <h1 class="text-4xl font-bold text-slate-900 mb-4">Battery Passport Software Vendors</h1>
      <p class="text-xl text-slate-600 max-w-3xl">A directory of platforms building traceability and compliance tools for the EU Battery Regulation. Compare approaches from blockchain ledgers to supply chain mapping.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        {vendors.map(vendor => (
          <div class="bg-white border border-slate-200 rounded-lg p-6 flex flex-col md:flex-row gap-6">
            <div class="flex-1">
              <h2 class="text-2xl font-semibold text-slate-900 mb-2">
                <a href={`/vendors/${vendor.id}/`} class="hover:text-blue-600">{vendor.data.title}</a>
              </h2>
              {vendor.data.pricing_model && (
                <span class="inline-block bg-slate-100 text-slate-700 text-xs px-2 py-1 rounded mb-3">{vendor.data.pricing_model}</span>
              )}
              <p class="text-slate-600 mb-4">{vendor.data.description}</p>
              <a href={`/vendors/${vendor.id}/`} class="text-blue-600 font-medium inline-flex items-center hover:underline">
                Read full analysis <ArrowRight class="w-4 h-4 ml-1" />
              </a>
            </div>
          </div>
        ))}
        {vendors.length === 0 && (
          <div class="bg-slate-50 border border-slate-200 rounded-lg p-8 text-center">
            <Store class="w-12 h-12 text-slate-400 mx-auto mb-4" />
            <p class="text-slate-600">Vendor directory is being populated.</p>
          </div>
        )}
      </div>

      <div>
        <div class="bg-blue-50 border border-blue-100 rounded-lg p-6 sticky top-6">
          <h3 class="text-lg font-semibold text-slate-900 mb-2">Are you a vendor?</h3>
          <p class="text-sm text-slate-600 mb-4">Get listed in our directory. We review platforms based on technical capability for the EU mandate.</p>
          <CaptureForm form="contact" submitLabel="Request Listing" class="btn btn-primary w-full">
            <input type="hidden" name="type" value="vendor_listing" />
            <label class="block text-sm font-medium text-slate-700 mb-1" for="vendor_email">Work Email</label>
            <input type="email" id="vendor_email" name="email" required class="w-full px-3 py-2 border border-slate-300 rounded mb-4" />
            <label class="block text-sm font-medium text-slate-700 mb-1" for="company">Company</label>
            <input type="text" id="company" name="company" required class="w-full px-3 py-2 border border-slate-300 rounded mb-4" />
          </CaptureForm>
        </div>
      </div>
    </div>
  </div>
</Layout>
