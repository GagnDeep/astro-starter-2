---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Strategies Compared | Institute of Property">
  <div class="py-16 px-6 sm:px-12 bg-background min-h-screen">
    <div class="max-w-5xl mx-auto prose prose-slate max-w-none">
      <h1 class="text-center">Property Strategies Compared</h1>
      <p class="text-center lead">An objective look at the trade-offs of major UK property investment strategies.</p>

      <div class="overflow-x-auto mt-10">
        <table class="min-w-full text-left">
          <thead>
            <tr class="bg-primary text-surface">
              <th class="p-4">Strategy</th>
              <th class="p-4">Capital Required</th>
              <th class="p-4">Time Involvement</th>
              <th class="p-4">Gross Yield (Avg)</th>
              <th class="p-4">Risk Profile</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-border bg-surface">
              <td class="p-4 font-bold">Standard Single Let (BTL)</td>
              <td class="p-4">Medium (25% deposit)</td>
              <td class="p-4">Low</td>
              <td class="p-4">5% - 7%</td>
              <td class="p-4">Low</td>
            </tr>
            <tr class="border-b border-border bg-surface">
              <td class="p-4 font-bold">HMO (Multi-Let)</td>
              <td class="p-4">High (Licensing, refurb)</td>
              <td class="p-4">High</td>
              <td class="p-4">10% - 15%</td>
              <td class="p-4">Medium</td>
            </tr>
            <tr class="border-b border-border bg-surface">
              <td class="p-4 font-bold">Serviced Accommodation (SA)</td>
              <td class="p-4">Medium</td>
              <td class="p-4">Very High</td>
              <td class="p-4">15%+</td>
              <td class="p-4">High (Void risks)</td>
            </tr>
            <tr class="border-b border-border bg-surface">
              <td class="p-4 font-bold">Property Flipping</td>
              <td class="p-4">High (Cash/Bridging)</td>
              <td class="p-4">Very High</td>
              <td class="p-4">N/A (Capital Gain)</td>
              <td class="p-4">High (Market timing)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>
