---
import Layout from "../layouts/Layout.astro";
---

<Layout title="How We Compare | CreateFitnessApp" seo={{ page_description: "Why choose CreateFitnessApp over generic development agencies or freelancers." }}>
  <div class="max-w-5xl mx-auto px-4 py-16 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold text-white mb-4">Why CreateFitnessApp?</h1>
      <p class="text-xl text-gray-400">Not all software agencies are equipped to build health tech.</p>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-gray-800">
            <th class="p-4 text-white font-bold border-b border-border w-1/4">Feature</th>
            <th class="p-4 text-primary font-bold border-b border-border w-1/4">CreateFitnessApp</th>
            <th class="p-4 text-gray-400 font-bold border-b border-border w-1/4">Generalist Agencies</th>
            <th class="p-4 text-gray-400 font-bold border-b border-border w-1/4">Freelancers</th>
          </tr>
        </thead>
        <tbody class="text-gray-300">
          <tr>
            <td class="p-4 border-b border-border font-medium">Domain Expertise</td>
            <td class="p-4 border-b border-border text-white">100% focused on fitness & health</td>
            <td class="p-4 border-b border-border">Builds everything from fintech to e-commerce</td>
            <td class="p-4 border-b border-border">Varies wildly</td>
          </tr>
          <tr class="bg-surface/50">
            <td class="p-4 border-b border-border font-medium">HealthKit / Google Fit</td>
            <td class="p-4 border-b border-border text-white">Deep API knowledge & edge-case handling</td>
            <td class="p-4 border-b border-border">Learning on your dime</td>
            <td class="p-4 border-b border-border">Often relies on unstable 3rd party plugins</td>
          </tr>
          <tr>
            <td class="p-4 border-b border-border font-medium">Compliance (HIPAA/GDPR)</td>
            <td class="p-4 border-b border-border text-white">Built-in to our architecture processes</td>
            <td class="p-4 border-b border-border">Often an afterthought</td>
            <td class="p-4 border-b border-border">Usually relies on client to architect</td>
          </tr>
          <tr class="bg-surface/50">
            <td class="p-4 border-b border-border font-medium">Hardware Integration</td>
            <td class="p-4 border-b border-border text-white">Expertise in BLE heart rate monitors</td>
            <td class="p-4 border-b border-border">Rarely experienced</td>
            <td class="p-4 border-b border-border">Rarely experienced</td>
          </tr>
          <tr>
            <td class="p-4 border-b border-border font-medium">Project Management</td>
            <td class="p-4 border-b border-border text-white">Dedicated technical PMs</td>
            <td class="p-4 border-b border-border">Account managers</td>
            <td class="p-4 border-b border-border">None (you manage them)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-16 text-center">
      <a href="/contact" class="btn-primary">Discuss your project with us</a>
    </div>
  </div>
</Layout>
