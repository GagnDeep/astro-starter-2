---
import Layout from "../../layouts/Layout.astro";

const treatmentsList = [
  { slug: "continuous-glucose-monitoring", title: "Continuous Glucose Monitoring (CGM)", desc: "Real-time glucose tracking with Dexcom G7 & FreeStyle Libre 3 without routine fingersticks.", category: "Technology" },
  { slug: "thyroid-ultrasound", title: "In-Office Diagnostic Thyroid Ultrasound", desc: "High-frequency neck ultrasound evaluation for nodules, goiter, and lymphadenopathy.", category: "Diagnostic Imaging" },
  { slug: "fine-needle-aspiration-biopsy", title: "Ultrasound-Guided FNA Biopsy", desc: "Precise in-office biopsy of suspicious thyroid nodules using local anesthesia.", category: "Procedure" },
  { slug: "insulin-pump-therapy", title: "Automated Insulin Pump Therapy", desc: "Omnipod 5, Tandem Control-IQ, and Medtronic closed-loop insulin delivery setup and tuning.", category: "Technology" },
  { slug: "bioidentical-hormone-replacement", title: "Evidence-Based Hormone Replacement (HRT)", desc: "FDA-approved bioidentical estrogen, progesterone, and androgen titration for menopause.", category: "Therapy" },
  { slug: "glp1-receptor-agonist-therapy", title: "GLP-1 & Dual Incretin Agonist Therapy", desc: "Semaglutide, Tirzepatide, and Liraglutide prescribing and side effect management.", category: "Pharmacology" },
  { slug: "bone-density-dexa-scan-evaluation", title: "Central DEXA Scan & FRAX Analysis", desc: "Lumbar spine and femoral neck bone densitometry evaluation and 10-year fracture risk.", category: "Diagnostics" },
  { slug: "thyroid-hormone-replacement-optimization", title: "Thyroid Dose Optimization", desc: "Levothyroxine (T4) and Liothyronine (T3) combination dosing and body-weight titration.", category: "Pharmacology" },
  { slug: "adrenal-vein-sampling-consultation", title: "Adrenal Vein Sampling Consultation", desc: "Diagnostic localization workup for primary aldosteronism and surgical candidacy.", category: "Diagnostics" },
  { slug: "pituitary-hormone-dynamic-testing", title: "Pituitary Dynamic Testing Protocols", desc: "In-office endocrine stimulation and suppression testing for pituitary hormone deficiencies.", category: "Diagnostics" }
];
---

<Layout title="10 Treatments & Procedures Offered">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 space-y-10">
    <div class="space-y-3 border-b border-stone-200 pb-6">
      <span class="badge-reviewed">Clinical Scope</span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#1B4332]">10 Treatments, Procedures & Technologies</h1>
      <p class="text-stone-600 text-sm sm:text-base max-w-3xl">
        High-precision in-office procedures, advanced diabetes technologies, and evidence-based endocrine pharmacotherapies in Austin, TX.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {treatmentsList.map((item) => (
        <a href={`/treatments/${item.slug}/`} class="bg-white p-6 rounded-xl border border-stone-200 hover:border-[#2D6A4F] hover:shadow-md transition space-y-3 flex flex-col justify-between group">
          <div class="space-y-2">
            <span class="badge-category">{item.category}</span>
            <h2 class="text-lg font-serif font-bold text-[#1B4332] group-hover:text-[#2D6A4F] transition">{item.title}</h2>
            <p class="text-xs text-stone-600 leading-relaxed">{item.desc}</p>
          </div>
          <div class="text-xs font-semibold text-[#2D6A4F] group-hover:underline pt-2">
            View Treatment Details →
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
