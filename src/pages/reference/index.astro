---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const references = await getCollection("reference");

const seo = {
  page_description: "The complete technical reference library for embedding documents on the web. Learn about iframes, CORS, PDF linearization, and more.",
};
---

<Layout title="Reference Library | uDocumentViewer" seo={seo}>
  <div class="max-w-7xl mx-auto px-4 py-20">
    <div class="text-center mb-16">
      <h1 class="text-4xl font-bold mb-4">Technical Reference Library</h1>
      <p class="text-xl text-text/80 max-w-2xl mx-auto">Deep technical documentation on how browsers handle documents, and how to optimize them for the web.</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
      {references.map(ref => (
        <a href={`/reference/${ref.id}/`} class="block bg-surface p-6 rounded-lg border border-border hover:border-primary transition-colors">
          <h2 class="text-xl font-bold mb-2 text-primary">{ref.data.title}</h2>
          <p class="text-text/70 text-sm">{ref.data.seo?.page_description}</p>
        </a>
      ))}
    </div>

    <div class="bg-bg p-8 rounded-lg border border-border max-w-3xl mx-auto text-center">
      <h2 class="text-2xl font-bold mb-4">Don't want to build it yourself?</h2>
      <p class="mb-6 text-text/70">Let us handle the complexity of CORS, linearization, and responsive scaling.</p>
      <a href="/pricing" class="btn">View API Pricing</a>
    </div>
  </div>
</Layout>
