---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Seo from "../../components/seo/seo.astro";

const references = await getCollection("reference" as any);

const seo = { page_description: "Reference Library index.", no_index: false };
---
<Layout title="Reference Library">
  <Seo seo={seo} />
  <div class="max-w-4xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold mb-8">Reference Library</h1>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {references.map((reference: any) => (
        <a href={`/reference/${reference.id}/`} class="p-4 border border-secondary rounded hover:bg-surface text-primary font-medium">{reference.data.title}</a>
      ))}
    </div>
  </div>
</Layout>
