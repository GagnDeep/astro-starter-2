---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Reference Library">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-8">Reference Library</h1>
    <p class="text-lg text-secondary mb-8">Browse our comprehensive reference library.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      <a href="/reference/video-codecs" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">video codecs</a>
      <a href="/reference/h264" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">h264</a>
      <a href="/reference/h265" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">h265</a>
      <a href="/reference/av1" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">av1</a>
      <a href="/reference/vp9" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">vp9</a>
      <a href="/reference/audio-codecs" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">audio codecs</a>
      <a href="/reference/aac" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">aac</a>
      <a href="/reference/mp3" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">mp3</a>
      <a href="/reference/containers" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">containers</a>
      <a href="/reference/mkv" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">mkv</a>
      <a href="/reference/mp4" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">mp4</a>
      <a href="/reference/mov" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">mov</a>
      <a href="/reference/webm" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">webm</a>
      <a href="/reference/avi" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">avi</a>
      <a href="/reference/flv" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">flv</a>
      <a href="/reference/bitrate" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">bitrate</a>
      <a href="/reference/resolution" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">resolution</a>
    </div>
  </div>
</Layout>
