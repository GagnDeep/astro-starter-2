---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const references = await getCollection("reference");
---
<Layout title="Health-Tech Reference Architecture Guides" seo={{ page_description: "Technical reference guides for building fitness applications." }}>
  <article class="max-w-4xl mx-auto px-4 py-16 prose prose-invert prose-green">
    <h1>Technical Reference Library</h1>
    <p class="lead text-xl text-gray-300">Deep dives into the hardest problems in health-tech.</p>

    <div class="not-prose grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
      {references.map(ref => (
        <a href={`/reference/${ref.id}`} class="block bg-surface border border-border p-6 rounded-xl hover:border-primary transition-colors">
          <h3 class="text-xl font-bold text-white mb-2">{ref.data.title}</h3>
          <p class="text-gray-400 text-sm">{ref.data.description}</p>
        </a>
      ))}
    </div>
  </article>
</Layout>
