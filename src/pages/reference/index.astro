---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allReference = await getCollection('reference');
const sortedReference = allReference.sort((a, b) => (a.data.order || 999) - (b.data.order || 999));

const seo = {
  page_description: "Beginner investing basics, account types, and assets explained simply.",
};
---

<Layout title="Reference Library | Institute of Investing" seo={seo}>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-4">Reference Library</h1>
    <p class="text-xl text-gray-600 mb-12">The basics of investing, explained simply and objectively.</p>

    <div class="grid md:grid-cols-2 gap-6">
      {sortedReference.map(doc => (
        <a href={`/reference/${doc.id}`} class="block border p-6 rounded-lg hover:border-blue-600 hover:shadow-md transition">
          <h2 class="text-2xl font-bold mb-2">{doc.data.title}</h2>
          <p class="text-gray-700">{doc.data.description}</p>
        </a>
      ))}
    </div>
  </main>
</Layout>
