---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allProcedures = await getCollection('procedures');
---

<BaseLayout
  title="In-Office Diagnostic Procedures — Austin Endocrinology"
  description="In-office procedures offered by Dr. Ameena Patel in Austin, TX: ultrasound-guided thyroid biopsy (FNA), continuous glucose monitoring setup, and insulin pump tuning."
>

  <div class="py-12 bg-cream border-b border-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

      <div class="space-y-3">
        <span class="text-xs font-bold text-terracotta uppercase tracking-wider">Clinical Procedures</span>
        <h1 class="font-serif text-3xl sm:text-4xl font-bold text-charcoal">
          In-Office Diagnostic Procedures
        </h1>
        <p class="text-sm text-charcoal-muted leading-relaxed max-w-2xl">
          Advanced diagnostic and therapeutic procedures performed directly by Dr. Ameena Patel in our Central Austin clinic suite. Fast turnaround without hospital radiology wait times.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {allProcedures.map((item) => (
          <a href={`/procedures/${item.id.replace(/\.(md|mdx)$/, '')}/`} class="group bg-surface border border-border rounded-xl p-6 hover:border-terracotta/50 hover:shadow-md transition-all space-y-3">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold uppercase tracking-wider text-terracotta">
                {item.data.durationMinutes} Minutes
              </span>
              <span class="text-[10px] font-semibold bg-sage-light text-sage-dark px-2.5 py-0.5 rounded-full">
                In-Office Suite
              </span>
            </div>
            <h2 class="font-serif text-xl font-bold text-charcoal group-hover:text-terracotta transition-colors">
              {item.data.title}
            </h2>
            <p class="text-xs text-charcoal-muted line-clamp-3 leading-relaxed">
              {item.data.summary}
            </p>
            <div class="text-[11px] text-terracotta font-semibold flex items-center justify-between border-t border-border/60 pt-3">
              <span>View Procedure Guide & Preparation</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>

</BaseLayout>
