---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Supported Formats">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-8">Supported Formats</h1>
    <p class="text-lg text-secondary mb-8">Browse our comprehensive supported formats.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      <a href="/formats/mp4" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">mp4</a>
      <a href="/formats/mkv" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">mkv</a>
      <a href="/formats/mov" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">mov</a>
      <a href="/formats/webm" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">webm</a>
      <a href="/formats/avi" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">avi</a>
      <a href="/formats/wmv" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">wmv</a>
      <a href="/formats/flv" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">flv</a>
      <a href="/formats/hevc" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">hevc</a>
      <a href="/formats/3gp" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">3gp</a>
      <a href="/formats/ts" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">ts</a>
    </div>
  </div>
</Layout>
