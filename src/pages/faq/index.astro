---
import Layout from "../../layouts/Layout.astro";

const seo = {
  page_description: "Frequently Asked Questions about uconvertfile.com",
  no_index: false,
};
---

<Layout title="Frequently Asked Questions" seo={seo}>
  <div class="max-w-4xl mx-auto px-4 py-12 prose">
    <h1>Frequently Asked Questions</h1>

    <h3>Is it really free?</h3>
    <p>Yes. uconvertfile is 100% free with no hidden fees or paywalls.</p>

    <h3>Do you keep my files?</h3>
    <p>No. We process your files and immediately discard them. We respect your data and privacy.</p>

    <h3>Are there file size limits?</h3>
    <p>Currently, to ensure the service remains fast and stable for everyone, we impose a reasonable limit on file sizes depending on the tool. Please refer to individual tool pages for specifics.</p>
  </div>
</Layout>
