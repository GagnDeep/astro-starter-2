---
import Layout from '../layouts/Layout.astro';

const seo = {
  title: 'Compare Free Tax Software',
  page_description: 'Compare the best free tax software options available this year.'
};
---
<Layout seo={seo} title="Compare Free Tax Software">
  <main class="max-w-4xl mx-auto px-4 py-12 prose">
    <h1>Compare Free Tax Software</h1>
    <p>Sometimes paper forms are too complex. Here is our comparison of free tax software.</p>
    <table>
      <thead>
        <tr>
          <th>Provider</th>
          <th>Best For</th>
          <th>Link</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>ExampleTax</td>
          <td>Simple Returns</td>
          <td><a href="https://example.com/affiliate-1">Visit</a></td>
        </tr>
        <tr>
          <td>TaxPro</td>
          <td>Freelancers</td>
          <td><a href="https://example.com/affiliate-2">Visit</a></td>
        </tr>
      </tbody>
    </table>
  </main>
</Layout>
