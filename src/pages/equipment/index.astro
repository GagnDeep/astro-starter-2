---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const equipmentEntries = await getCollection('equipment');
---
<Layout title="Equipment Reviews" seo={{ page_description: "Core culinary techniques and equipment library." }}>
  <div class="max-w-4xl mx-auto py-12 px-4">
    <h1 class="text-4xl mb-8">Equipment Reviews</h1>
    <ul class="space-y-4">
      {equipmentEntries.map(entry => (
        <li>
          <a href={`/equipment/${entry.id}/`} class="text-xl font-bold">{entry.data.title}</a>
          <p class="text-text-muted">{entry.data.description}</p>
        </li>
      ))}
    </ul>
  </div>
</Layout>
