---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CaptureForm from '../../components/forms/capture-form.astro';

const libraryEntries = await getCollection('library');

const seo = {
  page_description: "A comprehensive reference library on hydration.",
  no_index: false,
};
---
<Layout title="Hydration Library" seo={seo}>
  <div class="mx-auto max-w-5xl px-6 py-12">
    <h1 class="text-4xl font-bold tracking-tight mb-8">Hydration Library</h1>
    <ul class="grid gap-6 md:grid-cols-2">
      {
        libraryEntries.map((entry) => (
          <li class="rounded-lg border border-gray-200 p-6 shadow-sm hover:shadow-md transition">
            <a href={`/library/${entry.id}/`} class="block">
              <h2 class="text-xl font-semibold text-blue-600 mb-2">{entry.data.title}</h2>
              <p class="text-gray-600">{entry.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-16 bg-blue-50 p-8 rounded-lg">
      <h3 class="text-xl font-bold mb-4">Want more hydration tips?</h3>
      <CaptureForm form="newsletter" submitLabel="Subscribe" />
    </div>
  </div>
</Layout>
