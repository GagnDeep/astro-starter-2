---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const suppliers = await getCollection('suppliers');
  return suppliers.map(supplier => ({
    params: { slug: supplier.id.replace(/\.mdx?$/, '') },
    props: { supplier },
  }));
}

const { supplier } = Astro.props;
const { Content } = await render(supplier);

const seo = supplier.data.seo || {};
---

<Layout title={supplier.data.title} seo={seo}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 prose prose-slate">
    <div class="mb-8 not-prose">
      <a href="/directory" class="text-brand-primary hover:underline">&larr; Back to Directory</a>
    </div>
    <Content />
  </div>
</Layout>
