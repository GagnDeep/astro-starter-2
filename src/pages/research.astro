---
import Layout from "../layouts/Layout.astro";
import researchData from "../../data/research.json";
import { ArrowLeft, BookOpen, ShieldAlert, CheckCircle2, Search, ExternalLink } from "@lucide/astro";

const title = "Competitor Research, Keyword Intent & Clinical Sources — IBS Go";
const description = "Comprehensive landscape analysis of 7 competitor IBS apps, 40+ search intent keywords, and dated clinical source guidelines (Monash, NICE, ACG).";
---

<Layout title={title} seo={{ page_description: description }}>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="mb-6 flex items-center text-sm text-amber-800" aria-label="Breadcrumb">
      <a href="/" class="hover:underline flex items-center gap-1"><ArrowLeft class="w-4 h-4"/> Home</a>
      <span class="mx-2">/</span>
      <span class="font-medium text-stone-900">Research & Clinical Sources</span>
    </nav>

    <header class="mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-semibold uppercase tracking-wider mb-4">
        Evidence-Based Foundation
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-stone-900 tracking-tight mb-4">
        Competitor Analysis, SERP Intent & Clinical Evidence
      </h1>
      <p class="text-lg text-stone-700 max-w-3xl leading-relaxed">
        IBS Go is built upon rigorous market analysis and established clinical guidelines. We do not invent clinical advisors or unsourced statistics—all FODMAP thresholds, protocol stages, and diagnostic distinctions map directly to peer-reviewed literature.
      </p>
    </header>

    <!-- Medical Advice Warning Header -->
    <div class="bg-amber-50 border-l-4 border-amber-600 p-4 rounded-r-lg mb-10 text-stone-800 text-sm">
      <div class="flex items-start gap-3">
        <ShieldAlert class="w-5 h-5 text-amber-700 shrink-0 mt-0.5" />
        <div>
          <strong class="font-semibold text-stone-900 block mb-1">Medical Advice Disclaimer & Transparency</strong>
          Information on this page documents our product research and clinical literature foundation. IBS Go is an educational tracking companion, not a diagnostic medical device or a substitute for professional gastroenterology care.
        </div>
      </div>
    </div>

    <!-- Section 1: Dated Clinical Source Table -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-stone-900 mb-6 flex items-center gap-2">
        <BookOpen class="w-6 h-6 text-emerald-700" /> Dated Clinical Source Table
      </h2>
      <div class="overflow-x-auto bg-white rounded-xl border border-stone-200 shadow-sm">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-stone-100 border-b border-stone-200 text-stone-900 font-semibold">
              <th class="p-4">Clinical Guideline / Authority</th>
              <th class="p-4">Clinical Scope & Evidence Base</th>
              <th class="p-4">IBS Go Implementation</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-200 text-stone-800">
            {researchData.clinical_sources.map((source) => (
              <tr class="hover:bg-stone-50 transition-colors">
                <td class="p-4 font-semibold text-stone-900">{source.citation}</td>
                <td class="p-4 leading-relaxed">{source.scope}</td>
                <td class="p-4 text-emerald-800 font-medium">{source.application}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2: Competitor App Landscape -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-stone-900 mb-6">
        Competitor Apps & Hubs Analysis (7 Platforms)
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {researchData.competitors.map((app) => (
          <div class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <h3 class="text-lg font-bold text-stone-900">{app.name}</h3>
                <span class="text-xs bg-stone-100 px-2.5 py-1 rounded-full text-stone-700 font-medium">{app.type}</span>
              </div>
              <p class="text-sm text-stone-700 mb-3"><strong class="text-stone-900">Strengths:</strong> {app.strengths}</p>
              <p class="text-sm text-stone-700 mb-4"><strong class="text-stone-900">Weaknesses:</strong> {app.weaknesses}</p>
            </div>
            <div class="pt-3 border-t border-stone-100 bg-amber-50/50 -mx-6 -mb-6 p-4 rounded-b-xl">
              <p class="text-xs text-amber-900 font-medium">
                <strong class="text-amber-950">IBS Go Advantage:</strong> {app.differentiation}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 3: Keyword Analysis by Search Intent -->
    <section class="mb-16">
      <h2 class="text-2xl font-bold text-stone-900 mb-6 flex items-center gap-2">
        <Search class="w-6 h-6 text-amber-700" /> 40+ Keywords by Search Intent & SERP Focus
      </h2>
      <div class="overflow-x-auto bg-white rounded-xl border border-stone-200 shadow-sm">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-stone-100 border-b border-stone-200 text-stone-900 font-semibold">
              <th class="p-4">Target Keyword</th>
              <th class="p-4">Intent</th>
              <th class="p-4">Category</th>
              <th class="p-4">SERP Feature / Content Strategy</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-200 text-stone-800">
            {researchData.keywords.map((kw) => (
              <tr class="hover:bg-stone-50 transition-colors">
                <td class="p-4 font-mono text-xs font-semibold text-amber-900">{kw.keyword}</td>
                <td class="p-4">
                  <span class={`px-2 py-0.5 text-xs rounded-full font-medium ${
                    kw.intent === 'commercial' ? 'bg-emerald-100 text-emerald-800' :
                    kw.intent === 'informational' ? 'bg-blue-100 text-blue-800' :
                    'bg-amber-100 text-amber-800'
                  }`}>
                    {kw.intent}
                  </span>
                </td>
                <td class="p-4 text-xs font-medium text-stone-700">{kw.category}</td>
                <td class="p-4 text-xs text-stone-600">{kw.serp_focus}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Navigation links -->
    <div class="pt-8 border-t border-stone-200 flex flex-wrap gap-4 text-sm font-medium">
      <a href="/food/" class="text-amber-800 hover:underline">Explore Food Directory &rarr;</a>
      <a href="/symptoms/" class="text-amber-800 hover:underline">Explore Symptom Library &rarr;</a>
      <a href="/protocols/" class="text-amber-800 hover:underline">View Protocol Guides &rarr;</a>
    </div>
  </main>
</Layout>
