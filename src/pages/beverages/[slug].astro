---
import { getCollection } from 'astro:content';
import BeverageLayout from '../../layouts/Beverage.astro';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('beverages');
  return entries.map(entry => ({
    params: { slug: entry.id }, props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---
<BeverageLayout title={entry.data.title} description={entry.data.description} hydration_index={entry.data.hydration_index} seo={entry.data.seo}>
  <Content />
</BeverageLayout>
