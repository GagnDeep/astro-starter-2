---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const taxonomies = await getCollection('taxonomy');

const seo = {
  page_description: "Explore nutrition by goal and diet.",
  no_index: false
};
---

<Layout title="Page" seo={seo}>
  <div class="prose mx-auto py-12 px-4 max-w-4xl">
    <h1>Taxonomy & Goals</h1>
    <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 list-none pl-0">
      {taxonomies.map(tax => (
        <li class="m-0 p-4 border border-slate-200 rounded-lg">
          <a href={`/taxonomy/${tax.id}`} class="font-bold text-lg no-underline hover:underline">{tax.data.title}</a>
          <p class="text-sm text-slate-600 mt-2 mb-0">{tax.data.description}</p>
        </li>
      ))}
    </ul>
  </div>
</Layout>
