---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allTaxonomies = await getCollection('taxonomy');
const sortedTaxonomies = allTaxonomies.sort((a, b) => a.data.title.localeCompare(b.data.title));

const seo = {
  page_description: "Explore investing strategies, frameworks, and portfolio structures.",
};
---

<Layout title="Investing Strategies | Institute of Investing" seo={seo}>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-4">Investing Strategies</h1>
    <p class="text-xl text-gray-600 mb-12">Frameworks and approaches to building long-term wealth.</p>

    <div class="grid md:grid-cols-2 gap-6">
      {sortedTaxonomies.map(doc => (
        <a href={`/taxonomy/${doc.id}`} class="block border p-6 rounded-lg hover:border-blue-600 hover:shadow-md transition">
          <h2 class="text-2xl font-bold mb-2">{doc.data.title}</h2>
          <p class="text-gray-700">{doc.data.description}</p>
        </a>
      ))}
    </div>
  </main>
</Layout>
