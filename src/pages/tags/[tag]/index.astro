---
import Layout from "../../../layouts/Layout.astro";
import BlogList from "../../../components/blog/list.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const uniqueTags = [...new Set(allPosts.map((post) => post.data.post_hero.tags || []).flat())];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) => post.data.post_hero.tags?.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout
  title={`Posts tagged "${tag}"`}
  seo={{
    page_description: `Read all our blog posts tagged with ${tag}.`,
    canonical_url: `https://aiandinvesting.com/tags/${tag}/`,
    featured_image: null,
    featured_image_alt: null,
    author_twitter_handle: null,
    open_graph_type: "website",
    no_index: false
  }}
>
  <div class="mx-auto max-w-6xl px-8 py-16">
    <h1 class="text-3xl md:text-4xl font-bold mb-8 text-center">Posts tagged "{tag}"</h1>
    <BlogList posts={posts} />
  </div>
</Layout>
