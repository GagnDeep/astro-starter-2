---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const glossary = await getCollection("glossary");
glossary.sort((a, b) => a.data.title.localeCompare(b.data.title));

const seo = {
  page_description: "A comprehensive glossary of Cayman Islands business, finance, and legal terms.",
  canonical_url: "/glossary/",
  open_graph_type: "website"
};
---
<Layout seo={seo} title="Cayman Islands Business Glossary | The Cayman Journal">
  <div class="max-w-4xl mx-auto py-12 px-6">
    <h1 class="text-3xl font-bold mb-4">Cayman Islands Business Glossary</h1>
    <p class="text-gray-600 mb-12">Definitions and explanations of common regulatory, legal, and financial terms used in the Cayman Islands.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {glossary.map((term) => (
        <a href={`/glossary/${term.id}/`} class="block bg-white p-6 rounded-lg shadow-sm border border-gray-200 hover:shadow-md transition-shadow">
          <h2 class="text-lg font-bold text-navy-900 mb-2">{term.data.title}</h2>
          <p class="text-gray-700 text-sm line-clamp-3">{term.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
