---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Document Templates | usignpdf"
  seo={{
    page_description: "Free, ready-to-sign document templates for business, including NDAs, W9s, and contracts.",
    canonical_url: "https://usignpdf.com/templates/"
  }}
>
  <div class="max-w-4xl mx-auto py-20 px-4 md:px-8">
    <h1 class="text-4xl font-bold mb-12 text-center">Free Document Templates</h1>
    <p class="text-center text-text-muted mb-12">Download these free templates, customize them, and upload to <a href="/" class="underline text-accent">usignpdf</a> for instant signing. Unsure about legally binding rules? Check our <a href="/legality" class="underline">Legality Guide</a>.</p>
    <ul class="space-y-4 max-w-2xl mx-auto">
      <li class="p-4 bg-surface border border-border rounded shadow-sm flex justify-between items-center">
        <span class="font-semibold"><a href="/templates/freelance-contract" class="hover:underline">Freelance Contract Template</a></span>
        <a href="/templates/freelance-contract" class="text-sm bg-surface-alt px-3 py-1 rounded border border-border hover:bg-border transition">View</a>
      </li>
      <li class="p-4 bg-surface border border-border rounded shadow-sm flex justify-between items-center">
        <span class="font-semibold"><a href="/templates/nda" class="hover:underline">Non-Disclosure Agreement (NDA)</a></span>
        <a href="/templates/nda" class="text-sm bg-surface-alt px-3 py-1 rounded border border-border hover:bg-border transition">View</a>
      </li>
      <li class="p-4 bg-surface border border-border rounded shadow-sm flex justify-between items-center">
        <span class="font-semibold"><a href="/templates/w9" class="hover:underline">IRS W-9 Form (2024)</a></span>
        <a href="/templates/w9" class="text-sm bg-surface-alt px-3 py-1 rounded border border-border hover:bg-border transition">View</a>
      </li>
      <li class="p-4 bg-surface border border-border rounded shadow-sm flex justify-between items-center">
        <span class="font-semibold"><a href="/templates/lease-agreement" class="hover:underline">Residential Lease Agreement</a></span>
        <a href="/templates/lease-agreement" class="text-sm bg-surface-alt px-3 py-1 rounded border border-border hover:bg-border transition">View</a>
      </li>
      <li class="p-4 bg-surface border border-border rounded shadow-sm flex justify-between items-center">
        <span class="font-semibold"><a href="/templates/photo-release" class="hover:underline">Photo Release Form</a></span>
        <a href="/templates/photo-release" class="text-sm bg-surface-alt px-3 py-1 rounded border border-border hover:bg-border transition">View</a>
      </li>
    </ul>
  </div>
</Layout>
