---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Document Templates | usignpdf"
  seo={{
    page_description: "Free, ready-to-sign document templates for business, including NDAs, W9s, and contracts.",
    canonical_url: "https://usignpdf.com/templates/"
  }}
>
  <div class="max-w-4xl mx-auto py-20 px-4 md:px-8">
    <h1 class="text-4xl font-bold mb-12 text-center">Free Document Templates</h1>
    <p class="text-center text-text-muted mb-12">Download these free templates, customize them, and upload to usignpdf for instant signing.</p>
    <ul class="space-y-4 max-w-2xl mx-auto">
      <li class="p-4 bg-surface border border-border rounded shadow-sm flex justify-between items-center">
        <span class="font-semibold">Freelance Contract Template</span>
        <button class="text-sm bg-surface-alt px-3 py-1 rounded border border-border">Download PDF</button>
      </li>
      <li class="p-4 bg-surface border border-border rounded shadow-sm flex justify-between items-center">
        <span class="font-semibold">Non-Disclosure Agreement (NDA)</span>
        <button class="text-sm bg-surface-alt px-3 py-1 rounded border border-border">Download PDF</button>
      </li>
      <li class="p-4 bg-surface border border-border rounded shadow-sm flex justify-between items-center">
        <span class="font-semibold">IRS W-9 Form (2024)</span>
        <button class="text-sm bg-surface-alt px-3 py-1 rounded border border-border">Download PDF</button>
      </li>
    </ul>
  </div>
</Layout>
