---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Video Glossary">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-8">Video Glossary</h1>
    <p class="text-lg text-secondary mb-8">Browse our comprehensive video glossary.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
      <a href="/glossary/codec" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">codec</a>
      <a href="/glossary/container" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">container</a>
      <a href="/glossary/bitrate" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">bitrate</a>
      <a href="/glossary/framerate" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">framerate</a>
      <a href="/glossary/resolution" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">resolution</a>
      <a href="/glossary/aspect-ratio" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">aspect ratio</a>
      <a href="/glossary/keyframe" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">keyframe</a>
      <a href="/glossary/transcoding" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">transcoding</a>
      <a href="/glossary/encoding" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">encoding</a>
      <a href="/glossary/lossless" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">lossless</a>
      <a href="/glossary/lossy" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">lossy</a>
      <a href="/glossary/multiplexing" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">multiplexing</a>
      <a href="/glossary/demultiplexing" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">demultiplexing</a>
      <a href="/glossary/chroma-subsampling" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">chroma subsampling</a>
      <a href="/glossary/color-depth" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">color depth</a>
      <a href="/glossary/hdr" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">hdr</a>
      <a href="/glossary/sdr" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">sdr</a>
      <a href="/glossary/vbr" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">vbr</a>
      <a href="/glossary/cbr" class="p-4 border border-border rounded-lg hover:border-primary hover:shadow-sm transition-all capitalize block bg-bg">cbr</a>
    </div>
  </div>
</Layout>
