---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allTerms = await getCollection('glossary');
const sortedTerms = allTerms.sort((a, b) => a.data.term.localeCompare(b.data.term));

const seo = {
  page_description: "Investing terminology and definitions, translated into plain English.",
};
---

<Layout title="Investing Glossary | Institute of Investing" seo={seo}>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-4">Investing Glossary</h1>
    <p class="text-xl text-gray-600 mb-12">Financial jargon, translated into plain English.</p>

    <div class="space-y-8">
      {sortedTerms.map(doc => (
        <div class="border-b pb-6" id={doc.id}>
          <a href={`/glossary/${doc.id}`} class="group">
            <h2 class="text-2xl font-bold mb-2 group-hover:text-blue-600 transition inline-block">{doc.data.term}</h2>
          </a>
          <p class="text-gray-700">{doc.data.definition}</p>
        </div>
      ))}
    </div>
  </main>
</Layout>
