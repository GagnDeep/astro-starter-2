---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const glossary = await getCollection('glossary');
---
<Layout title="Document Conversion Glossary">
  <div class="mx-auto max-w-4xl px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Glossary</h1>
    <p class="mb-8 text-text-muted">Definitions for terms used in digital documents and image processing.</p>
    <div class="grid gap-4 sm:grid-cols-2">
      {glossary.map(term => (
        <a href={`/glossary/${term.id}/`} class="block p-4 bg-surface border border-border rounded hover:border-brand transition-all">
          <h2 class="text-lg font-semibold text-brand">{term.data.title}</h2>
        </a>
      ))}
    </div>
  </div>
</Layout>
