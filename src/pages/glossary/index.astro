---
import Layout from "../../layouts/Layout.astro";

const terms = [
  { term: "ABR (Adaptive Bitrate Streaming)", def: "Dynamically adjusts the video quality based on the viewer's internet speed to prevent buffering." },
  { term: "Bitrate", def: "The amount of data processed over time, usually measured in kilobits per second (kbps) or megabits per second (Mbps)." },
  { term: "CDN (Content Delivery Network)", def: "A global network of servers that caches video content closer to viewers to ensure fast loading times." },
  { term: "Codec", def: "Software that compresses or decompresses video files. Common ones include H.264, HEVC (H.265), and VP9." },
  { term: "HLS (HTTP Live Streaming)", def: "An adaptive bitrate streaming protocol created by Apple, widely supported across almost all modern browsers and devices." },
  { term: "DASH (Dynamic Adaptive Streaming over HTTP)", def: "An open-source alternative to HLS for adaptive bitrate streaming." },
  { term: "Transcoding", def: "The process of converting a video file from one format or resolution to multiple others to support different devices." },
  { term: "VOD (Video on Demand)", def: "Pre-recorded video content that viewers can watch at any time, unlike live streaming." },
  { term: "Player Chrome", def: "The user interface elements of a video player, such as the play button, progress bar, and volume controls." },
  { term: "iframe Embed", def: "An HTML tag used to embed a video player hosted on another domain into your website." }
];
---

<Layout title="Video Streaming Glossary" seo={{ page_description: "Learn the technical terms behind video hosting and streaming." }}>
  <section class="py-16 md:py-24 max-w-3xl mx-auto px-8 prose">
    <h1>Video Streaming Glossary</h1>
    <p>Understanding video hosting doesn't have to be complicated. Here are the core terms you'll run into when managing web video.</p>

    <dl class="space-y-6 mt-8">
      {terms.map(t => (
        <div class="border-b border-gray-200 pb-4">
          <dt class="font-bold text-lg text-[var(--color-primary)]">{t.term}</dt>
          <dd class="mt-2 text-gray-700">{t.def}</dd>
        </div>
      ))}
    </dl>
  </section>
</Layout>
