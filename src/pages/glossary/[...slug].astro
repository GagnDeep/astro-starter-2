---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CaptureForm from '../../components/forms/capture-form.astro';
import { capture } from '../../../capture.config';

export async function getStaticPaths() {
  const pages = await getCollection('glossary');
  return pages.map(page => ({
    params: { slug: page.id.split('.')[0] },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await (await import('astro:content')).render(page);
---

<Layout title={`${page.data.title} | Property Glossary`} seo={{page_description: page.data.definition}} >
  <div class="py-16 px-6 sm:px-12 max-w-3xl mx-auto prose prose-slate">
    <Content />

    <div class="mt-16 bg-surface p-8 border border-border rounded-lg not-prose">
      <h3 class="text-xl font-bold mb-4">Still confused about {page.data.title}?</h3>
      <CaptureForm form={capture.forms.contact} submitLabel="Ask an Expert" />
    </div>
  </div>
</Layout>
