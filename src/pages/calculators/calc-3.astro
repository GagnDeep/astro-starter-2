---
import Layout from "../../layouts/Layout.astro";
import CaptureForm from "../../components/forms/capture-form.astro";
const seo = { page_description: "Calculate the estimated cost of printing a PDF based on page count, color vs. black and white, and ink coverage." };
---
<Layout title="PDF Print Cost Estimator" seo={seo}>
  <div class="max-w-4xl mx-auto px-4 sm:px-8 py-16 prose">
    <h1>PDF Print Cost Estimator</h1>
    <p>Before sending a massive document to the printer, estimate the cost. This calculator factors in standard commercial printing rates for black and white versus color pages.</p>

    <div class="not-prose bg-bg-surface border border-gray-200 rounded-lg p-6 my-8 shadow-sm">
      <form id="calc-form" class="space-y-4">
        <div>
          <label for="pages-bw" class="block text-sm font-medium text-text-primary">Black & White Pages</label>
          <input type="number" id="pages-bw" name="pages-bw" value="50" min="0" class="mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-brand-accent focus:ring-brand-accent" />
        </div>
        <div>
          <label for="pages-color" class="block text-sm font-medium text-text-primary">Color Pages</label>
          <input type="number" id="pages-color" name="pages-color" value="5" min="0" class="mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-brand-accent focus:ring-brand-accent" />
        </div>
        <div>
          <label for="coverage" class="block text-sm font-medium text-text-primary">Ink Coverage Level</label>
          <select id="coverage" name="coverage" class="mt-1 block w-full rounded border-gray-300 shadow-sm focus:border-brand-accent focus:ring-brand-accent">
            <option value="1">Standard (Mostly Text, ~5% coverage)</option>
            <option value="1.5">Heavy (Many Images/Graphs, ~15% coverage)</option>
            <option value="2.5">Full Bleed (Solid backgrounds)</option>
          </select>
        </div>
        <button type="submit" class="btn-primary w-full">Estimate Cost</button>
      </form>

      <div id="result-container" class="mt-6 hidden p-4 bg-green-50 border-l-4 border-green-500 rounded">
        <h3 class="text-lg font-semibold text-text-primary">Estimated Print Cost:</h3>
        <p id="result-cost" class="text-2xl font-bold text-green-700 mt-2"></p>
        <p class="text-sm text-text-secondary mt-1">Based on average commercial rates ($0.10 B&W, $0.40 Color).</p>
      </div>

      <noscript>
        <div class="mt-6 p-4 bg-yellow-50 border-l-4 border-yellow-400 rounded">
          <h3 class="text-lg font-semibold text-text-primary">Manual Calculation Method</h3>
          <p class="text-sm text-text-secondary">Since JavaScript is disabled, use this formula: <br/>
          <code>((B&W Pages * $0.10) + (Color Pages * $0.40)) * Coverage Multiplier = Total</code></p>
        </div>
      </noscript>
    </div>

    <h2>Why Color Costs More</h2>
    <p>Color printing relies on the CMYK color model, requiring four separate passes of ink (Cyan, Magenta, Yellow, Key/Black) compared to a single pass for black text. Furthermore, documents with high <a href="/reference/topic-17">Content Stream</a> density or massive embedded images require more toner/ink.</p>

    <p>If you are submitting a document for professional printing, ensure you are using the <a href="/glossary/term-5">PDF/X standard</a> for accurate color reproduction.</p>

    <div class="mt-12 not-prose p-6 bg-gray-50 border border-gray-200 rounded">
      <h3 class="text-lg font-bold mb-4">Request a custom tool</h3>
      <CaptureForm formLabel="contact" submitText="Send Request" />
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('calc-form');
  const resultContainer = document.getElementById('result-container');
  const resultCost = document.getElementById('result-cost');

  if (form && resultContainer && resultCost) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const formData = new FormData(e.target as HTMLFormElement);
      const bw = Number(formData.get('pages-bw'));
      const color = Number(formData.get('pages-color'));
      const coverage = Number(formData.get('coverage'));

      // Average commercial printing rates
      const rateBw = 0.10;
      const rateColor = 0.40;

      const baseCost = (bw * rateBw) + (color * rateColor);
      const totalCost = baseCost * coverage;

      // Format as currency
      const formatter = new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
      });

      resultCost.textContent = formatter.format(totalCost);
      resultContainer.classList.remove('hidden');
    });
  }
</script>
