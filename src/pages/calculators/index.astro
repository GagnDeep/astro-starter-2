---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Calculators & Tools" seo={{ page_description: "Interactive culinary calculators for recipe conversion, scaling, and cost analysis." }}>
  <div class="max-w-4xl mx-auto py-12 px-4">
    <h1 class="text-4xl font-bold mb-8">Calculators & Tools</h1>
    <ul class="space-y-4">
      <li>
        <a href="/calculators/bakers-percentage/" class="text-xl font-bold">Baker's Percentage Calculator</a>
        <p class="text-text-muted">Calculate accurate recipe weights using baker's percentage methodology where flour is 100%.</p>
      </li>
      <li>
        <a href="/calculators/recipe-converter/" class="text-xl font-bold">Recipe Converter</a>
        <p class="text-text-muted">Scale recipes up or down accurately.</p>
      </li>
      <li>
        <a href="/calculators/brine-ratio/" class="text-xl font-bold">Brine Ratio Calculator</a>
        <p class="text-text-muted">Calculate the correct salt-to-water ratio for equilibrium brining.</p>
      </li>
      <li>
        <a href="/calculators/food-cost/" class="text-xl font-bold">Food Cost Calculator</a>
        <p class="text-text-muted">Determine the exact food cost percentage for any dish.</p>
      </li>
    </ul>
  </div>
</Layout>
