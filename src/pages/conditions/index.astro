---
import Layout from "../../layouts/Layout.astro";

const conditionsList = [
  { slug: "hypothyroidism", title: "Hypothyroidism & Low Thyroid", desc: "Underactive thyroid gland, fatigue, low T4, and levothyroxine dosing.", category: "Thyroid" },
  { slug: "hyperthyroidism", title: "Hyperthyroidism & Graves' Disease", desc: "Overactive thyroid gland, tremors, low TSH, and anti-thyroid care.", category: "Thyroid" },
  { slug: "hashimotos-thyroiditis", title: "Hashimoto's Thyroiditis", desc: "Autoimmune thyroiditis, anti-TPO antibody testing, and long-term care.", category: "Thyroid" },
  { slug: "thyroid-nodules", title: "Thyroid Nodules & Goiter", desc: "ACR TI-RADS risk stratification, ultrasound monitoring, and FNA decision tree.", category: "Thyroid" },
  { slug: "type-2-diabetes", title: "Type 2 Diabetes Mellitus", desc: "Glycemic optimization, insulin resistance, GLP-1 therapy, and A1C targets.", category: "Diabetes" },
  { slug: "prediabetes", title: "Prediabetes & Impaired Fasting Glucose", desc: "A1C 5.7–6.4% diagnostic threshold, lifestyle intervention, and reversal.", category: "Diabetes" },
  { slug: "type-1-diabetes", title: "Type 1 Diabetes", desc: "Intensive basal-bolus insulin management, CGM technology, and pump tuning.", category: "Diabetes" },
  { slug: "gestational-diabetes", title: "Gestational Diabetes", desc: "Pregnancy glycemic targets, meal logging, and safe fetal-maternal protocols.", category: "Diabetes" },
  { slug: "pcos", title: "Polycystic Ovary Syndrome (PCOS)", desc: "Hyperandrogenism, insulin resistance, irregular cycles, and metabolic health.", category: "Hormones" },
  { slug: "osteoporosis", title: "Osteoporosis & Low Bone Mass", desc: "Central DEXA T-score analysis, fracture risk reduction, and anabolic therapy.", category: "Bone Health" },
  { slug: "adrenal-insufficiency", title: "Adrenal Insufficiency & Addison's", desc: "Cortisol deficiency, ACTH stimulation testing, and glucocorticoid replacement.", category: "Adrenal" },
  { slug: "cushings-syndrome", title: "Cushing's Syndrome", desc: "Hypercortisolemia screening, 1mg dexamethasone suppression, and evaluation.", category: "Adrenal" },
  { slug: "hyperparathyroidism", title: "Hyperparathyroidism & High Calcium", desc: "Elevated PTH, hypercalcemia evaluation, kidney stone risk, and surgical referral.", category: "Parathyroid" },
  { slug: "pituitary-adenoma", title: "Pituitary Adenomas & Lesions", desc: "Prolactinoma, acromegaly, pituitary hormone axis testing, and MRI surveillance.", category: "Pituitary" },
  { slug: "metabolic-syndrome", title: "Metabolic Syndrome", desc: "Abdominal obesity, atherogenic dyslipidemia, elevated blood pressure, and insulin care.", category: "Metabolic" },
  { slug: "menopause-hormone-imbalance", title: "Perimenopause & Menopause Balance", desc: "Vasomotor symptoms, evidence-based HRT safety, and systemic hormone balancing.", category: "Hormones" },
  { slug: "hypogonadism", title: "Male Hypogonadism & Low Testosterone", desc: "Serum morning testosterone testing, LH/FSH evaluation, and safety monitoring.", category: "Hormones" },
  { slug: "obesity-weight-management", title: "Metabolic Weight Management", desc: "Incretin GLP-1/GIP pharmacology, basal metabolic rate science, and clinical plans.", category: "Metabolic" }
];
---

<Layout title="18 Endocrine Conditions Covered">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 space-y-10">
    <div class="space-y-3 border-b border-stone-200 pb-6">
      <span class="badge-reviewed">Clinical Directory</span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#1B4332]">18 Endocrine & Metabolic Conditions</h1>
      <p class="text-stone-600 text-sm sm:text-base max-w-3xl">
        Evidence-based diagnostic guidelines, laboratory thresholds, and medical management options written and reviewed by Dr. Ameena, MD.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {conditionsList.map((item) => (
        <a href={`/conditions/${item.slug}/`} class="bg-white p-6 rounded-xl border border-stone-200 hover:border-[#2D6A4F] hover:shadow-md transition space-y-3 flex flex-col justify-between group">
          <div class="space-y-2">
            <span class="badge-category">{item.category}</span>
            <h2 class="text-lg font-serif font-bold text-[#1B4332] group-hover:text-[#2D6A4F] transition">{item.title}</h2>
            <p class="text-xs text-stone-600 leading-relaxed">{item.desc}</p>
          </div>
          <div class="text-xs font-semibold text-[#2D6A4F] group-hover:underline pt-2">
            Read Condition Guide →
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
