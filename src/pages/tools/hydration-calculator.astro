---
import PageLayout from "../../layouts/Page.astro";
import CaptureForm from "../../components/forms/capture-form.astro";

const frontmatter = {
  title: "Dog Hydration Calculator",
  seo: {
    page_description: "Calculate how much water your dog needs daily based on body weight.",
  }
};
---
<PageLayout frontmatter={frontmatter}>
  <section class="max-w-4xl mx-auto py-16 px-4">
    <h1 class="text-4xl font-bold font-serif mb-6 text-[var(--color-text-main)]">Dog Hydration Calculator</h1>
    <p class="text-lg text-[var(--color-text-muted)] mb-8">
      Dogs generally need about 1 ounce of water per pound of body weight per day, though this varies with activity, heat, and diet (kibble vs wet food).
    </p>

    <div class="bg-[var(--color-bg-base)] p-6 rounded border border-[var(--color-border-light)] mb-12">
      <!-- No JS Fallback -->
      <noscript>
        <div class="prose max-w-none">
          <h3>How to calculate manually:</h3>
          <p>Multiply your dog's weight in pounds by 1. That is the rough estimate in ounces of water they need daily.</p>
        </div>
      </noscript>
      <form id="hydration-form" class="space-y-4">
        <div>
          <label class="block text-sm font-medium mb-1" for="weight">Dog's Weight (lbs):</label>
          <input type="number" id="weight" required class="w-full border border-[var(--color-border-light)] px-3 py-2 rounded focus:ring-1 focus:ring-[var(--color-primary)]" min="1" max="250" />
        </div>
        <button type="submit" class="bg-[var(--color-primary)] text-white px-6 py-2 rounded hover:bg-[var(--color-primary-hover)] font-medium">Calculate Water Need</button>
      </form>
      <div id="hydration-result" class="hidden mt-8 p-4 bg-white border border-[var(--color-border-light)] rounded" aria-live="polite">
        <h3 class="text-xl font-bold mb-2">Results</h3>
        <p>Estimated Daily Water Intake: <span id="res-oz" class="font-bold text-[var(--color-primary)]"></span> ounces (<span id="res-cups" class="font-bold"></span> cups)</p>
      </div>
    </div>

    <!-- Capture Integration -->
    <div class="bg-gray-100 p-8 rounded text-center mt-12">
      <h2 class="text-2xl font-bold font-serif mb-4">Questions about your dog's health or diet?</h2>
      <CaptureForm form="contact" submitLabel="Contact Our Team" class="max-w-md mx-auto text-left" />
    </div>
  </section>
</PageLayout>

<script>
  const form = document.getElementById('hydration-form');
  const resultDiv = document.getElementById('hydration-result');
  const resOz = document.getElementById('res-oz');
  const resCups = document.getElementById('res-cups');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const weightLbs = parseFloat((document.getElementById('weight') as HTMLInputElement).value);

      if (!weightLbs || weightLbs <= 0) return;

      const ounces = weightLbs * 1;
      const cups = (ounces / 8).toFixed(1);

      if (resOz && resCups && resultDiv) {
        resOz.textContent = ounces.toString();
        resCups.textContent = cups.toString();
        resultDiv.classList.remove('hidden');
      }
    });
  }
</script>
