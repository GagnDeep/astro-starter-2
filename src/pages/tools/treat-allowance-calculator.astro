---
import Layout from "../../layouts/Layout.astro";

const seo = {
  page_description: "Calculate exactly how many calories your dog should get from treats each day using the vet-recommended 10% rule.",
  open_graph_type: "website" as const,
};
---

<Layout title="Dog Treat Allowance Calculator" seo={seo}>
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-6 text-[var(--color-primary)]">Dog Treat Allowance Calculator</h1>

    <div class="prose mb-8">
      <p>
        Veterinarians recommend the <strong>10% rule</strong>: no more than 10% of your dog's daily calories should come from treats and snacks. The remaining 90% must come from a complete and balanced diet.
      </p>
      <p>
        Use this tool to calculate their daily Resting Energy Requirement (RER), Maintenance Energy Requirement (MER), and their exact 10% treat allowance.
      </p>
    </div>

    <div class="bg-[var(--color-surface)] p-6 rounded-lg border border-[var(--color-border)] mb-8">
      <form id="calc-form" class="space-y-6">
        <div>
          <label class="block text-sm font-medium mb-1">Dog's Weight</label>
          <div class="flex gap-4">
            <input type="number" id="weight" step="0.1" required class="w-full rounded border border-[var(--color-border)] px-3 py-2 focus:border-[var(--color-primary)] focus:outline-none" />
            <select id="unit" class="rounded border border-[var(--color-border)] px-3 py-2 bg-white">
              <option value="lbs">lbs</option>
              <option value="kg">kg</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium mb-1">Activity Level / Life Stage</label>
          <select id="factor" class="w-full rounded border border-[var(--color-border)] px-3 py-2 bg-white focus:border-[var(--color-primary)] focus:outline-none">
            <option value="1.6">Typical Adult (Neutered/Spayed)</option>
            <option value="1.8">Intact Adult</option>
            <option value="1.2">Senior / Inactive / Prone to obesity</option>
            <option value="1.0">Weight Loss</option>
            <option value="2.0">Working / Highly Active</option>
            <option value="3.0">Puppy (0-4 months)</option>
            <option value="2.0">Puppy (4 months to adult)</option>
          </select>
        </div>

        <button type="submit" class="w-full bg-[var(--color-primary)] text-white font-medium py-2 px-4 rounded hover:bg-[var(--color-primary-hover)]">Calculate</button>
      </form>

      <noscript>
        <div class="mt-6 p-4 bg-yellow-50 border-l-4 border-[var(--color-warning)] text-[var(--color-warning)] text-sm">
          <strong>Note:</strong> JavaScript is required for the interactive calculator. <br/>
          <strong>Manual Method:</strong><br/>
          1. Convert weight to kg (lbs / 2.2046)<br/>
          2. RER = 70 × (kg ^ 0.75)<br/>
          3. Daily Calories = RER × Activity Factor<br/>
          4. Treat Allowance = Daily Calories × 0.10
        </div>
      </noscript>

      <div id="results" class="hidden mt-8 pt-6 border-t border-[var(--color-border)]">
        <h3 class="text-xl font-semibold mb-4">Results</h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="bg-white p-4 rounded border border-[var(--color-border)] text-center">
            <div class="text-sm text-gray-500 mb-1">RER (Base Calories)</div>
            <div class="text-2xl font-bold" id="res-rer"></div>
            <div class="text-xs text-gray-400">kcal/day</div>
          </div>
          <div class="bg-white p-4 rounded border border-[var(--color-border)] text-center">
            <div class="text-sm text-gray-500 mb-1">Total Daily Calories</div>
            <div class="text-2xl font-bold text-[var(--color-secondary)]" id="res-total"></div>
            <div class="text-xs text-gray-400">kcal/day</div>
          </div>
          <div class="bg-[var(--color-primary)] text-white p-4 rounded border border-[var(--color-primary)] text-center">
            <div class="text-sm opacity-90 mb-1">Max Treat Allowance</div>
            <div class="text-2xl font-bold" id="res-treats"></div>
            <div class="text-xs opacity-80">kcal/day (10%)</div>
          </div>
        </div>
      </div>
    </div>

    <div class="prose">
      <h2>How it works</h2>
      <p>This calculator uses the standard veterinary formula for Resting Energy Requirement (RER): <code>70 × (body weight in kg)<sup>0.75</sup></code>.</p>
      <p>The RER is then multiplied by a life-stage factor to get the total daily Maintenance Energy Requirement (MER).</p>
      <p>Finally, we take 10% of the MER to find your exact treat allowance.</p>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('calc-form') as HTMLFormElement;
  const resultsDiv = document.getElementById('results');
  const resRer = document.getElementById('res-rer');
  const resTotal = document.getElementById('res-total');
  const resTreats = document.getElementById('res-treats');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const weightRaw = parseFloat((document.getElementById('weight') as HTMLInputElement).value);
      const unit = (document.getElementById('unit') as HTMLSelectElement).value;
      const factor = parseFloat((document.getElementById('factor') as HTMLSelectElement).value);

      if (isNaN(weightRaw) || weightRaw <= 0) return;

      const weightKg = unit === 'lbs' ? weightRaw / 2.20462 : weightRaw;

      // RER = 70 * (kg^0.75)
      const rer = 70 * Math.pow(weightKg, 0.75);

      const totalKcal = rer * factor;
      const treatsKcal = totalKcal * 0.10;

      if (resRer && resTotal && resTreats && resultsDiv) {
        resRer.textContent = Math.round(rer).toString();
        resTotal.textContent = Math.round(totalKcal).toString();
        resTreats.textContent = Math.round(treatsKcal).toString();
        resultsDiv.classList.remove('hidden');
      }
    });
  }
</script>
