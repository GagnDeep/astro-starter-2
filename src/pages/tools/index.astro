---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("tools");

const seo = {
  page_description: "Practical tools for estimating AI ROI, token costs, and time saved.",
};
---

<Layout title="AI Calculators & Tools" seo={seo}>
  <div class="max-w-4xl mx-auto px-6 py-12">
    <h1 class="text-4xl font-bold mb-4">AI Calculators & Tools</h1>
    <p class="text-xl text-slate-600 mb-12">Numbers beat intuition. Calculate exactly what AI will cost or save you.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {entries.map((entry) => (
        <a href={`/tools/${entry.id}/`} class="block p-6 border border-slate-200 rounded-lg hover:border-brand-500 transition-colors bg-white shadow-sm hover:shadow-md">
          <h2 class="text-xl font-semibold mb-2">{entry.data.title}</h2>
          <p class="text-slate-600">{entry.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
