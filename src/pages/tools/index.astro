---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const tools = await getCollection("tools");
---

<Layout title="Compliance Tools" seo={{ page_description: "Interactive tools for Battery Passport compliance." } }>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <h1 class="text-4xl font-bold text-slate-900 mb-8">Compliance Tools</h1>
    <div class="grid grid-cols-1 gap-6">
      {tools.map(tool => (
        <a href={`/tools/${tool.id}/`} class="block p-6 bg-white border border-slate-200 rounded-lg hover:shadow-md transition">
          <h2 class="text-2xl font-semibold text-slate-900 mb-2">{tool.data.title}</h2>
          <p class="text-slate-600">{tool.data.description}</p>
        </a>
      ))}
    </div>
  </div>
</Layout>
