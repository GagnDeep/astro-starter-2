---
import Layout from "../../layouts/Layout.astro";

const seo = {
  page_description: "Tools for calculating compliance and managing Cable Digital Product Passports.",
};
---

<Layout title="Compliance Tools" {seo}>
  <main class="max-w-4xl mx-auto px-4 py-12 prose">
    <h1>Compliance Tools</h1>
    <p>Select a tool below to verify your ESPR compliance and calculate data requirements.</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
      <a href="/tools/compliance-checker" class="block p-6 border border-[var(--color-border)] rounded hover:border-[var(--color-primary)] no-underline text-inherit">
        <h2 class="text-xl mt-0">Compliance Checker</h2>
        <p class="text-sm">Verify if your cable type requires a DPP under current EU rules.</p>
      </a>
      <a href="/tools/data-requirements" class="block p-6 border border-[var(--color-border)] rounded hover:border-[var(--color-primary)] no-underline text-inherit">
        <h2 class="text-xl mt-0">Data Requirements</h2>
        <p class="text-sm">Generate a checklist of required fields for your product passport.</p>
      </a>
      <a href="/tools/carbon-estimator" class="block p-6 border border-[var(--color-border)] rounded hover:border-[var(--color-primary)] no-underline text-inherit">
        <h2 class="text-xl mt-0">Carbon Estimator</h2>
        <p class="text-sm">Estimate the CO2 footprint based on materials and weight.</p>
      </a>
    </div>
  </main>
</Layout>
