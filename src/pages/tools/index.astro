---
import Layout from "../../layouts/Layout.astro";

const toolsList = [
  {
    slug: "symptom-checklist",
    title: "Interactive Endocrine Symptom Checklist",
    desc: "Evaluate your symptoms across thyroid, glycemic, reproductive, and bone health categories. Generates a clean, exportable summary for your doctor visit.",
    badge: "100% Client-Side / Private"
  },
  {
    slug: "question-builder",
    title: "Customized Visit Question Builder",
    desc: "Build a targeted list of diagnostic and treatment questions based on your specific condition, recent lab results, and personal health goals.",
    badge: "100% Client-Side / Private"
  },
  {
    slug: "insurance-checker",
    title: "Insurance Panel & Intake Verification Tool",
    desc: "Check accepted in-network insurance carriers and prior authorization requirements for Dr. Ameena's practice [NEEDS CONFIRMATION].",
    badge: "Practice Panel Record"
  }
];
---

<Layout title="Interactive Patient Health Tools">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 space-y-10">
    <div class="space-y-3 border-b border-stone-200 pb-6">
      <span class="badge-reviewed">Interactive Tools</span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#1B4332]">Interactive Patient Health Tools</h1>
      <p class="text-stone-600 text-sm sm:text-base max-w-3xl">
        Free, browser-based tools to help you prepare for your clinical consultation. All tools run locally in your browser with zero data collection or storage.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {toolsList.map((item) => (
        <a href={`/tools/${item.slug}/`} class="bg-white p-6 rounded-xl border border-stone-200 hover:border-[#2D6A4F] hover:shadow-md transition space-y-4 flex flex-col justify-between group">
          <div class="space-y-3">
            <span class="badge-reviewed text-[11px]">{item.badge}</span>
            <h2 class="text-xl font-serif font-bold text-[#1B4332] group-hover:text-[#2D6A4F] transition">{item.title}</h2>
            <p class="text-xs text-stone-600 leading-relaxed">{item.desc}</p>
          </div>
          <div class="btn-primary text-xs text-center">
            Launch Interactive Tool →
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
