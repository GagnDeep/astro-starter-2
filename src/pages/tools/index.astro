---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Document Conversion Tools" seo={{ page_description: "Explore our free document conversion tools: PDF to Word, Word to PDF, JPG to PDF, and Merge PDF." }}>
  <div class="mx-auto max-w-6xl px-4 py-16">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">All Tools</h1>
      <p class="text-xl text-text-muted max-w-2xl mx-auto">Free, fast, and secure tools to convert, edit, and compress your documents.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <a href="/tools/pdf-to-word" class="group block p-8 bg-surface border border-border rounded shadow-sm hover:shadow-md hover:border-brand transition-all">
        <h2 class="text-2xl font-semibold text-brand mb-2 group-hover:text-brand-hover">PDF to Word</h2>
        <p class="text-text-muted">Convert your PDF files to editable DOCX documents without losing formatting.</p>
      </a>

      <a href="/tools/word-to-pdf" class="group block p-8 bg-surface border border-border rounded shadow-sm hover:shadow-md hover:border-brand transition-all">
        <h2 class="text-2xl font-semibold text-brand mb-2 group-hover:text-brand-hover">Word to PDF</h2>
        <p class="text-text-muted">Convert DOCX files to PDF documents securely.</p>
      </a>

      <a href="/tools/jpg-to-pdf" class="group block p-8 bg-surface border border-border rounded shadow-sm hover:shadow-md hover:border-brand transition-all">
        <h2 class="text-2xl font-semibold text-brand mb-2 group-hover:text-brand-hover">JPG to PDF</h2>
        <p class="text-text-muted">Turn your images (JPG, PNG) into a single PDF document.</p>
      </a>

      <a href="/tools/merge-pdf" class="group block p-8 bg-surface border border-border rounded shadow-sm hover:shadow-md hover:border-brand transition-all">
        <h2 class="text-2xl font-semibold text-brand mb-2 group-hover:text-brand-hover">Merge PDF</h2>
        <p class="text-text-muted">Combine multiple PDF files into one single document.</p>
      </a>
    </div>
  </div>
</Layout>
