---
import Layout from "../../layouts/Layout.astro";
import CaptureForm from "../../components/forms/capture-form.astro";

const seo = {
  page_description: "Calculate your estimated gut transit time and understand what it means for your health.",
  canonical_url: null,
  featured_image: null,
  featured_image_alt: null,
  open_graph_type: "website",
  no_index: false,
};
---

<Layout title="Transit Time Calculator" seo={seo}>
  <main class="max-w-4xl mx-auto px-4 py-16 prose">
    <h1>Transit Time Calculator</h1>
    <p>Understanding how long food takes to move through your digestive tract can provide insights into your gut health. Average transit time is 30-40 hours (Source: Mayo Clinic).</p>

    <div class="bg-brand-secondary p-6 rounded-lg my-8">
      <h2>Calculate Your Estimate</h2>
      <p>This is a simplified no-JS fallback method. Note when you ate a marker food (like corn or beets) and when you first saw it in your stool.</p>

      <CaptureForm form="waitlist" submitLabel="Send me the full guide">
        <label class="block mb-4">
          <span class="text-sm font-medium">Time eaten (approx):</span>
          <input type="datetime-local" name="time_eaten" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm p-2" required />
        </label>
        <label class="block mb-4">
          <span class="text-sm font-medium">Time observed:</span>
          <input type="datetime-local" name="time_observed" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm p-2" required />
        </label>
        <label class="block mb-4">
          <span class="text-sm font-medium">Email address (to send results):</span>
          <input type="email" name="email" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm p-2" required />
        </label>
      </CaptureForm>
    </div>
  </main>
</Layout>
