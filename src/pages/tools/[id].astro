---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import NewsletterForm from "../../components/forms/newsletter-form.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
  const toolEntries = await getCollection("tools");
  return toolEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | Tools | uMediaPlayer`} seo={entry.data.seo}>
  <div class="max-w-6xl mx-auto px-4 py-12 flex flex-col md:flex-row gap-8">
    <div class="flex-1">
      <div class="surface-panel prose prose-invert max-w-none">
        <Content />
      </div>

      {/* Tool interactive area injected via script if applicable */}
      <div id="tool-interactive-area" class="mt-8 p-6 bg-slate-900 border border-slate-700 rounded-lg hidden">
        {/* Placeholder for JS injected content */}
      </div>
    </div>

    <div class="w-full md:w-80 flex flex-col gap-6">
      <div class="surface-panel bg-slate-800 p-6 rounded-lg">
        <h3 class="text-lg font-bold mb-3">Get Results & Updates</h3>
        <p class="text-sm text-slate-400 mb-4">Want to save these results or get more insights? Join our newsletter.</p>
        <NewsletterForm />
      </div>
    </div>
  </div>
</Layout>
