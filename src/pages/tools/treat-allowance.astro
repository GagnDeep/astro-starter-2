---
import Layout from "../../layouts/Layout.astro";
import CaptureForm from "../../components/forms/capture-form.astro";

const seo = {
  page_description: "Calculate exactly how many treats your dog can have per day based on their weight and activity level.",
  canonical_url: null,
  featured_image: null,
  featured_image_alt: null,
  author_twitter_handle: null,
  open_graph_type: "website",
  no_index: false,
};
---

<Layout title="Dog Treat Allowance Calculator - DogSnacker" seo={seo}>
  <div class="max-w-3xl mx-auto py-16 px-4">
    <h1 class="text-4xl font-bold mb-6">How many treats can a dog have a day?</h1>
    <p class="text-lg text-gray-700 mb-8">
      Veterinary guidelines (WSAVA) state that treats should make up no more than 10% of a dog's daily caloric intake.
      This calculator estimates their total daily calories and gives you a safe treat budget.
    </p>

    <div class="bg-white p-8 rounded-lg shadow-sm border border-gray-200 mb-12 relative overflow-hidden">
      <!-- We build a client island for the calculator -->
      <calculator-widget class="block">
        <form id="calc-form" class="space-y-6">
          <div class="grid md:grid-cols-2 gap-6">
            <div>
              <label for="weight" class="block text-sm font-medium text-gray-700 mb-1">Dog's Weight (lbs)</label>
              <input type="number" id="weight" min="1" max="250" required class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-primary focus:border-primary" />
            </div>
            <div>
              <label for="activity" class="block text-sm font-medium text-gray-700 mb-1">Activity Level</label>
              <select id="activity" required class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-primary focus:border-primary">
                <option value="1.2">Low Activity / Neutered Adult</option>
                <option value="1.6" selected>Average Activity</option>
                <option value="2.0">High Activity / Working Dog</option>
              </select>
            </div>
          </div>
          <button type="submit" class="btn-primary">Calculate Allowance</button>
        </form>

        <div id="results" class="hidden mt-8 pt-8 border-t border-gray-200">
          <h2 class="text-2xl font-bold mb-4">Results</h2>
          <div class="grid sm:grid-cols-2 gap-6 mb-8">
            <div class="bg-gray-50 p-6 rounded border border-gray-100">
              <p class="text-sm text-gray-500 uppercase tracking-wide font-medium">Estimated Daily Calories</p>
              <p class="text-3xl font-bold mt-2 number-tabular"><span id="res-total">0</span> <span class="text-lg text-gray-600 font-normal">kcal</span></p>
            </div>
            <div class="bg-green-50 p-6 rounded border border-green-100">
              <p class="text-sm text-green-800 uppercase tracking-wide font-medium">Max Treat Calories (10%)</p>
              <p class="text-3xl font-bold mt-2 text-primary number-tabular"><span id="res-treats">0</span> <span class="text-lg text-green-700 font-normal">kcal</span></p>
            </div>
          </div>

          <div class="bg-yellow-50 p-6 rounded">
            <h3 class="font-bold mb-2">Want to save these results?</h3>
            <p class="text-sm mb-4">Get your custom treat budget sent to your inbox, along with our list of top low-calorie training treats.</p>
            <CaptureForm form="waitlist" class="flex gap-2">
              <input type="hidden" id="form-treat-budget" name="treat_budget_kcal" value="" />
              <input type="email" name="email" required placeholder="Email address" class="flex-1 px-4 py-2 border border-gray-300 rounded-md" />
              <button type="submit" class="btn-primary py-2">Send Results</button>
            </CaptureForm>
          </div>
        </div>
      </calculator-widget>

      <noscript>
        <div class="p-6 bg-red-50 text-red-800 rounded">
          <p class="font-bold mb-2">JavaScript Required</p>
          <p>Please enable JavaScript to use the interactive calculator. Alternatively, use this rule of thumb: A typical 50lb dog needs about 1000 calories a day, meaning they can have 100 calories of treats safely.</p>
        </div>
      </noscript>
    </div>

    <div class="prose max-w-none">
      <h2>The Math Behind the Calculator</h2>
      <p>We use the Resting Energy Requirement (RER) formula widely accepted by veterinary professionals:</p>
      <p class="font-mono bg-gray-100 p-4 rounded text-sm number-tabular">RER = 70 × (Weight in kg)^0.75</p>
      <p>We then multiply the RER by an activity multiplier (1.2 to 2.0) to find the Maintenance Energy Requirement (MER), which is their total daily caloric need.</p>

      <h3>Why the 10% Rule?</h3>
      <p>Dog food is formulated to provide a complete and balanced diet. Treats are not. If treats make up more than 10% of a dog's diet, it can dilute the essential nutrients they get from their regular food, leading to deficiencies or weight gain.</p>
    </div>
  </div>
</Layout>

<script>
  class CalculatorWidget extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector('#calc-form') as HTMLFormElement;
      const resultsBlock = this.querySelector('#results') as HTMLDivElement;

      if (!form || !resultsBlock) return;

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const weightLbs = parseFloat((this.querySelector('#weight') as HTMLInputElement).value);
        const multiplier = parseFloat((this.querySelector('#activity') as HTMLSelectElement).value);

        if (isNaN(weightLbs) || isNaN(multiplier)) return;

        // Convert lbs to kg
        const weightKg = weightLbs / 2.20462;

        // RER = 70 * (kg ^ 0.75)
        const rer = 70 * Math.pow(weightKg, 0.75);

        // Total = RER * multiplier
        const totalCalories = Math.round(rer * multiplier);

        // Treats = 10% of total
        const treatCalories = Math.round(totalCalories * 0.1);

        (this.querySelector('#res-total') as HTMLSpanElement).textContent = totalCalories.toString();
        (this.querySelector('#res-treats') as HTMLSpanElement).textContent = treatCalories.toString();
        (this.querySelector('#form-treat-budget') as HTMLInputElement).value = treatCalories.toString();

        resultsBlock.classList.remove('hidden');
      });
    }
  }

  customElements.define('calculator-widget', CalculatorWidget);
</script>
