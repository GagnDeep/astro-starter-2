---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="BTL Mortgage Calculator | Institute of Property">
  <div class="py-16 px-6 sm:px-12 bg-background min-h-screen">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl font-bold mb-4 text-center">BTL Mortgage Calculator</h1>
      <p class="text-center text-text-muted mb-10 max-w-2xl mx-auto">Stress test interest-only vs repayment mortgages for buy-to-let properties.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="card">
          <form id="mortgage-form" class="space-y-4">
            <div>
              <label class="block text-sm font-medium mb-1" for="loan">Loan Amount (£)</label>
              <input type="number" id="loan" class="input-field" value="150000" required>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1" for="rate">Interest Rate (%)</label>
              <input type="number" id="rate" class="input-field" value="5.5" step="0.1" required>
            </div>
            <div>
              <label class="block text-sm font-medium mb-1" for="term">Term (Years)</label>
              <input type="number" id="term" class="input-field" value="25" required>
            </div>
            <button type="submit" class="btn-primary w-full">Calculate</button>
          </form>
        </div>

        <div class="card bg-primary text-surface flex flex-col justify-center items-center text-center">
          <div id="results" class="hidden w-full">
            <h3 class="text-xl font-medium text-surface/80 mb-2">Interest Only (Monthly)</h3>
            <p id="io-payment" class="text-4xl font-bold text-accent mb-6">£687.50</p>

            <h3 class="text-xl font-medium text-surface/80 mb-2">Repayment (Monthly)</h3>
            <p id="repayment-payment" class="text-4xl font-bold text-accent mb-6">£921.13</p>
          </div>
          <div id="initial-state" class="text-surface/60">
            Enter your figures and click calculate.
          </div>
        </div>
      </div>

      <noscript>
        <div class="mt-12 prose prose-slate max-w-none">
          <h3>How it is calculated</h3>
          <p><strong>Interest Only</strong> = (Loan Amount * Interest Rate) / 12</p>
          <p><strong>Repayment</strong> = Uses standard amortization formula: P * (r(1+r)^n) / ((1+r)^n - 1)</p>
        </div>
      </noscript>
    </div>
  </div>

  <script is:inline>
    const form = document.getElementById('mortgage-form');
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const p = parseFloat(document.getElementById('loan').value);
      const rAnnual = parseFloat(document.getElementById('rate').value) / 100;
      const t = parseFloat(document.getElementById('term').value);

      if(p > 0 && rAnnual > 0 && t > 0) {
        // Interest Only
        const io = (p * rAnnual) / 12;

        // Repayment
        const rMonthly = rAnnual / 12;
        const n = t * 12;
        const repayment = p * (rMonthly * Math.pow(1 + rMonthly, n)) / (Math.pow(1 + rMonthly, n) - 1);

        document.getElementById('io-payment').innerText = '£' + io.toFixed(2);
        document.getElementById('repayment-payment').innerText = '£' + repayment.toFixed(2);

        document.getElementById('initial-state').classList.add('hidden');
        document.getElementById('results').classList.remove('hidden');
      }
    });
  </script>
</Layout>
