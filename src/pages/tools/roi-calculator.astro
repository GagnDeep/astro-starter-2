---
import Layout from "../../layouts/Layout.astro";

const props = {
  title: "E-Signature ROI Calculator",
  seo: {
    page_description: "Calculate how much time and money you save by switching from paper to e-signatures with uSignPDF."
  }
};
---

<Layout {...props}>
  <div class="max-w-4xl mx-auto px-4 py-20">
    <h1 class="text-4xl font-bold mb-4">E-Signature ROI Calculator</h1>
    <p class="text-xl text-slate-600 mb-12">Calculate the hidden costs of printing, signing, and scanning contracts.</p>

    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <form id="roi-form" class="space-y-6">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Contracts sent per month</label>
            <input type="number" id="contracts" value="10" class="input-field" min="1" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Average pages per contract</label>
            <input type="number" id="pages" value="5" class="input-field" min="1" />
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Hourly rate ($)</label>
            <input type="number" id="rate" value="50" class="input-field" min="1" />
          </div>
        </form>
      </div>

      <div class="bg-slate-50 p-8 rounded-xl border border-slate-200">
        <h3 class="text-xl font-bold mb-6">Your Monthly Savings</h3>

        <div class="space-y-4 mb-8">
          <div class="flex justify-between border-b pb-2">
            <span class="text-slate-600">Material Savings (Paper, Ink, Postage)</span>
            <span id="material-savings" class="font-bold">$0.00</span>
          </div>
          <div class="flex justify-between border-b pb-2">
            <span class="text-slate-600">Time Savings (15 min/contract)</span>
            <span id="time-savings" class="font-bold">$0.00</span>
          </div>
          <div class="flex justify-between pt-2 text-xl">
            <span class="font-bold">Total Savings</span>
            <span id="total-savings" class="font-bold text-green-600">$0.00</span>
          </div>
        </div>

        <div class="text-sm text-slate-500 mb-6">
          <p>Assumptions: Printing/materials cost $1.50 per contract. It takes an average of 15 minutes of administrative time to print, track, scan, and file a physical contract vs uploading a PDF.</p>
        </div>

        <div class="border-t pt-6">
          <h4 class="font-bold mb-2">Get these results emailed to you:</h4>
          <form data-capture="tool_results" method="POST" action="https://api.markremover.com/v1/collect/tool_results" class="flex gap-2">
              <input type="hidden" name="key" value="wcs_pk_usignpdf_demo" />
              <input type="hidden" name="redirect" value="https://usignpdf.com/thanks" />
              <input type="hidden" name="calculated_savings" id="hidden-savings" value="0" />
              <input type="email" name="email" required placeholder="Email address" class="input-field flex-1 text-sm" />
              <button type="submit" class="btn-primary py-2 text-sm">Send Report</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    function calculate() {
      const contracts = parseFloat((document.getElementById('contracts') as HTMLInputElement).value) || 0;
      const pages = parseFloat((document.getElementById('pages') as HTMLInputElement).value) || 0;
      const rate = parseFloat((document.getElementById('rate') as HTMLInputElement).value) || 0;

      // Assumptions
      const costPerContractMaterials = 1.50; // Paper, ink, wear and tear
      const hoursPerContractAdmin = 15 / 60; // 15 mins to print, sign, scan, email

      const materialSavings = contracts * costPerContractMaterials;
      const timeSavings = contracts * hoursPerContractAdmin * rate;
      const totalSavings = materialSavings + timeSavings;

      document.getElementById('material-savings')!.innerText = '$' + materialSavings.toFixed(2);
      document.getElementById('time-savings')!.innerText = '$' + timeSavings.toFixed(2);
      document.getElementById('total-savings')!.innerText = '$' + totalSavings.toFixed(2);
      (document.getElementById('hidden-savings') as HTMLInputElement).value = totalSavings.toFixed(2);
    }

    document.getElementById('roi-form')?.addEventListener('input', calculate);
    // Initial calculation
    calculate();
  </script>
</Layout>
