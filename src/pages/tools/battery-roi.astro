---
import Layout from "../../layouts/Layout.astro";
import CaptureForm from "../../components/forms/capture-form.astro";

const seo: any = {
  page_description: "Calculate the return on investment (ROI) for adding a home solar battery in California.",
  no_index: false,
};
---

<Layout title={seo.title || "Solar"} seo={seo}>
  <div class="max-w-4xl mx-auto px-4 py-16 prose">
    <h1>Solar Battery ROI Calculator</h1>
    <p>Find out if adding a battery to your solar system makes financial sense.</p>

    <noscript>
      <div class="bg-gray-100 p-6 rounded-lg mb-8">
        <h3>Battery ROI Logic (No-JS Fallback)</h3>
        <p>A typical home battery (like a Tesla Powerwall or Enphase IQ) costs ~$12,000 to $15,000 installed before incentives.</p>
        <p><strong>Financial Benefits:</strong></p>
        <ul>
          <li><strong>Federal ITC:</strong> 30% off the total cost.</li>
          <li><strong>SGIP Rebate (CA):</strong> Varies, can be $1,000+.</li>
          <li><strong>Rate Arbitrage:</strong> Storing cheap daytime solar to use during expensive evening peak hours (4 PM - 9 PM) saves you roughly $0.20 to $0.40 per kWh every day.</li>
          <li><strong>NEM 3.0:</strong> Prevents exporting energy at low rates (~$0.05/kWh), retaining its full retail value (~$0.35/kWh).</li>
        </ul>
        <p><em>Typical Payback Period:</em> 6 to 9 years under NEM 3.0.</p>
      </div>
    </noscript>

    <div id="calculator" class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 mb-8 tabular-nums">
      <form id="battery-calc-form" class="space-y-4">
        <div>
          <label for="battery-cost" class="block text-sm font-medium mb-1">Estimated Installed Cost ($)</label>
          <input type="number" id="battery-cost" name="battery-cost" value="14000" class="w-full rounded border border-gray-300 px-3 py-2 focus:border-[var(--interactive)] focus:outline-none focus:ring-1 focus:ring-[var(--interactive)]" />
        </div>
        <div>
          <label for="peak-rate" class="block text-sm font-medium mb-1">Peak Time-of-Use Rate ($ / kWh) - Usually 4PM-9PM</label>
          <input type="number" id="peak-rate" name="peak-rate" value="0.55" step="0.01" class="w-full rounded border border-gray-300 px-3 py-2 focus:border-[var(--interactive)] focus:outline-none focus:ring-1 focus:ring-[var(--interactive)]" />
        </div>
        <div>
          <label for="daily-cycle" class="block text-sm font-medium mb-1">Daily Energy Cycled (kWh) - e.g., Powerwall is 13.5</label>
          <input type="number" id="daily-cycle" name="daily-cycle" value="10" class="w-full rounded border border-gray-300 px-3 py-2 focus:border-[var(--interactive)] focus:outline-none focus:ring-1 focus:ring-[var(--interactive)]" />
        </div>
        <button type="button" id="calc-btn" class="rounded bg-[var(--accent-primary)] px-5 py-2.5 font-medium text-white hover:bg-[var(--accent-secondary)]">Calculate Battery ROI</button>
      </form>

      <div id="results" class="mt-8 hidden">
        <h3 class="text-xl font-semibold mb-4">Estimated Results</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="bg-gray-50 p-4 rounded border border-gray-200">
            <p class="text-sm text-gray-500 mb-1">Net Cost (After 30% ITC)</p>
            <p class="text-2xl font-bold" id="res-net-cost">--</p>
          </div>
          <div class="bg-gray-50 p-4 rounded border border-gray-200">
            <p class="text-sm text-gray-500 mb-1">Estimated Annual Savings (Arbitrage)</p>
            <p class="text-2xl font-bold text-[var(--accent-primary)]" id="res-savings">--</p>
          </div>
          <div class="bg-gray-50 p-4 rounded border border-gray-200">
            <p class="text-sm text-gray-500 mb-1">Battery Payback Period</p>
            <p class="text-2xl font-bold" id="res-payback">--</p>
          </div>
        </div>
        <p class="text-sm text-gray-600 mt-4"><em>Note:</em> Calculations assume 365 days of cycling. Actual savings depend heavily on exact utility tariff and weather.</p>
      </div>
    </div>

    <script>
      document.getElementById('calc-btn')?.addEventListener('click', () => {
        const costInput = document.getElementById('battery-cost') as HTMLInputElement;
        const peakRateInput = document.getElementById('peak-rate') as HTMLInputElement;
        const dailyCycleInput = document.getElementById('daily-cycle') as HTMLInputElement;

        const cost = parseFloat(costInput.value) || 0;
        const peakRate = parseFloat(peakRateInput.value) || 0;
        const dailyCycle = parseFloat(dailyCycleInput.value) || 0;

        const netCost = cost * 0.7; // 30% ITC
        // Value created by avoiding peak rate imports and avoiding low off-peak exports
        // Rough estimate: The spread between export value (~0.05) and peak import cost (~0.55) is ~0.50
        const estimatedSpread = peakRate - 0.05;
        const dailySavings = dailyCycle * estimatedSpread;
        const annualSavings = dailySavings * 350; // Accounting for 15 low production days

        const paybackYears = netCost / annualSavings;

        const resultsDiv = document.getElementById('results');
        const resNetCost = document.getElementById('res-net-cost');
        const resSavings = document.getElementById('res-savings');
        const resPayback = document.getElementById('res-payback');

        if (resultsDiv && resNetCost && resSavings && resPayback) {
          resultsDiv.classList.remove('hidden');
          resNetCost.textContent = `$${netCost.toFixed(0)}`;
          resSavings.textContent = `$${annualSavings.toFixed(0)}`;
          resPayback.textContent = `${paybackYears.toFixed(1)} years`;
        }
      });
    </script>

    <div class="mt-16">
      <CaptureForm form="newsletter" submitLabel="Subscribe" successMessage="Thanks for subscribing!">
         <p>Subscribe for updates on California battery rebates and SGIP funding status.</p>
      </CaptureForm>
    </div>
  </div>
</Layout>
