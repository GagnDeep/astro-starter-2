---
import Layout from "../../layouts/Layout.astro";
import CaptureForm from "../../components/forms/capture-form.astro";

const seo = {
  page_description: "Calculate your optimal macronutrient split for your goals.",
  title: "Macro Calculator"
};
---

<Layout title="Macro Calculator" seo={seo}>
  <main class="max-w-3xl mx-auto px-4 py-12 prose">
    <h1>Macro Calculator</h1>
    <p>Find your optimal macro targets. For more info, read our <a href="/library/macro-tracking-basics/">guide to macros</a>.</p>
  </main>
</Layout>
