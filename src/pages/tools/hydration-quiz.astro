---
import Layout from '../../layouts/Layout.astro';
import CaptureForm from '../../components/forms/capture-form.astro';

const seo = {
  page_description: "Take the quiz to find out if you might be dehydrated.",
  no_index: false,
};
---

<Layout title="Am I Dehydrated? Quiz" seo={seo}>
  <div class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-4xl font-bold tracking-tight mb-4 text-center">Hydration Status Quiz</h1>
    <p class="text-lg text-gray-600 mb-8 text-center">
      Answer 5 quick questions to assess your current hydration level.
    </p>

    <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
      <form id="quiz-form" class="space-y-6">
        <div>
          <p class="font-semibold mb-2">1. What color is your urine?</p>
          <label class="block"><input type="radio" name="q1" value="0" class="mr-2"> Pale, transparent yellow</label>
          <label class="block"><input type="radio" name="q1" value="1" class="mr-2"> Dark yellow or amber</label>
        </div>
        <div>
          <p class="font-semibold mb-2">2. Are you experiencing a headache?</p>
          <label class="block"><input type="radio" name="q2" value="0" class="mr-2"> No</label>
          <label class="block"><input type="radio" name="q2" value="1" class="mr-2"> Yes</label>
        </div>
        <div>
          <p class="font-semibold mb-2">3. Does your mouth feel dry or sticky?</p>
          <label class="block"><input type="radio" name="q3" value="0" class="mr-2"> No</label>
          <label class="block"><input type="radio" name="q3" value="1" class="mr-2"> Yes</label>
        </div>
        <div>
          <p class="font-semibold mb-2">4. Have you felt dizzy when standing up recently?</p>
          <label class="block"><input type="radio" name="q4" value="0" class="mr-2"> No</label>
          <label class="block"><input type="radio" name="q4" value="1" class="mr-2"> Yes</label>
        </div>
        <div>
          <p class="font-semibold mb-2">5. How would you describe your energy levels?</p>
          <label class="block"><input type="radio" name="q5" value="0" class="mr-2"> Normal/Energetic</label>
          <label class="block"><input type="radio" name="q5" value="1" class="mr-2"> Unusually fatigued or lethargic</label>
        </div>
        <button type="button" onclick="scoreQuiz()" class="w-full rounded bg-blue-600 px-4 py-3 font-bold text-white hover:bg-blue-700">
          Get Results
        </button>
      </form>

      <div id="quiz-result" class="hidden mt-8 p-6 bg-blue-50 rounded border border-blue-200 text-center">
        <h2 id="result-title" class="text-2xl font-bold text-blue-900 mb-2"></h2>
        <p id="result-desc" class="text-gray-700 mb-6"></p>
        <div class="border-t border-blue-200 pt-6">
          <h3 class="font-bold mb-4">Want personalized daily reminders?</h3>
          <CaptureForm form="waitlist" submitLabel="Join WaterTrackLog" />
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function scoreQuiz() {
      let score = 0;
      const form = document.getElementById('quiz-form');
      for (let i = 1; i <= 5; i++) {
        const selected = form.querySelector(`input[name="q${i}"]:checked`);
        if (selected) score += parseInt(selected.value);
      }

      const res = document.getElementById('quiz-result');
      const title = document.getElementById('result-title');
      const desc = document.getElementById('result-desc');

      res.classList.remove('hidden');
      form.classList.add('hidden');

      if (score === 0) {
        title.textContent = "You're likely well hydrated!";
        desc.textContent = "Keep up the good work. Your body has the fluids it needs to function optimally.";
      } else if (score <= 2) {
        title.textContent = "Mild Dehydration Possible";
        desc.textContent = "You are exhibiting some early signs. Drink a glass or two of water and see how you feel in 30 minutes.";
      } else {
        title.textContent = "Likely Dehydrated";
        desc.textContent = "You are showing multiple signs of dehydration. Please drink water steadily over the next hour. (Consult a doctor if symptoms persist).";
      }
    }
  </script>
</Layout>
