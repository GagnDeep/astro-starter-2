---
import Layout from "../../layouts/Layout.astro";
import CaptureForm from "../../components/forms/capture-form.astro";

const seo = {
  page_description: "Calculate your daily fiber intake needs for optimal digestion.",
  canonical_url: null,
  featured_image: null,
  featured_image_alt: null,
  open_graph_type: "website",
  no_index: false,
};
---

<Layout title="Fiber Needs Calculator" seo={seo}>
  <main class="max-w-4xl mx-auto px-4 py-16 prose">
    <h1>Fiber Needs Calculator</h1>
    <p>Recommended daily fiber: 25g for women, 38g for men (Source: Academy of Nutrition and Dietetics).</p>

    <div class="bg-brand-secondary p-6 rounded-lg my-8">
      <CaptureForm form="waitlist" submitLabel="Calculate & Send Results">
        <label class="block mb-4">
          <span class="text-sm font-medium">Gender:</span>
          <select name="gender" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm p-2">
            <option value="female">Female</option>
            <option value="male">Male</option>
          </select>
        </label>
        <label class="block mb-4">
          <span class="text-sm font-medium">Age:</span>
          <input type="number" name="age" min="1" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm p-2" />
        </label>
        <label class="block mb-4">
          <span class="text-sm font-medium">Email address:</span>
          <input type="email" name="email" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm p-2" required />
        </label>
      </CaptureForm>
    </div>
  </main>
</Layout>
