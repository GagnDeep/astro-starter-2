---
import Layout from "../../layouts/Layout.astro";

const seo = {
  page_description: "Calculate potential toxicity from common dangerous foods like chocolate.",
  open_graph_type: "website" as const,
};
---

<Layout title="Chocolate Toxicity Calculator" seo={seo}>
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-6 text-[var(--color-primary)]">Chocolate Toxicity Calculator</h1>

    <div class="prose mb-8">
      <p>
        Chocolate contains theobromine and caffeine, which are toxic to dogs. Different types of chocolate have different levels of toxicity. Baker's chocolate and dark chocolate are the most dangerous.
      </p>
      <p class="text-[var(--color-danger)] font-bold">
        If you suspect your dog has eaten a dangerous amount of chocolate, contact your veterinarian or Animal Poison Control immediately. This calculator is for estimation only.
      </p>
    </div>

    <div class="bg-[var(--color-surface)] p-6 rounded-lg border border-[var(--color-border)] mb-8">
      <form id="calc-form" class="space-y-6">
        <div>
          <label class="block text-sm font-medium mb-1">Dog's Weight</label>
          <div class="flex gap-4">
            <input type="number" id="weight" step="0.1" required class="w-full rounded border border-[var(--color-border)] px-3 py-2 focus:border-[var(--color-primary)] focus:outline-none" />
            <select id="unit" class="rounded border border-[var(--color-border)] px-3 py-2 bg-white">
              <option value="lbs">lbs</option>
              <option value="kg">kg</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium mb-1">Chocolate Type</label>
          <select id="choc-type" class="w-full rounded border border-[var(--color-border)] px-3 py-2 bg-white focus:border-[var(--color-primary)] focus:outline-none">
            <option value="44">Milk Chocolate (44 mg/oz)</option>
            <option value="150">Dark Chocolate (150 mg/oz)</option>
            <option value="393">Baker's Chocolate (393 mg/oz)</option>
            <option value="400">Cocoa Powder (400 mg/oz)</option>
            <option value="1">White Chocolate (1 mg/oz - very low)</option>
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium mb-1">Amount Eaten</label>
          <div class="flex gap-4">
            <input type="number" id="amount" step="0.1" required class="w-full rounded border border-[var(--color-border)] px-3 py-2 focus:border-[var(--color-primary)] focus:outline-none" />
            <select id="amount-unit" class="rounded border border-[var(--color-border)] px-3 py-2 bg-white">
              <option value="oz">oz</option>
              <option value="g">grams</option>
            </select>
          </div>
        </div>

        <button type="submit" class="w-full bg-[var(--color-danger)] text-white font-medium py-2 px-4 rounded hover:bg-[var(--color-danger-hover)]">Calculate Risk</button>
      </form>

      <noscript>
        <div class="mt-6 p-4 bg-yellow-50 border-l-4 border-[var(--color-warning)] text-[var(--color-warning)] text-sm">
          <strong>Note:</strong> JavaScript is required for the interactive calculator. <br/>
          <strong>Manual Method:</strong><br/>
          1. Calculate mg of methylxanthines ingested.<br/>
          2. Divide by dog's weight in kg.<br/>
          3. >20 mg/kg: Mild symptoms. >40 mg/kg: Severe symptoms (cardiac). >60 mg/kg: Seizures.
        </div>
      </noscript>

      <div id="results" class="hidden mt-8 pt-6 border-t border-[var(--color-border)]">
        <h3 class="text-xl font-semibold mb-4">Results</h3>
        <div class="mb-4">
          Dose: <span id="res-dose" class="font-bold"></span> mg/kg
        </div>
        <div id="res-assessment" class="p-4 rounded border font-medium"></div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('calc-form') as HTMLFormElement;
  const resultsDiv = document.getElementById('results');
  const resDose = document.getElementById('res-dose');
  const resAssessment = document.getElementById('res-assessment');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const weightRaw = parseFloat((document.getElementById('weight') as HTMLInputElement).value);
      const weightUnit = (document.getElementById('unit') as HTMLSelectElement).value;
      const chocTypeMgPerOz = parseFloat((document.getElementById('choc-type') as HTMLSelectElement).value);

      const amountRaw = parseFloat((document.getElementById('amount') as HTMLInputElement).value);
      const amountUnit = (document.getElementById('amount-unit') as HTMLSelectElement).value;

      if (isNaN(weightRaw) || weightRaw <= 0 || isNaN(amountRaw) || amountRaw <= 0) return;

      const weightKg = weightUnit === 'lbs' ? weightRaw / 2.20462 : weightRaw;
      const amountOz = amountUnit === 'g' ? amountRaw / 28.3495 : amountRaw;

      const totalMg = amountOz * chocTypeMgPerOz;
      const doseMgPerKg = totalMg / weightKg;

      if (resultsDiv && resDose && resAssessment) {
        resDose.textContent = doseMgPerKg.toFixed(1);
        resultsDiv.classList.remove('hidden');

        resAssessment.className = 'p-4 rounded border font-medium ';

        if (doseMgPerKg < 9) {
          resAssessment.textContent = 'Likely non-toxic. Monitor for mild stomach upset.';
          resAssessment.classList.add('bg-green-50', 'text-green-800', 'border-green-200');
        } else if (doseMgPerKg < 20) {
          resAssessment.textContent = 'Mild risk. May cause agitation, vomiting, or diarrhea. Call your vet for advice.';
          resAssessment.classList.add('bg-yellow-50', 'text-yellow-800', 'border-yellow-200');
        } else if (doseMgPerKg < 40) {
          resAssessment.textContent = 'Moderate to Severe risk. Cardiac signs (rapid heart rate, high blood pressure) possible. Contact vet IMMEDIATELY.';
          resAssessment.classList.add('bg-orange-50', 'text-orange-800', 'border-orange-200');
        } else {
          resAssessment.textContent = 'EXTREME RISK. Potential for seizures, tremors, and death. GO TO EMERGENCY VET NOW.';
          resAssessment.classList.add('bg-red-50', 'text-red-800', 'border-red-200', 'font-bold');
        }
      }
    });
  }
</script>
