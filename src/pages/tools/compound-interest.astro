---
import Layout from "../../layouts/Layout.astro";
import Seo from "../../components/seo/seo.astro";
import CaptureForm from "../../components/forms/capture-form.astro";

const seo = { page_description: "Visualize the power of compound interest over time.", no_index: false };
---
<Layout title="Compound Interest Calculator">
  <Seo seo={seo} />
  <div class="max-w-5xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl font-bold mb-4">Compound Interest Calculator</h1>
    <p class="text-xl mb-8">See how your money grows over time with the magic of compound interest.</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="md:col-span-1 bg-surface p-6 rounded-lg border border-secondary">
        <h2 class="text-xl font-bold mb-4">Inputs</h2>
        <form id="compoundForm" class="space-y-4">
          <noscript>
            <div class="p-4 bg-yellow-50 text-yellow-900 border border-yellow-200 rounded mb-4">
              <h3 class="font-bold">Interactive Calculator Requires JavaScript</h3>
              <p class="mb-2">Since JavaScript is disabled, you can calculate this manually using the following method:</p>

              <p><strong>Formula:</strong> <code>A = P(1+r/n)^(nt) + PMT[((1+r/n)^(nt) - 1) / (r/n)]</code></p>
              <ul class="list-disc ml-4 mt-2">
                <li><code>P</code> = Initial Investment</li>
                <li><code>PMT</code> = Monthly Contribution</li>
                <li><code>r</code> = Estimated Annual Interest Rate</li>
                <li><code>n</code> = 12 (Monthly compounding)</li>
                <li><code>t</code> = Time Period in Years</li>
              </ul>

            </div>
          </noscript>

          <div>
            <label class="block text-sm font-medium mb-1">Initial Investment ($)</label>
            <input type="number" id="principal" class="w-full px-3 py-2 border border-secondary rounded" value="10000" min="0" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Monthly Contribution ($)</label>
            <input type="number" id="monthly" class="w-full px-3 py-2 border border-secondary rounded" value="500" min="0" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Time Period (Years)</label>
            <input type="number" id="years" class="w-full px-3 py-2 border border-secondary rounded" value="20" min="1" max="100" />
          </div>
          <div>
            <label class="block text-sm font-medium mb-1">Estimated Interest Rate (%)</label>
            <input type="number" id="rate" class="w-full px-3 py-2 border border-secondary rounded" value="7" min="0" max="20" step="0.1" />
          </div>
        </form>
      </div>

      <div class="md:col-span-2 bg-surface p-6 rounded-lg border border-secondary">
        <h2 class="text-xl font-bold mb-4">Growth Projection</h2>
        <div id="results" class="text-5xl font-bold text-primary mb-4">$0.00</div>

        <div class="prose max-w-none mb-8">
          <p>Over <span id="outYears">20</span> years, your total contributions of <strong id="outContributions">$0.00</strong> will grow by <strong id="outInterest">$0.00</strong> in interest.</p>
        </div>

        <div class="mt-8 pt-8 border-t border-secondary">
          <h3 class="text-lg font-bold mb-4">Get a detailed schedule</h3>
          <CaptureForm form="quote" submitLabel="Email Schedule">
             <input type="hidden" name="tool" value="Compound Interest" />
             <input type="email" name="email" required placeholder="Your email address" class="w-full px-3 py-2 border border-secondary rounded mb-4" />
          </CaptureForm>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function formatCurrency(num: number) {
    return new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(num);
  }

  function calculate() {
    const P = parseFloat((document.getElementById('principal') as HTMLInputElement).value) || 0;
    const PMT = parseFloat((document.getElementById('monthly') as HTMLInputElement).value) || 0;
    const t = parseFloat((document.getElementById('years') as HTMLInputElement).value) || 0;
    const rate = parseFloat((document.getElementById('rate') as HTMLInputElement).value) || 0;

    const r = rate / 100;
    const n = 12; // monthly compounding

    // Compound Interest formula with additions
    // A = P(1 + r/n)^(nt) + PMT * (((1 + r/n)^(nt) - 1) / (r/n))

    let A = 0;
    const totalContributions = P + (PMT * 12 * t);

    if (r === 0) {
      A = totalContributions;
    } else {
      A = P * Math.pow(1 + r/n, n*t) + PMT * ((Math.pow(1 + r/n, n*t) - 1) / (r/n));
    }

    const totalInterest = Math.max(0, A - totalContributions);

    const resultsEl = document.getElementById('results');
    const outYearsEl = document.getElementById('outYears');
    const outContributionsEl = document.getElementById('outContributions');
    const outInterestEl = document.getElementById('outInterest');

    if (resultsEl) resultsEl.innerText = formatCurrency(A);
    if (outYearsEl) outYearsEl.innerText = t.toString();
    if (outContributionsEl) outContributionsEl.innerText = formatCurrency(totalContributions);
    if (outInterestEl) outInterestEl.innerText = formatCurrency(totalInterest);
  }

  const inputs = document.querySelectorAll('#compoundForm input');
  inputs.forEach(input => {
    input.addEventListener('input', calculate);
  });

  calculate();
</script>
