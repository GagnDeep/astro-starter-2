---
import Layout from "../../layouts/Layout.astro";
import CaptureForm from "../../components/forms/capture-form.astro";

const seo = {
  page_description: "Calculate your take-home pay in the Cayman Islands. Understand pension deductions and health insurance costs.",
  canonical_url: "/tools/salary-calculator",
  open_graph_type: "website"
};
---
<Layout seo={seo} title="Cayman Islands Salary Calculator | Take-Home Pay">
  <div class="max-w-4xl mx-auto py-12 px-6">
    <h1 class="text-3xl font-bold mb-6">Cayman Islands Salary Calculator</h1>
    <p class="mb-8">Estimate your monthly take-home pay. The Cayman Islands has no income tax, but mandatory pension (5%) and health insurance contributions apply.</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div class="bg-white p-6 rounded-lg shadow-md border border-gray-100">
        <form id="salary-form" class="space-y-4">
          <div>
            <label for="salary" class="block text-sm font-medium text-gray-700 mb-1">Annual Salary (US$)</label>
            <input type="number" id="salary" name="salary" class="w-full rounded border border-gray-300 px-3 py-2" required placeholder="e.g. 100000" />
          </div>
          <div>
            <label for="health" class="block text-sm font-medium text-gray-700 mb-1">Monthly Health Premium Deduction (US$)</label>
            <input type="number" id="health" name="health" class="w-full rounded border border-gray-300 px-3 py-2" value="200" />
            <p class="text-xs text-gray-500 mt-1">Employers must cover at least 50% of the Standard Health Insurance Contract (SHIC), but many cover 100%.</p>
          </div>
          <button type="button" id="calc-btn" class="w-full bg-navy-900 text-white py-2 rounded font-medium hover:bg-navy-800 transition-colors">Calculate</button>
        </form>

        <noscript>
          <div class="mt-8 bg-brand-50 p-4 rounded-md border border-brand-100 text-sm">
            <h3 class="font-bold mb-2">How to calculate manually:</h3>
            <ol class="list-decimal pl-4 space-y-2">
              <li>Divide your annual salary by 12 to get your gross monthly pay.</li>
              <li>Subtract 5% of your gross monthly pay (Mandatory Pension).</li>
              <li>Subtract your portion of the monthly health insurance premium.</li>
              <li>The result is your estimated take-home pay.</li>
            </ol>
          </div>
        </noscript>

        <div id="results" class="mt-8 hidden bg-gray-50 p-4 rounded-md border border-gray-200">
          <h3 class="font-bold text-lg mb-4">Monthly Breakdown (US$)</h3>
          <div class="flex justify-between mb-2">
            <span>Gross Monthly:</span>
            <span id="res-gross" class="font-mono"></span>
          </div>
          <div class="flex justify-between mb-2 text-red-600">
            <span>Pension (5%):</span>
            <span id="res-pension" class="font-mono"></span>
          </div>
          <div class="flex justify-between mb-2 text-red-600">
            <span>Health Insurance:</span>
            <span id="res-health" class="font-mono"></span>
          </div>
          <div class="border-t border-gray-300 my-2 pt-2 flex justify-between font-bold text-green-700 text-lg">
            <span>Take-Home Pay:</span>
            <span id="res-net" class="font-mono"></span>
          </div>
        </div>
      </div>

      <div>
        <h3 class="text-xl font-bold mb-4">Save these results?</h3>
        <p class="text-sm text-gray-600 mb-4">Get a detailed breakdown sent to your email, along with our guide to negotiating relocation packages in Cayman.</p>
        <CaptureForm form="newsletter" submitLabel="Email me my results">
          <input type="hidden" name="calculated_salary" id="cap-salary" />
          <div>
            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required class="w-full rounded border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none" />
          </div>
        </CaptureForm>
      </div>
    </div>
  </div>

  <script is:inline>
    document.getElementById('calc-btn').addEventListener('click', () => {
      const annualStr = document.getElementById('salary').value;
      const healthStr = document.getElementById('health').value;
      if(!annualStr) return;

      const annual = parseFloat(annualStr);
      const health = parseFloat(healthStr || 0);

      const grossMonthly = annual / 12;
      const pension = grossMonthly * 0.05; // 5% mandatory employee contribution
      const net = grossMonthly - pension - health;

      document.getElementById('res-gross').innerText = '$' + grossMonthly.toFixed(2);
      document.getElementById('res-pension').innerText = '-$' + pension.toFixed(2);
      document.getElementById('res-health').innerText = '-$' + health.toFixed(2);
      document.getElementById('res-net').innerText = '$' + net.toFixed(2);

      document.getElementById('cap-salary').value = annual;

      document.getElementById('results').classList.remove('hidden');
    });
  </script>
</Layout>
