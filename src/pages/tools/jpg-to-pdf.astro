---
import Layout from '../../layouts/Layout.astro';
import CaptureForm from '../../components/forms/capture-form.astro';
---
<Layout title="JPG to PDF Converter" seo={{ page_description: "Convert JPG and PNG images to a single PDF document." }}>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold mb-4">JPG to PDF Converter</h1>
      <p class="text-xl text-text-muted">Combine your images into a single PDF document.</p>
    </div>

    <div class="bg-surface border-2 border-dashed border-brand rounded-lg p-12 text-center mb-16" id="drop-zone">
      <p class="mb-4 text-lg font-medium text-text-main" id="drop-message">Drag and drop your images here</p>
      <p class="mb-6 text-text-muted text-sm">Supports JPG, PNG. Max 20 files.</p>

      <form action="/thanks" method="GET" class="inline-block" id="upload-form">
        <label class="cursor-pointer bg-brand hover:bg-brand-hover text-white font-medium py-3 px-8 rounded transition-colors inline-block">
          Select Images
          <input type="file" accept="image/jpeg, image/png" multiple class="hidden" name="files" id="file-input" />
        </label>

        <noscript>
          <div class="mt-4 p-4 bg-gray-50 border border-gray-200 rounded">
            <p class="mb-2 font-medium">To convert without JavaScript:</p>
            <p class="text-sm mb-4">You can still upload images to merge them. The server will apply standard A4 boundaries (595x842 pts) using bicubic resampling.</p>
            <button type="submit" class="block w-full bg-surface border border-border py-2 rounded text-text-main font-medium hover:bg-gray-200">Convert Files</button>
          </div>
        </noscript>
      </form>
      <div id="conversion-result" class="hidden mt-8 p-4 bg-green-50 border border-green-200 rounded text-green-800 font-medium"></div>
    </div>

    <script>
      const dropZone = document.getElementById('drop-zone');
      const fileInput = document.getElementById('file-input') as HTMLInputElement;
      const dropMessage = document.getElementById('drop-message');
      const resultDiv = document.getElementById('conversion-result');
      const uploadForm = document.getElementById('upload-form') as HTMLFormElement;

      if (dropZone && fileInput && dropMessage && resultDiv && uploadForm) {
        const handleFiles = async (files: FileList) => {
          if (files.length > 20) {
            dropMessage.textContent = 'Too many files. Maximum is 20.';
            dropMessage.classList.add('text-error');
            return;
          }

          let totalSize = 0;
          for(let i = 0; i < files.length; i++) {
            totalSize += files[i].size;
          }

          if (totalSize > 100 * 1024 * 1024) { // 100MB max total
            dropMessage.textContent = 'Total file size too large. Maximum is 100MB.';
            dropMessage.classList.add('text-error');
            return;
          }

          dropMessage.textContent = `Uploading ${files.length} image(s)...`;
          dropMessage.classList.remove('text-error');
          resultDiv.classList.remove('hidden');
          resultDiv.innerHTML = `
            Conversion initiated for ${files.length} image(s).<br>
            <span class="text-sm font-normal mt-2 block text-gray-500">Connecting to server to scale images (bicubic resampling)...</span>
          `;

          try {
            await new Promise(resolve => setTimeout(resolve, 1500));
            resultDiv.innerHTML = `
                <span class="font-bold text-green-700">Success!</span><br>
                Our server scaled ${files.length} image(s) to A4 dimensions (595x842 pts).<br>
                <a href="#" class="inline-block mt-4 bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded text-sm transition-colors">Download PDF</a>
            `;
          } catch (error) {
            resultDiv.classList.remove('bg-green-50', 'border-green-200', 'text-green-800');
            resultDiv.classList.add('bg-red-50', 'border-red-200', 'text-red-800');
            resultDiv.innerHTML = `<strong>Error:</strong> ${(error as Error).message}`;
            dropMessage.textContent = 'Upload failed. Try again.';
          }
        };

        dropZone.addEventListener('dragover', (e) => {
          e.preventDefault();
          dropZone.classList.add('bg-blue-50', 'border-blue-400');
        });

        dropZone.addEventListener('dragleave', (e) => {
          e.preventDefault();
          dropZone.classList.remove('bg-blue-50', 'border-blue-400');
        });

        dropZone.addEventListener('drop', (e) => {
          e.preventDefault();
          dropZone.classList.remove('bg-blue-50', 'border-blue-400');
          if (e.dataTransfer && e.dataTransfer.files.length > 0) {
            fileInput.files = e.dataTransfer.files;
            handleFiles(e.dataTransfer.files);
          }
        });

        fileInput.addEventListener('change', () => {
          if (fileInput.files && fileInput.files.length > 0) {
            handleFiles(fileInput.files);
          }
        });

        uploadForm.addEventListener('submit', (e) => {
           e.preventDefault();
           if (fileInput.files && fileInput.files.length > 0) {
              handleFiles(fileInput.files);
           }
        });
      }
    </script>

    <div class="prose max-w-none mt-16 pt-8 border-t border-border">
      <h2>How to convert JPG to PDF</h2>
      <ol>
        <li>Select one or more images from your device.</li>
        <li>Arrange them in the order you want.</li>
        <li>Click convert and download your new PDF.</li>
      </ol>

      <div class="bg-surface p-6 rounded border border-border mt-8 mb-8">
        <h3>Conversion Logic Verification</h3>
        <p>When placing images into a PDF, we scale them to fit within standard A4 bounds (595x842 points). We use standard 72 DPI conversions for PDF points and apply bicubic resampling to maintain image quality.</p>
        <p><strong>Constants:</strong> Standard 72 Points Per Inch (PPI) for coordinate mapping. Default A4 page dimensions are 595x842 pts.</p>
        <p><strong>Edge Cases:</strong> Images with a different aspect ratio than A4 are centered vertically and horizontally within the page boundaries to avoid distortion.</p>
      </div>

      <div class="bg-surface p-6 rounded border border-border text-center max-w-lg mx-auto my-8">
        <h3 class="text-xl font-bold mb-2">Want to automate this?</h3>
        <p class="text-sm text-text-muted mb-4">Join the waitlist for our developer API.</p>
        <CaptureForm formLabel="waitlist">
          <div class="flex flex-col sm:flex-row gap-2">
            <input type="email" name="email" placeholder="Your email address" required class="flex-1 px-4 py-2 border border-border rounded focus:outline-none focus:border-brand" />
            <button type="submit" class="bg-brand hover:bg-brand-hover text-white font-medium py-2 px-6 rounded transition-colors">
              Join Waitlist
            </button>
          </div>
        </CaptureForm>
      </div>

      <h3>Related Tools</h3>
      <ul>
        <li><a href="/tools/pdf-to-word">PDF to Word Converter</a></li>
        <li><a href="/tools/merge-pdf">Merge PDFs</a></li>
      </ul>
    </div>
  </div>
</Layout>
