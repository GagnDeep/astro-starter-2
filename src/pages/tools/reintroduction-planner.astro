---
import Layout from "../../layouts/Layout.astro";
import protocolsData from "../../../data/protocols.json";
import { Calendar, ShieldAlert, CheckCircle2 } from "@lucide/astro";

const title = "Step-by-Step FODMAP Reintroduction Planner — IBS Go";
const description = "Plan your 8-week FODMAP group challenge calendar with washout periods and precise portion steps.";
---

<Layout title={title} seo={{ page_description: description }}>
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="mb-6 text-sm text-stone-600 flex items-center gap-2">
      <a href="/" class="hover:underline">Home</a> <span>/</span> <a href="/protocols/" class="hover:underline">Protocols</a> <span>/</span> <span class="font-semibold text-stone-900">Reintroduction Planner</span>
    </nav>

    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-bold text-stone-900 mb-3">Reintroduction Challenge Planner</h1>
      <p class="text-stone-700 text-lg">Systematically test fructans, GOS, sorbitol, mannitol, and lactose over 8 weeks.</p>
    </header>

    <div class="bg-amber-50 border-l-4 border-amber-600 p-4 rounded-r-lg mb-8 text-sm text-stone-800 flex items-start gap-3">
      <ShieldAlert class="w-5 h-5 text-amber-700 shrink-0 mt-0.5" />
      <div>
        <strong>Challenge Rule:</strong> Always allow a 2 to 3 day baseline low-FODMAP washout period between testing different food groups.
      </div>
    </div>

    <div class="bg-white rounded-xl border border-stone-200 p-6 shadow-sm mb-10">
      <h2 class="text-xl font-bold text-stone-900 mb-4">Challenge Portion Schedule Matrix</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm border-collapse">
          <thead>
            <tr class="bg-stone-100 border-b border-stone-200 font-semibold">
              <th class="p-3">FODMAP Group</th>
              <th class="p-3">Test Food</th>
              <th class="p-3">Day 1 Portion</th>
              <th class="p-3">Day 2 Portion</th>
              <th class="p-3">Day 3 Portion</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-200 text-xs">
            <tr>
              <td class="p-3 font-bold text-stone-900">Fructans (Garlic)</td>
              <td class="p-3">Garlic clove</td>
              <td class="p-3 font-mono">1/4 clove</td>
              <td class="p-3 font-mono">1/2 clove</td>
              <td class="p-3 font-mono">1 whole clove</td>
            </tr>
            <tr>
              <td class="p-3 font-bold text-stone-900">Fructans (Onion)</td>
              <td class="p-3">Yellow onion</td>
              <td class="p-3 font-mono">1 tbsp chopped</td>
              <td class="p-3 font-mono">2 tbsp chopped</td>
              <td class="p-3 font-mono">1/4 cup chopped</td>
            </tr>
            <tr>
              <td class="p-3 font-bold text-stone-900">Sorbitol</td>
              <td class="p-3">Avocado</td>
              <td class="p-3 font-mono">1/4 avocado (45g)</td>
              <td class="p-3 font-mono">1/2 avocado (80g)</td>
              <td class="p-3 font-mono">1 whole avocado</td>
            </tr>
            <tr>
              <td class="p-3 font-bold text-stone-900">Mannitol</td>
              <td class="p-3">Cauliflower</td>
              <td class="p-3 font-mono">1 small floret (20g)</td>
              <td class="p-3 font-mono">2 florets (40g)</td>
              <td class="p-3 font-mono">1/2 cup florets (80g)</td>
            </tr>
            <tr>
              <td class="p-3 font-bold text-stone-900">Lactose</td>
              <td class="p-3">Cow's milk</td>
              <td class="p-3 font-mono">1/4 cup (60ml)</td>
              <td class="p-3 font-mono">1/2 cup (125ml)</td>
              <td class="p-3 font-mono">1 cup (250ml)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="flex flex-wrap gap-4 text-sm font-medium pt-6 border-t border-stone-200">
      <a href="/protocols/" class="text-amber-800 hover:underline">&larr; Back to Protocol Guides</a>
      <a href="/app/" class="text-amber-800 hover:underline">Track Challenges in IBS Go App &rarr;</a>
    </div>
  </main>
</Layout>
