---
import Layout from "../../layouts/Layout.astro";
const seo = {
  page_description: "View MOBI files online directly in browser.",
  open_graph_type: "website",
};
---

<Layout title="Online MOBI Viewer | uDocumentView" seo={seo}>
  <main class="max-w-4xl mx-auto px-4 py-16 text-center">
    <h1 class="text-4xl font-bold mb-4">Online MOBI Viewer</h1>
    <div
      class="max-w-3xl mx-auto p-12 border-2 border-dashed border-slate-300 rounded-lg bg-slate-50 cursor-pointer mb-12"
    >
      <p class="text-lg font-medium text-slate-900">Drag & Drop your .mobi here</p>
    </div>
  </main>
</Layout>
