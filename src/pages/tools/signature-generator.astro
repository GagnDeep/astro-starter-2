---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Draw Signature Online | usignpdf"
  seo={{
    page_description: "Draw your signature online for free and download it as a transparent PNG for your documents.",
    canonical_url: "https://usignpdf.com/tools/signature-generator/"
  }}
>
  <div class="max-w-4xl mx-auto py-20 px-4 md:px-8 text-center">
    <h1 class="text-4xl font-bold mb-4">Draw Signature Online</h1>
    <p class="text-xl text-text-muted mb-12">Create a transparent signature image to use anywhere.</p>

    <div class="max-w-2xl mx-auto">
      <div class="bg-surface p-4 rounded-lg shadow-sm border border-border">
         <noscript>
            <div class="p-4 bg-error text-surface mb-4 rounded">
              <p class="text-sm font-semibold">JavaScript is required to draw on the canvas.</p>
            </div>
         </noscript>
         <div class="border-2 border-dashed border-border bg-surface-alt rounded-lg h-64 mb-4 relative overflow-hidden touch-none" id="canvas-container">
             <canvas id="sig-canvas" class="w-full h-full cursor-crosshair"></canvas>
             <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-20" id="placeholder-text">
                 <span class="text-2xl font-bold font-sans">Sign Here</span>
             </div>
         </div>
         <div class="flex gap-4 justify-center">
             <button id="btn-clear" class="px-4 py-2 bg-surface-alt border border-border rounded hover:bg-border transition">Clear</button>
             <button id="btn-download" class="px-4 py-2 bg-accent text-surface rounded hover:bg-accent-hover transition font-semibold" disabled>Download PNG</button>
         </div>
      </div>
    </div>
  </div>

  <script>
    const canvas = document.getElementById('sig-canvas') as HTMLCanvasElement;
    const ctx = canvas?.getContext('2d');
    const container = document.getElementById('canvas-container');
    const clearBtn = document.getElementById('btn-clear') as HTMLButtonElement;
    const downloadBtn = document.getElementById('btn-download') as HTMLButtonElement;
    const placeholder = document.getElementById('placeholder-text');

    if (canvas && ctx && container) {
        // Resize canvas to match container size
        function resize() {
            canvas.width = container!.clientWidth;
            canvas.height = container!.clientHeight;
            ctx!.strokeStyle = '#0f172a'; // primary text color
            ctx!.lineWidth = 3;
            ctx!.lineCap = 'round';
            ctx!.lineJoin = 'round';
        }

        window.addEventListener('resize', resize);
        resize();

        let isDrawing = false;
        let hasDrawn = false;
        let lastX = 0;
        let lastY = 0;

        function startPosition(e: MouseEvent | TouchEvent) {
            isDrawing = true;
            const pos = getPos(e);
            lastX = pos.x;
            lastY = pos.y;
            if(placeholder) placeholder.style.display = 'none';
        }

        function endPosition() {
            isDrawing = false;
            ctx!.beginPath();
            if (hasDrawn) {
                downloadBtn.disabled = false;
            }
        }

        function draw(e: MouseEvent | TouchEvent) {
            if (!isDrawing) return;
            e.preventDefault(); // Prevent scrolling on touch

            const pos = getPos(e);

            ctx!.beginPath();
            ctx!.moveTo(lastX, lastY);
            ctx!.lineTo(pos.x, pos.y);
            ctx!.stroke();

            lastX = pos.x;
            lastY = pos.y;
            hasDrawn = true;
        }

        function getPos(e: MouseEvent | TouchEvent) {
            const rect = canvas.getBoundingClientRect();
            if ('touches' in e) {
                return {
                    x: e.touches[0].clientX - rect.left,
                    y: e.touches[0].clientY - rect.top
                };
            }
            return {
                x: e.clientX - rect.left,
                y: e.clientY - rect.top
            };
        }

        canvas.addEventListener('mousedown', startPosition);
        canvas.addEventListener('mouseup', endPosition);
        canvas.addEventListener('mousemove', draw);
        canvas.addEventListener('mouseleave', endPosition);

        canvas.addEventListener('touchstart', startPosition, { passive: false });
        canvas.addEventListener('touchend', endPosition);
        canvas.addEventListener('touchmove', draw, { passive: false });

        clearBtn.addEventListener('click', () => {
            ctx!.clearRect(0, 0, canvas.width, canvas.height);
            hasDrawn = false;
            downloadBtn.disabled = true;
            if(placeholder) placeholder.style.display = 'flex';
        });

        downloadBtn.addEventListener('click', () => {
            if(!hasDrawn) return;
            const dataUrl = canvas.toDataURL('image/png');
            const link = document.createElement('a');
            link.download = 'signature.png';
            link.href = dataUrl;
            link.click();
        });
    }
  </script>
</Layout>
