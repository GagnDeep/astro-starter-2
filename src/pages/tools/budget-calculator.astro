---
import Layout from "../../layouts/Layout.astro";
import CaptureForm from "../../components/forms/capture-form.astro";

const seo = {
  page_description: "Calculate the real cost of owning a handpan, including maintenance and shipping.",
  canonical_url: "/tools/budget-calculator/",
  featured_image: "/images/og/og-default.png",
  featured_image_alt: "Budget Calculator",
  author_twitter_handle: "",
  open_graph_type: "website",
  no_index: false
};
---

<Layout title="Handpan Budget Calculator" seo={seo}>
  <div class="mx-auto max-w-4xl px-8 py-16">
    <h1 class="text-4xl font-bold mb-4 font-display">Handpan Budget Calculator</h1>
    <p class="text-lg text-gray-600 mb-8">
      Handpans aren't just the sticker price. Calculate shipping, cases, and maintenance.
    </p>

    <div class="bg-white p-8 rounded-xl shadow-md border border-gray-100 mb-12">
      <noscript>
        <div class="bg-amber-50 p-6 rounded-lg border border-amber-200 mb-6">
          <h2 class="text-xl font-semibold mb-2">Manual Budget Guide:</h2>
          <ul class="list-disc ml-6 space-y-2 text-gray-700">
            <li><strong>Entry Level:</strong> ~$1,000 - $1,500</li>
            <li><strong>Pro Level:</strong> ~$2,000 - $3,500+</li>
            <li><strong>Hard Case (Flights):</strong> ~$250</li>
            <li><strong>Soft Bag:</strong> ~$100</li>
            <li><strong>Maintenance (Oil, cloths, 1st retune):</strong> ~$100/yr</li>
          </ul>
        </div>
      </noscript>

      <form id="budget-form" class="space-y-6">
        <div>
          <label class="block font-semibold mb-2">Instrument Tier</label>
          <select id="tier" class="w-full p-3 border rounded-md" required>
            <option value="1200">Entry Level Quality (~$1,200)</option>
            <option value="2500">Professional Custom (~$2,500)</option>
            <option value="3500">Premium / Mutants (~$3,500+)</option>
          </select>
        </div>

        <div>
          <label class="block font-semibold mb-2">Case Type</label>
          <select id="casetype" class="w-full p-3 border rounded-md" required>
            <option value="100">Soft Bag (Local travel)</option>
            <option value="250">Evatek / Hardcase (Flights)</option>
            <option value="0">None (Not recommended)</option>
          </select>
        </div>

        <div>
          <label class="block font-semibold mb-2">International Shipping?</label>
          <select id="shipping" class="w-full p-3 border rounded-md" required>
            <option value="0">No, buying local</option>
            <option value="150">Yes, roughly $150</option>
          </select>
        </div>

        <button type="button" id="calculate-btn" class="bg-brand-800 text-white px-6 py-3 rounded-md font-semibold hover:bg-brand-700 transition">
          Calculate Total Cost
        </button>
      </form>

      <div id="results" class="hidden mt-8 p-6 bg-brand-50 border border-brand-200 rounded-lg">
        <h3 class="text-2xl font-bold text-brand-900 mb-2">Estimated Total: <span id="result-total" class="text-brand-700"></span></h3>
        <p class="text-gray-700 mb-4">Breakdown: <span id="result-desc"></span></p>

        <hr class="my-6 border-brand-200" />

        <h4 class="font-semibold mb-4">Want help finding a maker in this budget?</h4>
        <CaptureForm form="quote">
          <input type="hidden" name="budget" id="capture-budget" value="" />
          <div class="mb-4">
            <label class="block text-sm font-medium mb-1">Email</label>
            <input type="email" name="email" class="w-full p-2 border rounded-md" required />
          </div>
          <button class="bg-steel-700 text-white px-4 py-2 rounded-md hover:bg-steel-900 transition">Request Recommendations</button>
        </CaptureForm>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const btn = document.getElementById('calculate-btn');
      if (btn) {
        btn.addEventListener('click', () => {
          const tier = parseInt((document.getElementById('tier') as HTMLSelectElement).value);
          const casetype = parseInt((document.getElementById('casetype') as HTMLSelectElement).value);
          const shipping = parseInt((document.getElementById('shipping') as HTMLSelectElement).value);

          const total = tier + casetype + shipping + 50; // 50 for oil/maintenance

          document.getElementById('result-total')!.innerText = `$${total}`;
          document.getElementById('result-desc')!.innerText = `Instrument: $${tier}, Case: $${casetype}, Shipping: $${shipping}, Starter Maintenance Kit: $50`;
          (document.getElementById('capture-budget') as HTMLInputElement).value = total.toString();

          document.getElementById('results')!.classList.remove('hidden');
        });
      }
    });
  </script>
</Layout>
