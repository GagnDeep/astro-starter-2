---
import Layout from "../../layouts/Layout.astro";
import CaptureForm from "../../components/forms/capture-form.astro";
---

<Layout
  title="Paper Cost Calculator | usignpdf"
  seo={{
    page_description: "Calculate the hidden environmental and financial costs of printing documents for signature. Free paper cost calculator.",
    canonical_url: "https://usignpdf.com/tools/paper-cost-calculator/"
  }}
>
  <div class="max-w-4xl mx-auto py-20 px-4 md:px-8">
    <h1 class="text-4xl font-bold mb-4 text-center">Paper & Ink Cost Calculator</h1>
    <p class="text-xl text-text-muted mb-12 text-center">Printing contracts isn't just slow—it's surprisingly expensive.</p>

    <div class="grid md:grid-cols-2 gap-12">
      <div class="bg-surface p-8 rounded-lg shadow border border-border">
        <h2 class="text-2xl font-semibold mb-6">Usage</h2>

        <form id="cost-form" class="space-y-6">
          <div>
            <label class="block text-sm font-medium mb-2" for="pages-per-month">Pages printed per month (for signatures)</label>
            <input type="number" id="pages-per-month" value="100" min="1" class="w-full px-4 py-2 border border-border rounded focus:ring-2 focus:ring-accent outline-none" />
          </div>
          <div class="pt-4 border-t border-border mt-6">
            <h3 class="text-sm font-bold text-text-muted mb-4 uppercase">Assumptions (Avg)</h3>
            <div class="space-y-4">
                <div>
                  <label class="block text-xs font-medium mb-1" for="cost-per-page">Cost per piece of paper ($)</label>
                  <input type="number" id="cost-per-page" value="0.05" step="0.01" class="w-full px-3 py-1 text-sm border border-border rounded outline-none bg-surface-alt" />
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1" for="cost-per-ink">Cost of ink/toner per page ($)</label>
                  <input type="number" id="cost-per-ink" value="0.07" step="0.01" class="w-full px-3 py-1 text-sm border border-border rounded outline-none bg-surface-alt" />
                </div>
                <div>
                  <label class="block text-xs font-medium mb-1" for="postage">Postage/Courier per document ($) (optional)</label>
                  <input type="number" id="postage" value="0.00" step="0.10" class="w-full px-3 py-1 text-sm border border-border rounded outline-none bg-surface-alt" />
                  <p class="text-xs text-text-muted mt-1">If you mail them physically.</p>
                </div>
            </div>
          </div>
          <noscript>
            <div class="p-4 bg-surface-alt border-l-4 border-accent mt-4">
              <p class="text-sm font-semibold">Enable JavaScript to calculate automatically.</p>
            </div>
          </noscript>
        </form>
      </div>

      <div class="bg-primary text-surface p-8 rounded-lg shadow flex flex-col justify-center">
        <h2 class="text-2xl font-semibold mb-6 text-surface-alt">Annual Material Cost</h2>

        <div class="mb-8">
          <div class="text-sm text-surface-alt mb-1">Direct Cost (Paper + Ink)</div>
          <div class="text-5xl font-bold font-mono text-accent" id="result-materials">$144</div>
        </div>

        <div class="mb-8">
          <div class="text-sm text-surface-alt mb-1">Total Cost (incl. Postage)</div>
          <div class="text-3xl font-bold font-mono" id="result-total">$144</div>
        </div>

        <div class="text-sm text-surface-alt p-4 bg-surface/10 rounded">
          <strong>Environmental impact:</strong> you use approximately <span id="trees-saved" class="font-bold">0.1</span> trees per year just for signatures.
        </div>
      </div>
    </div>
  </div>

  <script>
    function calculate() {
      const pages = parseFloat((document.getElementById('pages-per-month') as HTMLInputElement).value) || 0;
      const paperCost = parseFloat((document.getElementById('cost-per-page') as HTMLInputElement).value) || 0;
      const inkCost = parseFloat((document.getElementById('cost-per-ink') as HTMLInputElement).value) || 0;
      const postage = parseFloat((document.getElementById('postage') as HTMLInputElement).value) || 0;

      const pagesPerYear = pages * 12;
      const materialsPerYear = pagesPerYear * (paperCost + inkCost);
      // Assuming 1 document = 5 pages for postage math if postage > 0
      const docsPerYear = pagesPerYear / 5;
      const totalPostageYear = docsPerYear * postage;

      const totalCost = materialsPerYear + totalPostageYear;

      // Approx 8333 pages per standard pine tree
      const trees = pagesPerYear / 8333;

      document.getElementById('result-materials')!.textContent = '$' + materialsPerYear.toLocaleString('en-US', { maximumFractionDigits: 0 });
      document.getElementById('result-total')!.textContent = '$' + totalCost.toLocaleString('en-US', { maximumFractionDigits: 0 });
      document.getElementById('trees-saved')!.textContent = trees.toFixed(2);
    }

    ['pages-per-month', 'cost-per-page', 'cost-per-ink', 'postage'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', calculate);
    });

    calculate();
  </script>
</Layout>
