---
import Layout from "../../layouts/Layout.astro";
import CaptureForm from "../../components/forms/capture-form.astro";
import { capture } from "../../../capture.config";

const seo = {
  page_description: "Analyze and improve your prompts.",
  no_index: false,
};
---
<Layout title="Prompt Optimizer" seo={seo}>
  <main class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-4">Prompt Optimizer</h1>
    <p class="text-slate-600 mb-8">Analyze your system and user prompts for best practices.</p>

    <div class="bg-white p-6 rounded-lg shadow-sm border border-slate-200">
      <p class="text-slate-500 italic text-sm mb-4">Note: This tool checks for common missing elements like persona, formatting instructions, and constraints.</p>

      <form class="space-y-4" onsubmit="event.preventDefault();
        const text = document.getElementById('prompt-text').value.toLowerCase();
        let score = 100;
        let tips = [];
        if(!text.includes('act as') && !text.includes('you are a')) { score -= 20; tips.push('Add a persona (e.g. \'Act as an expert...\').'); }
        if(!text.includes('format') && !text.includes('json') && !text.includes('markdown')) { score -= 20; tips.push('Specify the output format clearly.'); }
        if(text.length < 50) { score -= 20; tips.push('Prompt is too short. Provide more context.'); }

        document.getElementById('opt-score').innerText = score + '/100';
        document.getElementById('opt-tips').innerHTML = tips.length ? tips.map(t => '<li>' + t + '</li>').join('') : '<li>Looks good!</li>';
        document.getElementById('opt-results').classList.remove('hidden');">

        <div>
          <label class="block text-sm font-medium text-slate-700">Your Prompt</label>
          <textarea id="prompt-text" class="mt-1 block w-full rounded-md border-slate-300 shadow-sm p-2 border" rows="6" placeholder="Paste your prompt here..."></textarea>
        </div>
        <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 transition">Analyze Prompt</button>
      </form>
      <div id="opt-results" class="hidden mt-6 p-4 bg-slate-100 rounded">
        <h3 class="font-bold text-lg mb-2">Prompt Score: <span id="opt-score" class="text-indigo-600"></span></h3>
        <ul id="opt-tips" class="list-disc pl-5 text-slate-700">
        </ul>
      </div>
    </div>

    <!-- Results by email capture -->
    <div class="mt-12 bg-slate-50 p-6 rounded-lg border border-slate-200">
      <h2 class="text-xl font-semibold mb-2">Download our Prompt Library</h2>
      <p class="text-sm text-slate-600 mb-4">Get 50+ tested, production-ready prompts for coding, analysis, and automation.</p>
      <CaptureForm form={capture.forms.newsletter} submitLabel="Get Prompts" class="space-y-4">
        <div class="space-y-1">
          <label for="email" class="block text-sm font-medium text-slate-700">Email Address</label>
          <input type="email" id="email" name="email" required class="block w-full rounded-md border-slate-300 border p-2" />
        </div>
        <input type="hidden" name="tool" value="prompt-optimizer" />
      </CaptureForm>
    </div>
  </main>
</Layout>
