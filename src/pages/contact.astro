---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";

const seo = {
  page_description: "Contact DogSnacking.com",
};
---

<Layout title="Contact Us" seo={seo}>
  <div class="max-w-2xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-6 text-[var(--color-primary)]">Contact Us</h1>
    <p class="mb-8">Have a question about a treat? Found a broken link? Let us know.</p>
    <CaptureForm form="contact" />
  </div>
</Layout>
