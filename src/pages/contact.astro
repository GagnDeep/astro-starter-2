---
import Layout from '../layouts/Layout.astro';
import CaptureForm from '../components/forms/capture-form.astro';
import { capture } from '../../capture.config';
---

<Layout title="Contact Us | Institute of Property">
  <div class="py-16 px-6 sm:px-12 bg-background min-h-screen">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl font-bold mb-4">Contact Us</h1>
      <p class="text-lg text-text-muted mb-10">Have a question about our data, tools, or courses? Get in touch.</p>

      <div class="card max-w-2xl">
        <CaptureForm form={capture.forms.contact} submitLabel="Send Message" successMessage="Message sent. We will reply within 48 hours." />
      </div>
    </div>
  </div>
</Layout>
