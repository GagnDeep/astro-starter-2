---
import Layout from '../layouts/Layout.astro';
import CaptureForm from '../components/forms/capture-form.astro';

const seo = {
  page_description: "Contact the Institute of Investing for inquiries, partnerships, or support.",
};
---

<Layout title="Contact Us | Institute of Investing" seo={seo}>
  <main class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-4">Contact Us</h1>
    <p class="text-xl text-gray-600 mb-8">We'd love to hear from you. Note: We do not provide personalized financial advice.</p>

    <div class="bg-gray-50 p-8 rounded-lg border border-gray-200">
      <CaptureForm form="contact" submitLabel="Send Message" />
    </div>
  </main>
</Layout>
