---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";
import NewsletterForm from "../components/forms/newsletter-form.astro";
import { capture } from "../../capture.config";

const field =
  "w-full rounded border border-neutral-300 px-3 py-2 focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500";
const label = "block text-sm font-medium text-neutral-900 mb-1";

// Ensure all seven seo front-matter keys are present.
const seo = {
  page_description: "Contact AI Wire Harness to source custom wire harnesses or discuss RFQ matching. We read every message.",
  canonical_url: null,
  featured_image: null,
  featured_image_alt: null,
  author_twitter_handle: null,
  open_graph_type: "website",
  no_index: false
};
---

<Layout title="Contact" seo={seo}>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-8">
      <h1 class="mb-4 text-display-1 text-balance text-neutral-900">Contact Us</h1>
      <p class="mb-10 text-body text-neutral-600">Tell us what you need and we'll connect you with the right capabilities.</p>

      <CaptureForm form={capture.forms.contact} submitLabel="Send message">
        <div>
          <label for="name" class={label}>Name</label>
          <input id="name" name="name" autocomplete="name" required class={field} />
        </div>

        <div>
          <label for="email" class={label}>Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class={field} />
        </div>

        <div>
          <label for="phone" class={label}
            >Phone <span class="text-neutral-500">(optional)</span></label
          >
          <input id="phone" name="phone" type="tel" autocomplete="tel" class={field} />
        </div>

        <div>
          <label for="company" class={label}
            >Company <span class="text-neutral-500">(optional)</span></label
          >
          <input id="company" name="company" autocomplete="organization" class={field} />
        </div>

        <div>
          <label for="budget" class={label}>Budget</label>
          <select id="budget" name="budget" class={field}>
            <option value="">Not sure yet</option>
            <option>Under $5k</option>
            <option>$5k – $20k</option>
            <option>$20k+</option>
          </select>
        </div>

        <div>
          <label for="message" class={label}>Message</label>
          <textarea id="message" name="message" rows="5" required class={field}></textarea>
        </div>
      </CaptureForm>
    </div>
  </section>

  <section class="bg-neutral-100 py-12 md:py-20 shadow-brutal border-t border-neutral-300">
    <div class="mx-auto max-w-3xl px-8">
      <h2 class="mb-2 text-3xl font-bold font-display text-balance text-neutral-900">Join the waitlist</h2>
      <p class="mb-6 text-neutral-600">One email when we launch. No noise.</p>
      <NewsletterForm form={capture.forms.waitlist} submitLabel="Join waitlist" class="max-w-md" />
    </div>
  </section>
</Layout>
