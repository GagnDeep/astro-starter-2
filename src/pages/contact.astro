---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";

const seo = {
  page_description: "Contact the uDocumentView team for support, feature requests, or general inquiries.",
  open_graph_type: "website"
};
---
<Layout title="Contact Us | uDocumentView" seo={seo}>
  <main class="max-w-2xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-4">Contact Us</h1>
    <p class="text-lg text-slate-600 mb-8">Have a question about document security? Need to request support for a new file format? Send us a message.</p>

    <div class="bg-white p-8 border border-slate-200 rounded-lg shadow-sm">
      <CaptureForm form="contact" submitLabel="Send Message" />
    </div>
  </main>
</Layout>
