---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";

const seo = {
  page_description: "Contact the uDocumentViewer team for support, custom quotes, or API access.",
};
---

<Layout title="Contact uDocumentViewer" seo={seo}>
  <div class="max-w-7xl mx-auto px-4 py-20">
    <div class="grid md:grid-cols-2 gap-16">
      <div>
        <h1 class="text-4xl font-bold mb-6">Get in touch</h1>
        <p class="text-xl text-text/80 mb-8">Whether you need technical support, want to discuss a custom SLA, or just want to tell us how much you hate PDF.js, we're here.</p>

        <div class="space-y-6">
          <div>
            <h3 class="font-bold text-lg">Support Hours</h3>
            <p class="text-text/70">Monday - Friday, 9am - 5pm EST.</p>
          </div>
          <div>
            <h3 class="font-bold text-lg">Response Time</h3>
            <p class="text-text/70">We aim to respond to all inquiries within 24 hours. Pro and API customers receive priority handling.</p>
          </div>
        </div>
      </div>

      <div class="bg-surface p-8 rounded-lg border border-border shadow-sm">
        <CaptureForm form="contact" submitLabel="Send Message">
          <div>
            <label for="name" class="block text-sm font-medium text-text mb-1">Name</label>
            <input id="name" name="name" autocomplete="name" required class="w-full rounded border border-border px-3 py-2 bg-surface text-text focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-text mb-1">Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required class="w-full rounded border border-border px-3 py-2 bg-surface text-text focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-text mb-1">Message</label>
            <textarea id="message" name="message" rows="5" class="w-full rounded border border-border px-3 py-2 bg-surface text-text focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"></textarea>
          </div>
        </CaptureForm>
      </div>
    </div>
  </div>
</Layout>
