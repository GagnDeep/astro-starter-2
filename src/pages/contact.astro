---
import Layout from '../layouts/Layout.astro';
import CaptureForm from '../components/forms/capture-form.astro';

const seo = {
  page_description: "Contact WaterTrackLog",
  no_index: false,
};
---
<Layout title="Contact Us" seo={seo}>
  <div class="mx-auto max-w-4xl px-6 py-12">
    <h1 class="text-4xl font-bold mb-8">Contact Us</h1>
    <p class="mb-8">Have a question? We'd love to hear from you.</p>
    <CaptureForm form="contact" submitLabel="Send Message" />
  </div>
</Layout>
