---
/**
 * Contact page — reference wiring for the capture API.
 *
 * The extra `company` and `budget` inputs need no server change: anything the
 * capture server does not recognise as a documented field is stored in the
 * submission's `data` object automatically.
 */
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";
import NewsletterForm from "../components/forms/newsletter-form.astro";
import { capture } from "../../capture.config";

const field =
  "w-full rounded border border-border px-3 py-2 focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary";
const label = "block text-sm font-medium text-text mb-1";
---

<Layout title="Contact" seo={{ page_description: "Get in touch with the Institute of Property team." }}>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-8">
      <h1 class="mb-4 text-3xl font-bold text-balance md:text-5xl text-text">Contact Us</h1>
      <p class="mb-10 text-lg text-text-muted">Have a question about our calculators or courses? Send us a message.</p>

      <CaptureForm form={capture.forms.contact} submitLabel="Send message" class="p-6 bg-surface border border-border rounded-lg shadow-sm">
        <div>
          <label for="name" class={label}>Name</label>
          <input id="name" name="name" autocomplete="name" required class={field} />
        </div>

        <div>
          <label for="email" class={label}>Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class={field} />
        </div>

        <div>
          <label for="topic" class={label}>Topic</label>
          <select id="topic" name="topic" class={field}>
            <option value="General">General Enquiry</option>
            <option value="Calculators">Calculators / Tools Help</option>
            <option value="Courses">Courses & Strategy</option>
            <option value="Press">Media / Press</option>
          </select>
        </div>

        <div>
          <label for="message" class={label}>Message</label>
          <textarea id="message" name="message" rows="5" required class={field}></textarea>
        </div>
      </CaptureForm>
    </div>
  </section>

  <section class="bg-gray-50 py-12 md:py-20 border-t border-border">
    <div class="mx-auto max-w-3xl px-8">
      <h2 class="mb-2 text-2xl font-bold text-balance md:text-3xl text-text">Join the newsletter</h2>
      <p class="mb-6 text-text-muted">Get the latest property data and insights delivered to your inbox.</p>
      <NewsletterForm form={capture.forms.newsletter} submitLabel="Subscribe" class="max-w-md" />
    </div>
  </section>
</Layout>
