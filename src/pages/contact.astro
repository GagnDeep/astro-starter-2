---
import Layout from '../layouts/Layout.astro';
import CaptureForm from '../components/forms/capture-form.astro';

const seo = {
  page_description: 'Contact Aerospace UAE for directory listings, advertising, or procurement assistance.',
  canonical_url: '/contact'
};
---

<Layout title='Contact Us' seo={seo}>
  <div class='max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12'>
    <h1 class='text-3xl font-bold mb-6'>Contact Aerospace UAE</h1>
    <p class='text-slate-600 mb-8'>
      Whether you are looking to list your company in our B2B directory, inquire about advertising, or need help navigating the UAE defense supply chain, our team is here to assist.
    </p>

    <div class='card bg-brand-bg-subtle'>
      <CaptureForm form='contact' submitLabel='Send Message'>
        <div class='space-y-4'>
          <div>
            <label for='name' class='label-field'>Full Name</label>
            <input type='text' id='name' name='name' required class='input-field' />
          </div>
          <div>
            <label for='email' class='label-field'>Work Email</label>
            <input type='email' id='email' name='email' required class='input-field' />
          </div>
          <div>
            <label for='company' class='label-field'>Company</label>
            <input type='text' id='company' name='company' class='input-field' />
          </div>
          <div>
            <label for='message' class='label-field'>How can we help?</label>
            <textarea id='message' name='message' rows='4' required class='input-field'></textarea>
          </div>
        </div>
      </CaptureForm>
    </div>
  </div>
</Layout>
