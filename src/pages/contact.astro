---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";

const seo = {
  page_description: "Contact the FoodLogTrack team for support, feedback, or business inquiries.",
  no_index: false,
};
---
<Layout title="Contact Us" seo={seo}>
  <div class="max-w-2xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold text-primary mb-6 text-center">Contact Us</h1>
    <p class="text-text-muted text-center mb-10">Have a question about our calculators? Spotted a bug? Let us know below.</p>

    <div class="bg-surface p-8 rounded-lg border border-border shadow-sm">
      <CaptureForm form="contact" submitLabel="Send Message" />
    </div>
  </div>
</Layout>
