---
/**
 * Contact page — reference wiring for the capture API.
 */
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";
import NewsletterForm from "../components/forms/newsletter-form.astro";
import { capture } from "../../capture.config";

const field =
  "w-full rounded border border-gray-300 px-3 py-2 focus:border-[var(--interactive)] focus:outline-none focus:ring-1 focus:ring-[var(--interactive)]";
const label = "block text-sm font-medium mb-1";
---

<Layout title="Contact" seo={{ page_description: "Get in touch for a custom California solar quote or question." }}>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-8">
      <h1 class="mb-4 text-3xl font-bold text-balance md:text-5xl">Contact Us</h1>
      <p class="mb-10 text-lg text-gray-600">Have a question about NEM 3.0? Need a real quote without the sales pressure? Send us a message.</p>

      <CaptureForm form={capture.forms.contact} submitLabel="Send message">
        <div>
          <label for="name" class={label}>Name</label>
          <input id="name" name="name" autocomplete="name" required class={field} />
        </div>

        <div>
          <label for="email" class={label}>Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class={field} />
        </div>

        <div>
          <label for="phone" class={label}
            >Phone <span class="text-gray-400">(optional)</span></label
          >
          <input id="phone" name="phone" type="tel" autocomplete="tel" class={field} />
        </div>

        <div>
          <label for="utility" class={label}>Utility Provider</label>
          <select id="utility" name="utility" class={field}>
            <option value="">Select your utility</option>
            <option>PG&E</option>
            <option>SCE</option>
            <option>SDG&E</option>
            <option>Other / Municipal</option>
          </select>
        </div>

        <div>
          <label for="message" class={label}>Message</label>
          <textarea id="message" name="message" rows="5" required class={field}></textarea>
        </div>
      </CaptureForm>
    </div>
  </section>

  <section class="bg-[var(--bg-primary)] py-12 md:py-20 border-t border-gray-200">
    <div class="mx-auto max-w-3xl px-8 text-center">
      <h2 class="mb-2 text-2xl font-bold text-balance md:text-3xl">Stay Updated</h2>
      <p class="mb-6 text-gray-600">Subscribe for rate change alerts and battery rebate news.</p>
      <NewsletterForm form={capture.forms.newsletter} submitLabel="Subscribe" class="max-w-md mx-auto" />
    </div>
  </section>
</Layout>
