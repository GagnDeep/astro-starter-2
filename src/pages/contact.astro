---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";

const seo = {
  page_description: "Contact the IBS-Go support team. We're here to help with your symptom tracking app, premium subscription, or dietitian inquiries.",
  canonical_url: "/contact/",
  open_graph_type: "website",
};
---

<Layout title="Contact Support | IBS-Go" seo={seo}>
  <main class="container-narrow py-16">
    <div class="mb-12">
      <h1 class="text-4xl font-bold text-[var(--color-primary-950)] mb-4">How can we help?</h1>
      <p class="text-lg text-[var(--color-text-muted)]">
        Whether you have a question about FODMAP stacking algorithms, need help with your premium account, or want to partner with us, drop us a line below.
      </p>
    </div>

    <div class="grid md:grid-cols-5 gap-12">
      <div class="md:col-span-3">
        <div class="bg-white p-8 rounded-xl shadow-sm border border-[var(--color-primary-100)]">
          <CaptureForm form="contact" submitLabel="Send Message" />
        </div>
      </div>

      <div class="md:col-span-2 space-y-8">
        <div>
          <h3 class="font-bold text-[var(--color-primary-900)] mb-2">Support Hours</h3>
          <p class="text-[var(--color-text-muted)] text-sm">Monday – Friday<br/>9:00 AM – 5:00 PM EST</p>
        </div>
        <div>
          <h3 class="font-bold text-[var(--color-primary-900)] mb-2">Dietitian Access</h3>
          <p class="text-[var(--color-text-muted)] text-sm">If you are requesting a clinic account, please include your practice name and professional registration number in your message.</p>
        </div>
        <div class="bg-[var(--color-primary-50)] p-4 rounded-lg border border-[var(--color-primary-100)]">
           <h3 class="font-bold text-[var(--color-primary-900)] mb-2">Wait, is this food safe?</h3>
           <p class="text-[var(--color-text-muted)] text-sm mb-3">If you have a quick question about a specific food, try our stacking calculator first.</p>
           <a href="/tools/fodmap-stacking-calculator/" class="text-sm font-medium text-[var(--color-primary-600)] hover:underline">Open Calculator &rarr;</a>
        </div>
      </div>
    </div>
  </main>
</Layout>
