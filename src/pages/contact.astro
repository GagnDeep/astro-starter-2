---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import CaptureForm from "../components/forms/capture-form.astro";
import Seo from "../components/seo/seo.astro";

const seo = {
  page_description: "Contact ClearPath Finance with questions about our tools.",
  no_index: false,
};
---

<Layout title="Contact">
  <Seo seo={seo} />
  <Hero
    title="Contact Us"
    description="Have a question about our calculators or need help?"
  />
  <div class="max-w-xl mx-auto py-12 px-4 sm:px-6 lg:px-8">
    <CaptureForm form="contact" submitLabel="Send Message">
      <div class="mb-4">
        <label for="name" class="block text-sm font-medium text-text mb-1">Name</label>
        <input type="text" id="name" name="name" required class="w-full px-3 py-2 border border-secondary rounded-md" />
      </div>
      <div class="mb-4">
        <label for="email" class="block text-sm font-medium text-text mb-1">Email</label>
        <input type="email" id="email" name="email" required class="w-full px-3 py-2 border border-secondary rounded-md" />
      </div>
      <div class="mb-6">
        <label for="message" class="block text-sm font-medium text-text mb-1">Message</label>
        <textarea id="message" name="message" required rows="4" class="w-full px-3 py-2 border border-secondary rounded-md"></textarea>
      </div>
    </CaptureForm>
  </div>
</Layout>
