---
import Layout from '../layouts/Layout.astro';
import CaptureForm from '../components/forms/capture-form.astro';
import { capture } from "../../capture.config";

const seo = {
  page_description: "Contact the Protein or Fiber editorial team.",
  no_index: false
};
---

<Layout title="Page" seo={seo}>
  <div class="prose mx-auto py-12 px-4 max-w-2xl">
    <h1>Contact Us</h1>
    <p>Have a question about macros, need clarification on a calculation, or want to report a broken link? Reach out to our team below.</p>

    <div class="mt-8">
      <CaptureForm form={capture.forms.contact}>
        <div class="space-y-4">
          <div>
            <label class="block font-semibold mb-1 text-sm text-slate-700" for="name">Name</label>
            <input type="text" id="name" name="name" class="w-full border border-slate-300 rounded px-3 py-2" required />
          </div>
          <div>
            <label class="block font-semibold mb-1 text-sm text-slate-700" for="email">Email</label>
            <input type="email" id="email" name="email" class="w-full border border-slate-300 rounded px-3 py-2" required />
          </div>
          <div>
            <label class="block font-semibold mb-1 text-sm text-slate-700" for="message">Message</label>
            <textarea id="message" name="message" class="w-full border border-slate-300 rounded px-3 py-2 h-32" required></textarea>
          </div>
          <button type="submit" class="bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-2 px-4 rounded transition-colors">Send Message</button>
        </div>
      </CaptureForm>
    </div>
  </div>
</Layout>
