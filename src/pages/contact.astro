---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";
import { capture } from "../../capture.config";

const field =
  "w-full rounded border border-gray-300 px-3 py-2 focus:border-[var(--color-primary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-primary)]";
const label = "block text-sm font-medium text-gray-700 mb-1";
---

<Layout title="Contact" seo={{ page_description: "Get in touch with the FreeFileForm team." }}>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-8">
      <h1 class="mb-4 text-3xl font-bold font-heading text-[var(--color-primary)] md:text-5xl">Contact Us</h1>
      <p class="mb-10 text-lg text-gray-600">Have a question about a free tax tool? Found a broken link? Let us know.</p>

      <CaptureForm form={capture.forms.contact} submitLabel="Send message" class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label for="name" class={label}>Name</label>
            <input id="name" name="name" autocomplete="name" required class={field} />
          </div>

          <div>
            <label for="email" class={label}>Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required class={field} />
          </div>
        </div>

        <div>
          <label for="topic" class={label}>Topic</label>
          <select id="topic" name="topic" class={field}>
            <option value="general">General Question</option>
            <option value="correction">Suggest a Correction</option>
            <option value="press">Press / Media</option>
          </select>
        </div>

        <div>
          <label for="message" class={label}>Message</label>
          <textarea id="message" name="message" rows="6" required class={field}></textarea>
        </div>
      </CaptureForm>
    </div>
  </section>
</Layout>
