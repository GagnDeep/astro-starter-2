---
/**
 * Contact page — reference wiring for the capture API.
 */
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";
import { capture } from "../../capture.config";

const field =
  "w-full rounded-none border border-neutral-900 px-3 py-2 bg-white dark:bg-neutral-800 dark:border-neutral-700 focus:border-orange-500 focus:outline-none focus:ring-1 focus:ring-orange-500";
const label = "block text-sm font-display font-medium text-neutral-900 dark:text-neutral-100 mb-1";
---

<Layout
  title="Contact & RFQ Submission"
  seo={{
    page_description: "Submit an RFQ or contact our sourcing team. We match you with IPC/WHMA-A-620 verified wire harness manufacturers.",
    canonical_url: null,
    featured_image: null,
    featured_image_alt: null,
    author_twitter_handle: null,
    open_graph_type: "website",
    no_index: false
  }}
>
  <section class="py-16 md:py-24 bg-neutral-50 dark:bg-neutral-900">
    <div class="mx-auto max-w-3xl px-8">
      <h1 class="mb-4 text-3xl font-display font-bold text-neutral-900 dark:text-neutral-50 text-balance md:text-5xl">Submit your custom RFQ</h1>
      <p class="mb-10 text-lg text-neutral-700 dark:text-neutral-300 font-body">Detail your engineering requirements below. Our analysts will match your specifications with actively verified wire harness manufacturers. Free for buyers.</p>

      <div class="p-6 md:p-8 border-2 border-neutral-900 shadow-brutal dark:border-neutral-700 bg-white dark:bg-neutral-900/50">
        <CaptureForm form={capture.forms.rfq} submitLabel="Submit RFQ for Matching">
          <div>
            <label for="name" class={label}>Name / Point of Contact</label>
            <input id="name" name="name" autocomplete="name" required class={field} />
          </div>

          <div>
            <label for="email" class={label}>Work Email</label>
            <input id="email" name="email" type="email" autocomplete="email" required class={field} />
          </div>

          <div>
            <label for="company" class={label}>Company</label>
            <input id="company" name="company" autocomplete="organization" required class={field} />
          </div>

          <div>
            <label for="application" class={label}>Application / Industry</label>
            <select id="application" name="application" required class={field}>
              <option value="">Select an application type</option>
              <option>EV Prototyping (High Voltage)</option>
              <option>Aerospace / Military (Class 3)</option>
              <option>Medical Device</option>
              <option>Industrial Automation</option>
              <option>Other</option>
            </select>
          </div>

          <div>
            <label for="certification_req" class={label}>Required Certifications</label>
            <input id="certification_req" name="certification_req" placeholder="e.g. AS9100, ISO 13485, IPC Class 3" class={field} />
          </div>

          <div>
            <label for="message" class={label}>Technical Specifications & Volume</label>
            <textarea id="message" name="message" rows="6" placeholder="Describe connector types, shielding requirements, estimated annual usage, etc." required class={field}></textarea>
          </div>
        </CaptureForm>
      </div>
    </div>
  </section>
</Layout>
