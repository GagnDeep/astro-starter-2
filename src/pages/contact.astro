---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";
import { capture } from "../../capture.config";
---

<Layout title="Contact Us">
  <main class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-3xl font-bold mb-8">Contact Us</h1>
    <CaptureForm form={capture.forms.contact} submitLabel="Send Message" class="max-w-md">
      <div class="mb-4">
        <label for="name" class="block mb-2 font-medium">Name</label>
        <input type="text" id="name" name="name" required class="w-full border px-3 py-2" />
      </div>
      <div class="mb-4">
        <label for="email" class="block mb-2 font-medium">Email</label>
        <input type="email" id="email" name="email" required class="w-full border px-3 py-2" />
      </div>
      <div class="mb-4">
        <label for="message" class="block mb-2 font-medium">Message</label>
        <textarea id="message" name="message" required class="w-full border px-3 py-2 h-32"></textarea>
      </div>
    </CaptureForm>
  </main>
</Layout>
