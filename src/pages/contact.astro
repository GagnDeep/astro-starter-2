---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";

const seo = {
  page_description: "Contact the uMediaPlayer team securely without any third-party tracking.",
};
---

<Layout title="Contact Us | uMediaPlayer" seo={seo}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-8 text-cyan-500">Contact Us</h1>

    <div class="surface-panel mb-12 prose prose-invert max-w-none">
      <p>Reach out securely without any third-party tracking. Whether you have a feature request or need help with a specific file format, we're here.</p>
    </div>

    <div class="surface-panel bg-slate-800 p-8 rounded-lg max-w-2xl mx-auto">
      <CaptureForm form="contact" submitLabel="Send Message" />
    </div>
  </div>
</Layout>
