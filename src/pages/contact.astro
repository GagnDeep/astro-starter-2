---
/**
 * Contact page — reference wiring for the capture API.
 *
 * The extra `company` and `budget` inputs need no server change: anything the
 * capture server does not recognise as a documented field is stored in the
 * submission's `data` object automatically.
 */
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";
import NewsletterForm from "../components/forms/newsletter-form.astro";
import { capture } from "../../capture.config";

const field =
  "w-full rounded border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600";
const label = "block text-sm font-medium text-gray-700 mb-1";
---

<Layout title="Contact" seo={{ page_description: "Get in touch — we read every message." }}>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-8">
      <h1 class="mb-4 text-3xl font-bold text-balance md:text-5xl">Contact Us</h1>
      <p class="mb-10 text-lg text-gray-600">Have a question about a guide or tool? Want to report a mistake? We read every message.</p>

      <CaptureForm form={capture.forms.contact} submitLabel="Send message">
        <div>
          <label for="name" class={label}>Name</label>
          <input id="name" name="name" autocomplete="name" required class={field} />
        </div>

        <div>
          <label for="email" class={label}>Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class={field} />
        </div>

        <div>
          <label for="topic" class={label}>Topic</label>
          <select id="topic" name="topic" class={field}>
            <option value="">Select a topic</option>
            <option>Report an error on a page</option>
            <option>Suggest a new guide</option>
            <option>Press/Media inquiry</option>
            <option>Other</option>
          </select>
        </div>

        <div>
          <label for="message" class={label}>Message</label>
          <textarea id="message" name="message" rows="5" required class={field}></textarea>
        </div>
      </CaptureForm>
    </div>
  </section>

  <section class="bg-[rgb(var(--color-primary))] py-12 md:py-20 text-white">
    <div class="mx-auto max-w-3xl px-8">
      <h2 class="mb-2 text-2xl font-bold text-balance md:text-3xl">Get our 2025 Tax Cheat Sheet</h2>
      <p class="mb-6 text-gray-200">The actually useful deductions you might be missing, straight to your inbox.</p>
      <NewsletterForm form={capture.forms.waitlist} submitLabel="Join waitlist" class="max-w-md text-gray-900" />
    </div>
  </section>
</Layout>
