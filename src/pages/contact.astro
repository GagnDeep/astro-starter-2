---
import Layout from '../layouts/Layout.astro';
import CaptureForm from '../components/forms/capture-form.astro';
---
<Layout title="Contact Us" seo={{ page_description: "Get in touch with the UConvertDocument team." }}>
  <div class="mx-auto max-w-4xl px-4 py-16">
    <div class="max-w-2xl mx-auto prose mb-12 text-center">
      <h1>Contact Us</h1>
      <p>Have a question, suggestion, or experiencing an issue? Let us know!</p>
    </div>

    <div class="max-w-xl mx-auto">
      <CaptureForm formLabel="contact">
        <div class="space-y-4">
          <div>
            <label for="name" class="block text-sm font-medium text-text-main mb-1">Name</label>
            <input type="text" id="name" name="name" required class="w-full px-3 py-2 border border-border rounded focus:outline-none focus:border-brand" />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-text-main mb-1">Email</label>
            <input type="email" id="email" name="email" required class="w-full px-3 py-2 border border-border rounded focus:outline-none focus:border-brand" />
          </div>
          <div>
            <label for="subject" class="block text-sm font-medium text-text-main mb-1">Subject</label>
            <select id="subject" name="subject" class="w-full px-3 py-2 border border-border rounded focus:outline-none focus:border-brand">
              <option value="general">General Inquiry</option>
              <option value="support">Technical Support</option>
              <option value="feedback">Feedback</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-text-main mb-1">Message</label>
            <textarea id="message" name="message" rows="5" required class="w-full px-3 py-2 border border-border rounded focus:outline-none focus:border-brand"></textarea>
          </div>
          <button type="submit" class="w-full bg-brand hover:bg-brand-hover text-white font-medium py-2 px-4 rounded transition-colors">
            Send Message
          </button>
        </div>
      </CaptureForm>
    </div>
  </div>
</Layout>
