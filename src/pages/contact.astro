---
/**
 * Contact page — reference wiring for the capture API.
 */
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";
import NewsletterForm from "../components/forms/newsletter-form.astro";
import { capture } from "../../capture.config";

const field =
  "w-full rounded border border-[var(--border-color)] px-3 py-2 bg-[var(--bg-elevated)] focus:border-[var(--accent-color)] focus:outline-none focus:ring-1 focus:ring-[var(--accent-color)]";
const label = "block text-sm font-medium text-[var(--text-main)] mb-1";
---

<Layout
  title="Contact"
  seo={{
    page_description: "Get in touch — we read every message. Contact the AI & Investing team.",
    canonical_url: "https://aiandinvesting.com/contact/",
    featured_image: null,
    featured_image_alt: null,
    author_twitter_handle: null,
    open_graph_type: "website",
    no_index: false
  }}
>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-8">
      <h1 class="mb-4 text-3xl font-bold text-balance md:text-5xl">Contact</h1>
      <p class="mb-10 text-lg text-[var(--text-muted)]">Tell us what you need and we'll get back to you.</p>

      <CaptureForm form={capture.forms.contact} submitLabel="Send message">
        <div>
          <label for="name" class={label}>Name</label>
          <input id="name" name="name" autocomplete="name" required class={field} />
        </div>

        <div>
          <label for="email" class={label}>Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class={field} />
        </div>

        <div>
          <label for="phone" class={label}
            >Phone <span class="text-[var(--text-muted)]">(optional)</span></label
          >
          <input id="phone" name="phone" type="tel" autocomplete="tel" class={field} />
        </div>

        <div>
          <label for="message" class={label}>Message</label>
          <textarea id="message" name="message" rows="5" required class={field}></textarea>
        </div>
      </CaptureForm>
    </div>
  </section>

  <section class="bg-[var(--bg-elevated)] border-t border-[var(--border-color)] py-12 md:py-20">
    <div class="mx-auto max-w-3xl px-8">
      <h2 class="mb-2 text-2xl font-bold text-balance md:text-3xl">Join the newsletter</h2>
      <p class="mb-6 text-[var(--text-muted)]">One email when we publish a new back-test. No noise.</p>
      <NewsletterForm form={capture.forms.newsletter} submitLabel="Subscribe" class="max-w-md" />
    </div>
  </section>
</Layout>
