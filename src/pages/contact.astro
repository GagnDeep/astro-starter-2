---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";
---
<Layout title="Contact Us">
  <main class="prose mx-auto py-12">
    <div data-editable="source" data-path="src/pages/contact.astro" data-key="main">
      <h1>Contact Us</h1>
      <p>Get in touch for directory inclusion or compliance questions.</p>

      <CaptureForm form="contact" submitLabel="Send Message" class="mt-8">
        <div class="flex flex-col gap-4">
          <label class="flex flex-col gap-1">
            <span class="text-sm font-medium">Name</span>
            <input type="text" name="name" required class="border border-[var(--color-border-subtle)] p-2 rounded" />
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-sm font-medium">Email</span>
            <input type="email" name="email" required class="border border-[var(--color-border-subtle)] p-2 rounded" />
          </label>
          <label class="flex flex-col gap-1">
            <span class="text-sm font-medium">Message</span>
            <textarea name="message" required rows="4" class="border border-[var(--color-border-subtle)] p-2 rounded"></textarea>
          </label>
        </div>
      </CaptureForm>

      <p class="mt-8"><a href="/">Back to Home</a></p>
    </div>
  </main>
</Layout>
