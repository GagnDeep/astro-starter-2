---
/**
 * Contact page — reference wiring for the capture API.
 *
 * The extra `company` and `budget` inputs need no server change: anything the
 * capture server does not recognise as a documented field is stored in the
 * submission's `data` object automatically.
 */
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";
import NewsletterForm from "../components/forms/newsletter-form.astro";
import { capture } from "../../capture.config";

const field =
  "w-full rounded border border-gray-300 px-3 py-2 focus:border-blue-600 focus:outline-none focus:ring-1 focus:ring-blue-600";
const label = "block text-sm font-medium text-gray-700 mb-1";
---

<Layout title="Contact" seo={{ page_description: "Get in touch — we read every message." }}>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-8">
      <h1 class="mb-4 text-3xl font-bold text-balance md:text-5xl">Contact</h1>
      <p class="mb-10 text-lg text-gray-600">Tell us what you need and we'll get back to you.</p>

      <CaptureForm form={capture.forms.contact} submitLabel="Send message">
        <div>
          <label for="name" class={label}>Name</label>
          <input id="name" name="name" autocomplete="name" required class={field} />
        </div>

        <div>
          <label for="email" class={label}>Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class={field} />
        </div>

        <div>
          <label for="phone" class={label}
            >Phone <span class="text-gray-400">(optional)</span></label
          >
          <input id="phone" name="phone" type="tel" autocomplete="tel" class={field} />
        </div>

        <div>
          <label for="company" class={label}
            >Company <span class="text-gray-400">(optional)</span></label
          >
          <input id="company" name="company" autocomplete="organization" class={field} />
        </div>

        <div>
          <label for="budget" class={label}>Budget</label>
          <select id="budget" name="budget" class={field}>
            <option value="">Not sure yet</option>
            <option>Under $5k</option>
            <option>$5k – $20k</option>
            <option>$20k+</option>
          </select>
        </div>

        <div>
          <label for="message" class={label}>Message</label>
          <textarea id="message" name="message" rows="5" required class={field}></textarea>
        </div>
      </CaptureForm>
    </div>
  </section>

  <section class="bg-gray-50 py-12 md:py-20">
    <div class="mx-auto max-w-3xl px-8">
      <h2 class="mb-2 text-2xl font-bold text-balance md:text-3xl">Join the waitlist</h2>
      <p class="mb-6 text-gray-600">One email when we launch. No noise.</p>
      <NewsletterForm form={capture.forms.software_referral} submitLabel="Join software referral" class="max-w-md" />
    </div>
  </section>
</Layout>
