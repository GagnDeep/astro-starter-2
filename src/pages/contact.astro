---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";
import { capture } from "../../capture.config";

const seo = {
  page_description: "Contact World AI School.",
  no_index: false,
};
---

<Layout title="Contact Us" seo={seo}>
  <main class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-4xl font-bold mb-8">Contact Us</h1>
    <p class="text-slate-600 mb-8">Have a question? Fill out the form below and we'll get back to you.</p>

    <CaptureForm form={capture.forms.contact} submitLabel="Send Message" class="space-y-6">
      <div class="space-y-1">
        <label for="name" class="block text-sm font-medium text-slate-700">Name</label>
        <input type="text" id="name" name="name" required class="block w-full rounded-md border-slate-300 border p-2" />
      </div>
      <div class="space-y-1">
        <label for="email" class="block text-sm font-medium text-slate-700">Email</label>
        <input type="email" id="email" name="email" required class="block w-full rounded-md border-slate-300 border p-2" />
      </div>
      <div class="space-y-1">
        <label for="message" class="block text-sm font-medium text-slate-700">Message</label>
        <textarea id="message" name="message" rows="5" required class="block w-full rounded-md border-slate-300 border p-2"></textarea>
      </div>
    </CaptureForm>
  </main>
</Layout>
