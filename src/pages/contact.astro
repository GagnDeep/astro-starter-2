---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";
import { capture } from "../../capture.config";

const field =
  "w-full rounded border border-slate-300 px-3 py-2 bg-white focus:border-brand-600 focus:outline-none focus:ring-1 focus:ring-brand-600";
const label = "block text-sm font-medium text-slate-700 mb-1";
---

<Layout title="Contact World AI School" seo={{ page_description: "Get in touch for team training or enterprise licensing." }}>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-8">
      <h1 class="mb-4 text-4xl font-bold text-balance md:text-5xl text-slate-900">Contact Us</h1>
      <p class="mb-10 text-xl text-slate-600">Interested in team training, or have a question about our curriculum? Let us know.</p>

      <div class="bg-slate-50 p-8 rounded-xl border border-slate-200">
        <CaptureForm form={capture.forms.contact} submitLabel="Send Message">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label for="name" class={label}>Name</label>
              <input id="name" name="name" autocomplete="name" required class={field} />
            </div>

            <div>
              <label for="email" class={label}>Work Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required class={field} />
            </div>

            <div class="md:col-span-2">
              <label for="company" class={label}>Company</label>
              <input id="company" name="company" autocomplete="organization" class={field} />
            </div>

            <div class="md:col-span-2">
              <label for="inquiry_type" class={label}>How can we help?</label>
              <select id="inquiry_type" name="inquiry_type" class={field} required>
                <option value="">Please select...</option>
                <option value="Team Training">Team Training (10+ users)</option>
                <option value="Support">Course Support</option>
                <option value="General">General Inquiry</option>
              </select>
            </div>

            <div class="md:col-span-2">
              <label for="message" class={label}>Message</label>
              <textarea id="message" name="message" rows="5" required class={field}></textarea>
            </div>
          </div>
        </CaptureForm>
      </div>
    </div>
  </section>
</Layout>
