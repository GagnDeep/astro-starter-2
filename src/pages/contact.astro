---
/**
 * Contact page — reference wiring for the capture API.
 *
 * The extra `company` and `budget` inputs need no server change: anything the
 * capture server does not recognise as a documented field is stored in the
 * submission's `data` object automatically.
 */
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";
import NewsletterForm from "../components/forms/newsletter-form.astro";
import { capture } from "../../capture.config";

const field =
  "w-full rounded border border-[var(--color-border)] px-3 py-2 focus:border-[var(--color-primary)] focus:outline-none focus:ring-1 focus:ring-[var(--color-primary)] bg-[var(--color-bg-surface)] text-[var(--color-text-main)]";
const label = "block text-sm font-medium text-[var(--color-text-muted)] mb-1";
---

<Layout title="Contact us" seo={{ page_description: "Get in touch with uVideoPlayer." }}>
  <section class="py-16 md:py-24">
    <div class="mx-auto max-w-3xl px-8">
      <h1 class="mb-4 text-3xl font-bold text-balance md:text-5xl">Contact</h1>
      <p class="mb-10 text-lg text-[var(--color-text-muted)]">Tell us what you need and we'll get back to you.</p>

      <CaptureForm form={capture.forms.contact} submitLabel="Send message">
        <div>
          <label for="name" class={label}>Name</label>
          <input id="name" name="name" autocomplete="name" required class={field} />
        </div>

        <div>
          <label for="email" class={label}>Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class={field} />
        </div>

        <div>
          <label for="website" class={label}
            >Website <span class="text-gray-400">(optional)</span></label
          >
          <input id="website" name="website" type="url" placeholder="https://" class={field} />
        </div>

        <div>
          <label for="message" class={label}>Message</label>
          <textarea id="message" name="message" rows="5" required class={field}></textarea>
        </div>
      </CaptureForm>
    </div>
  </section>

  <section class="bg-gray-50 py-12 md:py-20">
    <div class="mx-auto max-w-3xl px-8">
      <h2 class="mb-2 text-2xl font-bold text-balance md:text-3xl">Get updates</h2>
      <p class="mb-6 text-[var(--color-text-muted)]">Sign up for product updates and creator tips.</p>
      <NewsletterForm form={capture.forms.newsletter} submitLabel="Subscribe" class="max-w-md" />
    </div>
  </section>
</Layout>
