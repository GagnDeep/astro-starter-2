---
import Layout from '../layouts/Layout.astro';
import CaptureForm from '../components/forms/capture-form.astro';

const seo = {
  title: 'Contact FreeTaxPDF',
  page_description: 'Get in touch with the FreeTaxPDF team.'
};
---

<Layout seo={seo} title="Contact Us">
  <main class="max-w-4xl mx-auto px-4 py-12 prose">
    <h1>Contact Us</h1>
    <p>Have a question or feedback? We'd love to hear from you.</p>

    <div class="mt-8 bg-surface p-6 rounded shadow border border-border not-prose">
      <CaptureForm form="contact">
        <div>
          <label for="name" class="block text-sm font-bold text-text mb-1">Name</label>
          <input id="name" name="name" autocomplete="name" required class="w-full rounded border border-border px-3 py-2 bg-surface text-text focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
        </div>

        <div>
          <label for="email" class="block text-sm font-bold text-text mb-1">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required class="w-full rounded border border-border px-3 py-2 bg-surface text-text focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary" />
        </div>

        <div>
          <label for="message" class="block text-sm font-bold text-text mb-1">Message</label>
          <textarea id="message" name="message" rows="5" class="w-full rounded border border-border px-3 py-2 bg-surface text-text focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"></textarea>
        </div>
      </CaptureForm>
    </div>
  </main>
</Layout>
