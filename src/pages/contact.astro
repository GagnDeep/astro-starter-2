---
import Layout from "../layouts/Layout.astro";
import CaptureForm from "../components/forms/capture-form.astro";

const seo = {
  page_description: "Contact Institute for Tax. Inquire about exclusive tax lead availability in your territory.",
  canonical_url: "/contact/",
  open_graph_type: "website"
};
---

<Layout title="Contact Us | Institute for Tax" seo={seo}>
  <div class="container py-12 lg:py-24">
    <div class="max-w-2xl mx-auto">
      <div class="text-center mb-10">
        <h1 class="text-4xl font-bold mb-4">Contact Us</h1>
        <p class="text-lg text-brand-slate">
          Have questions about our lead generation process? Want to check exclusivity availability in your state? Drop us a line.
        </p>
      </div>

      <div class="bg-white p-8 rounded-card border border-slate-200 shadow-sm">
        <CaptureForm
          form="contact"
          submitLabel="Send Message"
          successMessage="Thanks for reaching out. We will get back to you shortly."
        />
      </div>
    </div>
  </div>
</Layout>
