---
import Layout from "../../layouts/Layout.astro";
import WaitlistForm from "../../components/forms/waitlist-form.astro";
import { Check, X } from "@lucide/astro";
const titleStr = "exclusive-vs-shared-leads".split('-').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
const seo = {
  page_description: "Comparing " + titleStr + " for accounting firm growth.",
  canonical_url: "/compare/exclusive-vs-shared-leads/",
  open_graph_type: "website"
};
---
<Layout title={`${titleStr} | Institute for Tax`} seo={seo}>
  <div class="container py-12 lg:py-20">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h1 class="text-4xl font-bold mb-6">{titleStr}</h1>
      <p class="text-xl text-brand-slate">An objective look at the ROI, speed, and quality differences.</p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-5xl mx-auto mb-16">
      <div class="bg-white rounded-card border border-slate-200 p-8 shadow-sm">
        <h3 class="text-2xl font-bold text-brand-navy mb-6">The Old Way</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3"><X class="w-5 h-5 text-red-500 shrink-0 mt-0.5" /><span>Slow time to value</span></li>
          <li class="flex items-start gap-3"><X class="w-5 h-5 text-red-500 shrink-0 mt-0.5" /><span>Race to the bottom pricing</span></li>
          <li class="flex items-start gap-3"><X class="w-5 h-5 text-red-500 shrink-0 mt-0.5" /><span>Low intent prospects</span></li>
        </ul>
      </div>
      <div class="bg-brand-navy text-white rounded-card p-8 shadow-lg ring-2 ring-brand-emerald">
        <h3 class="text-2xl font-bold mb-6">Institute for Tax</h3>
        <ul class="space-y-4 text-slate-300">
          <li class="flex items-start gap-3"><Check class="w-5 h-5 text-brand-emerald shrink-0 mt-0.5" /><span class="text-white">Immediate ROI</span></li>
          <li class="flex items-start gap-3"><Check class="w-5 h-5 text-brand-emerald shrink-0 mt-0.5" /><span class="text-white">100% Exclusive, premium pricing</span></li>
          <li class="flex items-start gap-3"><Check class="w-5 h-5 text-brand-emerald shrink-0 mt-0.5" /><span class="text-white">High intent, pre-qualified</span></li>
        </ul>
      </div>
    </div>
    <div class="max-w-md mx-auto">
      <WaitlistForm />
    </div>
  </div>
</Layout>
