---
import Layout from "../../layouts/Layout.astro";
import CaptureForm from "../../components/forms/capture-form.astro";
import { Check, X } from "@lucide/astro";

const seo = {
  page_description: "Why DogSnacker is the best BarkBox alternative for treat-motivated dogs and owners who are tired of toys.",
  canonical_url: null,
  featured_image: null,
  featured_image_alt: null,
  author_twitter_handle: null,
  open_graph_type: "website",
  no_index: false,
};
---

<Layout title="BarkBox Alternative for Treats - DogSnacker" seo={seo}>
  <div class="max-w-4xl mx-auto py-16 px-4">
    <div class="text-center mb-16">
      <h1 class="text-5xl font-bold mb-6">The BarkBox alternative for dogs who prefer snacks over squeakers.</h1>
      <p class="text-xl text-gray-700 max-w-2xl mx-auto">
        Tired of finding shredded plush toys under the couch? DogSnacker is a 100% treat subscription.
        No fluff. Just high-value, single-ingredient rewards.
      </p>
    </div>

    <div class="overflow-x-auto mb-16">
      <table class="w-full border-collapse">
        <thead>
          <tr class="bg-gray-50 border-y border-gray-200 text-left">
            <th class="p-4 font-bold w-1/3">Feature</th>
            <th class="p-4 font-bold w-1/3">DogSnacker</th>
            <th class="p-4 font-bold w-1/3 text-gray-500">BarkBox</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <tr>
            <td class="p-4 font-medium text-gray-900">Focus</td>
            <td class="p-4">100% Treats & Chews</td>
            <td class="p-4 text-gray-600">Heavy on toys, light on treats</td>
          </tr>
          <tr>
            <td class="p-4 font-medium text-gray-900">Ingredients</td>
            <td class="p-4">Strictly single-ingredient</td>
            <td class="p-4 text-gray-600">Blended treats, fillers used</td>
          </tr>
          <tr>
            <td class="p-4 font-medium text-gray-900">House Clutter</td>
            <td class="p-4 flex items-center text-green-700"><Check class="w-5 h-5 mr-2" aria-hidden="true" /> Zero</td>
            <td class="p-4 flex items-center text-red-700"><X class="w-5 h-5 mr-2" aria-hidden="true" /> High (shredded toys)</td>
          </tr>
          <tr>
            <td class="p-4 font-medium text-gray-900">Cost per month</td>
            <td class="p-4 font-bold number-tabular">$29</td>
            <td class="p-4 text-gray-600 number-tabular">~$35+ (with fees/commitment)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="bg-primary text-white p-8 rounded-xl mb-16 text-center">
      <h2 class="text-3xl font-bold mb-4">Make the switch.</h2>
      <p class="text-lg text-green-100 mb-8 max-w-xl mx-auto">Get your dog what they actually want. Join the waitlist today and get an extra bag of beef liver in your first box.</p>

      <div class="max-w-md mx-auto bg-white p-4 rounded-lg shadow-lg">
        <CaptureForm form="waitlist" class="flex flex-col sm:flex-row gap-2">
          <input type="hidden" name="source" value="barkbox-comparison" />
          <input type="email" name="email" required placeholder="Email address" class="flex-1 px-4 py-3 border border-gray-300 rounded-md text-gray-900" />
          <button type="submit" class="btn-primary">Join Waitlist</button>
        </CaptureForm>
      </div>
    </div>
  </div>
</Layout>
