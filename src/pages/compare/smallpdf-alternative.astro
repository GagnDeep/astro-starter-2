---
import Layout from "../../layouts/Layout.astro";

const seo = {
  page_description:
    "Looking for an alternative to Smallpdf? uDocumentView focuses purely on viewing without aggressive upsells.",
  open_graph_type: "article",
};
---

<Layout title="Smallpdf Alternative | uDocumentView" seo={seo}>
  <main class="max-w-4xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold mb-6">uDocumentView vs. Smallpdf</h1>
    <p class="text-xl text-slate-600 mb-12">Pure viewing vs. heavy editing toolkits.</p>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-100">
            <th class="p-4 border border-slate-300 font-bold">Feature</th>
            <th class="p-4 border border-slate-300 font-bold text-blue-700">uDocumentView</th>
            <th class="p-4 border border-slate-300 font-bold">Smallpdf</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="p-4 border border-slate-300 font-medium">Primary Focus</td>
            <td class="p-4 border border-slate-300 font-medium text-green-600"
              >Pure, fast viewing</td
            >
            <td class="p-4 border border-slate-300">PDF editing and conversion</td>
          </tr>
          <tr class="bg-slate-50">
            <td class="p-4 border border-slate-300 font-medium">Free Tier Limits</td>
            <td class="p-4 border border-slate-300 text-green-600 font-medium">Unlimited viewing</td
            >
            <td class="p-4 border border-slate-300 text-red-500">Strict daily task limits</td>
          </tr>
          <tr>
            <td class="p-4 border border-slate-300 font-medium">Upsells</td>
            <td class="p-4 border border-slate-300 text-green-600 font-medium">None</td>
            <td class="p-4 border border-slate-300 text-red-500">Aggressive Pro prompts</td>
          </tr>
        </tbody>
      </table>
    </div>
  </main>
</Layout>
