---
import Layout from "../../layouts/Layout.astro";
import symptomsData from "../../../data/symptoms.json";
import { Stethoscope, ShieldAlert, AlertTriangle, ArrowRight } from "@lucide/astro";

const title = "IBS Symptom & Trigger Library — Visceral Pain, Gas & Motility Guide";
const description = "Comprehensive clinical library of 15+ IBS symptoms, triggers, red-flag warning signs, visceral hyperalgesia mechanisms, and evidence-based management.";
---

<Layout title={title} seo={{ page_description: description }}>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="mb-6 text-sm text-stone-600 flex items-center gap-2">
      <a href="/" class="hover:underline">Home</a> <span>/</span> <span class="font-semibold text-stone-900">Symptom Library</span>
    </nav>

    <header class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-semibold mb-3">
        Rome IV Criteria & Clinical Research
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-stone-900 tracking-tight mb-4">
        IBS Symptom & Trigger Library
      </h1>
      <p class="text-lg text-stone-700 max-w-3xl leading-relaxed">
        Understanding your physiological triggers is the first step toward regaining control. Explore clinical mechanisms, dietary vs non-dietary triggers, and management strategies.
      </p>
    </header>

    <!-- Prominent Red-Flag Symptoms Warning -->
    <div class="bg-rose-50 border-l-4 border-rose-600 p-6 rounded-r-xl mb-12 shadow-sm text-stone-900">
      <div class="flex items-start gap-4">
        <ShieldAlert class="w-7 h-7 text-rose-700 shrink-0 mt-1" />
        <div>
          <h2 class="text-lg font-bold text-rose-950 mb-1">Prominent Red-Flag Symptoms Warning</h2>
          <p class="text-sm text-rose-900 mb-2 leading-relaxed">
            IBS is a functional gastrointestinal disorder diagnosed by excluding organic disease. Consult a physician or gastroenterologist immediately if you experience:
          </p>
          <ul class="list-disc list-inside text-xs text-rose-900 font-medium space-y-1">
            <li>Unexplained involuntary weight loss (>5% body mass in 30 days)</li>
            <li>Nocturnal diarrhea (waking up from sleep to defecate)</li>
            <li>Rectal bleeding, blood in stool, or black tarry stools</li>
            <li>Unexplained persistent fever or systemic joint pain</li>
            <li>New onset of bowel habit changes after age 50</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Symptoms Grid -->
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {symptomsData.map((sym) => (
        <article class="bg-white p-6 rounded-xl border border-stone-200 shadow-sm flex flex-col justify-between hover:border-amber-400 transition-colors">
          <div>
            <div class="text-xs font-bold text-amber-900 bg-amber-50 px-2.5 py-1 rounded-md inline-block mb-3">
              {sym.medical_name}
            </div>
            <h3 class="text-xl font-bold text-stone-900 mb-2">{sym.name}</h3>
            <p class="text-xs text-stone-600 line-clamp-3 mb-4 leading-relaxed">{sym.description}</p>
          </div>

          <div class="pt-4 border-t border-stone-100 flex items-center justify-between text-xs font-semibold text-amber-800">
            <span>Explore Triggers & Protocol</span>
            <a href={`/symptoms/${sym.slug}/`} class="inline-flex items-center gap-1 hover:underline">
              View Guide &rarr;
            </a>
          </div>
        </article>
      ))}
    </section>

    <div class="pt-8 border-t border-stone-200 flex flex-wrap gap-4 text-sm font-medium">
      <a href="/food/" class="text-amber-800 hover:underline">View Low-FODMAP Food Directory &rarr;</a>
      <a href="/protocols/" class="text-amber-800 hover:underline">View Protocol Guides &rarr;</a>
      <a href="/tools/symptom-pattern/" class="text-amber-800 hover:underline">Interactive Symptom Pattern Tool &rarr;</a>
    </div>
  </main>
</Layout>
