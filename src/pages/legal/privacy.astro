---
import Layout from "../../layouts/Layout.astro";

const seo = {
  page_description: "Privacy policy for FoodLogTrack.",
  title: "Privacy Policy"
};
---

<Layout title="Privacy Policy" seo={seo}>
  <main class="max-w-3xl mx-auto px-4 py-12 prose">
    <h1>Privacy Policy</h1>
    <p>Last updated: Jan 1, 2024</p>
    <p>We don't sell your data. We use it to provide a simple tracking experience. Read our <a href="/legal/terms">Terms of Service</a>.</p>
  </main>
</Layout>
