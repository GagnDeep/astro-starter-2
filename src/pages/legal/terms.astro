---
import Layout from "../../layouts/Layout.astro";

const seo = {
  page_description: "Terms of Service for uDocumentView.",
  open_graph_type: "website"
};
---
<Layout title="Terms of Service | uDocumentView" seo={seo}>
  <main class="max-w-3xl mx-auto px-4 py-16 prose prose-slate">
    <h1>Terms of Service</h1>
    <p>Last updated: [NEEDS CONFIRMATION - Date]</p>

    <h2>1. Acceptance of Terms</h2>
    <p>By accessing and using uDocumentView, you accept and agree to be bound by the terms and provision of this agreement.</p>

    <h2>2. Description of Service</h2>
    <p>uDocumentView provides a web-based document viewing service. We do not provide document hosting, permanent storage, or editing capabilities.</p>

    <h2>3. Privacy and Data Security</h2>
    <p>We do not claim ownership over any documents you view using our service. Please refer to our Privacy Policy for detailed information on how we handle data ephemerally.</p>

    <h2>4. Limitations of Liability</h2>
    <p>The service is provided "as is". We are not responsible for any document corruption, data loss, or rendering inaccuracies.</p>
  </main>
</Layout>
