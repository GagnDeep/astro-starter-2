---
import Layout from '../../layouts/Layout.astro';

const seo = {
  page_description: "Terms of Service for Aerospace UAE.",
  canonical_url: "/legal/terms"
};
---

<Layout title="Terms of Service" seo={seo}>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12 prose prose-slate">
    <h1>Terms of Service</h1>
    <p>Last updated: March 2024</p>
    <p>Welcome to Aerospace UAE. By using our directory and tools, you agree to these terms.</p>
    <h2>Use of Directory</h2>
    <p>The information provided in our directory is for B2B intelligence purposes. While we strive for accuracy, we cannot guarantee the exact certification status of every supplier at all times. Users should perform their own due diligence.</p>
    <h2>Tools and Calculators</h2>
    <p>Tools such as the Offset Calculator are provided for estimation purposes only and do not constitute legal or financial advice regarding UAE government regulations.</p>
  </div>
</Layout>
