---
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Privacy Policy">
  <main class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-6">Privacy Policy</h1>
    <article class="prose">
      <p>We do not sell your data. Analytics are collected anonymously using OpenObserve unless you opt into forms, in which case data is securely stored for response purposes only.</p>
    </article>
  </main>
</Layout>
