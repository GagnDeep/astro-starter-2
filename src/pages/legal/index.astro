---
import Layout from "../../layouts/Layout.astro";

const seo = {
  page_description: "Legal terms and privacy policy for uconvertfile.com",
  no_index: true,
};
---

<Layout title="Legal Terms & Privacy" seo={seo}>
  <div class="max-w-4xl mx-auto px-4 py-12 prose">
    <h1>Legal & Privacy Policy</h1>
    <p>Last updated: <span data-format="date">2023-10-25</span></p>

    <h2>Terms of Service</h2>
    <p>
      By using uconvertfile.com, you agree to use our tools responsibly. We do not guarantee the absolute accuracy or fitness for a particular purpose of any converted file.
    </p>

    <h2>Privacy Policy</h2>
    <p>
      We value your privacy. Files uploaded for conversion are processed securely and are deleted from our servers immediately after the conversion is complete, or as soon as technically feasible. We do not store, sell, or analyze the contents of your files.
    </p>
    <p>
      If you submit your email via our capture forms, it will only be used to send you the requested materials (e.g., our file format guide). We do not sell your email address to third parties.
    </p>
  </div>
</Layout>
