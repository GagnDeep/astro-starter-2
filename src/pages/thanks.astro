---
import Layout from '../layouts/Layout.astro';

const seo = {
  no_index: true,
  page_description: "Thank you for contacting Aerospace UAE."
};
---

<Layout title="Thank You" seo={seo}>
  <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <div class="bg-green-100 text-green-800 p-4 rounded-full inline-block mb-6">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
    </div>
    <h1 class="text-3xl font-bold mb-4">Request Received</h1>
    <p class="text-slate-600 mb-8">
      Thank you for your submission. Our team will review your details and get back to you shortly.
    </p>
    <a href="/" class="btn-primary">Return to Homepage</a>
  </div>
</Layout>
