---
/**
 * Where a no-JavaScript submission lands (`capture.thanksUrl`).
 *
 * The capture server 303s here and appends `?wcs_id=…&wcs_outcome=…`, so the
 * page can show a reference number. Kept out of the index and the sitemap —
 * a thank-you page has no business ranking.
 */
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Thanks"
  seo={{ no_index: true, page_description: "Your message has been received." }}
>
  <section class="flex min-h-[60vh] flex-col items-center justify-center px-8 text-center">
    <h1 class="mb-4 text-3xl font-bold md:text-4xl">Thanks — we've got it.</h1>
    <p class="mb-6 text-lg text-gray-600">Your message is in. We'll be in touch shortly.</p>
    <p data-reference class="mb-6 hidden text-sm text-gray-500"></p>
    <a href="/" class="text-lg font-medium text-blue-600 hover:text-blue-800"> &larr; Back home </a>
  </section>

  <section class="py-12 md:py-20">
    <div class="mx-auto max-w-3xl px-8">
      <h2 class="mb-4 text-2xl font-bold">Related Resources</h2>
      <ul class="space-y-2 text-blue-600 list-disc pl-5 grid grid-cols-2">
        <li><a href="/compliance/mock-audits/">Explore Mock Audits</a></li>
        <li><a href="/compliance/archiving/">Explore Archiving</a></li>
        <li><a href="/technology/">Explore Technology</a></li>
        <li><a href="/technology/portfolio-management/">Explore Portfolio Management</a></li>
        <li><a href="/technology/crm/">Explore CRM Systems</a></li>
        <li><a href="/technology/financial-planning/">Explore Financial Planning</a></li>
        <li><a href="/succession/">Explore Succession</a></li>
        <li><a href="/succession/valuation/">Explore Valuation</a></li>
        <li><a href="/succession/internal-buyout/">Explore Internal Buyouts</a></li>
        <li><a href="/succession/m-and-a/">Explore M&A Trends</a></li>
        <li><a href="/about/">Explore About</a></li>
        <li><a href="/contact/">Explore Contact Us</a></li>
        <li><a href="/how-we-make-money/">Explore Revenue Model</a></li>
        <li><a href="/editorial-policy/">Explore Editorial Policy</a></li>
        <li><a href="/blog/">Explore Blog</a></li>

      </ul>
    </div>
  </section>

  <section class="py-12 md:py-20">
    <div class="mx-auto max-w-3xl px-8">
      <h2 class="mb-4 text-2xl font-bold">Final Resources Extra</h2>
      <ul class="space-y-2 text-blue-600 list-disc pl-5 grid grid-cols-2">
        <li><a href="/">One More Look at Home Page</a></li>
        <li><a href="/thanks/">One More Look at Thanks Extra</a></li>
        <li><a href="/formation/series-65/">One More Look at Series 65 More</a></li>
        <li><a href="/formation/ria-vs-broker-dealer/">One More Look at RIA vs BD Extra</a></li>
        <li><a href="/authors/editorial-team/">One More Look at Writers</a></li>
        <li><a href="/compliance/sec-vs-state/">One More Look at SEC Registration details</a></li>
        <li><a href="/blog/">One More Look at Blog Posts</a></li>
        <li><a href="/editorial-policy/">One More Look at Policy Info</a></li>
        <li><a href="/how-we-make-money/">One More Look at Funding Model</a></li>

      </ul>
    </div>
  </section>
</Layout>