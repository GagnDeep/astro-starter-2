---
import Layout from '../layouts/Layout.astro';

const seo = {
  page_description: "Thank you for contacting the Institute of Investing.",
  no_index: true,
};
---

<Layout title="Thank You | Institute of Investing" seo={seo}>
  <main class="max-w-3xl mx-auto px-4 py-24 text-center">
    <div class="inline-block bg-green-100 text-green-800 p-4 rounded-full mb-6">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h1 class="text-4xl font-bold mb-4">Message Received</h1>
    <p class="text-xl text-gray-600 mb-8">Thank you. We've received your information and will be in touch shortly.</p>
    <a href="/" class="text-blue-600 font-bold hover:underline">&larr; Return to Homepage</a>
  </main>
</Layout>
