---
import Layout from "../layouts/Layout.astro";

const seo = {
  page_description: "Thank you for contacting Institute for Tax.",
  canonical_url: "/thanks/",
  no_index: true
};
---

<Layout title="Thank You | Institute for Tax" seo={seo}>
  <div class="container py-24 text-center">
    <div class="max-w-xl mx-auto bg-brand-light p-10 rounded-card border border-slate-200">
      <div class="w-16 h-16 bg-brand-emerald/10 text-brand-emerald rounded-full flex items-center justify-center mx-auto mb-6">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <h1 class="text-3xl font-bold mb-4">Request Received</h1>
      <p class="text-lg text-brand-slate mb-8">
        Thank you. Your information has been securely submitted. A member of our team will be in touch shortly.
      </p>
      <a href="/" class="btn-primary">Return to Homepage</a>
    </div>
  </div>
</Layout>
