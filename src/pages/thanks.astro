---
/**
 * Where a no-JavaScript submission lands (`capture.thanksUrl`).
 *
 * The capture server 303s here and appends `?wcs_id=…&wcs_outcome=…`, so the
 * page can show a reference number. Kept out of the index and the sitemap —
 * a thank-you page has no business ranking.
 */
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Thanks"
  seo={{ no_index: true, page_description: "Your message has been received." }}
>
  <section class="flex min-h-[60vh] flex-col items-center justify-center px-8 text-center">
    <h1 class="mb-4 text-3xl font-bold md:text-4xl text-text">Thanks — we've got it.</h1>
    <p class="mb-6 text-lg text-text-muted">Your message is in. We'll be in touch shortly.</p>
    <p data-reference class="mb-6 hidden text-sm text-text-muted"></p>
    <a href="/" class="text-lg font-medium text-primary hover:text-primary-hover"> &larr; Back home </a>
  </section>
</Layout>

<script>
  // `wcs_id` is a UUIDv7 the visitor can quote back to us; nothing sensitive.
  const id = new URLSearchParams(window.location.search).get("wcs_id");
  const target = document.querySelector<HTMLElement>("[data-reference]");
  if (id && target) {
    target.textContent = `Reference: ${id}`;
    target.classList.remove("hidden");
  }
</script>
