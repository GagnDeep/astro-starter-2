---
import Layout from "../layouts/Layout.astro";
import Button from "../components/ui/button.astro";

const props = {
  title: "Thanks for your submission",
  seo: {
    page_description: "Thank you for getting in touch.",
    no_index: true
  }
};
---

<Layout {...props}>
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-green-100 mb-6">
      <svg class="w-8 h-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h1 class="text-3xl font-bold mb-4">Thanks for getting in touch</h1>
    <p class="text-lg text-slate-600 mb-8">
      We've received your submission and will get back to you shortly if a reply is needed.
    </p>
    <Button href="/">Return to homepage</Button>
  </div>
</Layout>
