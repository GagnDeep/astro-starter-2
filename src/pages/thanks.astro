---
import Layout from "../layouts/Layout.astro";

const seo = {
  no_index: true,
};
---
<Layout title="Thank You | uDocumentView" seo={seo}>
  <main class="max-w-2xl mx-auto px-4 py-32 text-center">
    <h1 class="text-4xl font-bold mb-4">Message Received</h1>
    <p class="text-lg text-slate-600 mb-8">Thanks for getting in touch. We'll get back to you as soon as possible.</p>
    <a href="/" class="text-blue-600 hover:underline font-medium">Return to homepage</a>
  </main>
</Layout>
