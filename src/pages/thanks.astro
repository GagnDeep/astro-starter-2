---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You | Institute of Property">
  <div class="py-24 px-6 sm:px-12 bg-background min-h-screen flex items-center justify-center">
    <div class="card max-w-lg text-center">
      <div class="w-16 h-16 bg-accent/10 rounded-full flex items-center justify-center mx-auto mb-6">
        <svg class="w-8 h-8 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
      </div>
      <h1 class="text-3xl font-bold mb-4">Submission Received</h1>
      <p class="text-text-muted mb-8">Thank you. Your information has been securely captured.</p>
      <a href="/" class="btn-primary">Return Home</a>
    </div>
  </div>
</Layout>
