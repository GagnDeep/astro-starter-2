---
import Layout from "../layouts/Layout.astro";

const schemaData = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  "name": "Dr. Ameena Endocrinology Clinic Austin TX",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "1200 Medical Parkway, Suite 400 [NEEDS CONFIRMATION]",
    "addressLocality": "Austin",
    "addressRegion": "TX",
    "postalCode": "78756",
    "addressCountry": "US"
  },
  "telephone": "(512) 555-0199 [NEEDS CONFIRMATION]",
  "openingHours": "Mo-Th 08:00-16:30, Fr 08:00-12:00"
};
---

<Layout title="Location, Directions & Hours" schemaData={schemaData}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 space-y-10">
    <div class="space-y-3 border-b border-stone-200 pb-6">
      <span class="badge-reviewed">Austin Practice Location</span>
      <h1 class="text-3xl sm:text-4xl font-serif font-bold text-[#1B4332]">Location, Office Hours & Directions</h1>
      <p class="text-stone-600 text-sm sm:text-base max-w-2xl">
        Dr. Ameena's clinic is situated in Central Austin, providing easy access from Mopac Expressway (Loop 1) and Interstate 35.
      </p>
    </div>

    <!-- NAP Info Card & Map Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <div class="lg:col-span-5 bg-white p-6 rounded-xl border border-stone-200 shadow-sm space-y-6 text-xs text-stone-800">
        <div>
          <h2 class="text-xl font-serif font-bold text-[#1B4332] mb-2">Clinic Information</h2>
          <p class="text-stone-600 mb-4">Dr. Ameena, MD — Endocrinology & Metabolic Care</p>
        </div>

        <div class="space-y-3">
          <div>
            <strong class="text-[#1B4332] text-sm">📍 Office Address <span class="bg-amber-100 text-amber-900 text-[10px] px-1 rounded font-bold">[NEEDS CONFIRMATION]</span>:</strong>
            <p class="mt-1 leading-relaxed">
              1200 Medical Parkway, Suite 400<br/>
              Austin, TX 78756
            </p>
          </div>

          <div>
            <strong class="text-[#1B4332] text-sm">📞 Phone & Fax <span class="bg-amber-100 text-amber-900 text-[10px] px-1 rounded font-bold">[NEEDS CONFIRMATION]</span>:</strong>
            <p class="mt-1 leading-relaxed">
              Main Office: (512) 555-0199<br/>
              Secure Fax: (512) 555-0190
            </p>
          </div>

          <div>
            <strong class="text-[#1B4332] text-sm">🕒 Practice Hours <span class="bg-amber-100 text-amber-900 text-[10px] px-1 rounded font-bold">[NEEDS CONFIRMATION]</span>:</strong>
            <ul class="mt-1 space-y-1">
              <li>Monday – Thursday: 8:00 AM – 4:30 PM</li>
              <li>Friday: 8:00 AM – 12:00 PM</li>
              <li>Saturday & Sunday: Closed</li>
            </ul>
          </div>

          <div>
            <strong class="text-[#1B4332] text-sm">🚗 Parking & Accessibility:</strong>
            <p class="mt-1 leading-relaxed">
              Free ground-level patient parking is available directly adjacent to the medical building entrance. Wheelchair accessible ramps and elevators are located at the main entry.
            </p>
          </div>
        </div>

        <div class="pt-4 border-t border-stone-100">
          <a href="/booking/" class="btn-primary w-full text-center text-xs">
            Schedule a Visit
          </a>
        </div>
      </div>

      <!-- Vector Map Placeholder -->
      <div class="lg:col-span-7 bg-[#E8F5E9] p-8 rounded-xl border border-emerald-200 flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <span class="badge-category bg-[#2D6A4F] text-white">Central Austin Medical District</span>
          <h3 class="text-2xl font-serif font-bold text-[#1B4332]">Geographic Coverage</h3>
          <p class="text-xs text-stone-700 leading-relaxed">
            Our Austin office welcomes patients from across Central Texas, including:
          </p>
          <div class="grid grid-cols-2 gap-2 text-xs font-semibold text-[#1B4332] pt-2">
            <div>• Austin (Central, North, South)</div>
            <div>• Westlake Hills & Bee Cave</div>
            <div>• Round Rock & Pflugerville</div>
            <div>• Cedar Park & Leander</div>
            <div>• Lakeway & Spicewood</div>
            <div>• Georgetown & San Marcos</div>
          </div>
        </div>

        <!-- SVG Map Vector Illustration -->
        <div class="bg-white p-6 rounded-lg border border-emerald-300 text-center space-y-2">
          <svg class="w-16 h-16 mx-auto text-[#2D6A4F]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <div class="font-serif font-bold text-sm text-[#1B4332]">1200 Medical Parkway, Suite 400</div>
          <div class="text-xs text-stone-500">Austin, TX 78756 <span class="bg-amber-100 text-amber-900 text-[10px] px-1 rounded font-bold">[NEEDS CONFIRMATION]</span></div>
        </div>
      </div>
    </div>
  </div>
</Layout>
