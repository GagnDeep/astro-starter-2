---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const guides = await getCollection("guides");
guides.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const seo = {
  page_description: "Authoritative guides on Cayman Islands corporate structuring, compliance, and business operations.",
  canonical_url: "/guides/",
  open_graph_type: "website"
};
---
<Layout seo={seo} title="Corporate & Finance Guides | The Cayman Journal">
  <div class="max-w-4xl mx-auto py-12 px-6">
    <h1 class="text-3xl font-bold mb-4">Corporate & Finance Guides</h1>
    <p class="text-gray-600 mb-12">Deep reference material verified against primary legal and regulatory sources.</p>

    <div class="space-y-8">
      {guides.map((guide) => (
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
          <h2 class="text-xl font-bold text-navy-900 mb-2">
            <a href={`/guides/${guide.id}/`} class="hover:text-brand-700 transition-colors">{guide.data.title}</a>
          </h2>
          <p class="text-gray-700 mb-4">{guide.data.description}</p>
          <div class="flex items-center text-sm text-gray-500 space-x-4">
            <span>{new Date(guide.data.date).toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric'})}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
