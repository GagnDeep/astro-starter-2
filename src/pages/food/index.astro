---
import Layout from "../../layouts/Layout.astro";
import foodsData from "../../../data/foods.json";
import { Search, Apple, ArrowLeft, ShieldAlert } from "@lucide/astro";

const title = "Low-FODMAP Food Directory & Monash Serving Thresholds — IBS Go";
const description = "Search 25+ essential foods with Monash-cited FODMAP serving thresholds (green, amber, red cutoffs), fructan warnings, and safe alternatives.";
---

<Layout title={title} seo={{ page_description: description }}>
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="mb-6 text-sm text-stone-600 flex items-center gap-2">
      <a href="/" class="hover:underline">Home</a> <span>/</span> <span class="font-semibold text-stone-900">Food Directory</span>
    </nav>

    <header class="mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-100 text-amber-900 text-xs font-semibold mb-3">
        Monash University Tested Thresholds
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-stone-900 tracking-tight mb-4">
        Low-FODMAP Food Directory
      </h1>
      <p class="text-lg text-stone-700 max-w-3xl leading-relaxed">
        FODMAP tolerance is portion-dependent. Search verified serving thresholds for green (low risk), amber (moderate), and red (high risk) quantities based on Monash research.
      </p>
    </header>

    <div class="bg-amber-50 border-l-4 border-amber-600 p-4 rounded-r-lg mb-8 text-sm text-stone-800 flex items-start gap-3">
      <ShieldAlert class="w-5 h-5 text-amber-700 shrink-0 mt-0.5" />
      <div>
        <strong>Education & Medical Disclaimer:</strong> Serving sizes are based on published Monash lab data. Low-FODMAP is a temporary elimination protocol (2-6 weeks), not a permanent restriction.
      </div>
    </div>

    <!-- Static Fallback Table & Food Cards -->
    <section class="mb-12">
      <h2 class="text-xl font-bold text-stone-900 mb-6 flex items-center gap-2">
        <Apple class="w-5 h-5 text-emerald-700" /> Full Food Directory Table
      </h2>

      <div class="overflow-x-auto bg-white rounded-xl border border-stone-200 shadow-sm">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-stone-100 border-b border-stone-200 text-stone-900 font-semibold">
              <th class="p-4">Food Item</th>
              <th class="p-4">Category</th>
              <th class="p-4">FODMAP Rating</th>
              <th class="p-4">FODMAP Group</th>
              <th class="p-4">Green Serving (Safe)</th>
              <th class="p-4">Red Serving (Limit)</th>
              <th class="p-4">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-200 text-stone-800">
            {foodsData.map((food) => (
              <tr class="hover:bg-stone-50 transition-colors">
                <td class="p-4 font-bold text-stone-900">{food.name}</td>
                <td class="p-4 text-xs font-medium text-stone-600">{food.category}</td>
                <td class="p-4">
                  <span class={`px-2.5 py-1 text-xs rounded-full font-semibold ${
                    food.fodmap_rating.includes('Low') ? 'bg-emerald-100 text-emerald-800' :
                    food.fodmap_rating.includes('Moderate') ? 'bg-amber-100 text-amber-900' :
                    'bg-rose-100 text-rose-900'
                  }`}>
                    {food.fodmap_rating}
                  </span>
                </td>
                <td class="p-4 text-xs text-stone-700">{food.fodmap_type}</td>
                <td class="p-4 font-mono text-xs font-semibold text-emerald-800">{food.green_serving}</td>
                <td class="p-4 font-mono text-xs font-semibold text-rose-800">{food.red_serving}</td>
                <td class="p-4">
                  <a href={`/food/${food.slug}/`} class="text-amber-800 font-medium text-xs hover:underline">
                    View Details &rarr;
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <div class="pt-8 border-t border-stone-200 flex flex-wrap gap-4 text-sm font-medium">
      <a href="/symptoms/" class="text-amber-800 hover:underline">Symptom & Trigger Library &rarr;</a>
      <a href="/protocols/" class="text-amber-800 hover:underline">Protocol Guides &rarr;</a>
      <a href="/tools/food-lookup/" class="text-amber-800 hover:underline">Interactive Food Lookup Tool &rarr;</a>
    </div>
  </main>
</Layout>
