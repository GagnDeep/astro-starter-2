---
import Layout from "../../layouts/Layout.astro";
import foodsData from "../../../data/foods.json";
import { ArrowLeft, ShieldAlert, CheckCircle2, AlertTriangle, XCircle, ExternalLink } from "@lucide/astro";

export async function getStaticPaths() {
  return foodsData.map((food) => ({
    params: { slug: food.slug },
    props: { food },
  }));
}

const { food } = Astro.props;
const title = `${food.name} Low-FODMAP Status & Monash Serving Size — IBS Go`;
const description = `Is ${food.name} low FODMAP? Detailed Monash threshold cutoffs, green/amber/red serving sizes, fructan warnings, and safe alternatives.`;

// Schema JSON-LD
const schema = {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  "name": title,
  "description": description,
  "aspect": "Overview",
  "about": {
    "@type": "Thing",
    "name": food.name
  }
};
---

<Layout title={title} seo={{ page_description: description }}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <nav class="mb-6 text-sm text-stone-600 flex items-center gap-2">
      <a href="/" class="hover:underline">Home</a> <span>/</span>
      <a href="/food/" class="hover:underline">Food Directory</a> <span>/</span>
      <span class="font-semibold text-stone-900">{food.name}</span>
    </nav>

    <header class="mb-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-stone-100 text-stone-800">
          {food.category}
        </span>
        <span class={`px-3 py-1 rounded-full text-xs font-bold ${
          food.fodmap_rating.includes('Low') ? 'bg-emerald-100 text-emerald-900' :
          food.fodmap_rating.includes('Moderate') ? 'bg-amber-100 text-amber-900' :
          'bg-rose-100 text-rose-900'
        }`}>
          {food.fodmap_rating}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold text-stone-900 mb-4">{food.name}</h1>
      <p class="text-stone-700 text-lg leading-relaxed">{food.description}</p>
    </header>

    <!-- Medical Advice Warning -->
    <div class="bg-amber-50 border-l-4 border-amber-600 p-4 rounded-r-lg mb-8 text-sm text-stone-800 flex items-start gap-3">
      <ShieldAlert class="w-5 h-5 text-amber-700 shrink-0 mt-0.5" />
      <div>
        <strong>Education & Medical Disclaimer:</strong> Information reflects Monash University FODMAP thresholds. IBS Go is an educational tracking app and does not replace medical or dietitian care.
      </div>
    </div>

    <!-- Serving Threshold Breakdown Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
      <div class="bg-emerald-50 border border-emerald-200 p-5 rounded-xl">
        <div class="flex items-center gap-2 text-emerald-900 font-bold mb-2">
          <CheckCircle2 class="w-5 h-5 text-emerald-700" /> Green Serving (Safe)
        </div>
        <p class="font-mono text-lg font-bold text-emerald-950 mb-1">{food.green_serving}</p>
        <p class="text-xs text-emerald-800">Low FODMAP load. Suitable during 2-6 week elimination phase.</p>
      </div>

      <div class="bg-amber-50 border border-amber-200 p-5 rounded-xl">
        <div class="flex items-center gap-2 text-amber-900 font-bold mb-2">
          <AlertTriangle class="w-5 h-5 text-amber-700" /> Amber Serving (Moderate)
        </div>
        <p class="font-mono text-lg font-bold text-amber-950 mb-1">{food.amber_serving}</p>
        <p class="text-xs text-amber-800">Moderate FODMAP load. Limit or monitor for stacking effects.</p>
      </div>

      <div class="bg-rose-50 border border-rose-200 p-5 rounded-xl">
        <div class="flex items-center gap-2 text-rose-900 font-bold mb-2">
          <XCircle class="w-5 h-5 text-rose-700" /> Red Serving (High Risk)
        </div>
        <p class="font-mono text-lg font-bold text-rose-950 mb-1">{food.red_serving}</p>
        <p class="text-xs text-rose-800">High FODMAP load. Avoid during strict elimination phase.</p>
      </div>
    </div>

    <!-- FODMAP Group Details & Tips -->
    <div class="bg-white rounded-xl border border-stone-200 p-6 shadow-sm mb-10 space-y-6">
      <div>
        <h3 class="text-lg font-bold text-stone-900 mb-2">Dominant FODMAP Carbohydrate Group</h3>
        <p class="text-stone-800 font-medium bg-stone-100 inline-block px-3 py-1 rounded-md text-sm">{food.fodmap_type}</p>
      </div>

      <div>
        <h3 class="text-lg font-bold text-stone-900 mb-2">Practical Culinary & Preparation Tips</h3>
        <p class="text-stone-700 text-sm leading-relaxed">{food.tips}</p>
      </div>

      <div>
        <h3 class="text-lg font-bold text-stone-900 mb-2">Recommended Low-FODMAP Alternatives</h3>
        <ul class="flex flex-wrap gap-2 text-sm">
          {food.alternatives.map((alt) => (
            <li class="bg-emerald-50 text-emerald-900 px-3 py-1 rounded-lg border border-emerald-200 font-medium">
              {alt}
            </li>
          ))}
        </ul>
      </div>

      <div class="pt-4 border-t border-stone-100 text-xs text-stone-500">
        Clinical Citation: <strong class="text-stone-700">{food.monash_threshold_citation}</strong> | Review Date: <span class="font-mono">May 2024</span>
      </div>
    </div>

    <!-- Page internal links -->
    <div class="flex flex-wrap gap-4 text-sm font-medium pt-6 border-t border-stone-200">
      <a href="/food/" class="text-amber-800 hover:underline">&larr; Back to Food Directory</a>
      <a href="/protocols/elimination-phase/" class="text-amber-800 hover:underline">Elimination Phase Guide &rarr;</a>
      <a href="/tools/food-lookup/" class="text-amber-800 hover:underline">Interactive Food Lookup Tool &rarr;</a>
    </div>
  </main>
</Layout>
