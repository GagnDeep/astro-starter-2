---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import NewsletterForm from "../components/forms/newsletter-form.astro";

// Normally we'd render the whole collection, but we'll mock the library index here for now and link to taxonomy.
const seo = {
  page_description: "The complete IBS-Go FODMAP food library. Find safe serving sizes for fruits, vegetables, grains, and proteins.",
  canonical_url: "/library/",
};
---

<Layout title="FODMAP Food Library | IBS-Go" seo={seo}>
  <main class="container-narrow py-16">
    <div class="mb-12">
      <h1 class="text-4xl font-bold text-[var(--color-primary-950)] mb-4">The FODMAP Food Library</h1>
      <p class="text-lg text-[var(--color-text-muted)]">
        Stop guessing in the grocery aisle. Browse foods by category to find evidence-based safe serving sizes.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6 mb-16">
      <a href="/taxonomy/fruits" class="p-6 bg-white border border-[var(--color-primary-200)] rounded-xl hover:border-[var(--color-primary-500)] hover:shadow-md transition-all group">
         <div class="text-3xl mb-3">🍎</div>
         <h3 class="font-bold text-lg group-hover:text-[var(--color-primary-600)]">Fruits</h3>
      </a>
      <a href="/taxonomy/vegetables" class="p-6 bg-white border border-[var(--color-primary-200)] rounded-xl hover:border-[var(--color-primary-500)] hover:shadow-md transition-all group">
         <div class="text-3xl mb-3">🥦</div>
         <h3 class="font-bold text-lg group-hover:text-[var(--color-primary-600)]">Vegetables</h3>
      </a>
      <a href="/taxonomy/grains" class="p-6 bg-white border border-[var(--color-primary-200)] rounded-xl hover:border-[var(--color-primary-500)] hover:shadow-md transition-all group">
         <div class="text-3xl mb-3">🌾</div>
         <h3 class="font-bold text-lg group-hover:text-[var(--color-primary-600)]">Grains</h3>
      </a>
      <!-- Add more placeholders to indicate depth -->
    </div>

    <div class="bg-[var(--color-primary-900)] text-white p-8 rounded-xl text-center">
       <h2 class="text-2xl font-bold mb-4">Download the PDF Cheat Sheet</h2>
       <p class="text-[var(--color-primary-200)] mb-6 max-w-xl mx-auto">Get our one-page printable grocery guide with the 50 most common low-FODMAP swaps.</p>
       <div class="max-w-md mx-auto">
          <NewsletterForm form="waitlist" submitLabel="Get PDF" placeholder="Your email" />
       </div>
    </div>
  </main>
</Layout>
