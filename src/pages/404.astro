---
import Layout from "../layouts/Layout.astro";

const seo = {
  no_index: true,
};
---
<Layout title="Page Not Found | uDocumentView" seo={seo}>
  <main class="max-w-2xl mx-auto px-4 py-32 text-center">
    <h1 class="text-6xl font-bold mb-4">404</h1>
    <h2 class="text-2xl font-semibold mb-6">Page Not Found</h2>
    <p class="text-lg text-slate-600 mb-8">The page you are looking for does not exist or has been moved.</p>
    <a href="/" class="inline-block bg-blue-600 text-white font-medium px-6 py-2 rounded-md hover:bg-blue-700">Return Home</a>
  </main>
</Layout>
