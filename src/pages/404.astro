---
import Layout from "../layouts/Layout.astro";
import Seo from "../components/seo/seo.astro";

const seo = {
  page_description: "Page not found.",
  no_index: true,
};
---

<Layout title="Page Not Found">
  <Seo seo={seo} />
  <div class="max-w-2xl mx-auto py-24 text-center px-4">
    <h1 class="text-6xl font-bold text-primary mb-4">404</h1>
    <h2 class="text-2xl font-semibold mb-6">Page Not Found</h2>
    <p class="mb-8">We couldn't find the page you're looking for. It might have been moved or deleted.</p>
    <a href="/" class="inline-block bg-primary text-white font-medium py-3 px-6 rounded-md hover:bg-opacity-90 transition-colors">Return Home</a>
  </div>
</Layout>
