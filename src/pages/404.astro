---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found (404) — Dr. Ameena Patel, MD"
  description="The requested page could not be found. Explore our endocrinology condition library or book a consultation."
>

  <div class="py-20 bg-cream text-center border-b border-border">
    <div class="max-w-md mx-auto px-4 space-y-6">
      <div class="w-16 h-16 rounded-full bg-terracotta/10 text-terracotta font-serif text-2xl font-bold flex items-center justify-center mx-auto">
        404
      </div>
      <h1 class="font-serif text-3xl font-bold text-charcoal">Page Not Found</h1>
      <p class="text-xs text-charcoal-muted leading-relaxed">
        The clinical resource or page you requested could not be located. You can search our medical library or return to the homepage.
      </p>
      <div class="flex items-center justify-center gap-4 pt-2">
        <a href="/" class="bg-terracotta text-cream font-medium px-5 py-2.5 rounded-lg text-xs hover:bg-terracotta-hover transition-colors">
          Return to Home
        </a>
        <a href="/conditions/" class="bg-surface text-charcoal border border-border font-medium px-5 py-2.5 rounded-lg text-xs hover:bg-border/60 transition-colors">
          Explore Conditions
        </a>
      </div>
    </div>
  </div>

</BaseLayout>
