---
import Layout from "../layouts/Layout.astro";

const seo = {
  page_description: "Page not found.",
  no_index: true
};
---

<Layout title="Page Not Found | uDocumentViewer" seo={seo}>
  <div class="max-w-3xl mx-auto px-4 py-32 text-center">
    <h1 class="text-6xl font-bold text-text mb-6">404</h1>
    <h2 class="text-3xl font-semibold mb-8">Page Not Found</h2>
    <p class="text-xl text-text/80 mb-10">The document or page you are looking for does not exist.</p>
    <a href="/" class="btn">Return Home</a>
  </div>
</Layout>
