---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - Not Found" seo={{ no_index: true }}>
  <section class="flex flex-col items-center justify-center min-h-[60vh] px-8 text-center py-24">
    <h1 class="text-4xl md:text-5xl font-bold mb-6">404 — Page not found.</h1>
    <p class="text-xl max-w-prose mb-8">
      We couldn't find the page you were looking for. It may have been moved or deleted.
    </p>
    <a href="/" class="inline-block bg-[var(--color-brand-900)] text-[var(--color-support-100)] px-6 py-3 font-bold hover:bg-[var(--color-brand-500)] hover-transition">
      &larr; Return to Home
    </a>
  </section>
</Layout>
