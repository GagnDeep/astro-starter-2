---
import Layout from '../layouts/Layout.astro';

const seo = {
  no_index: true,
  page_description: "Page not found."
};
---

<Layout title="404 - Not Found" seo={seo}>
  <div class="max-w-xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
    <h1 class="text-6xl font-bold mb-4 text-slate-200">404</h1>
    <h2 class="text-2xl font-bold mb-4">Page Not Found</h2>
    <p class="text-slate-600 mb-8">
      The page you are looking for does not exist or has been moved.
    </p>
    <a href="/" class="btn-primary">Return to Homepage</a>
  </div>
</Layout>
