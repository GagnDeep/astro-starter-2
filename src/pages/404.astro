---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - Not Found">
  <section class="flex flex-col items-center justify-center min-h-[60vh] px-8 text-center" aria-labelledby="error-title">
    <h1 id="error-title" class="text-3xl md:text-4xl font-bold mb-4 display-text text-[var(--color-brand-600)]">404 - Page Not Found</h1>
    <p class="text-lg text-[var(--color-text-muted)] mb-8 max-w-md mx-auto">The page you are looking for has been moved, deleted, or does not exist.</p>
    <a href="/" class="px-6 py-3 bg-[var(--color-brand-600)] text-white font-medium hover:bg-[var(--color-brand-700)] hover-transition shadow-sm inline-block rounded-none">
      Return to Homepage
    </a>
  </section>
</Layout>
