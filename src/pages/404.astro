---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 - Not Found">
  <section class="flex flex-col items-start justify-center min-h-[60vh] px-8 mx-auto max-w-6xl">
    <h1 class="text-4xl md:text-6xl font-bold font-display text-[var(--color-text)] mb-6 text-balance">
      Error 404: Page Not Found
    </h1>
    <p class="text-xl text-[var(--color-text-muted)] mb-8 max-w-[50ch]">
      The page you are looking for does not exist or has been moved. Use the navigation above or return to the homepage to find what you need.
    </p>
    <a href="/" class="brutalist-button">
      Return to Homepage
    </a>
  </section>
</Layout>
