---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found (404)">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-20 text-center space-y-6">
    <div class="w-20 h-20 bg-[#E8F5E9] text-[#1B4332] rounded-full flex items-center justify-center text-3xl font-serif font-bold mx-auto">
      404
    </div>
    <h1 class="text-3xl font-serif font-bold text-[#1B4332]">Page Not Found</h1>
    <p class="text-stone-600 text-sm max-w-md mx-auto">
      The requested page could not be located on doctorameena.com. You can navigate back to our home page or explore our medical directories below.
    </p>

    <div class="pt-4 flex flex-wrap justify-center gap-3 text-xs">
      <a href="/" class="btn-primary">Return to Homepage</a>
      <a href="/conditions/" class="btn-secondary">Conditions Index</a>
      <a href="/treatments/" class="btn-secondary">Treatments Index</a>
      <a href="/tools/symptom-checklist/" class="btn-secondary">Symptom Checker</a>
    </div>
  </div>
</Layout>
