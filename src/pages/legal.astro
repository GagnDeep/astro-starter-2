---
import Layout from "../layouts/Layout.astro";

const seo = {
  page_description: "Legal, Terms, and Privacy for DogSnacking.com",
};
---

<Layout title="Legal & Privacy" seo={seo}>
  <div class="max-w-4xl mx-auto px-4 py-12 prose">
    <h1 class="text-3xl font-bold mb-6 text-[var(--color-primary)]">Legal & Privacy Policy</h1>

    <h2>Medical Disclaimer</h2>
    <p>The information on DogSnacking.com is for educational purposes only. It is not a substitute for professional veterinary advice, diagnosis, or treatment. Always seek the advice of your veterinarian with any questions you may have regarding the medical condition of your pet.</p>

    <h2>Privacy Policy</h2>
    <p>We respect your privacy. Forms submitted via our site are securely captured and not sold to third parties.</p>

    <h2>Affiliate Disclosure</h2>
    <p>We may earn a small commission for endorsements, recommendations, or testimonials from links to products.</p>
  </div>
</Layout>
