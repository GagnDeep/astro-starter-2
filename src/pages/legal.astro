---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Legal & Privacy | Institute of Property">
  <div class="py-16 px-6 sm:px-12 bg-background min-h-screen">
    <div class="max-w-3xl mx-auto prose prose-slate">
      <h1>Legal & Privacy</h1>
      <p>Last updated: January 2024</p>

      <h2>Disclaimer</h2>
      <p>The content provided on this website, including but not limited to articles, tools, and calculators, is for educational and informational purposes only. It does not constitute financial, legal, or tax advice. Always consult a qualified professional before making investment decisions.</p>

      <h2>Privacy Policy</h2>
      <p>We collect personal information such as name and email when you submit a form. This data is securely transmitted and stored. We do not sell your data to third parties.</p>

      <h2>Cookies</h2>
      <p>We use essential cookies to ensure the site functions correctly.</p>
    </div>
  </div>
</Layout>
