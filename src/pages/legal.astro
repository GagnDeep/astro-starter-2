---
import Layout from "../layouts/Layout.astro";

const seo = {
  page_title: "Legal & Terms | World AI School",
  page_description: "Terms of service, privacy policy, and legal information.",
  no_index: true
};
---

<Layout title="Legal" seo={seo}>
  <div class="max-w-3xl mx-auto px-6 py-12 prose">
    <h1>Terms and Conditions</h1>
    <p class="text-sm text-slate-500">Last updated: August 2024</p>

    <h2>1. Introduction</h2>
    <p>Welcome to World AI School. By accessing our website and using our courses, you agree to comply with and be bound by the following terms and conditions.</p>

    <h2>2. Intellectual Property</h2>
    <p>All content included on this site, such as text, graphics, logos, images, and course material, is the property of World AI School or its content suppliers and protected by international copyright laws. You may not reproduce, duplicate, copy, sell, or otherwise exploit our content for any commercial purpose without express written consent.</p>

    <h2>3. User Conduct</h2>
    <p>You agree to use our site and services only for lawful purposes. You are prohibited from posting or transmitting any material that is offensive, defamatory, or infringes on the rights of others.</p>

    <h2>4. Limitation of Liability</h2>
    <p>World AI School shall not be liable for any indirect, incidental, or consequential damages resulting from the use or inability to use our services or content.</p>

    <h2>5. Privacy Policy</h2>
    <p>We respect your privacy. Any personal information you provide to us through capture forms or enrollment is handled securely and is never sold to third parties.</p>
  </div>
</Layout>
