---
import Layout from "../layouts/Page.astro";

const seo = {
  page_description: "Legal policies, terms of service, and privacy for Handpand.com.",
  canonical_url: "https://handpand.com/legal/",
  featured_image: "/images/og/og-default.png",
  featured_image_alt: "Handpand",
  author_twitter_handle: null,
  open_graph_type: "website",
  no_index: false
};
---
<Layout frontmatter={{ title: "Legal", seo }}>
  <div class="prose mx-auto max-w-4xl py-12 px-4">
    <h1>Legal Information</h1>
    <p>Privacy policy and terms of service...</p>
  </div>
</Layout>
