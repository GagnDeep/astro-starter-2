---
import Layout from "./Layout.astro";
import type { SEOProps } from "./Layout.astro";

export interface Props {
  title: string;
  definition?: string;
  seo?: SEOProps;
}

const { title, definition, seo } = Astro.props;
---
<Layout title={title} seo={seo}>
  <article class="max-w-3xl mx-auto px-4 py-12 prose prose-slate">
    <header class="mb-8">
      <h1 class="text-3xl font-bold mb-2">{title}</h1>
    </header>
    {definition && <p class="text-xl font-medium text-slate-700 mb-8 p-4 bg-slate-50 border-l-4 border-primary">{definition}</p>}
    <div>
      <slot />
    </div>
    <div class="mt-12 text-sm text-slate-500">
      <a href="/glossary" class="text-primary hover:underline">&larr; Back to Glossary</a>
    </div>
  </article>
</Layout>
