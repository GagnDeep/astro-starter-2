---
import Layout from "./Layout.astro";
import type { SEOProps } from "./Layout.astro";
import NewsletterForm from "../components/forms/newsletter-form.astro";

export interface Props {
  title: string;
  description?: string;
  seo?: SEOProps;
}

const { title, description, seo } = Astro.props;
---
<Layout title={title} seo={seo}>
  <article class="max-w-4xl mx-auto px-4 py-12 prose prose-slate">
    <header class="mb-8">
      <h1 class="text-4xl font-bold mb-4">{title}</h1>
      {description && <p class="text-xl text-slate-600 mb-8">{description}</p>}
    </header>
    <div class="mb-12">
      <slot />
    </div>

    <div class="mt-16 bg-slate-50 p-8 rounded-lg border border-slate-200">
      <h3 class="text-2xl font-semibold mb-4">Stay Hydrated, Stay Healthy</h3>
      <p class="mb-6 text-slate-600">Get a weekly hydration tip directly to your inbox.</p>
      <NewsletterForm form="newsletter" submitLabel="Subscribe" />
    </div>
  </article>
</Layout>
