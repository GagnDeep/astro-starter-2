---
import Header from "../components/navigation/header.astro";
import Footer from "../components/navigation/footer.astro";
import Seo from "../components/seo/seo.astro";
import Observability from "../components/observability/observability.astro";
import site from "../../data/site.json";
import "../styles/main.css";

interface Props {
  title?: string;
  seo?: {
    page_description?: string | null;
    canonical_url?: string | null;
    featured_image?: string | null;
    featured_image_alt?: string | null;
    author_twitter_handle?: string | null;
    open_graph_type?: string | null;
    no_index?: boolean;
  };
  article?: {
    publishedTime?: string;
    author?: string;
    tags?: string[];
  };
  breadcrumbs?: Array<{ label: string; url: string; name?: string }>;
}

const { seo, title, article, breadcrumbs } = Astro.props;
const pageTitle = title ? `${title} | ${site.site_title}` : site.site_title;

// Map breadcrumbs safely for Seo component
const safeBreadcrumbs = breadcrumbs?.map(bc => ({
  name: bc.name || bc.label,
  url: bc.url
}));
---
<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/meta/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/meta/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/meta/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <Seo
      title={pageTitle}
      seo={seo}
      article={article}
      breadcrumbs={safeBreadcrumbs}
    />
    <Observability />
  </head>
  <body class="min-h-screen flex flex-col font-sans text-gray-900 bg-white">
    <Header />
    <div class="flex-grow">
      <slot />
    </div>
    <Footer />
  </body>
</html>
