---
import "../styles/main.css";
import site from "../../data/site.json";
import Header from "../components/navigation/header.astro";
import Footer from "../components/navigation/footer.astro";
import Seo from "../components/seo/seo.astro";
import Observability from "../components/observability/observability.astro";
import type { ArticleMeta, SeoFrontmatter } from "../lib/seo/meta";
import type { BreadcrumbItem } from "../lib/seo/schema";

export type SEOProps = SeoFrontmatter;

export interface Props {
  title: string;
  seo?: SEOProps;
  /** Article metadata for blog posts; drives OG article tags + BlogPosting JSON-LD. */
  article?: ArticleMeta;
  breadcrumbs?: BreadcrumbItem[];
  /**
   * Blog post hero front matter. When present it is converted to `article`
   * metadata automatically, so `Post.astro` can just spread front matter.
   */
  post_hero?: {
    date?: string | Date;
    author?: string;
    tags?: string[];
  };
}

const { seo, title, article, breadcrumbs, post_hero } = Astro.props;

// Derive article metadata from a blog post's hero block when not passed explicitly.
const resolvedArticle: ArticleMeta | undefined =
  article ??
  (post_hero?.date
    ? {
        publishedTime: new Date(post_hero.date).toISOString(),
        author: post_hero.author ?? site.default_author,
        tags: post_hero.tags,
      }
    : undefined);
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Boot telemetry first so early errors and first-paint timings land. -->
    <Observability />

    <Seo title={title} seo={seo} article={resolvedArticle} breadcrumbs={breadcrumbs} />

    {/* Icons and manifest are generated by `pnpm assets` — see AGENTS.md. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/meta/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/meta/favicon-16x16.png" />
    <link rel="icon" type="image/x-icon" href="/meta/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/meta/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body class="flex flex-col min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:shadow"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      if (window.inEditorMode) {
        import("../scripts/register-components.ts").catch((error) => {
          console.warn("Failed to load CloudCannon component registration:", error);
        });
      }
    </script>
    <footer class="bg-gray-900 text-white py-12 mt-20">
      <div class="max-w-5xl mx-auto px-4 md:px-8 grid grid-cols-1 md:grid-cols-3 gap-8">
        <div>
          <h3 class="font-bold text-lg mb-4 text-white">FreeFileForm</h3>
          <p class="text-gray-400 text-sm">The brutally honest, no-B.S. guide to not paying to file your taxes. Find the actually free option.</p>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-4 text-white">Resources</h3>
          <ul class="space-y-2 text-sm text-gray-400">
            <li><a href="/tools" class="hover:text-white">Tax Tools & Calculators</a></li>
            <li><a href="/reference" class="hover:text-white">Reference Guides</a></li>
            <li><a href="/comparisons" class="hover:text-white">Software Comparisons</a></li>
            <li><a href="/blog" class="hover:text-white">Tax Blog</a></li>
          </ul>
        </div>
        <div>
          <h3 class="font-bold text-lg mb-4 text-white">Stay Updated</h3>
          <p class="text-gray-400 text-sm mb-4">Get the 2025 Tax Cheat Sheet.</p>
          <form data-capture="waitlist" method="POST" action="https://api.markremover.com/v1/collect/waitlist" class="flex flex-col gap-2">
            <input type="hidden" name="key" value="wcs_pk_freefileform_placeholder_key" />
            <input type="hidden" name="redirect" value="/thanks/" />
            <input type="email" name="email" required placeholder="you@example.com" class="px-3 py-2 text-gray-900 rounded border border-gray-300 focus:outline-none focus:ring-2 focus:ring-[rgb(var(--color-primary))]" />
            <button type="submit" class="bg-[rgb(var(--color-primary))] text-white px-4 py-2 rounded hover:opacity-90 transition font-medium">Subscribe</button>
          </form>
        </div>
      </div>
      <div class="max-w-5xl mx-auto px-4 md:px-8 mt-12 pt-8 border-t border-gray-800 text-center text-sm text-gray-500 flex flex-col md:flex-row justify-between items-center">
        <p>&copy; 2024 FreeFileForm. All rights reserved.</p>
        <div class="space-x-4 mt-4 md:mt-0">
          <a href="/privacy" class="hover:text-white">Privacy Policy</a>
          <a href="/terms" class="hover:text-white">Terms of Service</a>
          <a href="/contact" class="hover:text-white">Contact Us</a>
        </div>
      </div>
    </footer>
  </body>
</html>
