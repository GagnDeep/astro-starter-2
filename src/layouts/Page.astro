---
import Layout from "./Layout.astro";
import type { CollectionEntry } from "astro:content";

type Props = {
  frontmatter: CollectionEntry<"pages">["data"] & {
    content_blocks?: any[];
    hero_block?: any;
  };
};

const props = Astro.props.frontmatter;
---

<Layout {...props}>
  <slot />
</Layout>
