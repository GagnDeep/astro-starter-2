---
import Layout from "./Layout.astro";
import type { CollectionEntry } from "astro:content";
import siteData from "../../data/site.json";

type Props = {
  /** Front matter of a `pages` collection entry. */
  frontmatter: CollectionEntry<"pages">["data"] & {
    content_blocks?: any[];
    hero_block?: any;
  };
};

const props = Astro.props.frontmatter;

const components: Record<string, Function> = {};
const componentImports = import.meta.glob("../components/**/*.astro", {
  eager: true,
});

const componentMap: Record<string, string> = {
  Hero: "heroes/hero/hero",
  LeftRight: "left-right/left-right",
  TextBlock: "text-block/text-block",
  BentoFeatures: "bento-features",
  ComparisonTable: "comparison-table",
  CtaBand: "cta-band",
  FaqAccordion: "faq-accordion",
  ProofStrip: "proof-strip",
  Byline: "byline",
  SourcesList: "sources-list",
  Breadcrumbs: "breadcrumbs",
};

Object.entries(componentImports).forEach(([path, obj]) => {
  const relativePath = path.replace("../components/", "").replace(".astro", "");
  const entry = Object.entries(componentMap).find(([, v]) => v === relativePath);
  if (entry) {
    components[entry[0]] = (obj as any).default;
  }
});

const HeroComponent = props.hero_block?._name ? components[props.hero_block._name] : null;

let resolvedArticle: any = undefined;
let listData: any = undefined;

const comparisonBlock = props.content_blocks?.find(b => b._name === "ComparisonTable");
if (comparisonBlock && comparisonBlock.rows && comparisonBlock.columns) {
  listData = {
    name: comparisonBlock.heading || "Comparison",
    items: comparisonBlock.columns.slice(1).map((col: any, index: number) => ({
      name: col.header,
      description: comparisonBlock.rows.map((r: any) => `${r.label}: ${r.values[index]}`).join(', ') || ""
    }))
  };
}

if (props.seo?.open_graph_type === "article") {
  // Find byline if exists to get author and date
  const byline = props.content_blocks?.find(b => b._name === "Byline");
  if (byline) {
    resolvedArticle = {
      publishedTime: byline.date ? new Date(byline.date).toISOString() : new Date().toISOString(),
      author: byline.author_slug || "founder",
      author_name: siteData.authors.find((a:any) => a.slug === (byline.author_slug || "founder"))?.name || "CTO Founder"
    };
  }
}

const seoProps = { ...props.seo, list_data: listData };
---

<Layout {...props} seo={seoProps} article={resolvedArticle}>
  {HeroComponent && (
    <editable-component data-prop="hero_block" data-component={props.hero_block._name}>
      <HeroComponent {...props.hero_block} />
    </editable-component>
  )}

  {props.content_blocks && props.content_blocks.length > 0 && (
    <div data-editable="array" data-prop="content_blocks" data-id-key="_name" data-component-key="_name">
      {props.content_blocks.map((block: any) => {
        const Component = components[block._name];
        if (!Component) return null;
        return (
          <section data-editable="array-item" data-id={block._name} data-component={block._name}>
            <Component {...block} />
          </section>
        );
      })}
    </div>
  )}
</Layout>
