---
import Layout from "./Layout.astro";
import type { SEOProps } from "./Layout.astro";
import NewsletterForm from "../components/forms/newsletter-form.astro";
import { capture } from "../../capture.config";

type Props = {
  frontmatter: {
    title: string;
    seo?: SEOProps;
    hero_block?: {
      _name: string;
      [key: string]: any;
    };
    content_blocks?: Array<{
      _name: string;
      [key: string]: any;
    }>;
  };
};

const { frontmatter } = Astro.props;
const { title, seo, hero_block, content_blocks } = frontmatter;
---

<Layout title={title} seo={seo}>
  {
    hero_block && (
      <editable-component data-prop="hero_block" data-component={hero_block._name}>
        {/* Render hero component here based on mapping, or fallback */}
      </editable-component>
    )
  }

  <div class="mx-auto max-w-4xl px-8 py-12 prose">
    <slot />
  </div>

  <div class="mx-auto max-w-2xl px-8 py-12 mb-12 bg-slate-50 border border-slate-200 rounded-xl">
      <h3 class="font-semibold text-2xl text-slate-900 mb-2">Get the Cheatsheet</h3>
      <p class="text-slate-600 text-sm mb-4">Master practical AI. Get our free 12-page cheatsheet covering prompting, RAG, and tools.</p>
      <NewsletterForm form={capture.forms.newsletter} submitLabel="Download Cheatsheet" />
  </div>

  {
    content_blocks?.map((block, index) => (
      <editable-component
        data-prop={`content_blocks[${index}]`}
        data-component={block._name}
      >
        {/* Render content component here based on mapping */}
      </editable-component>
    ))
  }
</Layout>
