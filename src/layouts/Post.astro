---
import Layout from "./Layout.astro";
import type { CollectionEntry } from "astro:content";
import NewsletterForm from "../components/forms/newsletter-form.astro";

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

// Initialize seo safely and assert type to avoid readonly errors
const seo = post.data.seo ? { ...post.data.seo } : { page_description: null, canonical_url: null, featured_image: null, featured_image_alt: null, author_twitter_handle: null, open_graph_type: "article", no_index: false };

// Add default open_graph_type to article
if (!seo.open_graph_type) {
  seo.open_graph_type = "article";
}
---

<Layout title={post.data.title} seo={seo} article={{
  publishedTime: post.data.date ? new Date(post.data.date).toISOString() : undefined,
  author: post.data.author,
  tags: post.data.tags
}}>
  <main class="max-w-3xl mx-auto px-4 py-12">
    <a href="/blog" class="text-blue-600 hover:underline mb-8 inline-block">&larr; Back to Articles</a>
    <header class="mb-8 border-b pb-8 mt-4">
      <h1 class="text-4xl font-bold mb-4">{post.data.title}</h1>
      <div class="text-gray-600 flex gap-4">
        {post.data.date && <time datetime={new Date(post.data.date).toISOString()}>{new Date(post.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>}
        {post.data.author && <span>By {post.data.author}</span>}
      </div>
      {post.data.image && (
        <div class="mt-8 rounded-lg overflow-hidden bg-gray-100 aspect-video">
          <img src={post.data.image} alt={post.data.image_alt || ""} class="w-full h-full object-cover" />
        </div>
      )}
    </header>
    <article class="prose prose-blue max-w-none mb-12">
      <slot />
    </article>

    <div class="bg-blue-50 p-8 rounded-lg mt-12 text-center border border-blue-100 shadow-sm">
      <h3 class="text-2xl font-bold mb-2 text-blue-900">Did this guide help?</h3>
      <p class="text-gray-700 mb-6 max-w-lg mx-auto">Get one clear, actionable investing lesson sent to your inbox every Tuesday. No spam, no stock picks.</p>
      <div class="max-w-md mx-auto">
        <NewsletterForm form="newsletter" submitLabel="Subscribe for free" placeholder="your@email.com" />
      </div>
    </div>
  </main>
</Layout>
