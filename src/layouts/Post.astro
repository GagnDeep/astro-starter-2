---
import Layout from "./Layout.astro";
import PostSummary from "../components/blog/summary.astro";
import PostHero from "../components/blog/post-hero/post-hero.astro";
import { getCollection } from "astro:content";

type Props = {
  frontmatter: any;
  body?: string;
};

const { frontmatter, body } = Astro.props;

const posts = await getCollection("blog");
const filteredPosts = posts.filter(
  (post) => post.data.title !== frontmatter.title,
);
---

<Layout
  {...frontmatter}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog/" },
    { name: frontmatter.title, url: Astro.url.pathname },
  ]}
>
  <div class="mx-auto max-w-3xl px-8 py-12 md:py-20">
    <article>
      {frontmatter.post_hero && (
        <editable-component data-prop="post_hero" data-component="PostHero">
          <PostHero {...frontmatter.post_hero} bodyContent={body} />
        </editable-component>
      )}
      <div class="prose" data-pagefind-body>
        <editable-text data-prop="@content" data-type="block">
          <slot />
        </editable-text>
      </div>
    </article>
  </div>

  {
    filteredPosts.length > 0 && (
      <section class="mx-auto max-w-6xl px-8 pb-16">
        <h2 class="text-2xl font-bold mb-6">Recent Posts</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
          {filteredPosts.slice(0, 3).map((post) => (
            <li>
              <PostSummary {...post} loading="lazy" />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
