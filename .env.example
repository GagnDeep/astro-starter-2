# ---------------------------------------------------------------------------
# Copy to `.env` and edit. Every value is validated by the `env.schema` block
# in astro.config.mjs, so a typo fails the build instead of failing silently.
#
# All PUBLIC_* values are inlined into the browser bundle by design. The
# OpenObserve client token can only write RUM/log events and is rotatable from
# the OpenObserve UI — do NOT put real secrets behind a PUBLIC_ prefix.
# ---------------------------------------------------------------------------

# === 1. Change these for every new project =================================
PUBLIC_OO_APPLICATION_ID="most-private-phone"
PUBLIC_OO_SERVICE="most-private-phone"
PUBLIC_OO_ENV="development"          # development | staging | production
PUBLIC_OO_VERSION="0.0.1"

# Master switch. Leave false locally; set true in your production build env.
PUBLIC_OO_ENABLED=false

# === 2. Org-level defaults — usually leave alone ===========================
PUBLIC_OO_CLIENT_TOKEN="rumGJjCAU1pAyClNuhG"
PUBLIC_OO_SITE="data.markremover.com"
PUBLIC_OO_ORGANIZATION="default"
PUBLIC_OO_API_VERSION="v1"
PUBLIC_OO_INSECURE_HTTP=false

# === 3. Sampling & privacy =================================================
PUBLIC_OO_SESSION_SAMPLE_RATE=100         # % of sessions tracked
PUBLIC_OO_SESSION_REPLAY_SAMPLE_RATE=100  # % of sessions replayed (0 disables)
PUBLIC_OO_PRIVACY_LEVEL="allow"           # allow | mask-user-input | mask
PUBLIC_OO_RESPECT_DO_NOT_TRACK=true

# === 4. What to collect ====================================================
PUBLIC_OO_TRACK_RESOURCES=true
PUBLIC_OO_TRACK_LONG_TASKS=true
PUBLIC_OO_TRACK_USER_INTERACTIONS=true
PUBLIC_OO_FORWARD_ERRORS_TO_LOGS=true

# === 5. Distributed tracing (optional) =====================================
# Comma-separated API origins that should receive trace headers. Empty = off.
PUBLIC_OO_TRACING_URLS=""
